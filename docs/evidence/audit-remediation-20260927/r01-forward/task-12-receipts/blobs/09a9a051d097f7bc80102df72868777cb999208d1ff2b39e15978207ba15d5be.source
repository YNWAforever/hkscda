pg_catalog.jsonb_build_object('schemas',v_catalog->'schemas','defaults',v_catalog->'defaults','roles',v_catalog->'roles','memberships',v_catalog->'memberships','extensions',v_catalog->'extensions','extensionMembers',v_catalog->'extensionMembers','databaseOwner',v_catalog->'databaseOwner','sequences',v_catalog->'sequences','relations',(select coalesce(pg_catalog.jsonb_agg(f.value order by f.ordinality),'[]'::jsonb) from pg_catalog.jsonb_array_elements(v_catalog->'relations') with ordinality f(value,ordinality) where f.value->>'schema'='public' and coalesce(f.value->>'table',f.value->>'name')=any(array['admin_user','group_enquiries','audit_log'])),'columns',(select coalesce(pg_catalog.jsonb_agg(f.value order by f.ordinality),'[]'::jsonb) from pg_catalog.jsonb_array_elements(v_catalog->'columns') with ordinality f(value,ordinality) where f.value->>'schema'='public' and coalesce(f.value->>'table',f.value->>'name')=any(array['admin_user','group_enquiries','audit_log'])),'constraints',(select coalesce(pg_catalog.jsonb_agg(f.value order by f.ordinality),'[]'::jsonb) from pg_catalog.jsonb_array_elements(v_catalog->'constraints') with ordinality f(value,ordinality) where f.value->>'schema'='public' and coalesce(f.value->>'table',f.value->>'name')=any(array['admin_user','group_enquiries','audit_log'])),'indexes',(select coalesce(pg_catalog.jsonb_agg(f.value order by f.ordinality),'[]'::jsonb) from pg_catalog.jsonb_array_elements(v_catalog->'indexes') with ordinality f(value,ordinality) where f.value->>'schema'='public' and coalesce(f.value->>'table',f.value->>'name')=any(array['admin_user','group_enquiries','audit_log'])),'triggers',(select coalesce(pg_catalog.jsonb_agg(f.value order by f.ordinality),'[]'::jsonb) from pg_catalog.jsonb_array_elements(v_catalog->'triggers') with ordinality f(value,ordinality) where f.value->>'schema'='public' and coalesce(f.value->>'table',f.value->>'name')=any(array['admin_user','group_enquiries','audit_log'])),'policies',(select coalesce(pg_catalog.jsonb_agg(f.value order by f.ordinality),'[]'::jsonb) from pg_catalog.jsonb_array_elements(v_catalog->'policies') with ordinality f(value,ordinality) where f.value->>'schema'='public' and coalesce(f.value->>'table',f.value->>'name')=any(array['admin_user','group_enquiries','audit_log'])),'types',(select coalesce(pg_catalog.jsonb_agg(f.value order by f.ordinality),'[]'::jsonb) from pg_catalog.jsonb_array_elements(v_catalog->'types') with ordinality f(value,ordinality) where f.value->>'schema'='public' and ((f.value->>'name')=any(array['admin_user','group_enquiries','audit_log']) or substring(f.value->>'name' from 2)=any(array['admin_user','group_enquiries','audit_log']) and left(f.value->>'name',1)='_' or f.value->>'kind'<>'c' and left(f.value->>'name',1)<>'_')))
