nt_assets_mime_type_check", "type": "c", "table": "document_assets", "schema": "public", "validated": true, "definition": "CHECK (mime_type = 'application/pdf'::text)"}, {"name": "document_assets_object_path_check", "type": "c", "table": "document_assets", "schema": "public", "validated": true, "definition": "CHECK (object_path !~ '(^/|\\.\\.)'::text)"}, {"name": "document_assets_object_path_key", "type": "u", "table": "document_assets", "schema": "public", "validated": true, "definition": "UNIQUE (object_path)"}, {"name": "document_assets_pkey", "type": "p", "table": "document_assets", "schema": "public", "validated": true, "definition": "PRIMARY KEY (id)"}, {"name": "document_assets_sponsorship_terms_checksum_check", "type": "c", "table": "document_assets", "schema": "public", "validated": true, "definition": "CHECK (kind <> 'sponsorship_terms'::text OR checksum_sha256 IS NOT NULL)"}, {"name": "document_assets_title_check", "type": "c", "table": "document_assets", "schema": "public", "validated": true, "definition": "CHECK (char_length(title) >= 1 AND char_length(title) <= 180)"}, {"name": "protect_published_annual_report_asset", "type": "t", "table": "document_assets", "schema": "public", "validated": true, "definition": "TRIGGER DEFERRABLE"}, {"name": "protect_published_document_references", "type": "t", "table": "document_assets", "schema": "public", "validated": true, "definition": "TRIGGER DEFERRABLE"}, {"name": "dog_friendly_estates_district_check", "type": "c", "table": "dog_friendly_estates", "schema": "public", "validated": true, "definition": "CHECK (char_length(district) >= 1 AND char_length(district) <= 120)"}, {"name": "dog_friendly_estates_estate_name_check", "type": "c", "table": "dog_friendly_estates", "schema": "public", "validated": true, "definition": "CHECK (char_length(estate_name) >= 1 AND char_length(estate_name) <= 180)"}, {"name": "dog_friendly_estates_pkey", "type": "p", "table": "dog_friendly_estates", "schema": "public", "validated": tr