, media_id)"}, {"name": "content_public_asset_sha256_check", "type": "c", "table": "content_public_asset", "schema": "public", "validated": true, "definition": "CHECK (sha256 ~ '^[a-f0-9]{64}$'::text)"}, {"name": "content_public_asset_source_bucket_check", "type": "c", "table": "content_public_asset", "schema": "public", "validated": true, "definition": "CHECK (source_bucket = 'content-media-private'::text)"}, {"name": "content_publication_prepare_content_item_id_fkey", "type": "f", "table": "content_publication_prepare", "schema": "public", "validated": true, "definition": "FOREIGN KEY (content_item_id) REFERENCES public.content_item(id) ON DELETE CASCADE"}, {"name": "content_publication_prepare_pkey", "type": "p", "table": "content_publication_prepare", "schema": "public", "validated": true, "definition": "PRIMARY KEY (idempotency_key)"}, {"name": "content_publication_prepare_revision_id_fkey", "type": "f", "table": "content_publication_prepare", "schema": "public", "validated": true, "definition": "FOREIGN KEY (revision_id) REFERENCES public.content_revision(id)"}, {"name": "content_publish_request_content_item_id_fkey", "type": "f", "table": "content_publish_request", "schema": "public", "validated": true, "definition": "FOREIGN KEY (content_item_id) REFERENCES public.content_item(id) ON DELETE CASCADE"}, {"name": "content_publish_request_idempotency_key_check", "type": "c", "table": "content_publish_request", "schema": "public", "validated": true, "definition": "CHECK (char_length(idempotency_key) >= 16 AND char_length(idempotency_key) <= 200)"}, {"name": "content_publish_request_pkey", "type": "p", "table": "content_publish_request", "schema": "public", "validated": true, "definition": "PRIMARY KEY (idempotency_key)"}, {"name": "content_publish_request_revision_id_fkey", "type": "f", "table": "content_publish_request", "schema": "public", "validated": true, "definition": "FOREIGN KEY (revision_id) REFERENCES public.content_revision(id)"}, {"name": "content_rev