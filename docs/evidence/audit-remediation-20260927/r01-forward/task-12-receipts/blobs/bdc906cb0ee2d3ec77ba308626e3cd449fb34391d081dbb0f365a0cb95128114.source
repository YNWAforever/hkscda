", "schema": "public", "validated": true, "definition": "CHECK (ordinal >= 1 AND ordinal <= 1000)"}, {"name": "finance_bank_match_item_payment_hint_check", "type": "c", "table": "finance_bank_match_item", "schema": "public", "validated": true, "definition": "CHECK (length(btrim(payment_hint)) >= 1 AND length(btrim(payment_hint)) <= 120 AND payment_hint !~ '[[:cntrl:]]'::text)"}, {"name": "finance_bank_match_item_pkey", "type": "p", "table": "finance_bank_match_item", "schema": "public", "validated": true, "definition": "PRIMARY KEY (operation_id, ordinal)"}, {"name": "finance_bank_match_item_status_check", "type": "c", "table": "finance_bank_match_item", "schema": "public", "validated": true, "definition": "CHECK (status = ANY (ARRAY['pending'::text, 'succeeded'::text, 'skipped'::text, 'conflict'::text, 'failed'::text]))"}, {"name": "finance_bank_match_operation_actor_user_id_fkey", "type": "f", "table": "finance_bank_match_operation", "schema": "public", "validated": true, "definition": "FOREIGN KEY (actor_user_id) REFERENCES auth.users(id)"}, {"name": "finance_bank_match_operation_file_sha256_check", "type": "c", "table": "finance_bank_match_operation", "schema": "public", "validated": true, "definition": "CHECK (file_sha256 ~ '^[0-9a-f]{64}$'::text)"}, {"name": "finance_bank_match_operation_pkey", "type": "p", "table": "finance_bank_match_operation", "schema": "public", "validated": true, "definition": "PRIMARY KEY (id)"}, {"name": "group_enquiries_activity_type_check", "type": "c", "table": "group_enquiries", "schema": "public", "validated": true, "definition": "CHECK (activity_type = ANY (ARRAY['group_workshop'::text, 'school_talk'::text, 'shelter_visit'::text, 'other'::text]))"}, {"name": "group_enquiries_assigned_to_fkey", "type": "f", "table": "group_enquiries", "schema": "public", "validated": true, "definition": "FOREIGN KEY (assigned_to) REFERENCES public.admin_user(id) ON DELETE SET NULL"}, {"name": "group_enquiries_contact_name_check", "type": "c", "tab