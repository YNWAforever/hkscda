ue, "definition": "PRIMARY KEY (id)"}, {"name": "dog_friendly_estates_sort_order_check", "type": "c", "table": "dog_friendly_estates", "schema": "public", "validated": true, "definition": "CHECK (sort_order >= 0)"}, {"name": "dog_friendly_estates_version_positive", "type": "c", "table": "dog_friendly_estates", "schema": "public", "validated": true, "definition": "CHECK (version > 0)"}, {"name": "donation_acquisition_context_check", "type": "c", "table": "donation", "schema": "public", "validated": true, "definition": "CHECK (acquisition_context IS NULL OR (acquisition_context = ANY (ARRAY['general'::text, 'story'::text, 'animal'::text, 'sponsor'::text, 'transparency'::text, 'community'::text])))"}, {"name": "donation_acquisition_placement_check", "type": "c", "table": "donation", "schema": "public", "validated": true, "definition": "CHECK (acquisition_placement IS NULL OR (acquisition_placement = ANY (ARRAY['mobile-bottom'::text, 'desktop-left'::text])))"}, {"name": "donation_acquisition_source_check", "type": "c", "table": "donation", "schema": "public", "validated": true, "definition": "CHECK (acquisition_source IS NULL OR acquisition_source = 'contextual-cta'::text)"}, {"name": "donation_acquisition_trigger_check", "type": "c", "table": "donation", "schema": "public", "validated": true, "definition": "CHECK (acquisition_trigger IS NULL OR (acquisition_trigger = ANY (ARRAY['scroll'::text, 'timer'::text])))"}, {"name": "donation_amount_cents_check", "type": "c", "table": "donation", "schema": "public", "validated": true, "definition": "CHECK (amount_cents > 0)"}, {"name": "donation_check", "type": "c", "table": "donation", "schema": "public", "validated": true, "definition": "CHECK (refunded_cents >= 0 AND refunded_cents <= amount_cents)"}, {"name": "donation_contact_language_check", "type": "c", "table": "donation", "schema": "public", "validated": true, "definition": "CHECK (contact_language IS NULL OR (contact_language = ANY (ARRAY['zh-HK'::text, 'en'::text])))"