", "type": "c", "table": "crm_assignment_bulk_operation", "schema": "public", "validated": true, "definition": "CHECK (filter_hash ~ '^[0-9a-f]{64}$'::text)"}, {"name": "crm_assignment_bulk_operation_pkey", "type": "p", "table": "crm_assignment_bulk_operation", "schema": "public", "validated": true, "definition": "PRIMARY KEY (id)"}, {"name": "crm_export_job_actor_user_id_fkey", "type": "f", "table": "crm_export_job", "schema": "public", "validated": true, "definition": "FOREIGN KEY (actor_user_id) REFERENCES auth.users(id)"}, {"name": "crm_export_job_check", "type": "c", "table": "crm_export_job", "schema": "public", "validated": true, "definition": "CHECK (processed_count >= 0 AND processed_count <= cardinality(item_ids))"}, {"name": "crm_export_job_filters_check", "type": "c", "table": "crm_export_job", "schema": "public", "validated": true, "definition": "CHECK (jsonb_typeof(filters) = 'object'::text)"}, {"name": "crm_export_job_item_ids_check", "type": "c", "table": "crm_export_job", "schema": "public", "validated": true, "definition": "CHECK (cardinality(item_ids) <= 20000)"}, {"name": "crm_export_job_kind_check", "type": "c", "table": "crm_export_job", "schema": "public", "validated": true, "definition": "CHECK (kind = ANY (ARRAY['supporters'::text, 'donations'::text]))"}, {"name": "crm_export_job_pkey", "type": "p", "table": "crm_export_job", "schema": "public", "validated": true, "definition": "PRIMARY KEY (id)"}, {"name": "crm_export_job_status_check", "type": "c", "table": "crm_export_job", "schema": "public", "validated": true, "definition": "CHECK (status = ANY (ARRAY['pending'::text, 'processing'::text, 'ready'::text, 'failed'::text, 'cancelled'::text]))"}, {"name": "crm_tag_bulk_item_operation_id_fkey", "type": "f", "table": "crm_tag_bulk_item", "schema": "public", "validated": true, "definition": "FOREIGN KEY (operation_id) REFERENCES public.crm_tag_bulk_operation(id)"}, {"name": "crm_tag_bulk_item_operation_id_ordinal_key", "type": "u", "table": "cr