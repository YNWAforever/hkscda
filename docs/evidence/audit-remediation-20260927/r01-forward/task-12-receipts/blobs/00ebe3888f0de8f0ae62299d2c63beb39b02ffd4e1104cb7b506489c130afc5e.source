import pathlib,json,subprocess,sys,hashlib
out=pathlib.Path(__file__).parent;raw=(out/'package.py').read_bytes();(out/'package-executed.source').write_bytes(raw);cmd=[sys.executable,'-B',str(out/'package.py')];(out/'package.invocation.json').write_bytes((json.dumps({'command':cmd,'prearchive':'package-executed.source','rawSha256':hashlib.sha256(raw).hexdigest()})+'\n').encode());p=subprocess.run(cmd,capture_output=True);(out/'package.stdout.log').write_bytes(p.stdout);(out/'package.stderr.log').write_bytes(p.stderr);(out/'package.exit.json').write_bytes((json.dumps({'exit':p.returncode,'stdoutSha256':hashlib.sha256(p.stdout).hexdigest(),'stderrSha256':hashlib.sha256(p.stderr).hexdigest()})+'\n').encode());print(p.stdout.decode());print(p.stderr.decode());sys.exit(p.returncode)
