BEGIN;insert into auth.users(id,email,email_confirmed_at,banned_until)values('4399eef0-9b02-49c3-9b7a-c904ea84e62e','4399eef0-9b02-49c3-9b7a-c904ea84e62e@example.invalid',now(),now()-interval '1 hour');insert into public.admin_user(auth_user_id,email,role,status)values('4399eef0-9b02-49c3-9b7a-c904ea84e62e','4399eef0-9b02-49c3-9b7a-c904ea84e62e@example.invalid','staff','active');insert into public.group_enquiries(id,organisation,contact_name,contact_email,contact_phone,activity_type,participant_count,idempotency_key,updated_at)values('62f804e3-4cf9-496b-88da-13e93c50a8f7','Task12 native synthetic','Synthetic contact','group@example.invalid','00000000','shelter_visit',15,'bd4b8e60-38b8-4de8-bd4c-6b4ec40e2237','2020-01-01');set local role service_role;DO $case$declare r jsonb;begin r:=public.update_group_enquiry_with_audit('62f804e3-4cf9-496b-88da-13e93c50a8f7','4399eef0-9b02-49c3-9b7a-c904ea84e62e','2020-01-01','{"status":"in_progress"}');if r->>'kind'<>'updated' then raise exception 'Native group success absent';end if;end;$case$;set local role postgres;DO $assert$begin if (select status from public.group_enquiries where id='62f804e3-4cf9-496b-88da-13e93c50a8f7')<>'in_progress' or (select count(*)from public.audit_log where entity_id='62f804e3-4cf9-496b-88da-13e93c50a8f7')<>1 then raise exception 'Native group atomic observation differs';end if;end;$assert$;ROLLBACK;