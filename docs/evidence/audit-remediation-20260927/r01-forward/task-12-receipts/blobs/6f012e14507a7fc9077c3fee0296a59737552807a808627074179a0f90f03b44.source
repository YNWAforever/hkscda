const value={receiptVersion:1,receiptType:"native-source-proposal",mode:"metadata-only-next-unobserved",nativeAddress:path,bindings,vector:vector(n),oldTargets,nextExpectedFromModern:modern.nextTargets,nativeNextObserved:false,domainRowsAfterObserved:false,sourceAdmission:false,vectorFields:["catalog","helpers","auth","native","indexes","shapes"],catalogGlobalFields:["schemas","defaults","roles","memberships","extensions","extensionMembers","databaseOwner","sequences"],catalogScopedFields:["relations","columns","constraints","indexes","triggers","policies","types"],correlation:"One complete vector plus that profile's exact old or expected next tuple; no independently mixed field allowlists. Missing/old replaces only this target; next no-op. Entire outside-target catalog and complete vector compared after. Native NEXT expectation derives from independently observed modern next, native old tuple equals modern old; actual native NEXT observation remains mandatory in frozen final candidate integration."};
