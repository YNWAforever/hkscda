  result['stagedArchiveGitIdentitiesVerified']=True;result['archivePaths']=len(archives);result['qualification']='Local metadata acceptance only. Closing Git, fresh five-job CI, independent review and production readiness remain separate pending controller gates.'
 except Exception as e:result['error']=str(e)
 result['gitCommands']=commands;result['failedFinalFlags']=[f for f in FINAL_FLAGS if result[f]is not True];result['eligible']=result['error']is None and not result['failedFinalFlags'];pending(result);(out/'receipt.json').write_bytes((json.dumps(result,indent=2)+'\n').encode());print(json.dumps({'eligible':result['eligible'],'error':result['error'],'failedFinalFlags':result['failedFinalFlags'],'receipt':str(out/'receipt.json')}));return 0 if result['eligible']else 1

