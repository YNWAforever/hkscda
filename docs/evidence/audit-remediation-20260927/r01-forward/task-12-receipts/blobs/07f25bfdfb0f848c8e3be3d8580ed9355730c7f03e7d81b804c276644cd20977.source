{
  "statements": [
    "-- Persist COD's merchant order_ref. The API documents this as the supported\n-- key for order_details; transaction_details does not support out_trade_no.\n\nalter table public.payment\n  add column if not exists provider_order_ref text",
    "create unique index if not exists payment_provider_order_ref_idx\n  on public.payment(provider, provider_order_ref)\n  where provider_order_ref is not null"
  ],
  "transactionMode": "transactional",
  "ownTransaction": false,
  "incompatible": false
}
