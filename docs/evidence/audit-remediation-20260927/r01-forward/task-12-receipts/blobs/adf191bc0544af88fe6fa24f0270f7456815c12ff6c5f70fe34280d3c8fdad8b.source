{
  "statements": [
    "-- A bearer token recovers only the exact public submission that created it.\n-- Existing rows remain null and cannot falsely confirm a changed retry.\nalter table public.public_status_token\n  add column if not exists submission_fingerprint text",
    "alter table public.public_status_token\n  add constraint public_status_token_submission_fingerprint_format\n  check (submission_fingerprint is null or submission_fingerprint ~ '^[0-9a-f]{64}$')"
  ],
  "transactionMode": "transactional",
  "ownTransaction": false,
  "incompatible": false
}
