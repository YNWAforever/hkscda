    if v_actual is distinct from '{"acl":null,"keys":"2 6 8","kind":"i","live":true,"flags":"0 0 0","natts":3,"nkeys":3,"owner":"postgres","ready":true,"table":"public.recipient_notification_draft","valid":true,"access":"btree","unique":true,"options":null,"primary":false,"checkxmin":false,"clustered":false,"exclusion":false,"immediate":true,"opclasses":["pg_catalog.uuid_ops","pg_catalog.text_ops","pg_catalog.text_ops"],"predicate":null,"collations":[null,"pg_catalog.default","pg_catalog.default"],"definition":"CREATE UNIQUE INDEX recipient_notification_draft_delivery_target_idx ON public.recipient_notification_draft USING btree (story_update_id, channel, recipient_contact)","expressions":null,"persistence":"p","replicaIdentity":false,"nullsNotDistinct":false}'::jsonb then raise exception 'R01 CMS delivery target index differs' using errcode='55000'; end if;
