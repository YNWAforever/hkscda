      revoke all on function public.mutate_dog_friendly_estate_with_audit(uuid,text,uuid,integer,jsonb) from public,anon,authenticated,service_role;
      grant execute on function public.mutate_dog_friendly_estate_with_audit(uuid,text,uuid,integer,jsonb) to service_role;
    end if;
  end if;
end;
