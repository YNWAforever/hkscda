import pathlib,subprocess,json,sys,hashlib
out=pathlib.Path(__file__).parent;raw=(out/'fixtures.py').read_bytes();(out/'fixture-syntax-failure.source').write_bytes(raw);assert b"'hosted'else162"in raw;fixed=raw.replace(b"'hosted'else162",b"'hosted' else 162");p=out/'fixtures-correct.py';p.write_bytes(fixed);(out/'fixture-executed.source').write_bytes(fixed);command=[sys.executable,'-B',str(p)];(out/'fixture.invocation.json').write_bytes((json.dumps({'command':command,'prearchivedSource':'fixture-executed.source','rawSha256':hashlib.sha256(fixed).hexdigest()})+'\n').encode());r=subprocess.run(command,capture_output=True);(out/'fixture.stdout.log').write_bytes(r.stdout);(out/'fixture.stderr.log').write_bytes(r.stderr);(out/'fixture.exit.json').write_bytes((json.dumps({'exit':r.returncode,'stdoutSha256':hashlib.sha256(r.stdout).hexdigest(),'stderrSha256':hashlib.sha256(r.stderr).hexdigest()})+'\n').encode());print(r.stdout.decode());print(r.stderr.decode());sys.exit(r.returncode)
