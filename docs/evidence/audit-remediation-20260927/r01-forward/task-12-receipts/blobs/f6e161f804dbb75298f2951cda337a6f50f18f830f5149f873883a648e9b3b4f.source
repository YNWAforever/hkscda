import {test,expect} from "bun:test";
import {assertNativeProfile,nativeFlags} from "./task-12-native-profile";
// Portable validator fixture; never actual catalog proof or SQL generation input.
function fixture(){return {receiptVersion:1,receiptType:"native-source-qualification",mode:"native-metadata-only",error:null,requiredFinalFlags:[...nativeFlags],failedFinalFlags:[],...Object.fromEntries(nativeFlags.map(k=>[k,true])),sourceAdmission:true,nativeNextObserved:false,domainRowsAfterObserved:false,nativeLocalBunBehaviorRun:false,nextProvenance:"observed-modern-render-only",rulingSha256:"94222ad1965c265acb1046d8ed364c425f5147fc07236c32798a42c94a779d06",captureSha256:"0b23f5c6b913db501de7ac90774c8279e1715e8e9feb26b8aef8b39eb133d888",originalReceiptSha256:"70451e5238d24e3be591e5841336c1eb049bd0d1b4fe8bf1fa309cdfd5228812",sourceHead:"f4e96e3484d135d179caea835d913552d96d2dcb",migrationCount:183,managedKinds:["realtime","storage","auth"],cleanupCount:4,vector:{catalog:Object.fromEntries(Array.from({length:15},(_,i)=>["synthetic"+i,[]])),helpers:Array.from({length:6},()=>({synthetic:true})),auth:Object.fromEntries(Array.from({length:11},(_,i)=>["synthetic"+i,false])),native:Array.from({length:396},()=>({synthetic:true})),indexes:Array.from({length:26},()=>({synthetic:true})),shapes:Array.from({length:4},()=>({synthetic:true}))},oldTargets:[{body:"d9d5c9d4918cab681786bd7f6def2de2",definition:"053f4dfc4ae75dd19f4c81488914ec3a"}],nextTargets:[{body:"2769396f44ea208f010b60be0a8077ee",definition:"5385cdfd05d569b1bc57feaefa187ece"}]}}
test("source-only qualification is accepted without ignored receipts",()=>expect(()=>assertNativeProfile(fixture())).not.toThrow());
for(const patch of [{receiptVersion:0},{mode:"full-native"},{error:"cleanup"},{failedFinalFlags:["rawFilesBound"]},{requiredFinalFlags:[]},{nativeNextObserved:true},{domainRowsAfterObserved:true},{nativeLocalBunBehaviorRun:true},{sourceAdmission:false},{nextProvenance:"native-observed"},{captureSha256:"0".repeat(64)},{migrationCount:182},{cleanupCount:3},{managedKinds:["auth"]},{oldTargets:[]},{nextTargets:[]}])test("source-only qualification rejects "+JSON.stringify(patch),()=>expect(()=>assertNativeProfile({...fixture(),...patch})).toThrow());
for(const key of nativeFlags)for(const value of [false,undefined,1,"true"])test("exact native source flag "+key+"="+value,()=>expect(()=>assertNativeProfile({...fixture(),[key]:value})).toThrow());
