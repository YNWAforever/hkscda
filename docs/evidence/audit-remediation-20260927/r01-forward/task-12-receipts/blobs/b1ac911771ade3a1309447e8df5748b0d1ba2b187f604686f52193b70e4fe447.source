      "constraints": [
        {
          "name": "admin_user_auth_user_id_key",
          "type": "u",
          "table": "admin_user",
          "schema": "public",
          "validated": true,
          "definition": "UNIQUE (auth_user_id)"
        },
        {
          "name": "admin_user_email_key",
          "type": "u",
          "table": "admin_user",
          "schema": "public",
          "validated": true,
          "definition": "UNIQUE (email)"
        },
        {
          "name": "admin_user_last_invited_by_fkey",
          "type": "f",
          "table": "admin_user",
          "schema": "public",
          "validated": true,
          "definition": "FOREIGN KEY (last_invited_by) REFERENCES auth.users(id)"
        },
        {
          "name": "admin_user_pkey",
          "type": "p",
          "table": "admin_user",
          "schema": "public",
          "validated": true,
          "definition": "PRIMARY KEY (id)"
        },
        {
          "name": "admin_user_role_check",
          "type": "c",
          "table": "admin_user",
          "schema": "public",
          "validated": true,
          "definition": "CHECK (role = ANY (ARRAY['staff'::text, 'treasurer'::text, 'admin'::text]))"
        },
        {
          "name": "admin_user_status_check",
          "type": "c",
          "table": "admin_user",
          "schema": "public",
          "validated": true,
          "definition": "CHECK (status = ANY (ARRAY['pending'::text, 'active'::text, 'disabled'::text]))"
        },
        {
          "name": "audit_log_pkey",
          "type": "p",
          "table": "audit_log",
          "schema": "public",
          "validated": true,
          "definition": "PRIMARY KEY (id)"
        },
        {
          "name": "group_enquiries_activity_type_check",
          "type": "c",
          "table": "group_enquiries",
          "schema": "public",
          "validated": true,
          "definition": "CHECK (activity_type = ANY (ARRAY['group_workshop'::text, 'school_talk'::text, 'shelter_visit'::text, 'other'::text]))"
        },
        {
          "name": "group_enquiries_assigned_to_fkey",
          "type": "f",
          "table": "group_enquiries",
          "schema": "public",
          "validated": true,
          "definition": "FOREIGN KEY (assigned_to) REFERENCES public.admin_user(id) ON DELETE SET NULL"
        },
        {
          "name": "group_enquiries_contact_name_check",
          "type": "c",
          "table": "group_enquiries",
          "schema": "public",
          "validated": true,
          "definition": "CHECK (char_length(contact_name) >= 1 AND char_length(contact_name) <= 120)"
        },
        {
          "name": "group_enquiries_contact_phone_check",
          "type": "c",
          "table": "group_enquiries",
          "schema": "public",
          "validated": true,
          "definition": "CHECK (char_length(contact_phone) >= 1 AND char_length(contact_phone) <= 60)"
        },
        {
          "name": "group_enquiries_idempotency_key_key",
          "type": "u",
          "table": "group_enquiries",
          "schema": "public",
          "validated": true,
          "definition": "UNIQUE (idempotency_key)"
        },
        {
          "name": "group_enquiries_notification_status_check",
          "type": "c",
          "table": "group_enquiries",
          "schema": "public",
          "validated": true,
          "definition": "CHECK (notification_status = ANY (ARRAY['pending'::text, 'sent'::text, 'failed'::text]))"
        },
        {
          "name": "group_enquiries_organisation_check",
          "type": "c",
          "table": "group_enquiries",
          "schema": "public",
          "validated": true,
          "definition": "CHECK (char_length(organisation) >= 1 AND char_length(organisation) <= 180)"
        },
        {
          "name": "group_enquiries_other_activity_description_check",
          "type": "c",
          "table": "group_enquiries",
          "schema": "public",
          "validated": true,
          "definition": "CHECK (activity_type = 'other'::text AND NULLIF(btrim(other_activity_description), ''::text) IS NOT NULL OR activity_type <> 'other'::text AND other_activity_description IS NULL)"
        },
        {
          "name": "group_enquiries_participant_count_check",
          "type": "c",
          "table": "group_enquiries",
          "schema": "public",
          "validated": true,
          "definition": "CHECK (participant_count IS NULL OR participant_count > 0)"
        },
        {
          "name": "group_enquiries_pkey",
          "type": "p",
          "table": "group_enquiries",
          "schema": "public",
          "validated": true,
          "definition": "PRIMARY KEY (id)"
        },
        {
          "name": "group_enquiries_status_check",
          "type": "c",
          "table": "group_enquiries",
          "schema": "public",
          "validated": true,
          "definition": "CHECK (status = ANY (ARRAY['new'::text, 'in_progress'::text, 'resolved'::text, 'closed'::text]))"
        }
      ],
