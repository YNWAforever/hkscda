/** R56 finite diagnostic wire codec. Product scanner and profiles stay unchanged. */
import{createHash}from'node:crypto';
export const knownScannerQueries=Object.freeze({functions:'be5256c2f3091c0bd012696b52b91d26697f2a108a44b481e6adbd0a22e178e7',operators:'5cd67e7fa70d8a430f52a963531e4bf5bfd70f97123ead50bc50f5ad1098b673',triggers:'985720de78041b6407e881c19cdf8ee561e78182cdfa1c35c50c5bf2f608f698',expressions:'ea2f714672ff8cb7ac30a6634e9563a052492f5bc43e68859888e6b1acef879d'});
export function queryKind(query:string){const sha=createHash('sha256').update(query).digest('hex');const kind=Object.entries(knownScannerQueries).find(([,expected])=>expected===sha)?.[0];if(!kind)throw Error('Unknown exact scanner metadata query');return kind;}
function oid(value:unknown,nullable=false):number|null{if(nullable&&value===null)return null;const n=typeof value==='string'&&/^(?:0|[1-9][0-9]*)$/.test(value)?Number(value):typeof value==='number'?value:NaN;if(!Number.isInteger(n)||n<0||n>4294967295)throw Error('Invalid exact uint32 OID representation');return n;}
export function decodeScannerRows(query:string,raw:unknown){const kind=queryKind(query);if(!Array.isArray(raw))throw Error('Scanner metadata rows must be array');return raw.map(row=>{if(!row||typeof row!=='object'||Array.isArray(row))throw Error('Scanner metadata row must be object');const r={...row};const required=(key:string)=>{if(!Object.hasOwn(r,key))throw Error('Missing exact scanner metadata field '+key);return r[key]};if(kind==='functions')r.oid=oid(required('oid'));else if(kind==='operators'){for(const field of ['oid','implementationOid'])r[field]=oid(required(field));for(const field of ['restrictionOid','joinOid'])r[field]=oid(required(field),true);}else if(kind==='expressions'){if(typeof required('expression')!=='string')throw Error('Invalid scanner expression field');const values=required('operatorOids');if(!Array.isArray(values))throw Error('operatorOids must remain array');r.operatorOids=values.map(value=>oid(value));}else{for(const field of ['table_name','function_name'])if(typeof required(field)!=='string')throw Error('Invalid scanner trigger field');}return r;});}
