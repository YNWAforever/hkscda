BEGIN;insert into auth.users(id,email,email_confirmed_at,banned_until)values('fc3226be-49d6-4cf8-a526-53c067075483','fc3226be-49d6-4cf8-a526-53c067075483@example.invalid',now(),null);insert into public.admin_user(auth_user_id,email,role,status)values('fc3226be-49d6-4cf8-a526-53c067075483','fc3226be-49d6-4cf8-a526-53c067075483@example.invalid','staff','active');insert into public.group_enquiries(id,organisation,contact_name,contact_email,contact_phone,activity_type,participant_count,idempotency_key,updated_at)values('3f1db5a1-f433-4281-bb3d-c8acf1a123c6','Task12 native synthetic','Synthetic contact','group@example.invalid','00000000','shelter_visit',15,'49f2bdfd-6bb3-4683-8acd-3b6b46929914','2020-01-01');alter table public.audit_log add constraint task12_native_audit_reject check(action<>'group_enquiries.update');set local role service_role;DO $case$begin perform public.update_group_enquiry_with_audit('3f1db5a1-f433-4281-bb3d-c8acf1a123c6','fc3226be-49d6-4cf8-a526-53c067075483','2020-01-01','{"status":"in_progress"}');raise exception 'Native group rejection absent';exception when sqlstate '23514' then null;end;$case$;set local role postgres;DO $assert$begin if (select status from public.group_enquiries where id='3f1db5a1-f433-4281-bb3d-c8acf1a123c6')<>'new' or (select count(*)from public.audit_log where entity_id='3f1db5a1-f433-4281-bb3d-c8acf1a123c6')<>0 then raise exception 'Native group atomic observation differs';end if;end;$assert$;ROLLBACK;