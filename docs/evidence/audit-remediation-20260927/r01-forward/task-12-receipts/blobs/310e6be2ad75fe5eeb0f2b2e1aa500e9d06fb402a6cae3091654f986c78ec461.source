{
  "statements": [
    "-- Lets a fostered animal be published, while still never showing an adopted one.\n--\n-- 20260911140000 introduced publication_state but deliberately left\n-- `status = 'available'` in the public policy, because relaxing it is a WIDENING\n-- change and the risk was unquantified: \"applicants would see animals that\n-- already have homes.\"\n--\n-- Source data settles it. Among the 263 animals the association currently offers\n-- for adoption or sponsorship, the legacy status codes decode unambiguously\n-- against the lifecycle columns:\n--\n--     S  185 animals   3 with adopted_at   -- in the shelter\n--     F   65 animals   1 with adopted_at   -- in foster care\n--     A   13 animals  11 with adopted_at   -- adopted\n--\n-- So the population blocked by `status = 'available'` is **65 fostered animals**,\n-- a quarter of the catalogue, and the population that must stay hidden is the 13\n-- adopted ones. Those are different sets, and the harm is avoided by naming the\n-- excluded state rather than by requiring a single permitted one.\n--\n-- A fostered animal is in temporary care and still needs a permanent home --\n-- that is what fostering is. Hiding it from the adoption catalogue is the defect,\n-- not the protection. An adopted animal already has a home and stays excluded.\n--\n-- This IS a widening change and is written to be bounded and reversible:\n--\n--   * It admits exactly one additional care state, 'fostered'. 'adopted' remains\n--     excluded, so nobody can apply for an animal that already has a home.\n--   * Every other conjunct is unchanged: archived records stay hidden, and\n--     publication_state = 'published' still gates every row -- so staff can\n--     withhold any individual animal regardless of its care state.\n--   * Reverting is a one-word change back to `status = 'available'`.\n--\n-- Idempotent: the policy and index are dropped and recreated.\n\ndrop policy if exists \"public read available\" on public.animals",
    "create policy \"public read available\" on public.animals for select\nusing (\n  status in ('available', 'fostered')\n  and retired_at is null\n  and publication_state = 'published'\n  and (adoption_eligible or sponsorship_eligible)\n)",
    "-- The supporting index has to match the new predicate or it stops being used.\ndrop index if exists public.animals_public_catalogue_idx",
    "create index if not exists animals_public_catalogue_idx\n  on public.animals (type)\n  where status in ('available', 'fostered')\n    and retired_at is null\n    and publication_state = 'published'\n    and (adoption_eligible or sponsorship_eligible)",
    "comment on column public.animals.status is\n  'Care/case state: available, fostered or adopted. Public visibility is governed by '\n  'publication_state; this column only excludes adopted animals from the public '\n  'catalogues, since they already have homes. A fostered animal is still seeking one.'"
  ],
  "transactionMode": "transactional",
  "ownTransaction": false,
  "incompatible": false
}
