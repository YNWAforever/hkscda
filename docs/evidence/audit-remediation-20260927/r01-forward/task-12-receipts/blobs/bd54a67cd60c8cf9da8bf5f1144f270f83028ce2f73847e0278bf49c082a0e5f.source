revoke all on function public.volunteer_policy_json_schema() from public,anon,authenticated,service_role;
create function public.volunteer_policy_json_matches(p_value jsonb,p_schema jsonb,p_depth integer default 0)
returns boolean language plpgsql immutable set search_path=public,pg_temp as $$
declare node jsonb; member record; expected text; actual text; numeric_value numeric; text_value text;
begin
 -- Only trusted fixed grammar callers can execute this helper. Bounded depth and
 -- array/object limits also bound work for deliberately oversized request data.
 if p_value is null or p_schema is null or p_depth>32 then return false; end if;
 if p_schema ? 'anyOf' then
  for node in select value from jsonb_array_elements(p_schema->'anyOf') loop
   if public.volunteer_policy_json_matches(p_value,node,p_depth+1) then return true; end if;
  end loop;
  return false;
 end if;
 if p_schema ? 'const' and p_value is distinct from p_schema->'const' then return false; end if;
 if p_schema ? 'enum' and not exists(select 1 from jsonb_array_elements(p_schema->'enum') item where item=p_value) then return false; end if;
 expected:=p_schema->>'type';actual:=jsonb_typeof(p_value);
 if expected is null then return p_schema ? 'const' or p_schema ? 'enum'; end if;
 if expected='integer' then
  if actual<>'number' then return false; end if;
  numeric_value:=(p_value#>>'{}')::numeric;
  if trunc(numeric_value)<>numeric_value then return false; end if;
 elsif expected<>actual then return false;
 end if;
 if expected='object' then
  if (select count(*) from jsonb_object_keys(p_value))>100 then return false; end if;
  for node in select value from jsonb_array_elements(coalesce(p_schema->'required','[]'::jsonb)) loop
   if not p_value ? (node#>>'{}') then return false; end if;
  end loop;
  for member in select key,value from jsonb_each(p_value) loop
   if not (p_schema->'properties') ? member.key then return false; end if;
   if not public.volunteer_policy_json_matches(member.value,p_schema->'properties'->member.key,p_depth+1) then return false; end if;
  end loop;
 elsif expected='array' then
  if jsonb_array_length(p_value)>coalesce((p_schema->>'maxItems')::integer,1000) or jsonb_array_length(p_value)<coalesce((p_schema->>'minItems')::integer,0) then return false; end if;
  for node in select value from jsonb_array_elements(p_value) loop
   if not public.volunteer_policy_json_matches(node,p_schema->'items',p_depth+1) then return false; end if;
  end loop;
 elsif expected='string' then
  text_value:=p_value#>>'{}';
  if length(text_value)<coalesce((p_schema->>'minLength')::integer,0) or length(text_value)>coalesce((p_schema->>'maxLength')::integer,100000) then return false; end if;
  if p_schema ? 'pattern' and text_value !~ (p_schema->>'pattern') then return false; end if;
 elsif expected in ('number','integer') then
  numeric_value:=(p_value#>>'{}')::numeric;
  if (p_schema ? 'minimum' and numeric_value<(p_schema->>'minimum')::numeric) or (p_schema ? 'maximum' and numeric_value>(p_schema->>'maximum')::numeric) then return false; end if;
 end if;
 return true;
exception when others then return false;
end $$;
revoke all on function public.volunteer_policy_json_matches(jsonb,jsonb,integer) from public,anon,authenticated,service_role;
create function public.volunteer_validate_policy_shape(p jsonb) returns jsonb
language sql immutable security definer set search_path=public,pg_temp as $$
 select case when public.volunteer_policy_json_matches(p,public.volunteer_policy_json_schema()) then '[]'::jsonb else '["invalid_policy_structure"]'::jsonb end;
$$;
revoke all on function public.volunteer_validate_policy_shape(jsonb) from public,anon,authenticated;
grant execute on function public.volunteer_validate_policy_shape(jsonb) to service_role;
COMMIT;
