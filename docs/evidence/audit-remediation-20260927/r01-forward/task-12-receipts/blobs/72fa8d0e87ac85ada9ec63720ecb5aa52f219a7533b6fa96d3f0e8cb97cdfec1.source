        {
          "name": "staff can read adoption application photos",
          "check": null,
          "roles": [
            "authenticated"
          ],
          "table": "objects",
          "using": "((bucket_id = 'adoption-application-photos'::text) AND private.has_admin_role(ARRAY['staff'::text, 'admin'::text]))",
          "schema": "storage",
          "command": "r",
          "permissive": true
        },
