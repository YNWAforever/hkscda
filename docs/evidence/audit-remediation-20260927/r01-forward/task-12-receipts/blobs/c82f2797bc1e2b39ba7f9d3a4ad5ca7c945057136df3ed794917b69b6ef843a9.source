BEGIN;
-- T18: explicit classification and effective dates; existing published rows remain visible for review.
alter table public.content_item
  add column if not exists content_class text not null default 'unreviewed',
  add column if not exists source_reference text,
  add column if not exists content_owner text,
  add column if not exists effective_from timestamptz,
  add column if not exists effective_until timestamptz;
alter table public.content_item
  add constraint content_item_class_check check (content_class in ('unreviewed','verified','demo')),
  add constraint content_item_effective_range_check check (effective_from is null or effective_until is null or effective_from <= effective_until),
  add constraint content_item_verified_provenance_check check (
    content_class <> 'verified' or
    (nullif(btrim(source_reference),'') is not null and nullif(btrim(content_owner),'') is not null)
  );
create or replace function public.set_content_publication_metadata(
  p_actor_user_id uuid,
  p_content_id uuid,
  p_expected_version integer,
  p_values jsonb
) returns jsonb language plpgsql security invoker set search_path=public,pg_temp as $$
declare
  actor public.admin_user%rowtype;
  item public.content_item%rowtype;
  v_revision_id uuid;
begin
  actor := private.require_content_actor(p_actor_user_id);
  if jsonb_typeof(p_values) is distinct from 'object'
    or p_values ? 'contentClass' is false
    or p_values ? 'sourceReference' is false
    or p_values ? 'contentOwner' is false
    or p_values ? 'effectiveFrom' is false
    or p_values ? 'effectiveUntil' is false
    or (select count(*) from jsonb_object_keys(p_values)) <> 5
  then raise exception 'Invalid publication metadata' using errcode='22023'; end if;
  select * into item from public.content_item where id=p_content_id for update;
  if not found then raise exception 'Content item not found' using errcode='P0002'; end if;
  if item.version is distinct from p_expected_version then
    raise exception 'Stale content version' using errcode='40001';
  end if;
  update public.content_item set
    content_class=p_values->>'contentClass',
    source_reference=nullif(btrim(p_values->>'sourceReference'),''),
    content_owner=nullif(btrim(p_values->>'contentOwner'),''),
    effective_from=(p_values->>'effectiveFrom')::timestamptz,
    effective_until=(p_values->>'effectiveUntil')::timestamptz,
    version=item.version+1,
    updated_by=actor.id
  where id=p_content_id;
  v_revision_id := private.insert_content_revision(p_content_id,item.version+1,'set_publication_metadata',actor.id);
  insert into public.audit_log(actor_user_id,action,entity,entity_id,detail)
  values(actor.id,'content.set_publication_metadata','content_item',p_content_id::text,
    jsonb_build_object('expected_version',p_expected_version,'result_version',item.version+1,
      'revision_id',v_revision_id,'before_class',item.content_class,
      'after_class',p_values->>'contentClass'));
  return jsonb_build_object('content_id',p_content_id,'version',item.version+1,'revision_id',v_revision_id);
end
$$;
revoke all on function public.set_content_publication_metadata(uuid,uuid,integer,jsonb) from public,anon,authenticated;
grant execute on function public.set_content_publication_metadata(uuid,uuid,integer,jsonb) to service_role;
create or replace function public.read_published_content_snapshots(p_filters jsonb default '{}'::jsonb)
returns jsonb language sql stable security invoker set search_path=public,pg_temp as $$
  with filtered as (
    select jsonb_set(
      private.materialize_published_content_snapshot(
        revision.public_snapshot #- '{content,source_reference}' #- '{content,content_owner}',revision.id),
      '{content}',
      ((revision.public_snapshot->'content') - 'source_reference' - 'content_owner') ||
      jsonb_build_object('content_class',item.content_class,'effective_from',item.effective_from,'effective_until',item.effective_until)
    ) as snapshot, item.published_at, item.id
    from public.content_item item join public.content_revision revision
      on revision.id=item.published_revision_id and revision.content_item_id=item.id
    where item.status='published'
      and item.content_class <> 'demo'
      and (item.effective_from is null or item.effective_from <= now())
      and (item.effective_until is null or item.effective_until >= now()
        or p_filters->>'slug' is not null
        or (item.type in ('event','charity_market') and p_filters->>'isFeatured' is null and p_filters->>'surface' is distinct from 'promotion'))
      and (p_filters->>'slug' is null or revision.public_snapshot->'content'->>'slug'=p_filters->>'slug')
      and (p_filters->>'type' is null or revision.public_snapshot->'content'->>'type'=p_filters->>'type')
      and (p_filters->>'isFeatured' is null or coalesce((revision.public_snapshot->'profile'->>'is_featured')::boolean,false)=(p_filters->>'isFeatured')::boolean)
      and (p_filters->>'animalType' is null or revision.public_snapshot->'profile'->>'animal_type'=p_filters->>'animalType')
      and (p_filters->>'publicStatus' is null or revision.public_snapshot->'profile'->>'public_status'=p_filters->>'publicStatus')
      and (p_filters->>'rescueRegion' is null or revision.public_snapshot->'profile'->>'rescue_region'=p_filters->>'rescueRegion')
      and (p_filters->>'q' is null or strpos(lower(coalesce(revision.public_snapshot->'content'->>'title','') || ' ' || coalesce(revision.public_snapshot->'content'->>'summary','')),lower(p_filters->>'q'))>0)
  ), page as (
    select * from filtered order by published_at desc nulls last,id
    limit least(50,greatest(1,coalesce((p_filters->>'pageSize')::integer,25)))
    offset (greatest(1,coalesce((p_filters->>'page')::integer,1))-1)*least(50,greatest(1,coalesce((p_filters->>'pageSize')::integer,25)))
  )
  select jsonb_build_object('total',(select count(*) from filtered),
    'rows',coalesce((select jsonb_agg(jsonb_build_object('snapshot',case when p_filters->>'detail'='true' then snapshot else private.content_summary_snapshot(snapshot) end,'published_at',published_at) order by published_at desc nulls last,id) from page),'[]'::jsonb))
$$;
revoke all on function public.read_published_content_snapshots(jsonb) from public,anon,authenticated;
grant execute on function public.read_published_content_snapshots(jsonb) to service_role;
COMMIT;
