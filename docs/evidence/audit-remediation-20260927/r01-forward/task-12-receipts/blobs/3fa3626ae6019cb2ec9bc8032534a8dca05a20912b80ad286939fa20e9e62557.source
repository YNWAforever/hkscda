begin read only;set local search_path=pg_catalog;select coalesce(jsonb_agg(to_jsonb(q)),'[]'::jsonb) from (select n.nspname schema,p.proname name,pg_get_function_identity_arguments(p.oid) args,pg_get_function_arguments(p.oid) allargs,p.pronargdefaults defaults,pg_get_expr(p.proargdefaults,0) default_expression,pg_get_function_result(p.oid) result,pg_get_userbyid(p.proowner) owner,p.proacl::text acl,(select jsonb_agg(jsonb_build_object('grantor',pg_get_userbyid(a.grantor),'grantee',case when a.grantee=0 then 'PUBLIC' else pg_get_userbyid(a.grantee) end,'privilege',a.privilege_type,'grantable',a.is_grantable) order by pg_get_userbyid(a.grantor),case when a.grantee=0 then 'PUBLIC' else pg_get_userbyid(a.grantee) end,a.privilege_type) from aclexplode(coalesce(p.proacl,acldefault('f',p.proowner))) a) full_acl,p.proconfig config,p.prosecdef definer,l.lanname language,p.prokind kind,p.procost cost,p.prorows rows,p.proisstrict strict,p.proleakproof leakproof,p.proparallel parallel,p.provolatile volatility,p.prosupport::text support,p.provariadic::regtype::text variadic,p.proargmodes modes,md5(p.prosrc) body,md5(pg_get_functiondef(p.oid)) definition from pg_proc p join pg_namespace n on n.oid=p.pronamespace join pg_language l on l.oid=p.prolang where p.oid in(select t.tgfoid from pg_trigger t where t.tgrelid in('auth.users'::regclass,'public.admin_user'::regclass,'public.group_enquiries'::regclass,'public.audit_log'::regclass) and not t.tgisinternal) or (n.nspname='auth' and p.proname='uid') or(n.nspname='private' and p.proname in('has_admin_role','lock_admin_user_mutation','require_active_admin_user')) or(n.nspname='public' and p.proname in('update_group_enquiry_with_audit')) order by n.nspname,p.proname,pg_get_function_identity_arguments(p.oid))q;rollback;
