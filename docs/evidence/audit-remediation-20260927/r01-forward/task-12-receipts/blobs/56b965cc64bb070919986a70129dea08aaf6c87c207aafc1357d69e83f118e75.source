BEGIN;insert into auth.users(id,email,email_confirmed_at,banned_until)values('72a048d6-89c5-4600-982f-ab1ac9451556','72a048d6-89c5-4600-982f-ab1ac9451556@example.invalid',now(),null);insert into public.admin_user(auth_user_id,email,role,status)values('72a048d6-89c5-4600-982f-ab1ac9451556','72a048d6-89c5-4600-982f-ab1ac9451556@example.invalid','staff','active');insert into public.group_enquiries(id,organisation,contact_name,contact_email,contact_phone,activity_type,participant_count,idempotency_key,updated_at)values('d995de62-094a-4c26-b976-4c32b1ea9666','Task12 native synthetic','Synthetic contact','group@example.invalid','00000000','shelter_visit',15,'409c33a9-3fb7-448a-a36a-86df6435303f','2020-01-01');set local role service_role;DO $case$declare r jsonb;begin r:=public.update_group_enquiry_with_audit('d995de62-094a-4c26-b976-4c32b1ea9666','72a048d6-89c5-4600-982f-ab1ac9451556','2020-01-01','{"status":"in_progress"}');if r->>'kind'<>'updated' then raise exception 'Native group success absent';end if;end;$case$;set local role postgres;DO $assert$begin if (select status from public.group_enquiries where id='d995de62-094a-4c26-b976-4c32b1ea9666')<>'in_progress' or (select count(*)from public.audit_log where entity_id='d995de62-094a-4c26-b976-4c32b1ea9666')<>1 then raise exception 'Native group atomic observation differs';end if;end;$assert$;ROLLBACK;