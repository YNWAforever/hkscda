        "definition": "CHECK (code_fingerprint ~ '^[0-9a-f]{64}$'::text)"
      },
      {
        "name": "supporter_recovery_challenge_email_fingerprint_check",
        "type": "c",
        "table": "supporter_recovery_challenge",
