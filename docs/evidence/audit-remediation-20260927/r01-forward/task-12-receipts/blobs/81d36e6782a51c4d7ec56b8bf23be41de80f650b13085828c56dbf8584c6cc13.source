        "name": "animal_replacement_batch_pkey",
        "type": "p",
        "table": "animal_replacement_batch",
        "schema": "private",
        "validated": true,
        "definition": "PRIMARY KEY (id)"
      },
      {
        "name": "animal_replacement_batch_state_check",
        "type": "c",
        "table": "animal_replacement_batch",
        "schema": "private",
        "validated": true,
        "definition": "CHECK (state = ANY (ARRAY['applied'::text, 'rolled_back'::text]))"
      },
      {
        "name": "animal_replacement_row_batch_id_fkey",
        "type": "f",
        "table": "animal_replacement_row",
        "schema": "private",
