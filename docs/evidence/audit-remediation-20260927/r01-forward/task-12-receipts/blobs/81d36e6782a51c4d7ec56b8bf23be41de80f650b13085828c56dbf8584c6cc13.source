      },
      {
        "name": "crm_export_artifact_pkey",
        "type": "p",
        "table": "crm_export_artifact",
        "schema": "private",
        "validated": true,
        "definition": "PRIMARY KEY (job_id)"
      },
      {
        "name": "supporter_recovery_challenge_attempts_check",
        "type": "c",
        "table": "supporter_recovery_challenge",
        "schema": "private",
        "validated": true,
        "definition": "CHECK (attempts >= 0 AND attempts <= 5)"
      },
      {
        "name": "supporter_recovery_challenge_auth_user_id_fkey",
        "type": "f",
        "table": "supporter_recovery_challenge",
        "schema": "private",
        "validated": true,
        "definition": "FOREIGN KEY (auth_user_id) REFERENCES auth.users(id) ON DELETE CASCADE"
      },
      {
        "name": "supporter_recovery_challenge_check",
        "type": "c",
        "table": "supporter_recovery_challenge",
        "schema": "private",
        "validated": true,
        "definition": "CHECK (expires_at > created_at AND expires_at <= (created_at + '00:15:00'::interval))"
      },
      {
        "name": "supporter_recovery_challenge_check1",
        "type": "c",
        "table": "supporter_recovery_challenge",
        "schema": "private",
        "validated": true,
        "definition": "CHECK (consumed_at IS NULL OR sealed_carrier IS NULL)"
      },
