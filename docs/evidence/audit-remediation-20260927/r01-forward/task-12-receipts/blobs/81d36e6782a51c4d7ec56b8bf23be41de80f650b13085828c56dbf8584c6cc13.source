        "definition": "FOREIGN KEY (batch_id) REFERENCES private.animal_replacement_batch(id)"
      },
      {
        "name": "animal_replacement_row_operation_check",
        "type": "c",
        "table": "animal_replacement_row",
        "schema": "private",
        "validated": true,
        "definition": "CHECK (operation = ANY (ARRAY['insert'::text, 'retire'::text]))"
      },
      {
        "name": "animal_replacement_row_pkey",
        "type": "p",
        "table": "animal_replacement_row",
