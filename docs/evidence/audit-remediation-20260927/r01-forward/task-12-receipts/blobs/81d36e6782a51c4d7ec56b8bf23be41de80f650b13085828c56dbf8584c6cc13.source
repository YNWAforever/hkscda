        "definition": "PRIMARY KEY (id)"
      },
      {
        "name": "supporter_recovery_challenge_purpose_check",
        "type": "c",
        "table": "supporter_recovery_challenge",
        "schema": "private",
        "validated": true,
        "definition": "CHECK (purpose = 'supporter-recovery-v1'::text)"
      },
      {
        "name": "supporter_recovery_challenge_sealed_carrier_check",
        "type": "c",
        "table": "supporter_recovery_challenge",
