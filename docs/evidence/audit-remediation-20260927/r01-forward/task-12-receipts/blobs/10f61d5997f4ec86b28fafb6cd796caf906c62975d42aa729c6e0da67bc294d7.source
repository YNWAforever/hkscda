    "oid": 4206,
    "body": "CREATE OR REPLACE FUNCTION pg_catalog.ts_headline(regconfig, json, tsquery)\n RETURNS json\n LANGUAGE internal\n IMMUTABLE PARALLEL SAFE STRICT COST 100\nAS $function$ts_headline_json_byid$function$\n",
