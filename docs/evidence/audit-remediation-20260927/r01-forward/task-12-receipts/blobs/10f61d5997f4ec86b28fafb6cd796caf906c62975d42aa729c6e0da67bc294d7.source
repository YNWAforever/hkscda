  {
    "oid": 22233,
    "body": "CREATE OR REPLACE FUNCTION public.apply_cms_review_bulk_item(p_actor uuid, p_operation uuid, p_content uuid)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\ndeclare v_op public.cms_review_bulk_operation%rowtype;v_item public.cms_review_bulk_item%rowtype;\n  v_revision uuid;v_publication text;v_review public.editorial_content_review%rowtype;\n  v_result jsonb;v_status text;v_reason text;\nbegin\n  perform private.require_cms_review_bulk_actor(p_actor);\n  select * into v_op from public.cms_review_bulk_operation\n  where id=p_operation and actor_user_id=p_actor for update;\n  if not found then raise exception 'CMS review operation unavailable' using errcode='42501';end if;\n  if v_op.expires_at<=pg_catalog.clock_timestamp() then raise exception 'CMS review preview expired' using errcode='P0001';end if;\n  select * into v_item from public.cms_review_bulk_item\n  where operation_id=p_operation and content_id=p_content for update;\n  if not found then raise exception 'CMS review item unavailable' using errcode='42501';end if;\n  if v_item.status<>'pending' then\n    return jsonb_build_object('entityId',p_content,'status',v_item.status,'reasonCode',v_item.reason_code);\n  end if;\n  select draft_revision_id,status into v_revision,v_publication from public.content_item where id=p_content for update;\n  -- Lock waits can outlive the snapshot; reject before any classification/result/audit write.\n  if v_op.expires_at<=pg_catalog.clock_timestamp() then raise exception 'CMS review preview expired' using errcode='P0001';end if;\n  select * into v_review from public.editorial_content_review\n  where entity_kind='content' and entity_id=p_content and revision_key=v_revision::text;\n  if v_revision is null then v_status:='skipped';v_reason:='missing_draft';\n  elsif v_publication<>'draft' then v_status:='skipped';v_reason:='not_draft';\n  elsif v_revision<>v_item.expected_revision then v_status:='conflict';v_reason:='version_changed';\n  elsif v_review.entity_id is not null then v_status:='conflict';v_reason:='classification_changed';\n  else\n    v_result:=public.editorial_review_command(p_actor,jsonb_build_object(\n      'entity_kind','content','entity_id',p_content,'revision_key',v_revision::text,\n      'classification','needs_review','evidence',v_op.evidence));\n    if v_result->>'kind'='reviewed' then v_status:='succeeded';v_reason:=null;\n    else v_status:='conflict';v_reason:=coalesce(v_result->>'kind','unexpected_result');end if;\n  end if;\n  update public.cms_review_bulk_item\n  set status=v_status,reason_code=v_reason,applied_at=clock_timestamp()\n  where operation_id=p_operation and content_id=p_content;\n  if v_status<>'succeeded' then\n    insert into public.audit_log(actor_user_id,action,entity,entity_id,detail)\n    values(p_actor,'cms_review_bulk.item_result','cms_review_bulk_item',p_content::text,\n      jsonb_build_object('operationId',p_operation,'status',v_status,'reasonCode',v_reason));\n  end if;\n  return jsonb_build_object('entityId',p_content,'status',v_status,'reasonCode',v_reason);\nend $function$\n",
    "name": "apply_cms_review_bulk_item",
    "owner": "postgres",
    "config": [
      "search_path=\"\""
    ],
    "result": "jsonb",
    "schema": "public",
    "source": "\ndeclare v_op public.cms_review_bulk_operation%rowtype;v_item public.cms_review_bulk_item%rowtype;\n  v_revision uuid;v_publication text;v_review public.editorial_content_review%rowtype;\n  v_result jsonb;v_status text;v_reason text;\nbegin\n  perform private.require_cms_review_bulk_actor(p_actor);\n  select * into v_op from public.cms_review_bulk_operation\n  where id=p_operation and actor_user_id=p_actor for update;\n  if not found then raise exception 'CMS review operation unavailable' using errcode='42501';end if;\n  if v_op.expires_at<=pg_catalog.clock_timestamp() then raise exception 'CMS review preview expired' using errcode='P0001';end if;\n  select * into v_item from public.cms_review_bulk_item\n  where operation_id=p_operation and content_id=p_content for update;\n  if not found then raise exception 'CMS review item unavailable' using errcode='42501';end if;\n  if v_item.status<>'pending' then\n    return jsonb_build_object('entityId',p_content,'status',v_item.status,'reasonCode',v_item.reason_code);\n  end if;\n  select draft_revision_id,status into v_revision,v_publication from public.content_item where id=p_content for update;\n  -- Lock waits can outlive the snapshot; reject before any classification/result/audit write.\n  if v_op.expires_at<=pg_catalog.clock_timestamp() then raise exception 'CMS review preview expired' using errcode='P0001';end if;\n  select * into v_review from public.editorial_content_review\n  where entity_kind='content' and entity_id=p_content and revision_key=v_revision::text;\n  if v_revision is null then v_status:='skipped';v_reason:='missing_draft';\n  elsif v_publication<>'draft' then v_status:='skipped';v_reason:='not_draft';\n  elsif v_revision<>v_item.expected_revision then v_status:='conflict';v_reason:='version_changed';\n  elsif v_review.entity_id is not null then v_status:='conflict';v_reason:='classification_changed';\n  else\n    v_result:=public.editorial_review_command(p_actor,jsonb_build_object(\n      'entity_kind','content','entity_id',p_content,'revision_key',v_revision::text,\n      'classification','needs_review','evidence',v_op.evidence));\n    if v_result->>'kind'='reviewed' then v_status:='succeeded';v_reason:=null;\n    else v_status:='conflict';v_reason:=coalesce(v_result->>'kind','unexpected_result');end if;\n  end if;\n  update public.cms_review_bulk_item\n  set status=v_status,reason_code=v_reason,applied_at=clock_timestamp()\n  where operation_id=p_operation and content_id=p_content;\n  if v_status<>'succeeded' then\n    insert into public.audit_log(actor_user_id,action,entity,entity_id,detail)\n    values(p_actor,'cms_review_bulk.item_result','cms_review_bulk_item',p_content::text,\n      jsonb_build_object('operationId',p_operation,'status',v_status,'reasonCode',v_reason));\n  end if;\n  return jsonb_build_object('entityId',p_content,'status',v_status,'reasonCode',v_reason);\nend ",
    "system": false,
    "library": null,
    "language": "plpgsql",
    "arguments": 3,
    "extension": null,
    "argumentTypes": [
      "pg_catalog.uuid",
      "pg_catalog.uuid",
      "pg_catalog.uuid"
    ],
    "extensionVersion": null
  },
