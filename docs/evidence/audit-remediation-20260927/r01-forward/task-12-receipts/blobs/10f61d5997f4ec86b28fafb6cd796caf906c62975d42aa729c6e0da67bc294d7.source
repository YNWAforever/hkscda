  {
    "oid": 17194,
    "body": "CREATE OR REPLACE FUNCTION storage.get_common_prefix(p_key text, p_prefix text, p_delimiter text)\n RETURNS text\n LANGUAGE sql\n IMMUTABLE\nAS $function$\nSELECT CASE\n    WHEN p_delimiter <> ''\n         AND position(p_delimiter IN substring(p_key FROM length(p_prefix) + 1)) > 0\n    THEN left(\n        p_key,\n        length(p_prefix)\n            + position(p_delimiter IN substring(p_key FROM length(p_prefix) + 1))\n            + length(p_delimiter) - 1\n    )\n    ELSE NULL\nEND;\n$function$\n",
    "name": "get_common_prefix",
    "owner": "supabase_storage_admin",
    "config": null,
    "result": "text",
    "schema": "storage",
    "source": "\nSELECT CASE\n    WHEN p_delimiter <> ''\n         AND position(p_delimiter IN substring(p_key FROM length(p_prefix) + 1)) > 0\n    THEN left(\n        p_key,\n        length(p_prefix)\n            + position(p_delimiter IN substring(p_key FROM length(p_prefix) + 1))\n            + length(p_delimiter) - 1\n    )\n    ELSE NULL\nEND;\n",
    "system": false,
    "library": null,
    "language": "sql",
    "arguments": 3,
    "extension": null,
    "argumentTypes": [
      "pg_catalog.text",
      "pg_catalog.text",
      "pg_catalog.text"
    ],
    "extensionVersion": null
  },
  {
    "oid": 19909,
    "body": "CREATE OR REPLACE FUNCTION public.read_published_content_snapshots(p_filters jsonb DEFAULT '{}'::jsonb)\n RETURNS jsonb\n LANGUAGE sql\n STABLE\n SET search_path TO 'public', 'pg_temp'\nAS $function$\n  with filtered as (\n    select jsonb_set(\n      private.materialize_published_content_snapshot(\n        revision.public_snapshot #- '{content,source_reference}' #- '{content,content_owner}',revision.id),\n      '{content}',\n      ((revision.public_snapshot->'content') - 'source_reference' - 'content_owner') ||\n      jsonb_build_object('content_class',item.content_class,'effective_from',item.effective_from,'effective_until',item.effective_until)\n    ) as snapshot, item.published_at, item.id\n    from public.content_item item join public.content_revision revision\n      on revision.id=item.published_revision_id and revision.content_item_id=item.id\n    where item.status='published'\n      and item.content_class <> 'demo'\n      and (item.effective_from is null or item.effective_from <= now())\n      and (item.effective_until is null or item.effective_until >= now()\n        or p_filters->>'slug' is not null\n        or (item.type in ('event','charity_market') and p_filters->>'isFeatured' is null and p_filters->>'surface' is distinct from 'promotion'))\n      and (p_filters->>'slug' is null or revision.public_snapshot->'content'->>'slug'=p_filters->>'slug')\n      and (p_filters->>'type' is null or revision.public_snapshot->'content'->>'type'=p_filters->>'type')\n      and (p_filters->>'isFeatured' is null or coalesce((revision.public_snapshot->'profile'->>'is_featured')::boolean,false)=(p_filters->>'isFeatured')::boolean)\n      and (p_filters->>'animalType' is null or revision.public_snapshot->'profile'->>'animal_type'=p_filters->>'animalType')\n      and (p_filters->>'publicStatus' is null or revision.public_snapshot->'profile'->>'public_status'=p_filters->>'publicStatus')\n      and (p_filters->>'rescueRegion' is null or revision.public_snapshot->'profile'->>'rescue_region'=p_filters->>'rescueRegion')\n      and (p_filters->>'q' is null or strpos(lower(coalesce(revision.public_snapshot->'content'->>'title','') || ' ' || coalesce(revision.public_snapshot->'content'->>'summary','')),lower(p_filters->>'q'))>0)\n  ), page as (\n    select * from filtered order by published_at desc nulls last,id\n    limit least(50,greatest(1,coalesce((p_filters->>'pageSize')::integer,25)))\n    offset (greatest(1,coalesce((p_filters->>'page')::integer,1))-1)*least(50,greatest(1,coalesce((p_filters->>'pageSize')::integer,25)))\n  )\n  select jsonb_build_object('total',(select count(*) from filtered),\n    'rows',coalesce((select jsonb_agg(jsonb_build_object('snapshot',case when p_filters->>'detail'='true' then snapshot else private.content_summary_snapshot(snapshot) end,'published_at',published_at) order by published_at desc nulls last,id) from page),'[]'::jsonb))\n$function$\n",
    "name": "read_published_content_snapshots",
    "owner": "postgres",
    "config": [
      "search_path=public, pg_temp"
    ],
    "result": "jsonb",
    "schema": "public",
    "source": "\n  with filtered as (\n    select jsonb_set(\n      private.materialize_published_content_snapshot(\n        revision.public_snapshot #- '{content,source_reference}' #- '{content,content_owner}',revision.id),\n      '{content}',\n      ((revision.public_snapshot->'content') - 'source_reference' - 'content_owner') ||\n      jsonb_build_object('content_class',item.content_class,'effective_from',item.effective_from,'effective_until',item.effective_until)\n    ) as snapshot, item.published_at, item.id\n    from public.content_item item join public.content_revision revision\n      on revision.id=item.published_revision_id and revision.content_item_id=item.id\n    where item.status='published'\n      and item.content_class <> 'demo'\n      and (item.effective_from is null or item.effective_from <= now())\n      and (item.effective_until is null or item.effective_until >= now()\n        or p_filters->>'slug' is not null\n        or (item.type in ('event','charity_market') and p_filters->>'isFeatured' is null and p_filters->>'surface' is distinct from 'promotion'))\n      and (p_filters->>'slug' is null or revision.public_snapshot->'content'->>'slug'=p_filters->>'slug')\n      and (p_filters->>'type' is null or revision.public_snapshot->'content'->>'type'=p_filters->>'type')\n      and (p_filters->>'isFeatured' is null or coalesce((revision.public_snapshot->'profile'->>'is_featured')::boolean,false)=(p_filters->>'isFeatured')::boolean)\n      and (p_filters->>'animalType' is null or revision.public_snapshot->'profile'->>'animal_type'=p_filters->>'animalType')\n      and (p_filters->>'publicStatus' is null or revision.public_snapshot->'profile'->>'public_status'=p_filters->>'publicStatus')\n      and (p_filters->>'rescueRegion' is null or revision.public_snapshot->'profile'->>'rescue_region'=p_filters->>'rescueRegion')\n      and (p_filters->>'q' is null or strpos(lower(coalesce(revision.public_snapshot->'content'->>'title','') || ' ' || coalesce(revision.public_snapshot->'content'->>'summary','')),lower(p_filters->>'q'))>0)\n  ), page as (\n    select * from filtered order by published_at desc nulls last,id\n    limit least(50,greatest(1,coalesce((p_filters->>'pageSize')::integer,25)))\n    offset (greatest(1,coalesce((p_filters->>'page')::integer,1))-1)*least(50,greatest(1,coalesce((p_filters->>'pageSize')::integer,25)))\n  )\n  select jsonb_build_object('total',(select count(*) from filtered),\n    'rows',coalesce((select jsonb_agg(jsonb_build_object('snapshot',case when p_filters->>'detail'='true' then snapshot else private.content_summary_snapshot(snapshot) end,'published_at',published_at) order by published_at desc nulls last,id) from page),'[]'::jsonb))\n",
    "system": false,
    "library": null,
    "language": "sql",
    "arguments": 1,
    "extension": null,
    "argumentTypes": [
      "pg_catalog.jsonb"
    ],
    "extensionVersion": null
  },
