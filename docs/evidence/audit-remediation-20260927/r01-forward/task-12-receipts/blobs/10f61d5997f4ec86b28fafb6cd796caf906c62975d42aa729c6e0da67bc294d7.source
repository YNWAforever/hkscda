    "oid": 22289,
    "body": "CREATE OR REPLACE FUNCTION private.require_sponsorship_followup_bulk_user(p_user uuid)\n RETURNS void\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\nbegin\n  perform 1 from public.admin_user a join auth.users u on u.id=a.auth_user_id\n  where a.auth_user_id=p_user and a.status='active' and a.role in ('staff','admin')\n    and u.email_confirmed_at is not null and (u.banned_until is null or u.banned_until<=now())\n  for share of a,u;\n  if not found then raise exception 'Follow-up bulk user unavailable' using errcode='42501'; end if;\nend $function$\n",
    "name": "require_sponsorship_followup_bulk_user",
    "owner": "postgres",
    "config": [
      "search_path=\"\""
    ],
    "result": "void",
    "schema": "private",
    "source": "\nbegin\n  perform 1 from public.admin_user a join auth.users u on u.id=a.auth_user_id\n  where a.auth_user_id=p_user and a.status='active' and a.role in ('staff','admin')\n    and u.email_confirmed_at is not null and (u.banned_until is null or u.banned_until<=now())\n  for share of a,u;\n  if not found then raise exception 'Follow-up bulk user unavailable' using errcode='42501'; end if;\nend ",
    "system": false,
    "library": null,
    "language": "plpgsql",
    "arguments": 1,
    "extension": null,
    "argumentTypes": [
      "pg_catalog.uuid"
    ],
    "extensionVersion": null
  },
