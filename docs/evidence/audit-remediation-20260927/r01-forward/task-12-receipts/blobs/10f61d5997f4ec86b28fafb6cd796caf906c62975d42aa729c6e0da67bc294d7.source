  {
    "oid": 21406,
    "body": "CREATE OR REPLACE FUNCTION public.volunteer_cancellation_reason(p_body jsonb, p_start timestamp with time zone, p_now timestamp with time zone)\n RETURNS text\n LANGUAGE plpgsql\n IMMUTABLE\n SET search_path TO 'public', 'pg_temp'\nAS $function$\nbegin\n if p_body is null then return 'legacy_session'; end if;\n if p_body#>>'{booking,cancellation_close,mode}'='unrestricted' then return null; end if;\n if p_body#>>'{booking,cancellation_close,mode}'='disabled' then return 'cancellation_disabled'; end if;\n if p_now>=public.volunteer_policy_window(p_body#>'{booking,cancellation_close}',p_start,p_body->>'timezone') then return 'cancellation_closed'; end if;\n return null;\nend $function$\n",
    "name": "volunteer_cancellation_reason",
    "owner": "postgres",
    "config": [
      "search_path=public, pg_temp"
    ],
    "result": "text",
    "schema": "public",
    "source": "\nbegin\n if p_body is null then return 'legacy_session'; end if;\n if p_body#>>'{booking,cancellation_close,mode}'='unrestricted' then return null; end if;\n if p_body#>>'{booking,cancellation_close,mode}'='disabled' then return 'cancellation_disabled'; end if;\n if p_now>=public.volunteer_policy_window(p_body#>'{booking,cancellation_close}',p_start,p_body->>'timezone') then return 'cancellation_closed'; end if;\n return null;\nend ",
    "system": false,
    "library": null,
    "language": "plpgsql",
    "arguments": 3,
    "extension": null,
    "argumentTypes": [
      "pg_catalog.jsonb",
      "pg_catalog.timestamptz",
      "pg_catalog.timestamptz"
    ],
    "extensionVersion": null
  },
