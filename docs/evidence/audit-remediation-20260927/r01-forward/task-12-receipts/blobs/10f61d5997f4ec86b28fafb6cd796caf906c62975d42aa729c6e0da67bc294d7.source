    "oid": 20043,
    "body": "CREATE OR REPLACE FUNCTION public.get_content_media_session(p_actor_user_id uuid, p_content_id uuid, p_session_id uuid)\n RETURNS jsonb\n LANGUAGE plpgsql\n STABLE\n SET search_path TO 'public', 'pg_temp'\nAS $function$\ndeclare session public.content_media_session%rowtype;\nbegin\n perform private.require_content_actor(p_actor_user_id);\n select * into session from public.content_media_session where id=p_session_id and content_item_id=p_content_id;\n if not found then raise exception 'Media session not found' using errcode='P0002';end if;\n return to_jsonb(session);\nend $function$\n",
    "name": "get_content_media_session",
    "owner": "postgres",
    "config": [
      "search_path=public, pg_temp"
    ],
    "result": "jsonb",
    "schema": "public",
    "source": "\ndeclare session public.content_media_session%rowtype;\nbegin\n perform private.require_content_actor(p_actor_user_id);\n select * into session from public.content_media_session where id=p_session_id and content_item_id=p_content_id;\n if not found then raise exception 'Media session not found' using errcode='P0002';end if;\n return to_jsonb(session);\nend ",
    "system": false,
    "library": null,
    "language": "plpgsql",
    "arguments": 3,
    "extension": null,
