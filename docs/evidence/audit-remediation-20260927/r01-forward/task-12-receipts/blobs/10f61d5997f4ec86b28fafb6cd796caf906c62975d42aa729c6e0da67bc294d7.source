    "body": "CREATE OR REPLACE FUNCTION pg_catalog.interval_avg_accum_inv(internal, interval)\n RETURNS internal\n LANGUAGE internal\n IMMUTABLE PARALLEL SAFE\nAS $function$interval_avg_accum_inv$function$\n",
    "name": "interval_avg_accum_inv",
    "owner": "supabase_admin",
    "config": null,
    "result": "internal",
    "schema": "pg_catalog",
    "source": "interval_avg_accum_inv",
