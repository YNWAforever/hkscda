  {
    "oid": 20722,
    "body": "CREATE OR REPLACE FUNCTION public.claim_volunteer_runtime_job(p_job_key text, p_bucket timestamp with time zone, p_owner uuid, p_lease_until timestamp with time zone)\n RETURNS boolean\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public', 'pg_temp'\nAS $function$\ndeclare n int; begin\n insert into public.volunteer_runtime_job_run(job_key,bucket,status,lease_owner,lease_until) values(p_job_key,p_bucket,'running',p_owner,p_lease_until)\n on conflict(job_key,bucket) do update set status='running',lease_owner=excluded.lease_owner,lease_until=excluded.lease_until,updated_at=clock_timestamp()\n where volunteer_runtime_job_run.status='failed' or volunteer_runtime_job_run.status='running' and volunteer_runtime_job_run.lease_until<clock_timestamp(); get diagnostics n=row_count; return n=1; end $function$\n",
    "name": "claim_volunteer_runtime_job",
    "owner": "postgres",
    "config": [
      "search_path=public, pg_temp"
    ],
    "result": "boolean",
    "schema": "public",
    "source": "\ndeclare n int; begin\n insert into public.volunteer_runtime_job_run(job_key,bucket,status,lease_owner,lease_until) values(p_job_key,p_bucket,'running',p_owner,p_lease_until)\n on conflict(job_key,bucket) do update set status='running',lease_owner=excluded.lease_owner,lease_until=excluded.lease_until,updated_at=clock_timestamp()\n where volunteer_runtime_job_run.status='failed' or volunteer_runtime_job_run.status='running' and volunteer_runtime_job_run.lease_until<clock_timestamp(); get diagnostics n=row_count; return n=1; end ",
    "system": false,
    "library": null,
    "language": "plpgsql",
    "arguments": 4,
    "extension": null,
    "argumentTypes": [
      "pg_catalog.text",
      "pg_catalog.timestamptz",
      "pg_catalog.uuid",
      "pg_catalog.timestamptz"
    ],
    "extensionVersion": null
