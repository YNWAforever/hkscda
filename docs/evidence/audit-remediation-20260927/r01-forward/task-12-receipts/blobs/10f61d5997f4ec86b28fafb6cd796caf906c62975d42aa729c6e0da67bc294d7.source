  {
    "oid": 20053,
    "body": "CREATE OR REPLACE FUNCTION public.crm_read_supporters(p_filters jsonb, p_offset integer DEFAULT 0, p_limit integer DEFAULT 25, p_export boolean DEFAULT false)\n RETURNS jsonb\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'public', 'pg_temp'\nAS $function$\n with matches as materialized(select s.id,s.created_at from private.crm_matching_supporters(p_filters) s),\n total as (select count(*) n from matches),\n page as (select m.id,m.created_at from matches m where not p_export or (select n<=5000 from total)\n   order by m.created_at desc,m.id desc offset case when p_export then 0 else greatest(0,p_offset) end\n   limit case when p_export then 5000 else least(100,greatest(1,p_limit)) end)\n select jsonb_build_object('total',total.n,'overflow',p_export and total.n>5000,\n 'supporters',coalesce((select jsonb_agg(private.crm_supporter_summary(page.id) order by page.created_at desc,page.id desc) from page),'[]'::jsonb)) from total;\n$function$\n",
    "name": "crm_read_supporters",
    "owner": "postgres",
    "config": [
      "search_path=public, pg_temp"
    ],
    "result": "jsonb",
    "schema": "public",
    "source": "\n with matches as materialized(select s.id,s.created_at from private.crm_matching_supporters(p_filters) s),\n total as (select count(*) n from matches),\n page as (select m.id,m.created_at from matches m where not p_export or (select n<=5000 from total)\n   order by m.created_at desc,m.id desc offset case when p_export then 0 else greatest(0,p_offset) end\n   limit case when p_export then 5000 else least(100,greatest(1,p_limit)) end)\n select jsonb_build_object('total',total.n,'overflow',p_export and total.n>5000,\n 'supporters',coalesce((select jsonb_agg(private.crm_supporter_summary(page.id) order by page.created_at desc,page.id desc) from page),'[]'::jsonb)) from total;\n",
    "system": false,
    "library": null,
    "language": "sql",
    "arguments": 4,
    "extension": null,
    "argumentTypes": [
      "pg_catalog.jsonb",
      "pg_catalog.int4",
      "pg_catalog.int4",
      "pg_catalog.bool"
    ],
    "extensionVersion": null
  },
