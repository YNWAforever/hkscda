  {
    "oid": 22387,
    "body": "CREATE OR REPLACE FUNCTION public.list_crm_assignment_assignees(p_actor uuid)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\nbegin\n  perform private.require_crm_assignment_user(p_actor);\n  return (\n    select coalesce(jsonb_agg(jsonb_build_object(\n      'authUserId',eligible.auth_user_id,'email',eligible.email,'role',eligible.role\n    ) order by eligible.email),'[]'::jsonb)\n    from (\n      select a.auth_user_id,a.email,a.role\n      from public.admin_user a join auth.users u on u.id=a.auth_user_id\n      where a.status='active' and a.role in ('treasurer','admin')\n        and u.email_confirmed_at is not null\n        and (u.banned_until is null or u.banned_until<=now())\n      order by a.email limit 1000\n    ) eligible\n  );\nend $function$\n",
    "name": "list_crm_assignment_assignees",
    "owner": "postgres",
    "config": [
      "search_path=\"\""
    ],
    "result": "jsonb",
    "schema": "public",
    "source": "\nbegin\n  perform private.require_crm_assignment_user(p_actor);\n  return (\n    select coalesce(jsonb_agg(jsonb_build_object(\n      'authUserId',eligible.auth_user_id,'email',eligible.email,'role',eligible.role\n    ) order by eligible.email),'[]'::jsonb)\n    from (\n      select a.auth_user_id,a.email,a.role\n      from public.admin_user a join auth.users u on u.id=a.auth_user_id\n      where a.status='active' and a.role in ('treasurer','admin')\n        and u.email_confirmed_at is not null\n        and (u.banned_until is null or u.banned_until<=now())\n      order by a.email limit 1000\n    ) eligible\n  );\nend ",
    "system": false,
    "library": null,
    "language": "plpgsql",
    "arguments": 1,
    "extension": null,
    "argumentTypes": [
      "pg_catalog.uuid"
    ],
    "extensionVersion": null
  },
