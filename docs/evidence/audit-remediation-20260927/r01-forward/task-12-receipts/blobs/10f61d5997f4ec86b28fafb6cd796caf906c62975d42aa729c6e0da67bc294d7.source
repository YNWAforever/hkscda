  {
    "oid": 21312,
    "body": "CREATE OR REPLACE FUNCTION public.settle_volunteer_operation_outbox(p_id uuid, p_attempt integer, p_status text, p_reason text, p_available_at timestamp with time zone, p_provider_message_id text DEFAULT NULL::text)\n RETURNS boolean\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public', 'pg_temp'\nAS $function$\ndeclare n integer;\nbegin\n if p_status not in('queued','failed','provider_accepted') then raise exception 'invalid_notification_status' using errcode='22023';end if;\n if p_status='provider_accepted' and nullif(trim(p_provider_message_id),'') is null then raise exception 'provider_reference_required' using errcode='22023';end if;\n update public.volunteer_operation_outbox set status=p_status,claimed_until=null,last_error=left(p_reason,500),available_at=coalesce(p_available_at,clock_timestamp()),payload=case when p_status='provider_accepted' then payload||jsonb_build_object('providerMessageId',p_provider_message_id,'providerAcceptedAt',clock_timestamp()) else payload end\n where id=p_id and status='claimed' and attempts=p_attempt and claimed_until>=clock_timestamp();get diagnostics n=row_count;return n=1;\nend $function$\n",
    "name": "settle_volunteer_operation_outbox",
    "owner": "postgres",
    "config": [
      "search_path=public, pg_temp"
    ],
    "result": "boolean",
    "schema": "public",
    "source": "\ndeclare n integer;\nbegin\n if p_status not in('queued','failed','provider_accepted') then raise exception 'invalid_notification_status' using errcode='22023';end if;\n if p_status='provider_accepted' and nullif(trim(p_provider_message_id),'') is null then raise exception 'provider_reference_required' using errcode='22023';end if;\n update public.volunteer_operation_outbox set status=p_status,claimed_until=null,last_error=left(p_reason,500),available_at=coalesce(p_available_at,clock_timestamp()),payload=case when p_status='provider_accepted' then payload||jsonb_build_object('providerMessageId',p_provider_message_id,'providerAcceptedAt',clock_timestamp()) else payload end\n where id=p_id and status='claimed' and attempts=p_attempt and claimed_until>=clock_timestamp();get diagnostics n=row_count;return n=1;\nend ",
    "system": false,
    "library": null,
    "language": "plpgsql",
    "arguments": 6,
    "extension": null,
    "argumentTypes": [
      "pg_catalog.uuid",
      "pg_catalog.int4",
      "pg_catalog.text",
      "pg_catalog.text",
      "pg_catalog.timestamptz",
      "pg_catalog.text"
    ],
    "extensionVersion": null
  },
  {
