    "oid": 19418,
    "body": "CREATE OR REPLACE FUNCTION private.protect_published_annual_report_asset()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\nbegin\n  if (new.kind <> 'annual_report' or not new.is_published)\n    and exists (\n      select 1\n      from public.annual_reports\n      where document_asset_id = new.id\n        and is_published = true\n    )\n  then\n    raise exception 'Unpublish the annual report before changing its PDF asset'\n      using errcode = '23514';\n  end if;\n  return new;\nend;\n$function$\n",
    "name": "protect_published_annual_report_asset",
    "owner": "postgres",
    "config": [
      "search_path=\"\""
    ],
    "result": "trigger",
    "schema": "private",
    "source": "\nbegin\n  if (new.kind <> 'annual_report' or not new.is_published)\n    and exists (\n      select 1\n      from public.annual_reports\n      where document_asset_id = new.id\n        and is_published = true\n    )\n  then\n    raise exception 'Unpublish the annual report before changing its PDF asset'\n      using errcode = '23514';\n  end if;\n  return new;\nend;\n",
    "system": false,
    "library": null,
    "language": "plpgsql",
    "arguments": 0,
    "extension": null,
    "argumentTypes": [],
    "extensionVersion": null
