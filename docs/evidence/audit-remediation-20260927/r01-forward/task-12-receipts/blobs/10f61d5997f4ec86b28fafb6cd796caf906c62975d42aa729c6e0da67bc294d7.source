  {
    "oid": 21950,
    "body": "CREATE OR REPLACE FUNCTION public.list_due_donation_delivery_jobs(p_limit integer DEFAULT 10)\n RETURNS TABLE(id uuid)\n LANGUAGE sql\n SECURITY DEFINER\n SET search_path TO 'public', 'pg_temp'\nAS $function$\n  select j.id from public.donation_delivery_job j\n    where (j.status = 'pending'\n      or (j.status = 'retryable' and (j.next_attempt_at is null or j.next_attempt_at <= now()))\n      or (j.status = 'processing' and j.lease_until <= now()))\n    order by coalesce(j.next_attempt_at,j.created_at),j.id\n    limit least(greatest(coalesce(p_limit,10),1),25)\n$function$\n",
    "name": "list_due_donation_delivery_jobs",
    "owner": "postgres",
    "config": [
      "search_path=public, pg_temp"
    ],
    "result": "uuid",
    "schema": "public",
    "source": "\n  select j.id from public.donation_delivery_job j\n    where (j.status = 'pending'\n      or (j.status = 'retryable' and (j.next_attempt_at is null or j.next_attempt_at <= now()))\n      or (j.status = 'processing' and j.lease_until <= now()))\n    order by coalesce(j.next_attempt_at,j.created_at),j.id\n    limit least(greatest(coalesce(p_limit,10),1),25)\n",
    "system": false,
    "library": null,
    "language": "sql",
    "arguments": 1,
    "extension": null,
    "argumentTypes": [
      "pg_catalog.int4"
    ],
    "extensionVersion": null
  },
