  {
    "oid": 2893,
    "body": "CREATE OR REPLACE FUNCTION pg_catalog.xml_in(cstring)\n RETURNS xml\n LANGUAGE internal\n STABLE PARALLEL SAFE STRICT\nAS $function$xml_in$function$\n",
