    "oid": 3294,
    "body": "CREATE OR REPLACE FUNCTION pg_catalog.current_setting(text, boolean)\n RETURNS text\n LANGUAGE internal\n STABLE PARALLEL SAFE STRICT\nAS $function$show_config_by_name_missing_ok$function$\n",
