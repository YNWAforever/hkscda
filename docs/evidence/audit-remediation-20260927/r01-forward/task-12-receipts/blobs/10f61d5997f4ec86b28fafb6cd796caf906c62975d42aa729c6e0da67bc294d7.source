    "oid": 17206,
    "body": "CREATE OR REPLACE FUNCTION storage.allow_any_operation(expected_operations text[])\n RETURNS boolean\n LANGUAGE sql\n STABLE\nAS $function$\n  WITH current_operation AS (\n    SELECT storage.operation() AS raw_operation\n  ),\n  normalized AS (\n    SELECT CASE\n      WHEN raw_operation LIKE 'storage.%' THEN substr(raw_operation, 9)\n      ELSE raw_operation\n    END AS current_operation\n    FROM current_operation\n  )\n  SELECT EXISTS (\n    SELECT 1\n    FROM normalized n\n    CROSS JOIN LATERAL unnest(expected_operations) AS expected_operation\n    WHERE expected_operation IS NOT NULL\n      AND expected_operation <> ''\n      AND n.current_operation = CASE\n        WHEN expected_operation LIKE 'storage.%' THEN substr(expected_operation, 9)\n        ELSE expected_operation\n      END\n  );\n$function$\n",
    "name": "allow_any_operation",
    "owner": "supabase_storage_admin",
    "config": null,
    "result": "boolean",
    "schema": "storage",
    "source": "\n  WITH current_operation AS (\n    SELECT storage.operation() AS raw_operation\n  ),\n  normalized AS (\n    SELECT CASE\n      WHEN raw_operation LIKE 'storage.%' THEN substr(raw_operation, 9)\n      ELSE raw_operation\n    END AS current_operation\n    FROM current_operation\n  )\n  SELECT EXISTS (\n    SELECT 1\n    FROM normalized n\n    CROSS JOIN LATERAL unnest(expected_operations) AS expected_operation\n    WHERE expected_operation IS NOT NULL\n      AND expected_operation <> ''\n      AND n.current_operation = CASE\n        WHEN expected_operation LIKE 'storage.%' THEN substr(expected_operation, 9)\n        ELSE expected_operation\n      END\n  );\n",
    "system": false,
    "library": null,
    "language": "sql",
    "arguments": 1,
    "extension": null,
    "argumentTypes": [
      "pg_catalog._text"
    ],
    "extensionVersion": null
  },
  {
    "oid": 21842,
    "body": "CREATE OR REPLACE FUNCTION private.bump_supporter_edit_version_from_role()\n RETURNS trigger\n LANGUAGE plpgsql\n SET search_path TO ''\nAS $function$\nbegin\n  if tg_op = 'UPDATE' and old.supporter_id is distinct from new.supporter_id then\n    update public.supporter set edit_version = edit_version where id = old.supporter_id;\n  end if;\n  update public.supporter set edit_version = edit_version\n  where id = case when tg_op = 'DELETE' then old.supporter_id else new.supporter_id end;\n  return null;\nend;\n$function$\n",
    "name": "bump_supporter_edit_version_from_role",
    "owner": "postgres",
    "config": [
      "search_path=\"\""
    ],
    "result": "trigger",
    "schema": "private",
    "source": "\nbegin\n  if tg_op = 'UPDATE' and old.supporter_id is distinct from new.supporter_id then\n    update public.supporter set edit_version = edit_version where id = old.supporter_id;\n  end if;\n  update public.supporter set edit_version = edit_version\n  where id = case when tg_op = 'DELETE' then old.supporter_id else new.supporter_id end;\n  return null;\nend;\n",
    "system": false,
    "library": null,
    "language": "plpgsql",
    "arguments": 0,
    "extension": null,
    "argumentTypes": [],
    "extensionVersion": null
  },
