  {
    "oid": 20046,
    "body": "CREATE OR REPLACE FUNCTION public.mark_content_public_asset_ready(p_actor_user_id uuid, p_content_id uuid, p_asset_id uuid)\n RETURNS void\n LANGUAGE plpgsql\n SET search_path TO 'public', 'pg_temp'\nAS $function$\nbegin\n perform private.require_content_actor(p_actor_user_id);\n update public.content_public_asset set ready=true where id=p_asset_id and content_item_id=p_content_id;\n if not found then raise exception 'Publication asset not found' using errcode='P0002';end if;\nend $function$\n",
    "name": "mark_content_public_asset_ready",
    "owner": "postgres",
    "config": [
      "search_path=public, pg_temp"
    ],
    "result": "void",
    "schema": "public",
    "source": "\nbegin\n perform private.require_content_actor(p_actor_user_id);\n update public.content_public_asset set ready=true where id=p_asset_id and content_item_id=p_content_id;\n if not found then raise exception 'Publication asset not found' using errcode='P0002';end if;\nend ",
    "system": false,
    "library": null,
    "language": "plpgsql",
    "arguments": 3,
    "extension": null,
    "argumentTypes": [
      "pg_catalog.uuid",
      "pg_catalog.uuid",
      "pg_catalog.uuid"
    ],
    "extensionVersion": null
  },
