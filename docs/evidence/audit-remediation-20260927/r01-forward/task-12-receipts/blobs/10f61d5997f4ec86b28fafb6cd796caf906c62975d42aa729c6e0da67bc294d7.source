  {
    "oid": 21508,
    "body": "CREATE OR REPLACE FUNCTION private.require_active_admin_user()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public', 'pg_temp'\nAS $function$\ndeclare\n  removed_active_admin boolean;\nbegin\n  if tg_op = 'DELETE' then\n    removed_active_admin := old.role = 'admin' and old.status = 'active';\n  else\n    removed_active_admin := old.role = 'admin' and old.status = 'active'\n      and (new.role <> 'admin' or new.status <> 'active');\n  end if;\n\n  if removed_active_admin and not exists (\n    select 1 from public.admin_user\n    where role = 'admin' and status = 'active'\n  ) then\n    raise exception 'last_active_admin' using errcode = 'P0001';\n  end if;\n  return null;\nend;\n$function$\n",
    "name": "require_active_admin_user",
    "owner": "postgres",
    "config": [
      "search_path=public, pg_temp"
    ],
    "result": "trigger",
    "schema": "private",
    "source": "\ndeclare\n  removed_active_admin boolean;\nbegin\n  if tg_op = 'DELETE' then\n    removed_active_admin := old.role = 'admin' and old.status = 'active';\n  else\n    removed_active_admin := old.role = 'admin' and old.status = 'active'\n      and (new.role <> 'admin' or new.status <> 'active');\n  end if;\n\n  if removed_active_admin and not exists (\n    select 1 from public.admin_user\n    where role = 'admin' and status = 'active'\n  ) then\n    raise exception 'last_active_admin' using errcode = 'P0001';\n  end if;\n  return null;\nend;\n",
    "system": false,
    "library": null,
    "language": "plpgsql",
    "arguments": 0,
    "extension": null,
    "argumentTypes": [],
    "extensionVersion": null
  },
