    "oid": 1090,
    "body": "CREATE OR REPLACE FUNCTION pg_catalog.date_ge(date, date)\n RETURNS boolean\n LANGUAGE internal\n IMMUTABLE PARALLEL SAFE STRICT LEAKPROOF\nAS $function$date_ge$function$\n",
