  {
    "oid": 20929,
    "body": "CREATE OR REPLACE FUNCTION public.volunteer_group_activity_guard()\n RETURNS trigger\n LANGUAGE plpgsql\n SET search_path TO 'public', 'pg_temp'\nAS $function$\nbegin\n if old.policy_version_id is not null then\n  if new.group_headcount<>old.group_headcount and coalesce(current_setting('hkscda.group_command',true),'')<>'apply' then raise exception 'group_change_requires_review' using errcode='42501';end if;\n  if (new.shelter_key,new.template_key) is distinct from (old.shelter_key,old.template_key) and coalesce(current_setting('hkscda.policy_command',true),'')<>'apply' then raise exception 'policy_identity_requires_review' using errcode='42501';end if;\n  if new.status='published' and old.status<>'published' and coalesce(current_setting('hkscda.policy_command',true),'')<>'apply' then raise exception 'publication_requires_policy_review' using errcode='42501';end if;\n end if;return new;\nend $function$\n",
    "name": "volunteer_group_activity_guard",
    "owner": "postgres",
    "config": [
      "search_path=public, pg_temp"
    ],
    "result": "trigger",
    "schema": "public",
    "source": "\nbegin\n if old.policy_version_id is not null then\n  if new.group_headcount<>old.group_headcount and coalesce(current_setting('hkscda.group_command',true),'')<>'apply' then raise exception 'group_change_requires_review' using errcode='42501';end if;\n  if (new.shelter_key,new.template_key) is distinct from (old.shelter_key,old.template_key) and coalesce(current_setting('hkscda.policy_command',true),'')<>'apply' then raise exception 'policy_identity_requires_review' using errcode='42501';end if;\n  if new.status='published' and old.status<>'published' and coalesce(current_setting('hkscda.policy_command',true),'')<>'apply' then raise exception 'publication_requires_policy_review' using errcode='42501';end if;\n end if;return new;\nend ",
    "system": false,
    "library": null,
    "language": "plpgsql",
    "arguments": 0,
    "extension": null,
    "argumentTypes": [],
    "extensionVersion": null
  },
