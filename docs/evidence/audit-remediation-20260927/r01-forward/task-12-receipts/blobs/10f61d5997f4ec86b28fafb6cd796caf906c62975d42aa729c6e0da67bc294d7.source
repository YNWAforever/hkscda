    "oid": 21609,
    "body": "CREATE OR REPLACE FUNCTION private.is_adoption_instruction_plain_text(value text, max_length integer)\n RETURNS boolean\n LANGUAGE sql\n IMMUTABLE\nAS $function$\n  select value is not null\n    and char_length(btrim(value)) between 1 and max_length\n    and value !~* '(<|>|javascript:|https://|http://|www\\.)';\n$function$\n",
    "name": "is_adoption_instruction_plain_text",
    "owner": "postgres",
    "config": null,
    "result": "boolean",
    "schema": "private",
    "source": "\n  select value is not null\n    and char_length(btrim(value)) between 1 and max_length\n    and value !~* '(<|>|javascript:|https://|http://|www\\.)';\n",
    "system": false,
    "library": null,
    "language": "sql",
    "arguments": 2,
    "extension": null,
    "argumentTypes": [
