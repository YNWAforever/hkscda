  {
    "oid": 19905,
    "body": "CREATE OR REPLACE FUNCTION private.guard_content_revision_snapshot()\n RETURNS trigger\n LANGUAGE plpgsql\n SET search_path TO 'public', 'pg_temp'\nAS $function$\nbegin\n  if new.authoring_snapshot is distinct from old.authoring_snapshot\n    or new.public_snapshot is distinct from old.public_snapshot\n    or new.content_item_id is distinct from old.content_item_id\n    or new.version is distinct from old.version then\n    raise exception 'Content revision snapshots are immutable' using errcode='23514';\n  end if;\n  return new;\nend\n$function$\n",
    "name": "guard_content_revision_snapshot",
    "owner": "postgres",
    "config": [
      "search_path=public, pg_temp"
    ],
    "result": "trigger",
    "schema": "private",
    "source": "\nbegin\n  if new.authoring_snapshot is distinct from old.authoring_snapshot\n    or new.public_snapshot is distinct from old.public_snapshot\n    or new.content_item_id is distinct from old.content_item_id\n    or new.version is distinct from old.version then\n    raise exception 'Content revision snapshots are immutable' using errcode='23514';\n  end if;\n  return new;\nend\n",
    "system": false,
    "library": null,
    "language": "plpgsql",
    "arguments": 0,
    "extension": null,
    "argumentTypes": [],
    "extensionVersion": null
  },
