  {
    "oid": 20580,
    "body": "CREATE OR REPLACE FUNCTION public.volunteer_policy_json_matches(p_value jsonb, p_schema jsonb, p_depth integer DEFAULT 0)\n RETURNS boolean\n LANGUAGE plpgsql\n IMMUTABLE\n SET search_path TO 'public', 'pg_temp'\nAS $function$\ndeclare node jsonb; member record; expected text; actual text; numeric_value numeric; text_value text;\nbegin\n -- Only trusted fixed grammar callers can execute this helper. Bounded depth and\n -- array/object limits also bound work for deliberately oversized request data.\n if p_value is null or p_schema is null or p_depth>32 then return false; end if;\n if p_schema ? 'anyOf' then\n  for node in select value from jsonb_array_elements(p_schema->'anyOf') loop\n   if public.volunteer_policy_json_matches(p_value,node,p_depth+1) then return true; end if;\n  end loop;\n  return false;\n end if;\n if p_schema ? 'const' and p_value is distinct from p_schema->'const' then return false; end if;\n if p_schema ? 'enum' and not exists(select 1 from jsonb_array_elements(p_schema->'enum') item where item=p_value) then return false; end if;\n expected:=p_schema->>'type';actual:=jsonb_typeof(p_value);\n if expected is null then return p_schema ? 'const' or p_schema ? 'enum'; end if;\n if expected='integer' then\n  if actual<>'number' then return false; end if;\n  numeric_value:=(p_value#>>'{}')::numeric;\n  if trunc(numeric_value)<>numeric_value then return false; end if;\n elsif expected<>actual then return false;\n end if;\n if expected='object' then\n  if (select count(*) from jsonb_object_keys(p_value))>100 then return false; end if;\n  for node in select value from jsonb_array_elements(coalesce(p_schema->'required','[]'::jsonb)) loop\n   if not p_value ? (node#>>'{}') then return false; end if;\n  end loop;\n  for member in select key,value from jsonb_each(p_value) loop\n   if not (p_schema->'properties') ? member.key then return false; end if;\n   if not public.volunteer_policy_json_matches(member.value,p_schema->'properties'->member.key,p_depth+1) then return false; end if;\n  end loop;\n elsif expected='array' then\n  if jsonb_array_length(p_value)>coalesce((p_schema->>'maxItems')::integer,1000) or jsonb_array_length(p_value)<coalesce((p_schema->>'minItems')::integer,0) then return false; end if;\n  for node in select value from jsonb_array_elements(p_value) loop\n   if not public.volunteer_policy_json_matches(node,p_schema->'items',p_depth+1) then return false; end if;\n  end loop;\n elsif expected='string' then\n  text_value:=p_value#>>'{}';\n  if length(text_value)<coalesce((p_schema->>'minLength')::integer,0) or length(text_value)>coalesce((p_schema->>'maxLength')::integer,100000) then return false; end if;\n  if p_schema ? 'pattern' and text_value !~ (p_schema->>'pattern') then return false; end if;\n elsif expected in ('number','integer') then\n  numeric_value:=(p_value#>>'{}')::numeric;\n  if (p_schema ? 'minimum' and numeric_value<(p_schema->>'minimum')::numeric) or (p_schema ? 'maximum' and numeric_value>(p_schema->>'maximum')::numeric) then return false; end if;\n end if;\n return true;\nexception when others then return false;\nend $function$\n",
    "name": "volunteer_policy_json_matches",
    "owner": "postgres",
    "config": [
      "search_path=public, pg_temp"
    ],
    "result": "boolean",
    "schema": "public",
    "source": "\ndeclare node jsonb; member record; expected text; actual text; numeric_value numeric; text_value text;\nbegin\n -- Only trusted fixed grammar callers can execute this helper. Bounded depth and\n -- array/object limits also bound work for deliberately oversized request data.\n if p_value is null or p_schema is null or p_depth>32 then return false; end if;\n if p_schema ? 'anyOf' then\n  for node in select value from jsonb_array_elements(p_schema->'anyOf') loop\n   if public.volunteer_policy_json_matches(p_value,node,p_depth+1) then return true; end if;\n  end loop;\n  return false;\n end if;\n if p_schema ? 'const' and p_value is distinct from p_schema->'const' then return false; end if;\n if p_schema ? 'enum' and not exists(select 1 from jsonb_array_elements(p_schema->'enum') item where item=p_value) then return false; end if;\n expected:=p_schema->>'type';actual:=jsonb_typeof(p_value);\n if expected is null then return p_schema ? 'const' or p_schema ? 'enum'; end if;\n if expected='integer' then\n  if actual<>'number' then return false; end if;\n  numeric_value:=(p_value#>>'{}')::numeric;\n  if trunc(numeric_value)<>numeric_value then return false; end if;\n elsif expected<>actual then return false;\n end if;\n if expected='object' then\n  if (select count(*) from jsonb_object_keys(p_value))>100 then return false; end if;\n  for node in select value from jsonb_array_elements(coalesce(p_schema->'required','[]'::jsonb)) loop\n   if not p_value ? (node#>>'{}') then return false; end if;\n  end loop;\n  for member in select key,value from jsonb_each(p_value) loop\n   if not (p_schema->'properties') ? member.key then return false; end if;\n   if not public.volunteer_policy_json_matches(member.value,p_schema->'properties'->member.key,p_depth+1) then return false; end if;\n  end loop;\n elsif expected='array' then\n  if jsonb_array_length(p_value)>coalesce((p_schema->>'maxItems')::integer,1000) or jsonb_array_length(p_value)<coalesce((p_schema->>'minItems')::integer,0) then return false; end if;\n  for node in select value from jsonb_array_elements(p_value) loop\n   if not public.volunteer_policy_json_matches(node,p_schema->'items',p_depth+1) then return false; end if;\n  end loop;\n elsif expected='string' then\n  text_value:=p_value#>>'{}';\n  if length(text_value)<coalesce((p_schema->>'minLength')::integer,0) or length(text_value)>coalesce((p_schema->>'maxLength')::integer,100000) then return false; end if;\n  if p_schema ? 'pattern' and text_value !~ (p_schema->>'pattern') then return false; end if;\n elsif expected in ('number','integer') then\n  numeric_value:=(p_value#>>'{}')::numeric;\n  if (p_schema ? 'minimum' and numeric_value<(p_schema->>'minimum')::numeric) or (p_schema ? 'maximum' and numeric_value>(p_schema->>'maximum')::numeric) then return false; end if;\n end if;\n return true;\nexception when others then return false;\nend ",
    "system": false,
    "library": null,
    "language": "plpgsql",
    "arguments": 3,
    "extension": null,
    "argumentTypes": [
      "pg_catalog.jsonb",
      "pg_catalog.jsonb",
      "pg_catalog.int4"
    ],
    "extensionVersion": null
  },
