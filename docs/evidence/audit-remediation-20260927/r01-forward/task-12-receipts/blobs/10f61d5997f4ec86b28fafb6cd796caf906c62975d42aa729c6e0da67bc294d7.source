    "oid": 17940,
    "body": "CREATE OR REPLACE FUNCTION public.strpos(public.citext, public.citext)\n RETURNS integer\n LANGUAGE sql\n IMMUTABLE PARALLEL SAFE STRICT\nAS $function$\n    SELECT pg_catalog.strpos( pg_catalog.lower( $1::pg_catalog.text ), pg_catalog.lower( $2::pg_catalog.text ) );\n$function$\n",
    "name": "strpos",
    "owner": "supabase_admin",
    "config": null,
    "result": "integer",
    "schema": "public",
    "source": "\n    SELECT pg_catalog.strpos( pg_catalog.lower( $1::pg_catalog.text ), pg_catalog.lower( $2::pg_catalog.text ) );\n",
    "system": false,
    "library": null,
    "language": "sql",
