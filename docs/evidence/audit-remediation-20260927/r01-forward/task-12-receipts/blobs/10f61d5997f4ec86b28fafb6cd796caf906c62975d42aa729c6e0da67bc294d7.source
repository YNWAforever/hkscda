  {
    "oid": 20927,
    "body": "CREATE OR REPLACE FUNCTION public.volunteer_group_snapshot_guard()\n RETURNS trigger\n LANGUAGE plpgsql\n SET search_path TO 'public', 'pg_temp'\nAS $function$\nbegin if new.contact_snapshot is distinct from old.contact_snapshot or new.enquiry_id<>old.enquiry_id or new.submitted_by<>old.submitted_by then raise exception 'immutable_group_snapshot' using errcode='42501';end if;return new;end $function$\n",
    "name": "volunteer_group_snapshot_guard",
    "owner": "postgres",
    "config": [
      "search_path=public, pg_temp"
    ],
    "result": "trigger",
    "schema": "public",
    "source": "\nbegin if new.contact_snapshot is distinct from old.contact_snapshot or new.enquiry_id<>old.enquiry_id or new.submitted_by<>old.submitted_by then raise exception 'immutable_group_snapshot' using errcode='42501';end if;return new;end ",
    "system": false,
    "library": null,
    "language": "plpgsql",
    "arguments": 0,
    "extension": null,
    "argumentTypes": [],
    "extensionVersion": null
  },
