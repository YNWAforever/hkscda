    "oid": 21569,
    "body": "CREATE OR REPLACE FUNCTION public.mark_internship_attachment_uploaded()\n RETURNS trigger\n LANGUAGE plpgsql\n SET search_path TO ''\nAS $function$\ndeclare\n  v_claimed_at timestamptz;\nbegin\n  select intent.cleanup_claimed_at into v_claimed_at\n  from public.internship_attachment_upload_intent as intent\n  where intent.storage_path = new.object_path\n  for update;\n\n  if found then\n    if v_claimed_at is not null then\n      raise exception 'internship attachment upload is being cleaned up'\n        using errcode = '55000';\n    end if;\n    update public.internship_attachment_upload_intent\n    set attached_at = pg_catalog.clock_timestamp()\n    where storage_path = new.object_path;\n  end if;\n  return new;\nend;\n$function$\n",
    "name": "mark_internship_attachment_uploaded",
    "owner": "postgres",
    "config": [
      "search_path=\"\""
    ],
    "result": "trigger",
    "schema": "public",
    "source": "\ndeclare\n  v_claimed_at timestamptz;\nbegin\n  select intent.cleanup_claimed_at into v_claimed_at\n  from public.internship_attachment_upload_intent as intent\n  where intent.storage_path = new.object_path\n  for update;\n\n  if found then\n    if v_claimed_at is not null then\n      raise exception 'internship attachment upload is being cleaned up'\n        using errcode = '55000';\n    end if;\n    update public.internship_attachment_upload_intent\n    set attached_at = pg_catalog.clock_timestamp()\n    where storage_path = new.object_path;\n  end if;\n  return new;\nend;\n",
    "system": false,
    "library": null,
    "language": "plpgsql",
    "arguments": 0,
    "extension": null,
    "argumentTypes": [],
    "extensionVersion": null
  },
