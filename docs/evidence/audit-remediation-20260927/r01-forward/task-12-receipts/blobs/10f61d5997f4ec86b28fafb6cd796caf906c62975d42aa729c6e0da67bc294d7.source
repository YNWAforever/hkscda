  {
    "oid": 17937,
    "body": "CREATE OR REPLACE FUNCTION public.regexp_split_to_array(public.citext, public.citext, text)\n RETURNS text[]\n LANGUAGE sql\n IMMUTABLE PARALLEL SAFE STRICT\nAS $function$\n    SELECT pg_catalog.regexp_split_to_array( $1::pg_catalog.text, $2::pg_catalog.text, CASE WHEN pg_catalog.strpos($3, 'c') = 0 THEN  $3 || 'i' ELSE $3 END );\n$function$\n",
    "name": "regexp_split_to_array",
    "owner": "supabase_admin",
    "config": null,
    "result": "text[]",
    "schema": "public",
    "source": "\n    SELECT pg_catalog.regexp_split_to_array( $1::pg_catalog.text, $2::pg_catalog.text, CASE WHEN pg_catalog.strpos($3, 'c') = 0 THEN  $3 || 'i' ELSE $3 END );\n",
