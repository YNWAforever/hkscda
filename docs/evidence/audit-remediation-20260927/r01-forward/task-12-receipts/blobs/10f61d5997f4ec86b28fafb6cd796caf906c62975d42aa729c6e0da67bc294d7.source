  {
    "oid": 21313,
    "body": "CREATE OR REPLACE FUNCTION public.volunteer_policy_booking_shape_guard()\n RETURNS trigger\n LANGUAGE plpgsql\n SET search_path TO 'public', 'pg_temp'\nAS $function$\nbegin\n if (new.participant_count,new.registration_type) is distinct from (old.participant_count,old.registration_type)\n and exists(select 1 from public.volunteer_activity where id in (old.activity_id,new.activity_id) and policy_version_id is not null) then\n  raise exception 'immutable_policy_booking_shape' using errcode='22023';\n end if;\n return new;\nend; $function$\n",
    "name": "volunteer_policy_booking_shape_guard",
    "owner": "postgres",
    "config": [
      "search_path=public, pg_temp"
    ],
    "result": "trigger",
    "schema": "public",
    "source": "\nbegin\n if (new.participant_count,new.registration_type) is distinct from (old.participant_count,old.registration_type)\n and exists(select 1 from public.volunteer_activity where id in (old.activity_id,new.activity_id) and policy_version_id is not null) then\n  raise exception 'immutable_policy_booking_shape' using errcode='22023';\n end if;\n return new;\nend; ",
    "system": false,
    "library": null,
    "language": "plpgsql",
    "arguments": 0,
    "extension": null,
    "argumentTypes": [],
    "extensionVersion": null
  },
