    "oid": 21981,
    "body": "CREATE OR REPLACE FUNCTION public.mark_repaired_content_public_asset(p_asset_id uuid, p_lease_token uuid)\n RETURNS boolean\n LANGUAGE plpgsql\n SET search_path TO ''\nAS $function$\nbegin\n  update public.content_public_asset\n  set ready=true,copy_claimed_at=null,repair_status='completed',\n      next_retry_at=null,lease_token=null,last_error_code=null\n  where id=p_asset_id and ready=false\n    and repair_status='claimed' and lease_token=p_lease_token;\n  return found;\nend $function$\n",
    "name": "mark_repaired_content_public_asset",
    "owner": "postgres",
    "config": [
      "search_path=\"\""
    ],
    "result": "boolean",
    "schema": "public",
    "source": "\nbegin\n  update public.content_public_asset\n  set ready=true,copy_claimed_at=null,repair_status='completed',\n      next_retry_at=null,lease_token=null,last_error_code=null\n  where id=p_asset_id and ready=false\n    and repair_status='claimed' and lease_token=p_lease_token;\n  return found;\nend ",
    "system": false,
    "library": null,
    "language": "plpgsql",
    "arguments": 2,
    "extension": null,
    "argumentTypes": [
      "pg_catalog.uuid",
      "pg_catalog.uuid"
    ],
    "extensionVersion": null
  },
