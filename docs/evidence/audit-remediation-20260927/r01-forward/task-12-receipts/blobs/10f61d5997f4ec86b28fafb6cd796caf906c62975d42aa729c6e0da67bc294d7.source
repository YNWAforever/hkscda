  {
    "oid": 21591,
    "body": "CREATE OR REPLACE FUNCTION public.search_manual_case_identity(p_query text, p_page integer DEFAULT 1, p_page_size integer DEFAULT 10)\n RETURNS jsonb\n LANGUAGE sql\n STABLE\n SET search_path TO ''\nAS $function$\n  with needle as (\n    select lower(btrim(coalesce(p_query, ''))) as value\n  ),\n  candidates as materialized (\n    select\n      case when ap.id is null then 'supporter' else 'adopter' end as kind,\n      s.id as supporter_id,\n      ap.id as adopter_profile_id,\n      coalesce(\n        nullif(btrim(ap.name_english), ''),\n        nullif(btrim(ap.name_chinese), ''),\n        nullif(btrim(s.name), ''),\n        coalesce(ap.id, s.id)::text\n      ) as display_name,\n      s.email::text as email,\n      s.phone as phone,\n      coalesce(ap.is_blacklisted, false) as is_blacklisted\n    from public.supporter s\n    left join public.adopter_profile ap on ap.supporter_id = s.id\n    cross join needle n\n    where s.deleted_at is null\n      and (\n        n.value = ''\n        or strpos(lower(coalesce(ap.name_english, '')), n.value) > 0\n        or strpos(lower(coalesce(ap.name_chinese, '')), n.value) > 0\n        or strpos(lower(coalesce(ap.address, '')), n.value) > 0\n        or strpos(lower(coalesce(s.name, '')), n.value) > 0\n        or strpos(lower(coalesce(s.email::text, '')), n.value) > 0\n        or strpos(lower(coalesce(s.phone, '')), n.value) > 0\n      )\n  ),\n  page_rows as (\n    select *\n    from candidates\n    order by lower(display_name), supporter_id\n    limit least(greatest(coalesce(p_page_size, 10), 1), 25)\n    offset (greatest(coalesce(p_page, 1), 1)::bigint - 1)\n      * least(greatest(coalesce(p_page_size, 10), 1), 25)\n  )\n  select jsonb_build_object(\n    'total', (select count(*) from candidates),\n    'candidates', coalesce(\n      (\n        select jsonb_agg(\n          jsonb_build_object(\n            'kind', kind,\n            'supporterId', supporter_id,\n            'adopterProfileId', adopter_profile_id,\n            'displayName', display_name,\n            'email', email,\n            'phone', phone,\n            'isBlacklisted', is_blacklisted,\n            'latestCaseAt', null\n          )\n          order by lower(display_name), supporter_id\n        )\n        from page_rows\n      ),\n      '[]'::jsonb\n    )\n  );\n$function$\n",
    "name": "search_manual_case_identity",
    "owner": "postgres",
    "config": [
      "search_path=\"\""
    ],
    "result": "jsonb",
    "schema": "public",
    "source": "\n  with needle as (\n    select lower(btrim(coalesce(p_query, ''))) as value\n  ),\n  candidates as materialized (\n    select\n      case when ap.id is null then 'supporter' else 'adopter' end as kind,\n      s.id as supporter_id,\n      ap.id as adopter_profile_id,\n      coalesce(\n        nullif(btrim(ap.name_english), ''),\n        nullif(btrim(ap.name_chinese), ''),\n        nullif(btrim(s.name), ''),\n        coalesce(ap.id, s.id)::text\n      ) as display_name,\n      s.email::text as email,\n      s.phone as phone,\n      coalesce(ap.is_blacklisted, false) as is_blacklisted\n    from public.supporter s\n    left join public.adopter_profile ap on ap.supporter_id = s.id\n    cross join needle n\n    where s.deleted_at is null\n      and (\n        n.value = ''\n        or strpos(lower(coalesce(ap.name_english, '')), n.value) > 0\n        or strpos(lower(coalesce(ap.name_chinese, '')), n.value) > 0\n        or strpos(lower(coalesce(ap.address, '')), n.value) > 0\n        or strpos(lower(coalesce(s.name, '')), n.value) > 0\n        or strpos(lower(coalesce(s.email::text, '')), n.value) > 0\n        or strpos(lower(coalesce(s.phone, '')), n.value) > 0\n      )\n  ),\n  page_rows as (\n    select *\n    from candidates\n    order by lower(display_name), supporter_id\n    limit least(greatest(coalesce(p_page_size, 10), 1), 25)\n    offset (greatest(coalesce(p_page, 1), 1)::bigint - 1)\n      * least(greatest(coalesce(p_page_size, 10), 1), 25)\n  )\n  select jsonb_build_object(\n    'total', (select count(*) from candidates),\n    'candidates', coalesce(\n      (\n        select jsonb_agg(\n          jsonb_build_object(\n            'kind', kind,\n            'supporterId', supporter_id,\n            'adopterProfileId', adopter_profile_id,\n            'displayName', display_name,\n            'email', email,\n            'phone', phone,\n            'isBlacklisted', is_blacklisted,\n            'latestCaseAt', null\n          )\n          order by lower(display_name), supporter_id\n        )\n        from page_rows\n      ),\n      '[]'::jsonb\n    )\n  );\n",
    "system": false,
    "library": null,
    "language": "sql",
    "arguments": 3,
    "extension": null,
    "argumentTypes": [
      "pg_catalog.text",
      "pg_catalog.int4",
      "pg_catalog.int4"
    ],
    "extensionVersion": null
  },
  {
    "oid": 21493,
    "body": "CREATE OR REPLACE FUNCTION public.replace_supporter_roles_atomic(p_supporter_id uuid, p_roles jsonb)\n RETURNS void\n LANGUAGE plpgsql\n SET search_path TO ''\nAS $function$\nbegin\n  if p_roles is null or jsonb_typeof(p_roles) <> 'array' then\n    raise exception 'invalid_supporter_roles';\n  end if;\n  perform 1 from public.supporter where id = p_supporter_id for update;\n  if not found then\n    raise exception 'supporter_not_found';\n  end if;\n  delete from public.supporter_role where supporter_id = p_supporter_id;\n  insert into public.supporter_role(supporter_id, role)\n  select p_supporter_id, role from jsonb_array_elements_text(p_roles) as role;\nend;\n$function$\n",
    "name": "replace_supporter_roles_atomic",
    "owner": "postgres",
    "config": [
      "search_path=\"\""
    ],
    "result": "void",
    "schema": "public",
    "source": "\nbegin\n  if p_roles is null or jsonb_typeof(p_roles) <> 'array' then\n    raise exception 'invalid_supporter_roles';\n  end if;\n  perform 1 from public.supporter where id = p_supporter_id for update;\n  if not found then\n    raise exception 'supporter_not_found';\n  end if;\n  delete from public.supporter_role where supporter_id = p_supporter_id;\n  insert into public.supporter_role(supporter_id, role)\n  select p_supporter_id, role from jsonb_array_elements_text(p_roles) as role;\nend;\n",
    "system": false,
    "library": null,
    "language": "plpgsql",
    "arguments": 2,
    "extension": null,
    "argumentTypes": [
      "pg_catalog.uuid",
      "pg_catalog.jsonb"
    ],
    "extensionVersion": null
  },
