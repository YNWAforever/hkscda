  {
    "oid": 21512,
    "body": "CREATE OR REPLACE FUNCTION public.resend_admin_invite_with_audit(p_actor_user_id uuid, p_target_id uuid, p_sent_at timestamp with time zone)\n RETURNS public.admin_user\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\ndeclare\n  current_user_row public.admin_user%rowtype;\n  resent_user_row public.admin_user%rowtype;\nbegin\n  perform pg_catalog.pg_advisory_xact_lock(pg_catalog.hashtextextended('public.admin_user.active_admin', 0));\n\n  perform 1 from auth.users u\n  where u.id = p_actor_user_id and u.email_confirmed_at is not null\n    and (u.banned_until is null or u.banned_until <= pg_catalog.clock_timestamp())\n  for share;\n  if not found then\n    raise exception 'admin_actor_denied' using errcode = 'P0001';\n  end if;\n\n  perform 1 from public.admin_user\n  where auth_user_id = p_actor_user_id and role = 'admin' and status = 'active'\n  for share;\n  if not found then\n    raise exception 'admin_actor_denied' using errcode = 'P0001';\n  end if;\n  if p_sent_at is null then\n    raise exception 'invalid_invite_input' using errcode = 'P0001';\n  end if;\n\n  select * into current_user_row\n  from public.admin_user\n  where id = p_target_id\n  for update;\n  if not found then\n    raise exception 'admin_user_not_found' using errcode = 'P0001';\n  end if;\n  if current_user_row.status <> 'pending' then\n    raise exception 'invite_not_pending' using errcode = 'P0001';\n  end if;\n\n  update public.admin_user\n  set invite_sent_at = p_sent_at,\n      last_invited_by = p_actor_user_id\n  where id = p_target_id\n  returning * into resent_user_row;\n\n  insert into public.audit_log (\n    actor_user_id, action, entity, entity_id, timestamp, detail\n  ) values (\n    p_actor_user_id,\n    'admin_user.invite_resend',\n    'admin_user',\n    resent_user_row.id::text,\n    p_sent_at,\n    pg_catalog.jsonb_build_object(\n      'targetEmail', resent_user_row.email,\n      'role', resent_user_row.role,\n      'status', resent_user_row.status\n    )\n  );\n\n  return resent_user_row;\nend;\n$function$\n",
    "name": "resend_admin_invite_with_audit",
    "owner": "postgres",
    "config": [
      "search_path=\"\""
    ],
    "result": "public.admin_user",
    "schema": "public",
    "source": "\ndeclare\n  current_user_row public.admin_user%rowtype;\n  resent_user_row public.admin_user%rowtype;\nbegin\n  perform pg_catalog.pg_advisory_xact_lock(pg_catalog.hashtextextended('public.admin_user.active_admin', 0));\n\n  perform 1 from auth.users u\n  where u.id = p_actor_user_id and u.email_confirmed_at is not null\n    and (u.banned_until is null or u.banned_until <= pg_catalog.clock_timestamp())\n  for share;\n  if not found then\n    raise exception 'admin_actor_denied' using errcode = 'P0001';\n  end if;\n\n  perform 1 from public.admin_user\n  where auth_user_id = p_actor_user_id and role = 'admin' and status = 'active'\n  for share;\n  if not found then\n    raise exception 'admin_actor_denied' using errcode = 'P0001';\n  end if;\n  if p_sent_at is null then\n    raise exception 'invalid_invite_input' using errcode = 'P0001';\n  end if;\n\n  select * into current_user_row\n  from public.admin_user\n  where id = p_target_id\n  for update;\n  if not found then\n    raise exception 'admin_user_not_found' using errcode = 'P0001';\n  end if;\n  if current_user_row.status <> 'pending' then\n    raise exception 'invite_not_pending' using errcode = 'P0001';\n  end if;\n\n  update public.admin_user\n  set invite_sent_at = p_sent_at,\n      last_invited_by = p_actor_user_id\n  where id = p_target_id\n  returning * into resent_user_row;\n\n  insert into public.audit_log (\n    actor_user_id, action, entity, entity_id, timestamp, detail\n  ) values (\n    p_actor_user_id,\n    'admin_user.invite_resend',\n    'admin_user',\n    resent_user_row.id::text,\n    p_sent_at,\n    pg_catalog.jsonb_build_object(\n      'targetEmail', resent_user_row.email,\n      'role', resent_user_row.role,\n      'status', resent_user_row.status\n    )\n  );\n\n  return resent_user_row;\nend;\n",
    "system": false,
    "library": null,
    "language": "plpgsql",
    "arguments": 3,
    "extension": null,
    "argumentTypes": [
      "pg_catalog.uuid",
      "pg_catalog.uuid",
      "pg_catalog.timestamptz"
    ],
    "extensionVersion": null
  },
