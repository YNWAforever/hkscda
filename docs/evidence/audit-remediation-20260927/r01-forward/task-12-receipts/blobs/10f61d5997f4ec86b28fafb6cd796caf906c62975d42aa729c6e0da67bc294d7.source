  {
    "oid": 21009,
    "body": "CREATE OR REPLACE FUNCTION public.claim_sponsorship_deliveries(p_actor uuid, p_limit integer DEFAULT 10, p_pledge uuid DEFAULT NULL::uuid)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public', 'pg_temp'\nAS $function$\ndeclare v_result jsonb;\nbegin\n if not exists(select 1 from public.admin_user where auth_user_id=p_actor and status='active' and role in ('admin','staff','treasurer')) then raise exception 'Coordinator required' using errcode='42501'; end if;\n with candidates as (select id from public.sponsorship_delivery_outbox where (p_pledge is null or pledge_id=p_pledge) and next_attempt_at<=now() and (status in ('queued','failed') or (status='processing' and lease_until<now())) order by created_at for update skip locked limit least(greatest(p_limit,1),25)),\n claimed as (update public.sponsorship_delivery_outbox o set status='processing',lease_token=gen_random_uuid(),lease_until=now()+interval '2 minutes',attempts=attempts+1 from candidates c where o.id=c.id returning o.*)\n select coalesce(jsonb_agg(to_jsonb(c)||jsonb_build_object('supporterEmail',c.recipient_email,'supporterName',c.recipient_name,'language',c.language,'amountCents',c.amount_cents)),'[]'::jsonb) into v_result\n from claimed c join public.sponsorship_pledge p on p.id=c.pledge_id join public.supporter s on s.id=p.supporter_id left join public.sponsorship_payment_proof proof on proof.id=c.proof_id;\n return v_result;\nend; $function$\n",
    "name": "claim_sponsorship_deliveries",
    "owner": "postgres",
    "config": [
      "search_path=public, pg_temp"
    ],
    "result": "jsonb",
    "schema": "public",
    "source": "\ndeclare v_result jsonb;\nbegin\n if not exists(select 1 from public.admin_user where auth_user_id=p_actor and status='active' and role in ('admin','staff','treasurer')) then raise exception 'Coordinator required' using errcode='42501'; end if;\n with candidates as (select id from public.sponsorship_delivery_outbox where (p_pledge is null or pledge_id=p_pledge) and next_attempt_at<=now() and (status in ('queued','failed') or (status='processing' and lease_until<now())) order by created_at for update skip locked limit least(greatest(p_limit,1),25)),\n claimed as (update public.sponsorship_delivery_outbox o set status='processing',lease_token=gen_random_uuid(),lease_until=now()+interval '2 minutes',attempts=attempts+1 from candidates c where o.id=c.id returning o.*)\n select coalesce(jsonb_agg(to_jsonb(c)||jsonb_build_object('supporterEmail',c.recipient_email,'supporterName',c.recipient_name,'language',c.language,'amountCents',c.amount_cents)),'[]'::jsonb) into v_result\n from claimed c join public.sponsorship_pledge p on p.id=c.pledge_id join public.supporter s on s.id=p.supporter_id left join public.sponsorship_payment_proof proof on proof.id=c.proof_id;\n return v_result;\nend; ",
    "system": false,
    "library": null,
    "language": "plpgsql",
    "arguments": 3,
    "extension": null,
    "argumentTypes": [
      "pg_catalog.uuid",
      "pg_catalog.int4",
      "pg_catalog.uuid"
    ],
    "extensionVersion": null
  },
  {
    "oid": 5042,
    "body": "CREATE OR REPLACE FUNCTION pg_catalog.min_scale(numeric)\n RETURNS integer\n LANGUAGE internal\n IMMUTABLE PARALLEL SAFE STRICT\nAS $function$numeric_min_scale$function$\n",
    "name": "min_scale",
    "owner": "supabase_admin",
    "config": null,
    "result": "integer",
