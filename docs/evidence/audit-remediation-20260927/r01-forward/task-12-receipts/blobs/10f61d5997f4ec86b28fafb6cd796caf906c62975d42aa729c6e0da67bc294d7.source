    "oid": 3989,
    "body": "CREATE OR REPLACE FUNCTION pg_catalog.percent_rank_final(internal, VARIADIC \"any\")\n RETURNS double precision\n LANGUAGE internal\n IMMUTABLE PARALLEL SAFE\nAS $function$hypothetical_percent_rank_final$function$\n",
    "name": "percent_rank_final",
