    "oid": 3649,
    "body": "CREATE OR REPLACE FUNCTION pg_catalog.gtsvector_decompress(internal)\n RETURNS internal\n LANGUAGE internal\n IMMUTABLE PARALLEL SAFE STRICT\nAS $function$gtsvector_decompress$function$\n",
    "name": "gtsvector_decompress",
    "owner": "supabase_admin",
    "config": null,
    "result": "internal",
