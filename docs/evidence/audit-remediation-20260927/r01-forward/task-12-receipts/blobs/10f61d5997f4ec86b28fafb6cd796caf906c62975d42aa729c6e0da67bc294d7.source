    "oid": 6250,
    "body": "CREATE OR REPLACE FUNCTION pg_catalog.pg_ident_file_mappings(OUT map_number integer, OUT file_name text, OUT line_number integer, OUT map_name text, OUT sys_name text, OUT pg_username text, OUT error text)\n RETURNS SETOF record\n LANGUAGE internal\n PARALLEL SAFE STRICT\nAS $function$pg_ident_file_mappings$function$\n",
    "name": "pg_ident_file_mappings",
