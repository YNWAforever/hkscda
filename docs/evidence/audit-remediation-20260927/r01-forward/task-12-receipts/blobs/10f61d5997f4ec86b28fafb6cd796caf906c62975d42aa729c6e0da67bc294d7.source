  {
    "oid": 20931,
    "body": "CREATE OR REPLACE FUNCTION public.volunteer_change_fingerprint(p_activity uuid, p_other uuid, p_body jsonb, p_now timestamp with time zone)\n RETURNS text\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'public', 'pg_temp'\nAS $function$\n select md5(public.volunteer_policy_fingerprint(public.volunteer_policy_manifest(case when p_other is null then jsonb_build_array(p_activity) else jsonb_build_array(p_activity,p_other) end,p_body,p_now))||\n coalesce((select jsonb_agg(to_jsonb(g) order by g.id)::text from public.volunteer_group_request g where g.activity_id in(p_activity,p_other)),'')||\n coalesce((select jsonb_agg(to_jsonb(s) order by s.template_key,s.effective_from)::text from public.volunteer_policy_schedule s),'')||coalesce((select jsonb_agg(to_jsonb(t) order by t.id)::text from public.volunteer_terms_version t),'')||\n (p_now>=public.volunteer_policy_window(p_body#>'{booking,group_close}',(select starts_at from public.volunteer_activity where id=p_activity),p_body->>'timezone'))::text);\n$function$\n",
    "name": "volunteer_change_fingerprint",
    "owner": "postgres",
    "config": [
      "search_path=public, pg_temp"
    ],
    "result": "text",
    "schema": "public",
    "source": "\n select md5(public.volunteer_policy_fingerprint(public.volunteer_policy_manifest(case when p_other is null then jsonb_build_array(p_activity) else jsonb_build_array(p_activity,p_other) end,p_body,p_now))||\n coalesce((select jsonb_agg(to_jsonb(g) order by g.id)::text from public.volunteer_group_request g where g.activity_id in(p_activity,p_other)),'')||\n coalesce((select jsonb_agg(to_jsonb(s) order by s.template_key,s.effective_from)::text from public.volunteer_policy_schedule s),'')||coalesce((select jsonb_agg(to_jsonb(t) order by t.id)::text from public.volunteer_terms_version t),'')||\n (p_now>=public.volunteer_policy_window(p_body#>'{booking,group_close}',(select starts_at from public.volunteer_activity where id=p_activity),p_body->>'timezone'))::text);\n",
    "system": false,
    "library": null,
    "language": "sql",
    "arguments": 4,
    "extension": null,
    "argumentTypes": [
      "pg_catalog.uuid",
      "pg_catalog.uuid",
      "pg_catalog.jsonb",
      "pg_catalog.timestamptz"
    ],
    "extensionVersion": null
  },
