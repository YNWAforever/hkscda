    "oid": 2548,
    "body": "CREATE OR REPLACE FUNCTION pg_catalog.interval_pl_timestamp(interval, timestamp without time zone)\n RETURNS timestamp without time zone\n LANGUAGE sql\n IMMUTABLE PARALLEL SAFE STRICT COST 1\nRETURN ($2 + $1)\n",
    "name": "interval_pl_timestamp",
