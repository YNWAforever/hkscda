    "body": "CREATE OR REPLACE FUNCTION pg_catalog.pg_stat_get_db_sessions_killed(oid)\n RETURNS bigint\n LANGUAGE internal\n STABLE PARALLEL RESTRICTED STRICT\nAS $function$pg_stat_get_db_sessions_killed$function$\n",
