  {
    "oid": 21433,
    "body": "CREATE OR REPLACE FUNCTION public.volunteer_policy_evaluate(p_activity uuid, p_profile uuid, p_role text, p_now timestamp with time zone, p_exclude uuid DEFAULT NULL::uuid)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public', 'pg_temp'\nAS $function$begin\n if exists(select 1 from public.volunteer_activity where id=p_activity and registrations_closed_at is not null)\n and not exists(select 1 from public.volunteer_registration where id=p_exclude and activity_id=p_activity and status='approved') then\n return jsonb_build_object('allowed',false,'reason','registration_closed');end if;\n return public.volunteer_policy_evaluate_before_bulk(p_activity,p_profile,p_role,p_now,p_exclude);\nend $function$\n",
    "name": "volunteer_policy_evaluate",
    "owner": "postgres",
    "config": [
      "search_path=public, pg_temp"
    ],
    "result": "jsonb",
    "schema": "public",
    "source": "begin\n if exists(select 1 from public.volunteer_activity where id=p_activity and registrations_closed_at is not null)\n and not exists(select 1 from public.volunteer_registration where id=p_exclude and activity_id=p_activity and status='approved') then\n return jsonb_build_object('allowed',false,'reason','registration_closed');end if;\n return public.volunteer_policy_evaluate_before_bulk(p_activity,p_profile,p_role,p_now,p_exclude);\nend ",
    "system": false,
    "library": null,
    "language": "plpgsql",
    "arguments": 5,
    "extension": null,
    "argumentTypes": [
      "pg_catalog.uuid",
      "pg_catalog.uuid",
