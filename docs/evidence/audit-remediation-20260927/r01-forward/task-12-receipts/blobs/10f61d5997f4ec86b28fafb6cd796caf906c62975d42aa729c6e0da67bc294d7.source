  {
    "oid": 19613,
    "body": "CREATE OR REPLACE FUNCTION public.cancel_sponsorship_pledge(p_pledge_id uuid, p_actor_user_id uuid, p_note text)\n RETURNS void\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public', 'pg_temp'\nAS $function$\ndeclare\n  v_pledge public.sponsorship_pledge%rowtype;\nbegin\n  if not exists (\n    select 1\n    from public.admin_user\n    where auth_user_id = p_actor_user_id\n      and status = 'active'\n      and role in ('staff', 'admin')\n  ) then\n    raise exception 'Actor % is not an active staff/admin user', p_actor_user_id\n      using errcode = '42501';\n  end if;\n\n  select *\n  into v_pledge\n  from public.sponsorship_pledge\n  where id = p_pledge_id\n  for update;\n\n  if not found then\n    raise exception 'Sponsorship pledge not found';\n  end if;\n\n  if v_pledge.status = 'cancelled' then\n    raise exception 'Sponsorship pledge is already cancelled';\n  end if;\n\n  update public.sponsorship_pledge\n  set status = 'cancelled'\n  where id = p_pledge_id;\n\n  -- Cancelling future commitment does not decide whether past money arrived.\n  insert into public.audit_log (\n    actor_user_id,\n    action,\n    entity,\n    entity_id,\n    detail\n  ) values (\n    p_actor_user_id,\n    'sponsorship_pledge.cancelled',\n    'sponsorship_pledge',\n    p_pledge_id::text,\n    jsonb_build_object('note', p_note)\n  );\nend;\n$function$\n",
    "name": "cancel_sponsorship_pledge",
    "owner": "postgres",
    "config": [
      "search_path=public, pg_temp"
    ],
    "result": "void",
    "schema": "public",
    "source": "\ndeclare\n  v_pledge public.sponsorship_pledge%rowtype;\nbegin\n  if not exists (\n    select 1\n    from public.admin_user\n    where auth_user_id = p_actor_user_id\n      and status = 'active'\n      and role in ('staff', 'admin')\n  ) then\n    raise exception 'Actor % is not an active staff/admin user', p_actor_user_id\n      using errcode = '42501';\n  end if;\n\n  select *\n  into v_pledge\n  from public.sponsorship_pledge\n  where id = p_pledge_id\n  for update;\n\n  if not found then\n    raise exception 'Sponsorship pledge not found';\n  end if;\n\n  if v_pledge.status = 'cancelled' then\n    raise exception 'Sponsorship pledge is already cancelled';\n  end if;\n\n  update public.sponsorship_pledge\n  set status = 'cancelled'\n  where id = p_pledge_id;\n\n  -- Cancelling future commitment does not decide whether past money arrived.\n  insert into public.audit_log (\n    actor_user_id,\n    action,\n    entity,\n    entity_id,\n    detail\n  ) values (\n    p_actor_user_id,\n    'sponsorship_pledge.cancelled',\n    'sponsorship_pledge',\n    p_pledge_id::text,\n    jsonb_build_object('note', p_note)\n  );\nend;\n",
    "system": false,
    "library": null,
    "language": "plpgsql",
    "arguments": 3,
    "extension": null,
    "argumentTypes": [
      "pg_catalog.uuid",
      "pg_catalog.uuid",
      "pg_catalog.text"
    ],
    "extensionVersion": null
  },
