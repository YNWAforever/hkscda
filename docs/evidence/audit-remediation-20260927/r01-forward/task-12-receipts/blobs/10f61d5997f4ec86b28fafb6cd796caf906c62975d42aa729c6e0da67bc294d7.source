  {
    "oid": 20518,
    "body": "CREATE OR REPLACE FUNCTION public.volunteer_calendar_policy_checks(p_ids uuid[])\n RETURNS jsonb\n LANGUAGE sql\n SECURITY DEFINER\n SET search_path TO 'public', 'pg_temp'\nAS $function$\n select coalesce(jsonb_agg(jsonb_build_object('registration_id',r.id,'tier',p.tier,'evaluation',public.volunteer_policy_evaluate(r.activity_id,r.profile_id,r.duty_role,clock_timestamp(),r.id))),'[]'::jsonb)\n from public.volunteer_registration r join public.volunteer_activity a on a.id=r.activity_id left join public.volunteer_profile p on p.id=r.profile_id\n where r.activity_id=any(p_ids) and r.status='approved' and a.policy_version_id is not null and a.starts_at>clock_timestamp();\n$function$\n",
    "name": "volunteer_calendar_policy_checks",
    "owner": "postgres",
    "config": [
      "search_path=public, pg_temp"
    ],
    "result": "jsonb",
    "schema": "public",
    "source": "\n select coalesce(jsonb_agg(jsonb_build_object('registration_id',r.id,'tier',p.tier,'evaluation',public.volunteer_policy_evaluate(r.activity_id,r.profile_id,r.duty_role,clock_timestamp(),r.id))),'[]'::jsonb)\n from public.volunteer_registration r join public.volunteer_activity a on a.id=r.activity_id left join public.volunteer_profile p on p.id=r.profile_id\n where r.activity_id=any(p_ids) and r.status='approved' and a.policy_version_id is not null and a.starts_at>clock_timestamp();\n",
    "system": false,
    "library": null,
    "language": "sql",
    "arguments": 1,
    "extension": null,
    "argumentTypes": [
      "pg_catalog._uuid"
    ],
    "extensionVersion": null
  },
