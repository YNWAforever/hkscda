    "oid": 21980,
    "body": "CREATE OR REPLACE FUNCTION public.mark_repaired_animal_publication_media(p_public_path text, p_lease_token uuid)\n RETURNS boolean\n LANGUAGE plpgsql\n SET search_path TO ''\nAS $function$\nbegin\n  update public.animal_publication_media_copy\n  set copied_at=pg_catalog.clock_timestamp(),copy_claimed_at=null,\n      repair_status='completed',next_retry_at=null,lease_token=null,last_error_code=null\n  where public_path=p_public_path and copied_at is null\n    and repair_status='claimed' and lease_token=p_lease_token;\n  return found;\nend $function$\n",
    "name": "mark_repaired_animal_publication_media",
    "owner": "postgres",
    "config": [
      "search_path=\"\""
    ],
    "result": "boolean",
    "schema": "public",
    "source": "\nbegin\n  update public.animal_publication_media_copy\n  set copied_at=pg_catalog.clock_timestamp(),copy_claimed_at=null,\n      repair_status='completed',next_retry_at=null,lease_token=null,last_error_code=null\n  where public_path=p_public_path and copied_at is null\n    and repair_status='claimed' and lease_token=p_lease_token;\n  return found;\nend ",
    "system": false,
    "library": null,
    "language": "plpgsql",
    "arguments": 2,
    "extension": null,
    "argumentTypes": [
      "pg_catalog.text",
      "pg_catalog.uuid"
    ],
    "extensionVersion": null
  },
