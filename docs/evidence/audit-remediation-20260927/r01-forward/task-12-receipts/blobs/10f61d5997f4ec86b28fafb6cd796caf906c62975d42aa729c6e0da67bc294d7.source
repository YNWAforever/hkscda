  {
    "oid": 20485,
    "body": "CREATE OR REPLACE FUNCTION public.volunteer_policy_credentials(p_profile uuid, p_requirement jsonb, p_at timestamp with time zone)\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'public', 'pg_temp'\nAS $function$\n select case when p_requirement->>'mode'='any' then exists(\n select 1 from jsonb_array_elements_text(p_requirement->'keys') k where exists(select 1 from public.volunteer_credential c where c.profile_id=p_profile and c.credential_key=k and c.revoked_at is null and c.valid_from<=p_at and (c.valid_until is null or c.valid_until>p_at)))\n else not exists(select 1 from jsonb_array_elements_text(p_requirement->'keys') k where not exists(select 1 from public.volunteer_credential c where c.profile_id=p_profile and c.credential_key=k and c.revoked_at is null and c.valid_from<=p_at and (c.valid_until is null or c.valid_until>p_at))) end;\n$function$\n",
    "name": "volunteer_policy_credentials",
    "owner": "postgres",
    "config": [
      "search_path=public, pg_temp"
    ],
    "result": "boolean",
    "schema": "public",
    "source": "\n select case when p_requirement->>'mode'='any' then exists(\n select 1 from jsonb_array_elements_text(p_requirement->'keys') k where exists(select 1 from public.volunteer_credential c where c.profile_id=p_profile and c.credential_key=k and c.revoked_at is null and c.valid_from<=p_at and (c.valid_until is null or c.valid_until>p_at)))\n else not exists(select 1 from jsonb_array_elements_text(p_requirement->'keys') k where not exists(select 1 from public.volunteer_credential c where c.profile_id=p_profile and c.credential_key=k and c.revoked_at is null and c.valid_from<=p_at and (c.valid_until is null or c.valid_until>p_at))) end;\n",
    "system": false,
    "library": null,
    "language": "sql",
    "arguments": 3,
    "extension": null,
    "argumentTypes": [
      "pg_catalog.uuid",
      "pg_catalog.jsonb",
      "pg_catalog.timestamptz"
    ],
    "extensionVersion": null
  },
