    "body": "CREATE OR REPLACE FUNCTION public.invalidate_supporter_recovery_challenge(p_id uuid)\n RETURNS void\n LANGUAGE sql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\n  update private.supporter_recovery_challenge set consumed_at = now(), sealed_carrier = null\n    where id = p_id and consumed_at is null;\n$function$\n",
    "name": "invalidate_supporter_recovery_challenge",
    "owner": "postgres",
    "config": [
      "search_path=\"\""
    ],
    "result": "void",
    "schema": "public",
    "source": "\n  update private.supporter_recovery_challenge set consumed_at = now(), sealed_carrier = null\n    where id = p_id and consumed_at is null;\n",
    "system": false,
