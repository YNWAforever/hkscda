    "oid": 720,
    "body": "CREATE OR REPLACE FUNCTION pg_catalog.octet_length(bytea)\n RETURNS integer\n LANGUAGE internal\n IMMUTABLE PARALLEL SAFE STRICT\nAS $function$byteaoctetlen$function$\n",
