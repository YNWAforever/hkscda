    "oid": 20169,
    "body": "CREATE OR REPLACE FUNCTION private.reject_sponsorship_allocation_rewrite()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public', 'pg_temp'\nAS $function$\nbegin\n  raise exception\n    'sponsorship_payment_allocation is append-only (attempted %); record a reversal row instead',\n    lower(tg_op);\nend;\n$function$\n",
    "name": "reject_sponsorship_allocation_rewrite",
    "owner": "postgres",
    "config": [
      "search_path=public, pg_temp"
    ],
