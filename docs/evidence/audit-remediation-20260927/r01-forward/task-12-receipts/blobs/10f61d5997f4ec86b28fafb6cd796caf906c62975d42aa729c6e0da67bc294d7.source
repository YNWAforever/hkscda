  {
    "oid": 20505,
    "body": "CREATE OR REPLACE FUNCTION public.volunteer_policy_fingerprint(p_manifest jsonb)\n RETURNS text\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'public', 'pg_temp'\nAS $function$\n select md5(p_manifest::text||coalesce((select string_agg(id::text||revision::text||status||tier,',' order by id) from public.volunteer_profile),'')||coalesce((select string_agg(to_jsonb(c)::text,',' order by id) from public.volunteer_credential c),''));\n$function$\n",
    "name": "volunteer_policy_fingerprint",
    "owner": "postgres",
    "config": [
      "search_path=public, pg_temp"
    ],
    "result": "text",
    "schema": "public",
    "source": "\n select md5(p_manifest::text||coalesce((select string_agg(id::text||revision::text||status||tier,',' order by id) from public.volunteer_profile),'')||coalesce((select string_agg(to_jsonb(c)::text,',' order by id) from public.volunteer_credential c),''));\n",
    "system": false,
    "library": null,
    "language": "sql",
    "arguments": 1,
    "extension": null,
    "argumentTypes": [
      "pg_catalog.jsonb"
    ],
    "extensionVersion": null
  },
