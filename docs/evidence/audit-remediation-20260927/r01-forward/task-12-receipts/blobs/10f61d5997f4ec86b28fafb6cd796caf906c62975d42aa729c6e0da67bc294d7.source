  {
    "oid": 21573,
    "body": "CREATE OR REPLACE FUNCTION public.void_donation_receipts_with_audit(p_donation_id uuid, p_reason text DEFAULT 'refund'::text)\n RETURNS TABLE(receipt_id uuid, pdf_url text)\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\ndeclare\n  v_receipt public.receipt%rowtype;\n  v_voided_at timestamptz;\nbegin\n  if p_donation_id is null or p_reason is null or pg_catalog.length(pg_catalog.btrim(p_reason)) = 0 then\n    raise exception 'invalid_receipt_void_request' using errcode = '22023';\n  end if;\n\n  for v_receipt in\n    select * from public.receipt\n    where donation_ids @> array[p_donation_id]\n      and status = 'issued'\n    order by id\n    for update\n  loop\n    v_voided_at := pg_catalog.clock_timestamp();\n    update public.receipt\n    set status = 'void', voided_at = v_voided_at, voided_by = null\n    where id = v_receipt.id;\n\n    insert into public.audit_log(actor_user_id, action, entity, entity_id, detail)\n    values (\n      null, 'receipt.void', 'receipt', v_receipt.id::text,\n      pg_catalog.jsonb_build_object(\n        'voidedAt', v_voided_at,\n        'donationId', p_donation_id,\n        'reason', p_reason\n      )\n    );\n\n    return query select v_receipt.id, v_receipt.pdf_url;\n  end loop;\nend;\n$function$\n",
    "name": "void_donation_receipts_with_audit",
    "owner": "postgres",
    "config": [
      "search_path=\"\""
    ],
    "result": "record",
    "schema": "public",
    "source": "\ndeclare\n  v_receipt public.receipt%rowtype;\n  v_voided_at timestamptz;\nbegin\n  if p_donation_id is null or p_reason is null or pg_catalog.length(pg_catalog.btrim(p_reason)) = 0 then\n    raise exception 'invalid_receipt_void_request' using errcode = '22023';\n  end if;\n\n  for v_receipt in\n    select * from public.receipt\n    where donation_ids @> array[p_donation_id]\n      and status = 'issued'\n    order by id\n    for update\n  loop\n    v_voided_at := pg_catalog.clock_timestamp();\n    update public.receipt\n    set status = 'void', voided_at = v_voided_at, voided_by = null\n    where id = v_receipt.id;\n\n    insert into public.audit_log(actor_user_id, action, entity, entity_id, detail)\n    values (\n      null, 'receipt.void', 'receipt', v_receipt.id::text,\n      pg_catalog.jsonb_build_object(\n        'voidedAt', v_voided_at,\n        'donationId', p_donation_id,\n        'reason', p_reason\n      )\n    );\n\n    return query select v_receipt.id, v_receipt.pdf_url;\n  end loop;\nend;\n",
    "system": false,
    "library": null,
    "language": "plpgsql",
    "arguments": 2,
    "extension": null,
    "argumentTypes": [
      "pg_catalog.uuid",
      "pg_catalog.text"
    ],
    "extensionVersion": null
  },
