    "oid": 1305,
    "body": "CREATE OR REPLACE FUNCTION pg_catalog.\"overlaps\"(timestamp with time zone, interval, timestamp with time zone, interval)\n RETURNS boolean\n LANGUAGE sql\n STABLE PARALLEL SAFE COST 1\nRETURN (($1, ($1 + $2)) OVERLAPS ($3, ($3 + $4)))\n",
    "name": "overlaps",
