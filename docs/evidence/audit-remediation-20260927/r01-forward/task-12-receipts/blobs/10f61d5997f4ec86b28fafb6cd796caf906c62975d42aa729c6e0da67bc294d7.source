  {
    "oid": 22102,
    "body": "CREATE OR REPLACE FUNCTION private.require_volunteer_review_reviewer(p_reviewer uuid)\n RETURNS void\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\nbegin\n  perform 1 from public.admin_user a join auth.users u on u.id=a.auth_user_id\n    where a.auth_user_id=p_reviewer and a.status='active' and a.role in ('staff','admin')\n      and u.email_confirmed_at is not null\n      and (u.banned_until is null or u.banned_until <= now())\n  for share of a,u;\n  if not found then raise exception 'Volunteer reviewer unavailable' using errcode='42501'; end if;\nend $function$\n",
    "name": "require_volunteer_review_reviewer",
    "owner": "postgres",
    "config": [
      "search_path=\"\""
    ],
    "result": "void",
    "schema": "private",
    "source": "\nbegin\n  perform 1 from public.admin_user a join auth.users u on u.id=a.auth_user_id\n    where a.auth_user_id=p_reviewer and a.status='active' and a.role in ('staff','admin')\n      and u.email_confirmed_at is not null\n      and (u.banned_until is null or u.banned_until <= now())\n  for share of a,u;\n  if not found then raise exception 'Volunteer reviewer unavailable' using errcode='42501'; end if;\nend ",
    "system": false,
    "library": null,
    "language": "plpgsql",
    "arguments": 1,
    "extension": null,
    "argumentTypes": [
      "pg_catalog.uuid"
    ],
    "extensionVersion": null
  },
