  {
    "oid": 21464,
    "body": "CREATE OR REPLACE FUNCTION public.editorial_review_queue(p_actor uuid, p_page integer DEFAULT 1, p_kind text DEFAULT 'content'::text)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public', 'pg_temp'\nAS $function$\ndeclare result jsonb;\nbegin\n if not exists(select 1 from public.admin_user a join auth.users u on u.id=a.auth_user_id where a.auth_user_id=p_actor and a.status='active' and a.role in ('staff','admin') and u.email_confirmed_at is not null and (u.banned_until is null or u.banned_until<=clock_timestamp())) then raise exception 'forbidden' using errcode='42501';end if;\n if p_page<1 or p_kind not in ('animal','content') then raise exception 'invalid page' using errcode='22023';end if;\n with candidates as (\n select 'content'::text entity_kind,c.id entity_id,c.title,c.status publication_state,c.draft_revision_id::text revision_key,c.updated_at from public.content_item c where p_kind='content'\n union all select 'animal',a.id,a.name,a.publication_state,d.revision::text,a.updated_at from public.animals a left join public.animal_draft d on d.id=a.id where p_kind='animal'\n ), paged as (select * from candidates order by updated_at desc,entity_id desc offset (p_page-1)*25 limit 25)\n select jsonb_build_object('total',(select count(*) from candidates),'items',coalesce((select jsonb_agg(to_jsonb(p)||jsonb_build_object('classification',coalesce(r.classification,'needs_review'),'evidence',r.evidence) order by p.updated_at desc,p.entity_id desc) from paged p left join public.editorial_content_review r on r.entity_kind=p.entity_kind and r.entity_id=p.entity_id and r.revision_key=p.revision_key),'[]'::jsonb)) into result;\n return result;\nend $function$\n",
    "name": "editorial_review_queue",
    "owner": "postgres",
    "config": [
      "search_path=public, pg_temp"
    ],
    "result": "jsonb",
    "schema": "public",
    "source": "\ndeclare result jsonb;\nbegin\n if not exists(select 1 from public.admin_user a join auth.users u on u.id=a.auth_user_id where a.auth_user_id=p_actor and a.status='active' and a.role in ('staff','admin') and u.email_confirmed_at is not null and (u.banned_until is null or u.banned_until<=clock_timestamp())) then raise exception 'forbidden' using errcode='42501';end if;\n if p_page<1 or p_kind not in ('animal','content') then raise exception 'invalid page' using errcode='22023';end if;\n with candidates as (\n select 'content'::text entity_kind,c.id entity_id,c.title,c.status publication_state,c.draft_revision_id::text revision_key,c.updated_at from public.content_item c where p_kind='content'\n union all select 'animal',a.id,a.name,a.publication_state,d.revision::text,a.updated_at from public.animals a left join public.animal_draft d on d.id=a.id where p_kind='animal'\n ), paged as (select * from candidates order by updated_at desc,entity_id desc offset (p_page-1)*25 limit 25)\n select jsonb_build_object('total',(select count(*) from candidates),'items',coalesce((select jsonb_agg(to_jsonb(p)||jsonb_build_object('classification',coalesce(r.classification,'needs_review'),'evidence',r.evidence) order by p.updated_at desc,p.entity_id desc) from paged p left join public.editorial_content_review r on r.entity_kind=p.entity_kind and r.entity_id=p.entity_id and r.revision_key=p.revision_key),'[]'::jsonb)) into result;\n return result;\nend ",
    "system": false,
    "library": null,
    "language": "plpgsql",
    "arguments": 3,
    "extension": null,
    "argumentTypes": [
      "pg_catalog.uuid",
      "pg_catalog.int4",
      "pg_catalog.text"
    ],
    "extensionVersion": null
  },
  {
    "oid": 21439,
    "body": "CREATE OR REPLACE FUNCTION public.volunteer_bulk_result(p_operation public.volunteer_bulk_operation)\n RETURNS jsonb\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'public', 'pg_temp'\nAS $function$\n select jsonb_build_object('kind','ready','operation',to_jsonb(p_operation)||jsonb_build_object('notifications',coalesce((select jsonb_agg(jsonb_build_object('id',o.id,'kind',o.kind,'queue_status',o.status,'follow_up',case when c.outbox_id is not null then 'completed' else 'pending' end,'completed_at',c.completed_at,'provider_message_id',o.payload->>'providerMessageId') order by o.created_at,o.id) from public.volunteer_operation_outbox o left join public.volunteer_task_completion c on c.outbox_id=o.id where exists(select 1 from jsonb_array_elements(p_operation.groups) g cross join lateral jsonb_array_elements(g->'items') i where o.dedup_key='bulk:'||(i->>'item_key') or o.dedup_key like 'bulk:'||(i->>'item_key')||':%')),'[]'::jsonb)));\n$function$\n",
    "name": "volunteer_bulk_result",
    "owner": "postgres",
    "config": [
      "search_path=public, pg_temp"
    ],
    "result": "jsonb",
    "schema": "public",
    "source": "\n select jsonb_build_object('kind','ready','operation',to_jsonb(p_operation)||jsonb_build_object('notifications',coalesce((select jsonb_agg(jsonb_build_object('id',o.id,'kind',o.kind,'queue_status',o.status,'follow_up',case when c.outbox_id is not null then 'completed' else 'pending' end,'completed_at',c.completed_at,'provider_message_id',o.payload->>'providerMessageId') order by o.created_at,o.id) from public.volunteer_operation_outbox o left join public.volunteer_task_completion c on c.outbox_id=o.id where exists(select 1 from jsonb_array_elements(p_operation.groups) g cross join lateral jsonb_array_elements(g->'items') i where o.dedup_key='bulk:'||(i->>'item_key') or o.dedup_key like 'bulk:'||(i->>'item_key')||':%')),'[]'::jsonb)));\n",
    "system": false,
    "library": null,
    "language": "sql",
    "arguments": 1,
    "extension": null,
    "argumentTypes": [
      "public.volunteer_bulk_operation"
    ],
    "extensionVersion": null
  },
