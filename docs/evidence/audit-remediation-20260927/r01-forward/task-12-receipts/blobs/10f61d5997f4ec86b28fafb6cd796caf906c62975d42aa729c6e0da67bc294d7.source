  {
    "oid": 1215,
    "body": "CREATE OR REPLACE FUNCTION pg_catalog.obj_description(oid, name)\n RETURNS text\n LANGUAGE sql\n STABLE PARALLEL SAFE STRICT\nBEGIN ATOMIC\n SELECT pg_description.description\n    FROM pg_description\n   WHERE ((pg_description.objoid = $1) AND (pg_description.classoid = ( SELECT pg_class.oid\n            FROM pg_class\n           WHERE ((pg_class.relname = $2) AND (pg_class.relnamespace = ('pg_catalog'::regnamespace)::oid)))) AND (pg_description.objsubid = 0));\nEND\n",
    "name": "obj_description",
    "owner": "supabase_admin",
    "config": null,
    "result": "text",
    "schema": "pg_catalog",
    "source": "",
    "system": true,
    "library": null,
    "language": "sql",
    "arguments": 2,
    "extension": null,
    "argumentTypes": [
      "pg_catalog.oid",
      "pg_catalog.name"
    ],
    "extensionVersion": null
  },
