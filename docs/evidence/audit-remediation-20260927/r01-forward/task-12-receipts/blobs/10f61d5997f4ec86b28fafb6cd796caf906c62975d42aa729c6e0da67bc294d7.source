    "oid": 342,
    "body": "CREATE OR REPLACE FUNCTION pg_catalog.poly_overleft(polygon, polygon)\n RETURNS boolean\n LANGUAGE internal\n IMMUTABLE PARALLEL SAFE STRICT\nAS $function$poly_overleft$function$\n",
    "name": "poly_overleft",
    "owner": "supabase_admin",
    "config": null,
