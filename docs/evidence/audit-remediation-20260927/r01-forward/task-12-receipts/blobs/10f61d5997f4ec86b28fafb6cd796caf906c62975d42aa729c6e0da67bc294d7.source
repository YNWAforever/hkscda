  {
    "oid": 21158,
    "body": "CREATE OR REPLACE FUNCTION public.volunteer_credential_history_guard()\n RETURNS trigger\n LANGUAGE plpgsql\n SET search_path TO 'public', 'pg_temp'\nAS $function$\nbegin\n if tg_op='UPDATE' and (new.id,new.profile_id,new.credential_key,new.valid_from,new.valid_until,new.verified_by,new.evidence) is not distinct from (old.id,old.profile_id,old.credential_key,old.valid_from,old.valid_until,old.verified_by,old.evidence) and (new.revoked_at is not distinct from old.revoked_at or (old.revoked_at is null and new.revoked_at is not null)) then return new; end if;\n raise exception 'immutable_credential_evidence' using errcode='42501';\nend $function$\n",
    "name": "volunteer_credential_history_guard",
    "owner": "postgres",
    "config": [
      "search_path=public, pg_temp"
    ],
    "result": "trigger",
    "schema": "public",
    "source": "\nbegin\n if tg_op='UPDATE' and (new.id,new.profile_id,new.credential_key,new.valid_from,new.valid_until,new.verified_by,new.evidence) is not distinct from (old.id,old.profile_id,old.credential_key,old.valid_from,old.valid_until,old.verified_by,old.evidence) and (new.revoked_at is not distinct from old.revoked_at or (old.revoked_at is null and new.revoked_at is not null)) then return new; end if;\n raise exception 'immutable_credential_evidence' using errcode='42501';\nend ",
    "system": false,
    "library": null,
    "language": "plpgsql",
    "arguments": 0,
    "extension": null,
    "argumentTypes": [],
    "extensionVersion": null
  },
