    "oid": 17936,
    "body": "CREATE OR REPLACE FUNCTION public.regexp_split_to_array(public.citext, public.citext)\n RETURNS text[]\n LANGUAGE sql\n IMMUTABLE PARALLEL SAFE STRICT\nAS $function$\n    SELECT pg_catalog.regexp_split_to_array( $1::pg_catalog.text, $2::pg_catalog.text, 'i' );\n$function$\n",
