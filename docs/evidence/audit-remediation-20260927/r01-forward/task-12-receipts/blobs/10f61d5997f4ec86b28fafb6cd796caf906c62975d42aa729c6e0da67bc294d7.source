  {
    "oid": 21529,
    "body": "CREATE OR REPLACE FUNCTION public.fail_pending_provider_payment(p_payment_id uuid, p_donation_id uuid)\n RETURNS jsonb\n LANGUAGE plpgsql\n SET search_path TO ''\nAS $function$\ndeclare\n  v_payment public.payment%rowtype;\n  v_donation public.donation%rowtype;\n  v_now timestamptz;\nbegin\n  if p_payment_id is null or p_donation_id is null then\n    raise exception 'missing payment or donation id' using errcode = '22023';\n  end if;\n\n  select * into v_payment\n  from public.payment\n  where id = p_payment_id\n  for update;\n  if not found or v_payment.donation_id <> p_donation_id then\n    return jsonb_build_object('kind', 'not_found');\n  end if;\n\n  select * into v_donation\n  from public.donation\n  where id = p_donation_id\n  for update;\n  if not found then\n    return jsonb_build_object('kind', 'not_found');\n  end if;\n\n  if v_payment.status not in ('pending', 'failed')\n     or v_donation.status not in ('pending', 'failed') then\n    return jsonb_build_object(\n      'kind', 'state_conflict',\n      'payment_status', v_payment.status,\n      'donation_status', v_donation.status\n    );\n  end if;\n\n  if v_payment.status = 'failed' and v_donation.status = 'failed' then\n    return jsonb_build_object('kind', 'already_failed');\n  end if;\n\n  v_now := clock_timestamp();\n  update public.payment\n  set status = 'failed', updated_at = v_now\n  where id = p_payment_id and status = 'pending';\n\n  update public.donation\n  set status = 'failed', updated_at = v_now\n  where id = p_donation_id and status = 'pending';\n\n  return jsonb_build_object('kind', 'failed');\nend;\n$function$\n",
    "name": "fail_pending_provider_payment",
    "owner": "postgres",
    "config": [
      "search_path=\"\""
    ],
    "result": "jsonb",
    "schema": "public",
    "source": "\ndeclare\n  v_payment public.payment%rowtype;\n  v_donation public.donation%rowtype;\n  v_now timestamptz;\nbegin\n  if p_payment_id is null or p_donation_id is null then\n    raise exception 'missing payment or donation id' using errcode = '22023';\n  end if;\n\n  select * into v_payment\n  from public.payment\n  where id = p_payment_id\n  for update;\n  if not found or v_payment.donation_id <> p_donation_id then\n    return jsonb_build_object('kind', 'not_found');\n  end if;\n\n  select * into v_donation\n  from public.donation\n  where id = p_donation_id\n  for update;\n  if not found then\n    return jsonb_build_object('kind', 'not_found');\n  end if;\n\n  if v_payment.status not in ('pending', 'failed')\n     or v_donation.status not in ('pending', 'failed') then\n    return jsonb_build_object(\n      'kind', 'state_conflict',\n      'payment_status', v_payment.status,\n      'donation_status', v_donation.status\n    );\n  end if;\n\n  if v_payment.status = 'failed' and v_donation.status = 'failed' then\n    return jsonb_build_object('kind', 'already_failed');\n  end if;\n\n  v_now := clock_timestamp();\n  update public.payment\n  set status = 'failed', updated_at = v_now\n  where id = p_payment_id and status = 'pending';\n\n  update public.donation\n  set status = 'failed', updated_at = v_now\n  where id = p_donation_id and status = 'pending';\n\n  return jsonb_build_object('kind', 'failed');\nend;\n",
    "system": false,
    "library": null,
    "language": "plpgsql",
    "arguments": 2,
    "extension": null,
    "argumentTypes": [
      "pg_catalog.uuid",
      "pg_catalog.uuid"
    ],
    "extensionVersion": null
  },
