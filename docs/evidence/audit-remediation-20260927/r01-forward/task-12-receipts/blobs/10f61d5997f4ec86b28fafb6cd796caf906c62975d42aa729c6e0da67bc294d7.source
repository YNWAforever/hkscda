  {
    "oid": 20932,
    "body": "CREATE OR REPLACE FUNCTION public.volunteer_policy_session_reason(p_body jsonb, p_status text, p_starts_at timestamp with time zone, p_group_headcount integer, p_now timestamp with time zone)\n RETURNS text\n LANGUAGE plpgsql\n IMMUTABLE\n SET search_path TO 'public', 'pg_temp'\nAS $function$\ndeclare service_date date:=(p_starts_at at time zone (p_body->>'timezone'))::date;begin\n if p_status<>'published' or p_starts_at<=p_now or not (p_body#>>'{schedule,enabled}')::boolean then return 'activity_closed';end if;\n if (p_body#>>'{schedule,effective_from}' is not null and service_date<(p_body#>>'{schedule,effective_from}')::date) or (p_body#>>'{schedule,effective_until}' is not null and service_date>(p_body#>>'{schedule,effective_until}')::date) then return 'date_closed';end if;\n if (p_body#>>'{booking,scenario}'='confirmed_group' and p_group_headcount=0) or (p_body#>>'{booking,scenario}'='no_confirmed_group' and p_group_headcount>0) then return 'group_scenario_mismatch';end if;\n if not (p_body#>'{schedule,weekdays}' @> jsonb_build_array(extract(dow from service_date)::integer)) or p_body#>'{schedule,excluded_dates}' @> to_jsonb(array[service_date::text]) then return 'date_closed';end if;\n return null;\nend $function$\n",
    "name": "volunteer_policy_session_reason",
    "owner": "postgres",
    "config": [
      "search_path=public, pg_temp"
    ],
    "result": "text",
    "schema": "public",
    "source": "\ndeclare service_date date:=(p_starts_at at time zone (p_body->>'timezone'))::date;begin\n if p_status<>'published' or p_starts_at<=p_now or not (p_body#>>'{schedule,enabled}')::boolean then return 'activity_closed';end if;\n if (p_body#>>'{schedule,effective_from}' is not null and service_date<(p_body#>>'{schedule,effective_from}')::date) or (p_body#>>'{schedule,effective_until}' is not null and service_date>(p_body#>>'{schedule,effective_until}')::date) then return 'date_closed';end if;\n if (p_body#>>'{booking,scenario}'='confirmed_group' and p_group_headcount=0) or (p_body#>>'{booking,scenario}'='no_confirmed_group' and p_group_headcount>0) then return 'group_scenario_mismatch';end if;\n if not (p_body#>'{schedule,weekdays}' @> jsonb_build_array(extract(dow from service_date)::integer)) or p_body#>'{schedule,excluded_dates}' @> to_jsonb(array[service_date::text]) then return 'date_closed';end if;\n return null;\nend ",
    "system": false,
    "library": null,
    "language": "plpgsql",
    "arguments": 5,
    "extension": null,
    "argumentTypes": [
      "pg_catalog.jsonb",
      "pg_catalog.text",
      "pg_catalog.timestamptz",
      "pg_catalog.int4",
      "pg_catalog.timestamptz"
    ],
    "extensionVersion": null
  },
