  {
    "oid": 21830,
    "body": "CREATE OR REPLACE FUNCTION public.claim_crm_export_job(p_owner uuid)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public', 'pg_temp'\nAS $function$\ndeclare v_job public.crm_export_job%rowtype;\nbegin\n  with exhausted as (\n    update public.crm_export_job set status='failed',error_code='retry_exhausted',\n      lease_owner=null,lease_until=null,updated_at=clock_timestamp()\n      where status='processing' and lease_until<clock_timestamp() and attempts>=3\n      returning id,actor_user_id,kind\n  )\n  insert into public.audit_log(actor_user_id,action,entity,entity_id,timestamp,detail)\n    select actor_user_id,'export.job.failed','crm_export',id::text,clock_timestamp(),\n      jsonb_build_object('kind',kind,'errorCode','retry_exhausted') from exhausted;\n  select * into v_job from public.crm_export_job\n    where expires_at>clock_timestamp() and attempts<3\n      and (status='pending' or (status='processing' and lease_until<clock_timestamp()))\n    order by created_at,id for update skip locked limit 1;\n  if not found then return null; end if;\n  update public.crm_export_job set status='processing',lease_owner=p_owner,\n    lease_until=clock_timestamp()+interval '10 minutes',attempts=attempts+1,\n    updated_at=clock_timestamp() where id=v_job.id returning * into v_job;\n  return jsonb_build_object('id',v_job.id,'lease_owner',v_job.lease_owner,\n    'kind',v_job.kind,'total',v_job.total,'processed',v_job.processed_count,'attempts',v_job.attempts);\nend;\n$function$\n",
    "name": "claim_crm_export_job",
    "owner": "postgres",
    "config": [
      "search_path=public, pg_temp"
    ],
    "result": "jsonb",
    "schema": "public",
    "source": "\ndeclare v_job public.crm_export_job%rowtype;\nbegin\n  with exhausted as (\n    update public.crm_export_job set status='failed',error_code='retry_exhausted',\n      lease_owner=null,lease_until=null,updated_at=clock_timestamp()\n      where status='processing' and lease_until<clock_timestamp() and attempts>=3\n      returning id,actor_user_id,kind\n  )\n  insert into public.audit_log(actor_user_id,action,entity,entity_id,timestamp,detail)\n    select actor_user_id,'export.job.failed','crm_export',id::text,clock_timestamp(),\n      jsonb_build_object('kind',kind,'errorCode','retry_exhausted') from exhausted;\n  select * into v_job from public.crm_export_job\n    where expires_at>clock_timestamp() and attempts<3\n      and (status='pending' or (status='processing' and lease_until<clock_timestamp()))\n    order by created_at,id for update skip locked limit 1;\n  if not found then return null; end if;\n  update public.crm_export_job set status='processing',lease_owner=p_owner,\n    lease_until=clock_timestamp()+interval '10 minutes',attempts=attempts+1,\n    updated_at=clock_timestamp() where id=v_job.id returning * into v_job;\n  return jsonb_build_object('id',v_job.id,'lease_owner',v_job.lease_owner,\n    'kind',v_job.kind,'total',v_job.total,'processed',v_job.processed_count,'attempts',v_job.attempts);\nend;\n",
    "system": false,
    "library": null,
    "language": "plpgsql",
    "arguments": 1,
    "extension": null,
    "argumentTypes": [
      "pg_catalog.uuid"
    ],
    "extensionVersion": null
  },
