  {
    "oid": 20049,
    "body": "CREATE OR REPLACE FUNCTION private.materialize_published_content_snapshot(p_snapshot jsonb, p_revision_id uuid)\n RETURNS jsonb\n LANGUAGE sql\n STABLE\n SET search_path TO 'public', 'pg_temp'\nAS $function$\n select jsonb_set(p_snapshot,'{media}',coalesce((select jsonb_agg(case when media->>'storage_bucket'='content-media' then media else media||jsonb_build_object('storage_bucket',asset.public_bucket,'storage_path',asset.public_path) end order by ordinal)\n from jsonb_array_elements(p_snapshot->'media') with ordinality as entry(media,ordinal)\n left join public.content_public_asset asset on asset.revision_id=p_revision_id and asset.media_id=(media->>'id')::uuid and asset.ready\n where media->>'storage_bucket'='content-media' or asset.id is not null),'[]'::jsonb))\n$function$\n",
    "name": "materialize_published_content_snapshot",
    "owner": "postgres",
    "config": [
      "search_path=public, pg_temp"
    ],
    "result": "jsonb",
    "schema": "private",
    "source": "\n select jsonb_set(p_snapshot,'{media}',coalesce((select jsonb_agg(case when media->>'storage_bucket'='content-media' then media else media||jsonb_build_object('storage_bucket',asset.public_bucket,'storage_path',asset.public_path) end order by ordinal)\n from jsonb_array_elements(p_snapshot->'media') with ordinality as entry(media,ordinal)\n left join public.content_public_asset asset on asset.revision_id=p_revision_id and asset.media_id=(media->>'id')::uuid and asset.ready\n where media->>'storage_bucket'='content-media' or asset.id is not null),'[]'::jsonb))\n",
    "system": false,
    "library": null,
    "language": "sql",
    "arguments": 2,
    "extension": null,
    "argumentTypes": [
      "pg_catalog.jsonb",
      "pg_catalog.uuid"
    ],
    "extensionVersion": null
  },
