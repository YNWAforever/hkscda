  {
    "oid": 21610,
    "body": "CREATE OR REPLACE FUNCTION private.has_exact_jsonb_keys(candidate jsonb, expected text[])\n RETURNS boolean\n LANGUAGE sql\n IMMUTABLE\nAS $function$\n  select case when jsonb_typeof(candidate) = 'object' then\n    candidate ?& expected and (select count(*) from jsonb_object_keys(candidate)) = cardinality(expected)\n    else false end;\n$function$\n",
    "name": "has_exact_jsonb_keys",
    "owner": "postgres",
    "config": null,
    "result": "boolean",
    "schema": "private",
    "source": "\n  select case when jsonb_typeof(candidate) = 'object' then\n    candidate ?& expected and (select count(*) from jsonb_object_keys(candidate)) = cardinality(expected)\n    else false end;\n",
    "system": false,
    "library": null,
    "language": "sql",
    "arguments": 2,
    "extension": null,
    "argumentTypes": [
      "pg_catalog.jsonb",
      "pg_catalog._text"
    ],
    "extensionVersion": null
  },
