  {
    "oid": 4207,
    "body": "CREATE OR REPLACE FUNCTION pg_catalog.ts_headline(json, tsquery, text)\n RETURNS json\n LANGUAGE internal\n STABLE PARALLEL SAFE STRICT COST 100\nAS $function$ts_headline_json_opt$function$\n",
    "name": "ts_headline",
    "owner": "supabase_admin",
