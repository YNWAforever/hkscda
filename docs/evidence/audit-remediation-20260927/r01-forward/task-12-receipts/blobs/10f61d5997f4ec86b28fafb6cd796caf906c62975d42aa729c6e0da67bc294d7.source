    "oid": 472,
    "body": "CREATE OR REPLACE FUNCTION pg_catalog.int8ge(bigint, bigint)\n RETURNS boolean\n LANGUAGE internal\n IMMUTABLE PARALLEL SAFE STRICT LEAKPROOF\nAS $function$int8ge$function$\n",
    "name": "int8ge",
