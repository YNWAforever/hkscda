    "oid": 21271,
    "body": "CREATE OR REPLACE FUNCTION public.volunteer_validate_policy_references(p jsonb)\n RETURNS jsonb\n LANGUAGE plpgsql\n STABLE SECURITY DEFINER\n SET search_path TO 'public', 'pg_temp'\nAS $function$\ndeclare credential_key text;begin\n if not exists(select 1 from public.volunteer_shelter_definition where key=p->>'shelter') then return '[\"unknown_shelter\"]'::jsonb;end if;\n for credential_key in select distinct value#>>'{}' from jsonb_path_query(p,'$.**.credentials.keys[*]') value loop\n  if not exists(select 1 from public.volunteer_credential_definition where key=credential_key) then return jsonb_build_array('unknown_credential:'||credential_key);end if;\n end loop;\n return '[]'::jsonb;\nend $function$\n",
    "name": "volunteer_validate_policy_references",
    "owner": "postgres",
    "config": [
      "search_path=public, pg_temp"
    ],
    "result": "jsonb",
    "schema": "public",
    "source": "\ndeclare credential_key text;begin\n if not exists(select 1 from public.volunteer_shelter_definition where key=p->>'shelter') then return '[\"unknown_shelter\"]'::jsonb;end if;\n for credential_key in select distinct value#>>'{}' from jsonb_path_query(p,'$.**.credentials.keys[*]') value loop\n  if not exists(select 1 from public.volunteer_credential_definition where key=credential_key) then return jsonb_build_array('unknown_credential:'||credential_key);end if;\n end loop;\n return '[]'::jsonb;\nend ",
    "system": false,
    "library": null,
    "language": "plpgsql",
    "arguments": 1,
    "extension": null,
    "argumentTypes": [
      "pg_catalog.jsonb"
    ],
    "extensionVersion": null
  },
