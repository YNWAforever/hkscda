  {
    "oid": 21511,
    "body": "CREATE OR REPLACE FUNCTION public.invite_admin_user_with_audit(p_actor_user_id uuid, p_auth_user_id uuid, p_email text, p_role text, p_sent_at timestamp with time zone)\n RETURNS public.admin_user\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\ndeclare\n  current_user_row public.admin_user%rowtype;\n  invited_user_row public.admin_user%rowtype;\nbegin\n  perform pg_catalog.pg_advisory_xact_lock(pg_catalog.hashtextextended('public.admin_user.active_admin', 0));\n\n  perform 1 from auth.users u\n  where u.id = p_actor_user_id and u.email_confirmed_at is not null\n    and (u.banned_until is null or u.banned_until <= pg_catalog.clock_timestamp())\n  for share;\n  if not found then\n    raise exception 'admin_actor_denied' using errcode = 'P0001';\n  end if;\n\n  perform 1 from public.admin_user\n  where auth_user_id = p_actor_user_id and role = 'admin' and status = 'active'\n  for share;\n  if not found then\n    raise exception 'admin_actor_denied' using errcode = 'P0001';\n  end if;\n  if p_email is null or pg_catalog.btrim(p_email) = '' then\n    raise exception 'invalid_email' using errcode = 'P0001';\n  end if;\n  if p_role is null or p_role not in ('staff', 'treasurer', 'admin') then\n    raise exception 'invalid_role' using errcode = 'P0001';\n  end if;\n  if p_auth_user_id is null or p_sent_at is null then\n    raise exception 'invalid_invite_input' using errcode = 'P0001';\n  end if;\n\n  select * into current_user_row\n  from public.admin_user\n  where email OPERATOR(public.=) p_email::public.citext\n  for update;\n\n  if found and current_user_row.status <> 'disabled' then\n    raise exception 'duplicate_admin_user' using errcode = 'P0001';\n  end if;\n\n  if found then\n    update public.admin_user\n    set auth_user_id = p_auth_user_id,\n        role = p_role,\n        status = 'pending',\n        invited_at = p_sent_at,\n        invite_sent_at = p_sent_at,\n        invite_accepted_at = null,\n        last_invited_by = p_actor_user_id\n    where id = current_user_row.id\n    returning * into invited_user_row;\n  else\n    insert into public.admin_user (\n      auth_user_id, email, role, status, invited_at, invite_sent_at,\n      invite_accepted_at, last_invited_by\n    ) values (\n      p_auth_user_id, p_email, p_role, 'pending', p_sent_at, p_sent_at,\n      null, p_actor_user_id\n    )\n    returning * into invited_user_row;\n  end if;\n\n  insert into public.audit_log (\n    actor_user_id, action, entity, entity_id, timestamp, detail\n  ) values (\n    p_actor_user_id,\n    'admin_user.invite',\n    'admin_user',\n    invited_user_row.id::text,\n    p_sent_at,\n    pg_catalog.jsonb_build_object(\n      'targetEmail', invited_user_row.email,\n      'role', invited_user_row.role,\n      'status', invited_user_row.status\n    )\n  );\n\n  return invited_user_row;\nend;\n$function$\n",
    "name": "invite_admin_user_with_audit",
    "owner": "postgres",
    "config": [
      "search_path=\"\""
    ],
    "result": "public.admin_user",
    "schema": "public",
    "source": "\ndeclare\n  current_user_row public.admin_user%rowtype;\n  invited_user_row public.admin_user%rowtype;\nbegin\n  perform pg_catalog.pg_advisory_xact_lock(pg_catalog.hashtextextended('public.admin_user.active_admin', 0));\n\n  perform 1 from auth.users u\n  where u.id = p_actor_user_id and u.email_confirmed_at is not null\n    and (u.banned_until is null or u.banned_until <= pg_catalog.clock_timestamp())\n  for share;\n  if not found then\n    raise exception 'admin_actor_denied' using errcode = 'P0001';\n  end if;\n\n  perform 1 from public.admin_user\n  where auth_user_id = p_actor_user_id and role = 'admin' and status = 'active'\n  for share;\n  if not found then\n    raise exception 'admin_actor_denied' using errcode = 'P0001';\n  end if;\n  if p_email is null or pg_catalog.btrim(p_email) = '' then\n    raise exception 'invalid_email' using errcode = 'P0001';\n  end if;\n  if p_role is null or p_role not in ('staff', 'treasurer', 'admin') then\n    raise exception 'invalid_role' using errcode = 'P0001';\n  end if;\n  if p_auth_user_id is null or p_sent_at is null then\n    raise exception 'invalid_invite_input' using errcode = 'P0001';\n  end if;\n\n  select * into current_user_row\n  from public.admin_user\n  where email OPERATOR(public.=) p_email::public.citext\n  for update;\n\n  if found and current_user_row.status <> 'disabled' then\n    raise exception 'duplicate_admin_user' using errcode = 'P0001';\n  end if;\n\n  if found then\n    update public.admin_user\n    set auth_user_id = p_auth_user_id,\n        role = p_role,\n        status = 'pending',\n        invited_at = p_sent_at,\n        invite_sent_at = p_sent_at,\n        invite_accepted_at = null,\n        last_invited_by = p_actor_user_id\n    where id = current_user_row.id\n    returning * into invited_user_row;\n  else\n    insert into public.admin_user (\n      auth_user_id, email, role, status, invited_at, invite_sent_at,\n      invite_accepted_at, last_invited_by\n    ) values (\n      p_auth_user_id, p_email, p_role, 'pending', p_sent_at, p_sent_at,\n      null, p_actor_user_id\n    )\n    returning * into invited_user_row;\n  end if;\n\n  insert into public.audit_log (\n    actor_user_id, action, entity, entity_id, timestamp, detail\n  ) values (\n    p_actor_user_id,\n    'admin_user.invite',\n    'admin_user',\n    invited_user_row.id::text,\n    p_sent_at,\n    pg_catalog.jsonb_build_object(\n      'targetEmail', invited_user_row.email,\n      'role', invited_user_row.role,\n      'status', invited_user_row.status\n    )\n  );\n\n  return invited_user_row;\nend;\n",
    "system": false,
    "library": null,
    "language": "plpgsql",
    "arguments": 5,
    "extension": null,
    "argumentTypes": [
      "pg_catalog.uuid",
      "pg_catalog.uuid",
