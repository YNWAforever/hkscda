  {
    "oid": 21126,
    "body": "CREATE OR REPLACE FUNCTION public.volunteer_release_is_active(p_binding text, p_rule jsonb, p_anchor timestamp with time zone, p_count integer, p_now timestamp with time zone)\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'public', 'pg_temp'\nAS $function$\n select (p_rule->>'semantics'='once' and exists(select 1 from public.volunteer_release_transition t where t.binding_key=p_binding and t.rule_key=p_rule->>'key' and t.rule_snapshot=p_rule)) or\n (p_now>=p_anchor-make_interval(hours=>(p_rule->>'within_hours')::integer) and ((p_rule#>>'{condition,operator}'='lt' and p_count<(p_rule#>>'{condition,threshold}')::integer) or (p_rule#>>'{condition,operator}'='lte' and p_count<=(p_rule#>>'{condition,threshold}')::integer)));\n$function$\n",
    "name": "volunteer_release_is_active",
    "owner": "postgres",
    "config": [
      "search_path=public, pg_temp"
    ],
    "result": "boolean",
    "schema": "public",
    "source": "\n select (p_rule->>'semantics'='once' and exists(select 1 from public.volunteer_release_transition t where t.binding_key=p_binding and t.rule_key=p_rule->>'key' and t.rule_snapshot=p_rule)) or\n (p_now>=p_anchor-make_interval(hours=>(p_rule->>'within_hours')::integer) and ((p_rule#>>'{condition,operator}'='lt' and p_count<(p_rule#>>'{condition,threshold}')::integer) or (p_rule#>>'{condition,operator}'='lte' and p_count<=(p_rule#>>'{condition,threshold}')::integer)));\n",
    "system": false,
    "library": null,
    "language": "sql",
    "arguments": 5,
    "extension": null,
    "argumentTypes": [
      "pg_catalog.text",
      "pg_catalog.jsonb",
      "pg_catalog.timestamptz",
      "pg_catalog.int4",
      "pg_catalog.timestamptz"
    ],
    "extensionVersion": null
