  {
    "oid": 21386,
    "body": "CREATE OR REPLACE FUNCTION public.record_mail_delivery_event(p_event_id text, p_message_id text, p_type text, p_occurred_at timestamp with time zone, p_body_hash text)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public', 'pg_temp'\nAS $function$\ndeclare prior public.mail_delivery_event%rowtype; inserted integer;\nbegin\n insert into public.mail_delivery_event(event_id,provider_message_id,event_type,occurred_at,body_hash) values(p_event_id,p_message_id,p_type,p_occurred_at,p_body_hash) on conflict(event_id) do nothing;\n get diagnostics inserted=row_count;\n select * into strict prior from public.mail_delivery_event where event_id=p_event_id;\n if prior.provider_message_id is distinct from p_message_id or prior.event_type is distinct from p_type or prior.occurred_at is distinct from p_occurred_at or prior.body_hash is distinct from p_body_hash then raise exception 'mail_delivery_event_conflict' using errcode='23505';end if;\n if inserted=1 then insert into public.audit_log(action,entity,entity_id,detail) values('notification.delivery_event','mail_delivery_event',p_event_id,jsonb_build_object('provider','resend','providerMessageId',p_message_id,'type',p_type,'occurredAt',p_occurred_at));end if;\n return jsonb_build_object('replayed',inserted=0);\nend$function$\n",
    "name": "record_mail_delivery_event",
    "owner": "postgres",
    "config": [
      "search_path=public, pg_temp"
    ],
    "result": "jsonb",
    "schema": "public",
    "source": "\ndeclare prior public.mail_delivery_event%rowtype; inserted integer;\nbegin\n insert into public.mail_delivery_event(event_id,provider_message_id,event_type,occurred_at,body_hash) values(p_event_id,p_message_id,p_type,p_occurred_at,p_body_hash) on conflict(event_id) do nothing;\n get diagnostics inserted=row_count;\n select * into strict prior from public.mail_delivery_event where event_id=p_event_id;\n if prior.provider_message_id is distinct from p_message_id or prior.event_type is distinct from p_type or prior.occurred_at is distinct from p_occurred_at or prior.body_hash is distinct from p_body_hash then raise exception 'mail_delivery_event_conflict' using errcode='23505';end if;\n if inserted=1 then insert into public.audit_log(action,entity,entity_id,detail) values('notification.delivery_event','mail_delivery_event',p_event_id,jsonb_build_object('provider','resend','providerMessageId',p_message_id,'type',p_type,'occurredAt',p_occurred_at));end if;\n return jsonb_build_object('replayed',inserted=0);\nend",
    "system": false,
    "library": null,
    "language": "plpgsql",
    "arguments": 5,
    "extension": null,
    "argumentTypes": [
      "pg_catalog.text",
      "pg_catalog.text",
      "pg_catalog.text",
      "pg_catalog.timestamptz",
      "pg_catalog.text"
    ],
    "extensionVersion": null
  },
