    "oid": 21004,
    "body": "CREATE OR REPLACE FUNCTION private.sponsorship_cancel_transition()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public', 'pg_temp'\nAS $function$\nbegin\n if new.status='cancelled' and old.status <> 'cancelled' then\n  perform private.queue_sponsorship_transition(new.id,null,'cancelled','pledge:'||new.id::text||':cancelled:'||new.updated_at::text);\n end if;\n return new;\nend; $function$\n",
    "name": "sponsorship_cancel_transition",
    "owner": "postgres",
    "config": [
      "search_path=public, pg_temp"
    ],
    "result": "trigger",
    "schema": "private",
    "source": "\nbegin\n if new.status='cancelled' and old.status <> 'cancelled' then\n  perform private.queue_sponsorship_transition(new.id,null,'cancelled','pledge:'||new.id::text||':cancelled:'||new.updated_at::text);\n end if;\n return new;\nend; ",
    "system": false,
    "library": null,
    "language": "plpgsql",
    "arguments": 0,
    "extension": null,
    "argumentTypes": [],
    "extensionVersion": null
