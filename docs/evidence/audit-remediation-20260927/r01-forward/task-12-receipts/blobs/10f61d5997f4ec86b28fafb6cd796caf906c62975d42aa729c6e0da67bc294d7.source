  {
    "oid": 21117,
    "body": "CREATE OR REPLACE FUNCTION public.volunteer_my_history(p_actor uuid)\n RETURNS jsonb\n LANGUAGE plpgsql\n STABLE SECURITY DEFINER\n SET search_path TO 'public', 'pg_temp'\nAS $function$\ndeclare p public.volunteer_profile%rowtype; stamp timestamptz:=statement_timestamp();\nbegin\n if not exists(select 1 from auth.users where id=p_actor and email_confirmed_at is not null and (banned_until is null or banned_until<=stamp)) then raise exception 'verified_actor_required' using errcode='42501'; end if;\n select * into p from public.volunteer_profile where auth_user_id=p_actor;\n if not found then return jsonb_build_object('credentials','[]'::jsonb,'verified_sessions',0,'history_coverage_start',null); end if;\n return jsonb_build_object('history_coverage_start',p.history_coverage_start,'joined_on',p.joined_on,\n 'credentials',(select coalesce(jsonb_agg(jsonb_build_object('id',c.id,'label',d.label,'valid_from',c.valid_from,'valid_until',c.valid_until,'revoked',c.revoked_at is not null,'currently_valid',c.revoked_at is null and c.valid_from<=stamp and (c.valid_until is null or c.valid_until>stamp)) order by d.label),'[]') from public.volunteer_credential c join public.volunteer_credential_definition d on d.key=c.credential_key where c.profile_id=p.id),\n 'verified_sessions',(select count(*) from public.volunteer_registration r join public.volunteer_activity a on a.id=r.activity_id where r.profile_id=p.id and r.status='approved' and r.attendance_status='completed' and a.ends_at<=stamp and exists(select 1 from public.volunteer_attendance_event e where e.registration_id=r.id)));\nend $function$\n",
    "name": "volunteer_my_history",
    "owner": "postgres",
    "config": [
      "search_path=public, pg_temp"
    ],
    "result": "jsonb",
    "schema": "public",
    "source": "\ndeclare p public.volunteer_profile%rowtype; stamp timestamptz:=statement_timestamp();\nbegin\n if not exists(select 1 from auth.users where id=p_actor and email_confirmed_at is not null and (banned_until is null or banned_until<=stamp)) then raise exception 'verified_actor_required' using errcode='42501'; end if;\n select * into p from public.volunteer_profile where auth_user_id=p_actor;\n if not found then return jsonb_build_object('credentials','[]'::jsonb,'verified_sessions',0,'history_coverage_start',null); end if;\n return jsonb_build_object('history_coverage_start',p.history_coverage_start,'joined_on',p.joined_on,\n 'credentials',(select coalesce(jsonb_agg(jsonb_build_object('id',c.id,'label',d.label,'valid_from',c.valid_from,'valid_until',c.valid_until,'revoked',c.revoked_at is not null,'currently_valid',c.revoked_at is null and c.valid_from<=stamp and (c.valid_until is null or c.valid_until>stamp)) order by d.label),'[]') from public.volunteer_credential c join public.volunteer_credential_definition d on d.key=c.credential_key where c.profile_id=p.id),\n 'verified_sessions',(select count(*) from public.volunteer_registration r join public.volunteer_activity a on a.id=r.activity_id where r.profile_id=p.id and r.status='approved' and r.attendance_status='completed' and a.ends_at<=stamp and exists(select 1 from public.volunteer_attendance_event e where e.registration_id=r.id)));\nend ",
    "system": false,
    "library": null,
    "language": "plpgsql",
    "arguments": 1,
    "extension": null,
    "argumentTypes": [
      "pg_catalog.uuid"
    ],
    "extensionVersion": null
  },
