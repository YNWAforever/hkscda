  {
    "oid": 20476,
    "body": "CREATE OR REPLACE FUNCTION public.volunteer_policy_window(p_window jsonb, p_start timestamp with time zone, p_timezone text)\n RETURNS timestamp with time zone\n LANGUAGE plpgsql\n IMMUTABLE\n SET search_path TO 'public', 'pg_temp'\nAS $function$\nbegin\n case p_window->>'mode'\n when 'hours_before' then return p_start-make_interval(hours=>(p_window->>'value')::integer);\n when 'calendar_days_before' then return (((p_start at time zone p_timezone)::date-(p_window->>'value')::integer)+(p_window->>'at')::time) at time zone p_timezone;\n when 'unrestricted' then return '-infinity'::timestamptz;\n when 'disabled' then return 'infinity'::timestamptz;\n else raise exception 'invalid_policy_window' using errcode='22023'; end case;\nend $function$\n",
    "name": "volunteer_policy_window",
    "owner": "postgres",
    "config": [
      "search_path=public, pg_temp"
    ],
    "result": "timestamp with time zone",
    "schema": "public",
    "source": "\nbegin\n case p_window->>'mode'\n when 'hours_before' then return p_start-make_interval(hours=>(p_window->>'value')::integer);\n when 'calendar_days_before' then return (((p_start at time zone p_timezone)::date-(p_window->>'value')::integer)+(p_window->>'at')::time) at time zone p_timezone;\n when 'unrestricted' then return '-infinity'::timestamptz;\n when 'disabled' then return 'infinity'::timestamptz;\n else raise exception 'invalid_policy_window' using errcode='22023'; end case;\nend ",
    "system": false,
    "library": null,
    "language": "plpgsql",
    "arguments": 3,
    "extension": null,
    "argumentTypes": [
      "pg_catalog.jsonb",
      "pg_catalog.timestamptz",
      "pg_catalog.text"
    ],
    "extensionVersion": null
  },
