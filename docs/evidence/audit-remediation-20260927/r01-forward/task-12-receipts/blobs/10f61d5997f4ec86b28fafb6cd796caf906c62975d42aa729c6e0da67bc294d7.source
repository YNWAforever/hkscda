  {
    "oid": 21833,
    "body": "CREATE OR REPLACE FUNCTION public.fail_crm_export_job(p_job uuid, p_owner uuid, p_error text)\n RETURNS boolean\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public', 'pg_temp'\nAS $function$\ndeclare v_job public.crm_export_job%rowtype;\nbegin\n  update public.crm_export_job set status='failed',lease_owner=null,lease_until=null,\n    error_code=left(p_error,80),updated_at=clock_timestamp()\n    where id=p_job and status='processing' and lease_owner=p_owner\n    returning * into v_job;\n  if not found then return false; end if;\n  insert into public.audit_log(actor_user_id,action,entity,entity_id,timestamp,detail)\n    values(v_job.actor_user_id,'export.job.failed','crm_export',p_job::text,clock_timestamp(),\n      jsonb_build_object('kind',v_job.kind,'errorCode',v_job.error_code));\n  return true;\nend;\n$function$\n",
    "name": "fail_crm_export_job",
    "owner": "postgres",
    "config": [
      "search_path=public, pg_temp"
    ],
    "result": "boolean",
    "schema": "public",
    "source": "\ndeclare v_job public.crm_export_job%rowtype;\nbegin\n  update public.crm_export_job set status='failed',lease_owner=null,lease_until=null,\n    error_code=left(p_error,80),updated_at=clock_timestamp()\n    where id=p_job and status='processing' and lease_owner=p_owner\n    returning * into v_job;\n  if not found then return false; end if;\n  insert into public.audit_log(actor_user_id,action,entity,entity_id,timestamp,detail)\n    values(v_job.actor_user_id,'export.job.failed','crm_export',p_job::text,clock_timestamp(),\n      jsonb_build_object('kind',v_job.kind,'errorCode',v_job.error_code));\n  return true;\nend;\n",
    "system": false,
    "library": null,
    "language": "plpgsql",
    "arguments": 3,
    "extension": null,
    "argumentTypes": [
      "pg_catalog.uuid",
      "pg_catalog.uuid",
      "pg_catalog.text"
    ],
    "extensionVersion": null
  },
