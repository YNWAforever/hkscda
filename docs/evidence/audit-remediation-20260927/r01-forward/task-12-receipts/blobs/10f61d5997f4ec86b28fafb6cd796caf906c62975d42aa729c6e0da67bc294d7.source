    "oid": 3810,
    "body": "CREATE OR REPLACE FUNCTION pg_catalog.pg_is_in_recovery()\n RETURNS boolean\n LANGUAGE internal\n PARALLEL SAFE STRICT\nAS $function$pg_is_in_recovery$function$\n",
