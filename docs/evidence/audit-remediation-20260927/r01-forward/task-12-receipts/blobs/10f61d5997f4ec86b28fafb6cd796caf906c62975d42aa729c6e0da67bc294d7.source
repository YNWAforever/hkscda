  {
    "oid": 21501,
    "body": "CREATE OR REPLACE FUNCTION public.mutate_adoption_coordinator_with_audit(p_actor_user_id uuid, p_entity text, p_operation text, p_id uuid, p_payload jsonb)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\ndeclare\n  actor public.admin_user%rowtype;\n  current_status public.coordinator_status%rowtype;\n  desired_status public.coordinator_status%rowtype;\n  current_task public.adoption_followup%rowtype;\n  desired_task public.adoption_followup%rowtype;\n  linked_status public.coordinator_status%rowtype;\n  result jsonb;\n  action_name text;\n  audit_detail jsonb := '{}'::jsonb;\nbegin\n  perform 1 from auth.users u\n  where u.id = p_actor_user_id and u.email_confirmed_at is not null\n    and (u.banned_until is null or u.banned_until <= pg_catalog.clock_timestamp())\n  for share;\n  if not found then\n    raise exception 'Active staff or admin actor required' using errcode = '42501';\n  end if;\n  select * into actor\n  from public.admin_user\n  where auth_user_id = p_actor_user_id\n    and status = 'active'\n    and role in ('staff', 'admin')\n  for share;\n  if not found then\n    raise exception 'Active staff or admin actor required' using errcode = '42501';\n  end if;\n  if p_entity = 'coordinator_status' and actor.role <> 'admin' then\n    raise exception 'Admin actor required for status mutation' using errcode = '42501';\n  end if;\n\n  if p_entity = 'coordinator_status' and p_operation = 'create' then\n    insert into public.coordinator_status (\n      category, key, label_zh, label_en, sort_order, color,\n      is_active, is_closing, is_final\n    ) values (\n      p_payload->>'category', p_payload->>'key',\n      p_payload->>'label_zh', p_payload->>'label_en',\n      (p_payload->>'sort_order')::integer, p_payload->>'color',\n      (p_payload->>'is_active')::boolean,\n      (p_payload->>'is_closing')::boolean,\n      (p_payload->>'is_final')::boolean\n    )\n    returning to_jsonb(coordinator_status.*) into result;\n    action_name := 'coordinator_status.create';\n    audit_detail := jsonb_build_object('category', result->>'category', 'key', result->>'key');\n\n  elsif p_entity = 'coordinator_status' and p_operation in ('update', 'delete') then\n    select * into current_status from public.coordinator_status\n    where id = p_id for update;\n    if not found then\n      raise exception 'Status not found' using errcode = 'P0002';\n    end if;\n    if p_operation = 'delete' then\n      if current_status.is_system then\n        raise exception 'System statuses cannot be deleted' using errcode = '23514';\n      end if;\n      delete from public.coordinator_status where id = p_id\n      returning to_jsonb(coordinator_status.*) into result;\n      action_name := 'coordinator_status.delete';\n      audit_detail := jsonb_build_object('category', current_status.category, 'key', current_status.key);\n    else\n      select * into desired_status\n      from jsonb_populate_record(current_status, p_payload);\n      if current_status.is_system and\n         (desired_status.key <> current_status.key or desired_status.category <> current_status.category) then\n        raise exception 'System status identity cannot be changed' using errcode = '23514';\n      end if;\n      update public.coordinator_status set\n        category = desired_status.category,\n        key = desired_status.key,\n        label_zh = desired_status.label_zh,\n        label_en = desired_status.label_en,\n        sort_order = desired_status.sort_order,\n        color = desired_status.color,\n        is_active = desired_status.is_active,\n        is_closing = desired_status.is_closing,\n        is_final = desired_status.is_final\n      where id = p_id\n      returning to_jsonb(coordinator_status.*) into result;\n      action_name := 'coordinator_status.update';\n      audit_detail := p_payload;\n    end if;\n\n  elsif p_entity = 'adoption_followup' and p_operation = 'create' then\n    select * into desired_task\n    from jsonb_populate_record(null::public.adoption_followup, p_payload);\n    select * into linked_status from public.coordinator_status\n    where id = desired_task.status_id and category = 'followup' and is_active;\n    if not found then\n      raise exception 'Active followup status required' using errcode = '23514';\n    end if;\n    insert into public.adoption_followup (\n      adoption_case_id, adopter_profile_id, animal_id, status_id,\n      title, task_type, priority, due_at, scheduled_at, completed_at,\n      assigned_to, volunteer, contact_channel, outcome, next_step_at, remarks,\n      has_window_net, environment, score, created_by, updated_by\n    ) values (\n      desired_task.adoption_case_id, desired_task.adopter_profile_id,\n      desired_task.animal_id, desired_task.status_id,\n      desired_task.title, desired_task.task_type, desired_task.priority,\n      desired_task.due_at, desired_task.scheduled_at, desired_task.completed_at,\n      desired_task.assigned_to, desired_task.volunteer, desired_task.contact_channel,\n      desired_task.outcome, desired_task.next_step_at, desired_task.remarks,\n      desired_task.has_window_net, desired_task.environment, desired_task.score,\n      p_actor_user_id, p_actor_user_id\n    )\n    returning to_jsonb(adoption_followup.*) into result;\n    action_name := 'coordinator_task.create';\n    audit_detail := jsonb_build_object(\n      'adoptionCaseId', desired_task.adoption_case_id,\n      'adopterProfileId', desired_task.adopter_profile_id,\n      'animalId', desired_task.animal_id,\n      'statusId', desired_task.status_id,\n      'priority', desired_task.priority,\n      'dueAt', desired_task.due_at\n    );\n\n  elsif p_entity = 'adoption_followup' and p_operation = 'update' then\n    select * into current_task from public.adoption_followup\n    where id = p_id for update;\n    if not found then\n      raise exception 'Task not found' using errcode = 'P0002';\n    end if;\n    select * into desired_task\n    from jsonb_populate_record(current_task, p_payload);\n    select * into linked_status from public.coordinator_status\n    where id = desired_task.status_id and category = 'followup'\n      and (is_active or not (p_payload ? 'status_id'));\n    if not found then\n      raise exception 'Active followup status required' using errcode = '23514';\n    end if;\n    update public.adoption_followup set\n      adoption_case_id = desired_task.adoption_case_id,\n      adopter_profile_id = desired_task.adopter_profile_id,\n      animal_id = desired_task.animal_id,\n      status_id = desired_task.status_id,\n      title = desired_task.title,\n      task_type = desired_task.task_type,\n      priority = desired_task.priority,\n      due_at = desired_task.due_at,\n      scheduled_at = desired_task.scheduled_at,\n      completed_at = desired_task.completed_at,\n      assigned_to = desired_task.assigned_to,\n      volunteer = desired_task.volunteer,\n      contact_channel = desired_task.contact_channel,\n      outcome = desired_task.outcome,\n      next_step_at = desired_task.next_step_at,\n      remarks = desired_task.remarks,\n      has_window_net = desired_task.has_window_net,\n      environment = desired_task.environment,\n      score = desired_task.score,\n      updated_by = p_actor_user_id\n    where id = p_id\n    returning to_jsonb(adoption_followup.*) into result;\n    action_name := case\n      when p_payload ? 'status_id' and linked_status.key = 'completed' then 'coordinator_task.complete'\n      when p_payload ? 'status_id' and linked_status.key = 'cancelled' then 'coordinator_task.cancel'\n      else 'coordinator_task.update'\n    end;\n    audit_detail := p_payload - 'updated_by';\n\n  elsif p_entity = 'animal_match' and p_operation = 'create' then\n    select * into linked_status from public.coordinator_status\n    where id = (p_payload->>'status_id')::uuid and category = 'match' and is_active;\n    if not found then\n      raise exception 'Active match status required' using errcode = '23514';\n    end if;\n    insert into public.animal_match (\n      adoption_case_id, animal_id, status_id, is_approved,\n      notes, created_by, updated_by\n    ) values (\n      (p_payload->>'adoption_case_id')::uuid,\n      (p_payload->>'animal_id')::uuid,\n      linked_status.id,\n      linked_status.key = 'approved',\n      p_payload->>'notes',\n      p_actor_user_id, p_actor_user_id\n    )\n    returning to_jsonb(animal_match.*) into result;\n    action_name := 'animal_match.create';\n    audit_detail := jsonb_build_object(\n      'adoptionCaseId', result->>'adoption_case_id',\n      'animalId', result->>'animal_id',\n      'statusId', result->>'status_id',\n      'isApproved', result->'is_approved'\n    );\n\n  else\n    raise exception 'Unsupported adoption coordinator mutation' using errcode = '22023';\n  end if;\n\n  insert into public.audit_log (actor_user_id, action, entity, entity_id, detail)\n  values (p_actor_user_id, action_name, p_entity, result->>'id', audit_detail);\n  return result;\nend;\n$function$\n",
    "name": "mutate_adoption_coordinator_with_audit",
    "owner": "postgres",
    "config": [
      "search_path=\"\""
    ],
    "result": "jsonb",
    "schema": "public",
    "source": "\ndeclare\n  actor public.admin_user%rowtype;\n  current_status public.coordinator_status%rowtype;\n  desired_status public.coordinator_status%rowtype;\n  current_task public.adoption_followup%rowtype;\n  desired_task public.adoption_followup%rowtype;\n  linked_status public.coordinator_status%rowtype;\n  result jsonb;\n  action_name text;\n  audit_detail jsonb := '{}'::jsonb;\nbegin\n  perform 1 from auth.users u\n  where u.id = p_actor_user_id and u.email_confirmed_at is not null\n    and (u.banned_until is null or u.banned_until <= pg_catalog.clock_timestamp())\n  for share;\n  if not found then\n    raise exception 'Active staff or admin actor required' using errcode = '42501';\n  end if;\n  select * into actor\n  from public.admin_user\n  where auth_user_id = p_actor_user_id\n    and status = 'active'\n    and role in ('staff', 'admin')\n  for share;\n  if not found then\n    raise exception 'Active staff or admin actor required' using errcode = '42501';\n  end if;\n  if p_entity = 'coordinator_status' and actor.role <> 'admin' then\n    raise exception 'Admin actor required for status mutation' using errcode = '42501';\n  end if;\n\n  if p_entity = 'coordinator_status' and p_operation = 'create' then\n    insert into public.coordinator_status (\n      category, key, label_zh, label_en, sort_order, color,\n      is_active, is_closing, is_final\n    ) values (\n      p_payload->>'category', p_payload->>'key',\n      p_payload->>'label_zh', p_payload->>'label_en',\n      (p_payload->>'sort_order')::integer, p_payload->>'color',\n      (p_payload->>'is_active')::boolean,\n      (p_payload->>'is_closing')::boolean,\n      (p_payload->>'is_final')::boolean\n    )\n    returning to_jsonb(coordinator_status.*) into result;\n    action_name := 'coordinator_status.create';\n    audit_detail := jsonb_build_object('category', result->>'category', 'key', result->>'key');\n\n  elsif p_entity = 'coordinator_status' and p_operation in ('update', 'delete') then\n    select * into current_status from public.coordinator_status\n    where id = p_id for update;\n    if not found then\n      raise exception 'Status not found' using errcode = 'P0002';\n    end if;\n    if p_operation = 'delete' then\n      if current_status.is_system then\n        raise exception 'System statuses cannot be deleted' using errcode = '23514';\n      end if;\n      delete from public.coordinator_status where id = p_id\n      returning to_jsonb(coordinator_status.*) into result;\n      action_name := 'coordinator_status.delete';\n      audit_detail := jsonb_build_object('category', current_status.category, 'key', current_status.key);\n    else\n      select * into desired_status\n      from jsonb_populate_record(current_status, p_payload);\n      if current_status.is_system and\n         (desired_status.key <> current_status.key or desired_status.category <> current_status.category) then\n        raise exception 'System status identity cannot be changed' using errcode = '23514';\n      end if;\n      update public.coordinator_status set\n        category = desired_status.category,\n        key = desired_status.key,\n        label_zh = desired_status.label_zh,\n        label_en = desired_status.label_en,\n        sort_order = desired_status.sort_order,\n        color = desired_status.color,\n        is_active = desired_status.is_active,\n        is_closing = desired_status.is_closing,\n        is_final = desired_status.is_final\n      where id = p_id\n      returning to_jsonb(coordinator_status.*) into result;\n      action_name := 'coordinator_status.update';\n      audit_detail := p_payload;\n    end if;\n\n  elsif p_entity = 'adoption_followup' and p_operation = 'create' then\n    select * into desired_task\n    from jsonb_populate_record(null::public.adoption_followup, p_payload);\n    select * into linked_status from public.coordinator_status\n    where id = desired_task.status_id and category = 'followup' and is_active;\n    if not found then\n      raise exception 'Active followup status required' using errcode = '23514';\n    end if;\n    insert into public.adoption_followup (\n      adoption_case_id, adopter_profile_id, animal_id, status_id,\n      title, task_type, priority, due_at, scheduled_at, completed_at,\n      assigned_to, volunteer, contact_channel, outcome, next_step_at, remarks,\n      has_window_net, environment, score, created_by, updated_by\n    ) values (\n      desired_task.adoption_case_id, desired_task.adopter_profile_id,\n      desired_task.animal_id, desired_task.status_id,\n      desired_task.title, desired_task.task_type, desired_task.priority,\n      desired_task.due_at, desired_task.scheduled_at, desired_task.completed_at,\n      desired_task.assigned_to, desired_task.volunteer, desired_task.contact_channel,\n      desired_task.outcome, desired_task.next_step_at, desired_task.remarks,\n      desired_task.has_window_net, desired_task.environment, desired_task.score,\n      p_actor_user_id, p_actor_user_id\n    )\n    returning to_jsonb(adoption_followup.*) into result;\n    action_name := 'coordinator_task.create';\n    audit_detail := jsonb_build_object(\n      'adoptionCaseId', desired_task.adoption_case_id,\n      'adopterProfileId', desired_task.adopter_profile_id,\n      'animalId', desired_task.animal_id,\n      'statusId', desired_task.status_id,\n      'priority', desired_task.priority,\n      'dueAt', desired_task.due_at\n    );\n\n  elsif p_entity = 'adoption_followup' and p_operation = 'update' then\n    select * into current_task from public.adoption_followup\n    where id = p_id for update;\n    if not found then\n      raise exception 'Task not found' using errcode = 'P0002';\n    end if;\n    select * into desired_task\n    from jsonb_populate_record(current_task, p_payload);\n    select * into linked_status from public.coordinator_status\n    where id = desired_task.status_id and category = 'followup'\n      and (is_active or not (p_payload ? 'status_id'));\n    if not found then\n      raise exception 'Active followup status required' using errcode = '23514';\n    end if;\n    update public.adoption_followup set\n      adoption_case_id = desired_task.adoption_case_id,\n      adopter_profile_id = desired_task.adopter_profile_id,\n      animal_id = desired_task.animal_id,\n      status_id = desired_task.status_id,\n      title = desired_task.title,\n      task_type = desired_task.task_type,\n      priority = desired_task.priority,\n      due_at = desired_task.due_at,\n      scheduled_at = desired_task.scheduled_at,\n      completed_at = desired_task.completed_at,\n      assigned_to = desired_task.assigned_to,\n      volunteer = desired_task.volunteer,\n      contact_channel = desired_task.contact_channel,\n      outcome = desired_task.outcome,\n      next_step_at = desired_task.next_step_at,\n      remarks = desired_task.remarks,\n      has_window_net = desired_task.has_window_net,\n      environment = desired_task.environment,\n      score = desired_task.score,\n      updated_by = p_actor_user_id\n    where id = p_id\n    returning to_jsonb(adoption_followup.*) into result;\n    action_name := case\n      when p_payload ? 'status_id' and linked_status.key = 'completed' then 'coordinator_task.complete'\n      when p_payload ? 'status_id' and linked_status.key = 'cancelled' then 'coordinator_task.cancel'\n      else 'coordinator_task.update'\n    end;\n    audit_detail := p_payload - 'updated_by';\n\n  elsif p_entity = 'animal_match' and p_operation = 'create' then\n    select * into linked_status from public.coordinator_status\n    where id = (p_payload->>'status_id')::uuid and category = 'match' and is_active;\n    if not found then\n      raise exception 'Active match status required' using errcode = '23514';\n    end if;\n    insert into public.animal_match (\n      adoption_case_id, animal_id, status_id, is_approved,\n      notes, created_by, updated_by\n    ) values (\n      (p_payload->>'adoption_case_id')::uuid,\n      (p_payload->>'animal_id')::uuid,\n      linked_status.id,\n      linked_status.key = 'approved',\n      p_payload->>'notes',\n      p_actor_user_id, p_actor_user_id\n    )\n    returning to_jsonb(animal_match.*) into result;\n    action_name := 'animal_match.create';\n    audit_detail := jsonb_build_object(\n      'adoptionCaseId', result->>'adoption_case_id',\n      'animalId', result->>'animal_id',\n      'statusId', result->>'status_id',\n      'isApproved', result->'is_approved'\n    );\n\n  else\n    raise exception 'Unsupported adoption coordinator mutation' using errcode = '22023';\n  end if;\n\n  insert into public.audit_log (actor_user_id, action, entity, entity_id, detail)\n  values (p_actor_user_id, action_name, p_entity, result->>'id', audit_detail);\n  return result;\nend;\n",
