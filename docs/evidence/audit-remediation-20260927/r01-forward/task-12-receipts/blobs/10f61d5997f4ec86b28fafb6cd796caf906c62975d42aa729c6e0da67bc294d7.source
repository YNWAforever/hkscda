  {
    "oid": 19651,
    "body": "CREATE OR REPLACE FUNCTION public.deactivate_faq_entry_with_audit(p_actor_user_id uuid, p_id uuid)\n RETURNS void\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public', 'pg_temp'\nAS $function$\ndeclare\n  actor public.admin_user%rowtype;\nbegin\n  select * into actor\n  from public.admin_user\n  where auth_user_id = p_actor_user_id\n    and status = 'active'\n    and role in ('staff', 'admin');\n\n  if not found then\n    raise exception 'Active staff or admin actor required' using errcode = '42501';\n  end if;\n\n  update public.faq_entry set is_active = false where id = p_id;\n\n  if not found then\n    raise exception 'FAQ entry not found' using errcode = 'P0002';\n  end if;\n\n  insert into public.audit_log (actor_user_id, action, entity, entity_id, detail)\n  values (p_actor_user_id, 'faq_entry.deactivate', 'faq_entry', p_id::text, '{}'::jsonb);\nend;\n$function$\n",
    "name": "deactivate_faq_entry_with_audit",
    "owner": "postgres",
    "config": [
      "search_path=public, pg_temp"
    ],
    "result": "void",
    "schema": "public",
    "source": "\ndeclare\n  actor public.admin_user%rowtype;\nbegin\n  select * into actor\n  from public.admin_user\n  where auth_user_id = p_actor_user_id\n    and status = 'active'\n    and role in ('staff', 'admin');\n\n  if not found then\n    raise exception 'Active staff or admin actor required' using errcode = '42501';\n  end if;\n\n  update public.faq_entry set is_active = false where id = p_id;\n\n  if not found then\n    raise exception 'FAQ entry not found' using errcode = 'P0002';\n  end if;\n\n  insert into public.audit_log (actor_user_id, action, entity, entity_id, detail)\n  values (p_actor_user_id, 'faq_entry.deactivate', 'faq_entry', p_id::text, '{}'::jsonb);\nend;\n",
    "system": false,
    "library": null,
    "language": "plpgsql",
    "arguments": 2,
    "extension": null,
    "argumentTypes": [
      "pg_catalog.uuid",
      "pg_catalog.uuid"
    ],
    "extensionVersion": null
  },
