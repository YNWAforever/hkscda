    "oid": 21835,
    "body": "CREATE OR REPLACE FUNCTION public.crm_export_job_download(p_job uuid, p_actor uuid)\n RETURNS text\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'public', 'pg_temp'\nAS $function$\n  select a.csv from public.crm_export_job j join private.crm_export_artifact a on a.job_id=j.id\n    where j.id=p_job and j.actor_user_id=p_actor and j.status='ready'\n      and j.expires_at>clock_timestamp() and private.crm_export_actor_allowed(p_actor);\n$function$\n",
    "name": "crm_export_job_download",
    "owner": "postgres",
    "config": [
      "search_path=public, pg_temp"
    ],
    "result": "text",
    "schema": "public",
    "source": "\n  select a.csv from public.crm_export_job j join private.crm_export_artifact a on a.job_id=j.id\n    where j.id=p_job and j.actor_user_id=p_actor and j.status='ready'\n      and j.expires_at>clock_timestamp() and private.crm_export_actor_allowed(p_actor);\n",
    "system": false,
