    "body": "CREATE OR REPLACE FUNCTION pg_catalog.regexp_instr(text, text)\n RETURNS integer\n LANGUAGE internal\n IMMUTABLE PARALLEL SAFE STRICT\nAS $function$regexp_instr_no_start$function$\n",
    "name": "regexp_instr",
