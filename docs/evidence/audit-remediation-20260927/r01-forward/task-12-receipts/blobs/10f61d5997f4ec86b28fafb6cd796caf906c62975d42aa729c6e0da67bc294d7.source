    "oid": 16841,
    "body": "CREATE OR REPLACE FUNCTION realtime.quote_wal2json(entity regclass)\n RETURNS text\n LANGUAGE sql\n IMMUTABLE STRICT\nAS $function$\n  SELECT\n    realtime.wal2json_escape_identifier(nsp.nspname::text)\n    || '.'\n    || realtime.wal2json_escape_identifier(pc.relname::text)\n  FROM pg_class pc\n  JOIN pg_namespace nsp ON pc.relnamespace = nsp.oid\n  WHERE pc.oid = entity\n$function$\n",
    "name": "quote_wal2json",
    "owner": "supabase_realtime_admin",
    "config": null,
    "result": "text",
    "schema": "realtime",
    "source": "\n  SELECT\n    realtime.wal2json_escape_identifier(nsp.nspname::text)\n    || '.'\n    || realtime.wal2json_escape_identifier(pc.relname::text)\n  FROM pg_class pc\n  JOIN pg_namespace nsp ON pc.relnamespace = nsp.oid\n  WHERE pc.oid = entity\n",
    "system": false,
    "library": null,
    "language": "sql",
    "arguments": 1,
    "extension": null,
    "argumentTypes": [
      "pg_catalog.regclass"
    ],
