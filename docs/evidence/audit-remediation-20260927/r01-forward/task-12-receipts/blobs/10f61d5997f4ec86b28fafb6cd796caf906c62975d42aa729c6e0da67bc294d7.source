    "oid": 21786,
    "body": "CREATE OR REPLACE FUNCTION public.mark_claimed_content_public_asset_ready(p_asset_id uuid, p_claimed_at timestamp with time zone)\n RETURNS boolean\n LANGUAGE plpgsql\n SET search_path TO ''\nAS $function$\nbegin\n  update public.content_public_asset\n  set ready=true,copy_claimed_at=null,repair_status='completed',\n      next_retry_at=null,lease_token=null\n  where id=p_asset_id and ready=false and copy_claimed_at=p_claimed_at;\n  if found then return true; end if;\n  return exists(select 1 from public.content_public_asset where id=p_asset_id and ready=true);\nend $function$\n",
    "name": "mark_claimed_content_public_asset_ready",
    "owner": "postgres",
    "config": [
      "search_path=\"\""
    ],
    "result": "boolean",
    "schema": "public",
    "source": "\nbegin\n  update public.content_public_asset\n  set ready=true,copy_claimed_at=null,repair_status='completed',\n      next_retry_at=null,lease_token=null\n  where id=p_asset_id and ready=false and copy_claimed_at=p_claimed_at;\n  if found then return true; end if;\n  return exists(select 1 from public.content_public_asset where id=p_asset_id and ready=true);\nend ",
    "system": false,
    "library": null,
    "language": "plpgsql",
    "arguments": 2,
    "extension": null,
    "argumentTypes": [
      "pg_catalog.uuid",
      "pg_catalog.timestamptz"
    ],
    "extensionVersion": null
  },
