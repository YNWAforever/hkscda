    "body": "CREATE OR REPLACE FUNCTION information_schema._pg_truetypid(pg_attribute, pg_type)\n RETURNS oid\n LANGUAGE sql\n IMMUTABLE PARALLEL SAFE STRICT\nRETURN CASE WHEN (($2).typtype = 'd'::\"char\") THEN ($2).typbasetype ELSE ($1).atttypid END\n",
