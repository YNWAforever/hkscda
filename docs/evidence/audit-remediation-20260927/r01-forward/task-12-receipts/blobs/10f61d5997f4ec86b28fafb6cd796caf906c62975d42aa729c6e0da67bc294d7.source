    "oid": 2981,
    "body": "CREATE OR REPLACE FUNCTION pg_catalog.record_eq(record, record)\n RETURNS boolean\n LANGUAGE internal\n IMMUTABLE PARALLEL SAFE STRICT\nAS $function$record_eq$function$\n",
    "name": "record_eq",
