    "oid": 20857,
    "body": "CREATE OR REPLACE FUNCTION public.internship_history_guard()\n RETURNS trigger\n LANGUAGE plpgsql\n SET search_path TO 'public', 'pg_temp'\nAS $function$ begin\n if tg_table_name='internship_application' and tg_op='UPDATE' and (new.applicant_id,new.intake_version_id,new.contact_snapshot,new.student_snapshot,new.shelter,new.created_at) is not distinct from (old.applicant_id,old.intake_version_id,old.contact_snapshot,old.student_snapshot,old.shelter,old.created_at) then return new; end if;\n raise exception 'internship_factual_history_is_immutable' using errcode='42501'; end $function$\n",
    "name": "internship_history_guard",
    "owner": "postgres",
    "config": [
      "search_path=public, pg_temp"
    ],
    "result": "trigger",
    "schema": "public",
    "source": " begin\n if tg_table_name='internship_application' and tg_op='UPDATE' and (new.applicant_id,new.intake_version_id,new.contact_snapshot,new.student_snapshot,new.shelter,new.created_at) is not distinct from (old.applicant_id,old.intake_version_id,old.contact_snapshot,old.student_snapshot,old.shelter,old.created_at) then return new; end if;\n raise exception 'internship_factual_history_is_immutable' using errcode='42501'; end ",
    "system": false,
    "library": null,
    "language": "plpgsql",
    "arguments": 0,
    "extension": null,
    "argumentTypes": [],
    "extensionVersion": null
  },
