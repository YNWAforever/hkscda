  {
    "oid": 17930,
    "body": "CREATE OR REPLACE FUNCTION public.regexp_match(public.citext, public.citext)\n RETURNS text[]\n LANGUAGE sql\n IMMUTABLE PARALLEL SAFE STRICT\nAS $function$\n    SELECT pg_catalog.regexp_match( $1::pg_catalog.text, $2::pg_catalog.text, 'i' );\n$function$\n",
    "name": "regexp_match",
    "owner": "supabase_admin",
    "config": null,
    "result": "text[]",
    "schema": "public",
    "source": "\n    SELECT pg_catalog.regexp_match( $1::pg_catalog.text, $2::pg_catalog.text, 'i' );\n",
    "system": false,
    "library": null,
    "language": "sql",
    "arguments": 2,
    "extension": "citext",
    "argumentTypes": [
      "public.citext",
      "public.citext"
    ],
    "extensionVersion": "1.6"
  },
  {
    "oid": 17931,
    "body": "CREATE OR REPLACE FUNCTION public.regexp_match(public.citext, public.citext, text)\n RETURNS text[]\n LANGUAGE sql\n IMMUTABLE PARALLEL SAFE STRICT\nAS $function$\n    SELECT pg_catalog.regexp_match( $1::pg_catalog.text, $2::pg_catalog.text, CASE WHEN pg_catalog.strpos($3, 'c') = 0 THEN  $3 || 'i' ELSE $3 END );\n$function$\n",
    "name": "regexp_match",
    "owner": "supabase_admin",
    "config": null,
    "result": "text[]",
    "schema": "public",
    "source": "\n    SELECT pg_catalog.regexp_match( $1::pg_catalog.text, $2::pg_catalog.text, CASE WHEN pg_catalog.strpos($3, 'c') = 0 THEN  $3 || 'i' ELSE $3 END );\n",
    "system": false,
    "library": null,
    "language": "sql",
    "arguments": 3,
    "extension": "citext",
    "argumentTypes": [
      "public.citext",
      "public.citext",
      "pg_catalog.text"
    ],
    "extensionVersion": "1.6"
  },
  {
