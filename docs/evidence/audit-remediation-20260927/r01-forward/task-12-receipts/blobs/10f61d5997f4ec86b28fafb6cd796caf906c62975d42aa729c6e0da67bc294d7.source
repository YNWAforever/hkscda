  {
    "oid": 20622,
    "body": "CREATE OR REPLACE FUNCTION public.volunteer_daily_policy_command(p_actor uuid, p_command jsonb)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public', 'pg_temp'\nAS $function$\ndeclare command_action text:=p_command->>'action';binding public.volunteer_daily_policy_binding%rowtype;preview public.volunteer_daily_policy_preview%rowtype;\n prior public.volunteer_command_result%rowtype;candidate jsonb;q jsonb;rules jsonb;issues jsonb;key_name text;day_key text;day_date date;stamp timestamptz;\n used integer;visitors integer;new_id uuid;result jsonb;hash text:=md5(p_command::text);begin\n perform pg_advisory_xact_lock(hashtextextended('volunteer-domain',0));\n perform public.volunteer_policy_admin(p_actor);stamp:=clock_timestamp();\n if command_action='list' then\n  if p_command- 'action'<>'{}'::jsonb then raise exception 'invalid_daily_command' using errcode='22023';end if;\n  return jsonb_build_object('bindings',(select coalesce(jsonb_agg(jsonb_build_object('scope_key',d.scope_key,'service_date',d.service_date,'revision',d.revision,'body',d.body,'release_rules',d.release_rules,'timezone',d.timezone,\n   'policy_body',jsonb_set(jsonb_set(v.body,'{daily_limits}',coalesce((select jsonb_agg(value) from jsonb_array_elements(v.body->'daily_limits') where value->>'key'<>d.body->>'key'),'[]'::jsonb)||jsonb_build_array(d.body)),'{release_rules}',coalesce((select jsonb_agg(value) from jsonb_array_elements(v.body->'release_rules') where not(value#>>'{action,type}'='relax_quota' and value#>>'{action,quota}'=d.body->>'key' and value#>>'{action,scope}'=d.body->>'scope')),'[]'::jsonb)||d.release_rules),\n   'activities',(select coalesce(jsonb_agg(jsonb_build_object('id',a.id,'title',a.title,'starts_at',a.starts_at) order by a.starts_at),'[]'::jsonb) from public.volunteer_activity a where (a.starts_at at time zone d.timezone)::date=d.service_date and (split_part(d.scope_key,':',1)='all' or a.shelter_key=split_part(d.scope_key,':',1)))) order by d.service_date,d.scope_key),'[]'::jsonb)\n   from public.volunteer_daily_policy_binding d cross join lateral (select pv.body from public.volunteer_activity a join public.volunteer_policy_version pv on pv.id=a.policy_version_id where (a.starts_at at time zone d.timezone)::date=d.service_date and (split_part(d.scope_key,':',1)='all' or a.shelter_key=split_part(d.scope_key,':',1)) order by a.starts_at limit 1) v where d.service_date>=(stamp at time zone d.timezone)::date),\n   'credentials',(select coalesce(jsonb_agg(jsonb_build_object('key',c.key,'label',c.label) order by c.label),'[]'::jsonb) from public.volunteer_credential_definition c));\n elsif command_action='publish' then\n  for key_name in select jsonb_object_keys(p_command) loop if not key_name=any(array['action','preview_id','idempotency_key','reason']) then raise exception 'invalid_daily_command' using errcode='22023';end if;end loop;\n  if nullif(p_command->>'idempotency_key','') is null or nullif(trim(p_command->>'reason'),'') is null then raise exception 'invalid_daily_command' using errcode='22023';end if;\n  select * into prior from public.volunteer_command_result where actor_user_id=p_actor and operation='daily_publish' and idempotency_key=(p_command->>'idempotency_key')::uuid;\n  if found then if prior.payload_hash<>hash then return jsonb_build_object('kind','conflict','reason','idempotency_payload_changed');end if;return prior.result;end if;\n  select * into preview from public.volunteer_daily_policy_preview where id=(p_command->>'preview_id')::uuid and actor_user_id=p_actor for update;\n  if not found then return jsonb_build_object('kind','not_found');end if;\n  select * into binding from public.volunteer_daily_policy_binding where scope_key=preview.scope_key and service_date=preview.service_date for update;\n  if not found or binding.revision<>preview.expected_revision or preview.expires_at<=stamp or preview.fingerprint<>public.volunteer_daily_fingerprint(preview.scope_key,preview.service_date,preview.timezone,preview.release_rules,stamp) then return jsonb_build_object('kind','conflict');end if;\n  update public.volunteer_daily_policy_binding set body=preview.body,release_rules=preview.release_rules,revision=revision+1 where scope_key=preview.scope_key and service_date=preview.service_date returning revision into used;\n  insert into public.volunteer_daily_policy_history(scope_key,service_date,revision,before_body,body,release_rules,timezone,actor_user_id,reason) values(preview.scope_key,preview.service_date,used,binding.body,preview.body,preview.release_rules,preview.timezone,p_actor,p_command->>'reason') returning id into new_id;\n  insert into public.audit_log(actor_user_id,action,entity,entity_id,detail) values(p_actor,'volunteer_daily_policy.published','volunteer_daily_policy',new_id::text,jsonb_build_object('scope_key',preview.scope_key,'service_date',preview.service_date,'before',binding.body,'after',preview.body,'revision',used));\n  result:=jsonb_build_object('kind','published','revision',used,'scope_key',preview.scope_key,'service_date',preview.service_date);\n  insert into public.volunteer_command_result(actor_user_id,operation,idempotency_key,payload_hash,result) values(p_actor,'daily_publish',(p_command->>'idempotency_key')::uuid,hash,result);\n  return result;\n elsif command_action='preview' then\n  for key_name in select jsonb_object_keys(p_command) loop if not key_name=any(array['action','scope_key','service_date','expected_revision','body']) then raise exception 'invalid_daily_command' using errcode='22023';end if;end loop;\n  day_key:=p_command->>'scope_key';day_date:=(p_command->>'service_date')::date;candidate:=p_command->'body';\n  issues:=public.volunteer_validate_policy(candidate);if jsonb_array_length(issues)>0 then return jsonb_build_object('kind','invalid','issues',issues);end if;\n  select * into binding from public.volunteer_daily_policy_binding where scope_key=day_key and service_date=day_date for update;\n  if not found then return jsonb_build_object('kind','not_found');end if;\n  if binding.revision is distinct from (p_command->>'expected_revision')::bigint then return jsonb_build_object('kind','conflict','revision',binding.revision);end if;\n  if day_date<(stamp at time zone binding.timezone)::date or candidate->>'timezone'<>binding.timezone then return jsonb_build_object('kind','invalid','reason','historical_or_timezone_change');end if;\n  select value into q from jsonb_array_elements(candidate->'daily_limits') where (case when value->>'scope'='all_shelters_day' then 'all' else candidate->>'shelter' end||':'||(value->>'key'))=day_key;\n  if q is null then return jsonb_build_object('kind','invalid','reason','daily_scope_missing');end if;\n  select coalesce(jsonb_agg(value order by (value->>'priority')::integer),'[]'::jsonb) into rules from jsonb_array_elements(candidate->'release_rules') where value#>>'{action,type}'='relax_quota' and value#>>'{action,scope}'=q->>'scope' and value#>>'{action,quota}'=q->>'key';\n  select case when q->>'count_mode'='distinct_people' then count(distinct b.profile_id) else count(*) end into used from public.volunteer_registration b join public.volunteer_activity a on a.id=b.activity_id join public.volunteer_profile v on v.id=b.profile_id where b.status='approved' and (a.starts_at at time zone binding.timezone)::date=day_date and (split_part(day_key,':',1)='all' or a.shelter_key=split_part(day_key,':',1)) and q->'tiers' ? v.tier;\n  if (q->>'include_group_visitors')::boolean then select coalesce(sum(a.group_headcount),0) into visitors from public.volunteer_activity a where a.status='published' and (a.starts_at at time zone binding.timezone)::date=day_date and (split_part(day_key,':',1)='all' or a.shelter_key=split_part(day_key,':',1));used:=used+visitors;end if;\n  if q#>>'{maximum,state}'='value' and used>(q#>>'{maximum,value}')::integer then return jsonb_build_object('kind','invalid','reason','daily_capacity_below_occupancy','occupied',used);end if;\n  insert into public.volunteer_daily_policy_preview(scope_key,service_date,expected_revision,body,release_rules,timezone,actor_user_id,fingerprint,expires_at) values(day_key,day_date,binding.revision,q,rules,binding.timezone,p_actor,public.volunteer_daily_fingerprint(day_key,day_date,binding.timezone,rules,stamp),stamp+interval '5 minutes') returning id into new_id;\n  return jsonb_build_object('kind','preview','preview_id',new_id,'occupied',used,'before',binding.body,'after',q,'scope_key',day_key,'service_date',day_date,'activity_ids',(select coalesce(jsonb_agg(a.id order by a.id),'[]'::jsonb) from public.volunteer_activity a where (a.starts_at at time zone binding.timezone)::date=day_date and (split_part(day_key,':',1)='all' or a.shelter_key=split_part(day_key,':',1))));\n else raise exception 'invalid_daily_command' using errcode='22023';end if;\nend $function$\n",
    "name": "volunteer_daily_policy_command",
    "owner": "postgres",
    "config": [
      "search_path=public, pg_temp"
    ],
    "result": "jsonb",
    "schema": "public",
    "source": "\ndeclare command_action text:=p_command->>'action';binding public.volunteer_daily_policy_binding%rowtype;preview public.volunteer_daily_policy_preview%rowtype;\n prior public.volunteer_command_result%rowtype;candidate jsonb;q jsonb;rules jsonb;issues jsonb;key_name text;day_key text;day_date date;stamp timestamptz;\n used integer;visitors integer;new_id uuid;result jsonb;hash text:=md5(p_command::text);begin\n perform pg_advisory_xact_lock(hashtextextended('volunteer-domain',0));\n perform public.volunteer_policy_admin(p_actor);stamp:=clock_timestamp();\n if command_action='list' then\n  if p_command- 'action'<>'{}'::jsonb then raise exception 'invalid_daily_command' using errcode='22023';end if;\n  return jsonb_build_object('bindings',(select coalesce(jsonb_agg(jsonb_build_object('scope_key',d.scope_key,'service_date',d.service_date,'revision',d.revision,'body',d.body,'release_rules',d.release_rules,'timezone',d.timezone,\n   'policy_body',jsonb_set(jsonb_set(v.body,'{daily_limits}',coalesce((select jsonb_agg(value) from jsonb_array_elements(v.body->'daily_limits') where value->>'key'<>d.body->>'key'),'[]'::jsonb)||jsonb_build_array(d.body)),'{release_rules}',coalesce((select jsonb_agg(value) from jsonb_array_elements(v.body->'release_rules') where not(value#>>'{action,type}'='relax_quota' and value#>>'{action,quota}'=d.body->>'key' and value#>>'{action,scope}'=d.body->>'scope')),'[]'::jsonb)||d.release_rules),\n   'activities',(select coalesce(jsonb_agg(jsonb_build_object('id',a.id,'title',a.title,'starts_at',a.starts_at) order by a.starts_at),'[]'::jsonb) from public.volunteer_activity a where (a.starts_at at time zone d.timezone)::date=d.service_date and (split_part(d.scope_key,':',1)='all' or a.shelter_key=split_part(d.scope_key,':',1)))) order by d.service_date,d.scope_key),'[]'::jsonb)\n   from public.volunteer_daily_policy_binding d cross join lateral (select pv.body from public.volunteer_activity a join public.volunteer_policy_version pv on pv.id=a.policy_version_id where (a.starts_at at time zone d.timezone)::date=d.service_date and (split_part(d.scope_key,':',1)='all' or a.shelter_key=split_part(d.scope_key,':',1)) order by a.starts_at limit 1) v where d.service_date>=(stamp at time zone d.timezone)::date),\n   'credentials',(select coalesce(jsonb_agg(jsonb_build_object('key',c.key,'label',c.label) order by c.label),'[]'::jsonb) from public.volunteer_credential_definition c));\n elsif command_action='publish' then\n  for key_name in select jsonb_object_keys(p_command) loop if not key_name=any(array['action','preview_id','idempotency_key','reason']) then raise exception 'invalid_daily_command' using errcode='22023';end if;end loop;\n  if nullif(p_command->>'idempotency_key','') is null or nullif(trim(p_command->>'reason'),'') is null then raise exception 'invalid_daily_command' using errcode='22023';end if;\n  select * into prior from public.volunteer_command_result where actor_user_id=p_actor and operation='daily_publish' and idempotency_key=(p_command->>'idempotency_key')::uuid;\n  if found then if prior.payload_hash<>hash then return jsonb_build_object('kind','conflict','reason','idempotency_payload_changed');end if;return prior.result;end if;\n  select * into preview from public.volunteer_daily_policy_preview where id=(p_command->>'preview_id')::uuid and actor_user_id=p_actor for update;\n  if not found then return jsonb_build_object('kind','not_found');end if;\n  select * into binding from public.volunteer_daily_policy_binding where scope_key=preview.scope_key and service_date=preview.service_date for update;\n  if not found or binding.revision<>preview.expected_revision or preview.expires_at<=stamp or preview.fingerprint<>public.volunteer_daily_fingerprint(preview.scope_key,preview.service_date,preview.timezone,preview.release_rules,stamp) then return jsonb_build_object('kind','conflict');end if;\n  update public.volunteer_daily_policy_binding set body=preview.body,release_rules=preview.release_rules,revision=revision+1 where scope_key=preview.scope_key and service_date=preview.service_date returning revision into used;\n  insert into public.volunteer_daily_policy_history(scope_key,service_date,revision,before_body,body,release_rules,timezone,actor_user_id,reason) values(preview.scope_key,preview.service_date,used,binding.body,preview.body,preview.release_rules,preview.timezone,p_actor,p_command->>'reason') returning id into new_id;\n  insert into public.audit_log(actor_user_id,action,entity,entity_id,detail) values(p_actor,'volunteer_daily_policy.published','volunteer_daily_policy',new_id::text,jsonb_build_object('scope_key',preview.scope_key,'service_date',preview.service_date,'before',binding.body,'after',preview.body,'revision',used));\n  result:=jsonb_build_object('kind','published','revision',used,'scope_key',preview.scope_key,'service_date',preview.service_date);\n  insert into public.volunteer_command_result(actor_user_id,operation,idempotency_key,payload_hash,result) values(p_actor,'daily_publish',(p_command->>'idempotency_key')::uuid,hash,result);\n  return result;\n elsif command_action='preview' then\n  for key_name in select jsonb_object_keys(p_command) loop if not key_name=any(array['action','scope_key','service_date','expected_revision','body']) then raise exception 'invalid_daily_command' using errcode='22023';end if;end loop;\n  day_key:=p_command->>'scope_key';day_date:=(p_command->>'service_date')::date;candidate:=p_command->'body';\n  issues:=public.volunteer_validate_policy(candidate);if jsonb_array_length(issues)>0 then return jsonb_build_object('kind','invalid','issues',issues);end if;\n  select * into binding from public.volunteer_daily_policy_binding where scope_key=day_key and service_date=day_date for update;\n  if not found then return jsonb_build_object('kind','not_found');end if;\n  if binding.revision is distinct from (p_command->>'expected_revision')::bigint then return jsonb_build_object('kind','conflict','revision',binding.revision);end if;\n  if day_date<(stamp at time zone binding.timezone)::date or candidate->>'timezone'<>binding.timezone then return jsonb_build_object('kind','invalid','reason','historical_or_timezone_change');end if;\n  select value into q from jsonb_array_elements(candidate->'daily_limits') where (case when value->>'scope'='all_shelters_day' then 'all' else candidate->>'shelter' end||':'||(value->>'key'))=day_key;\n  if q is null then return jsonb_build_object('kind','invalid','reason','daily_scope_missing');end if;\n  select coalesce(jsonb_agg(value order by (value->>'priority')::integer),'[]'::jsonb) into rules from jsonb_array_elements(candidate->'release_rules') where value#>>'{action,type}'='relax_quota' and value#>>'{action,scope}'=q->>'scope' and value#>>'{action,quota}'=q->>'key';\n  select case when q->>'count_mode'='distinct_people' then count(distinct b.profile_id) else count(*) end into used from public.volunteer_registration b join public.volunteer_activity a on a.id=b.activity_id join public.volunteer_profile v on v.id=b.profile_id where b.status='approved' and (a.starts_at at time zone binding.timezone)::date=day_date and (split_part(day_key,':',1)='all' or a.shelter_key=split_part(day_key,':',1)) and q->'tiers' ? v.tier;\n  if (q->>'include_group_visitors')::boolean then select coalesce(sum(a.group_headcount),0) into visitors from public.volunteer_activity a where a.status='published' and (a.starts_at at time zone binding.timezone)::date=day_date and (split_part(day_key,':',1)='all' or a.shelter_key=split_part(day_key,':',1));used:=used+visitors;end if;\n  if q#>>'{maximum,state}'='value' and used>(q#>>'{maximum,value}')::integer then return jsonb_build_object('kind','invalid','reason','daily_capacity_below_occupancy','occupied',used);end if;\n  insert into public.volunteer_daily_policy_preview(scope_key,service_date,expected_revision,body,release_rules,timezone,actor_user_id,fingerprint,expires_at) values(day_key,day_date,binding.revision,q,rules,binding.timezone,p_actor,public.volunteer_daily_fingerprint(day_key,day_date,binding.timezone,rules,stamp),stamp+interval '5 minutes') returning id into new_id;\n  return jsonb_build_object('kind','preview','preview_id',new_id,'occupied',used,'before',binding.body,'after',q,'scope_key',day_key,'service_date',day_date,'activity_ids',(select coalesce(jsonb_agg(a.id order by a.id),'[]'::jsonb) from public.volunteer_activity a where (a.starts_at at time zone binding.timezone)::date=day_date and (split_part(day_key,':',1)='all' or a.shelter_key=split_part(day_key,':',1))));\n else raise exception 'invalid_daily_command' using errcode='22023';end if;\nend ",
