    "body": "CREATE OR REPLACE FUNCTION auth.uid()\n RETURNS uuid\n LANGUAGE sql\n STABLE\nAS $function$\n  select \n  coalesce(\n    nullif(current_setting('request.jwt.claim.sub', true), ''),\n    (nullif(current_setting('request.jwt.claims', true), '')::jsonb ->> 'sub')\n  )::uuid\n$function$\n",
    "name": "uid",
    "owner": "supabase_auth_admin",
    "config": null,
    "result": "uuid",
    "schema": "auth",
    "source": "\n  select \n  coalesce(\n    nullif(current_setting('request.jwt.claim.sub', true), ''),\n    (nullif(current_setting('request.jwt.claims', true), '')::jsonb ->> 'sub')\n  )::uuid\n",
    "system": false,
    "library": null,
    "language": "sql",
    "arguments": 0,
    "extension": null,
    "argumentTypes": [],
    "extensionVersion": null
