  {
    "oid": 21051,
    "body": "CREATE OR REPLACE FUNCTION public.record_sponsorship_receipt_request(p_actor uuid, p_proof uuid)\n RETURNS uuid\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public', 'pg_temp'\nAS $function$\ndeclare v_source public.sponsorship_payment_source%rowtype;v_pledge uuid;v_changed integer;\nbegin\n if not exists(select 1 from public.admin_user where auth_user_id=p_actor and status='active' and role in ('admin','treasurer')) then raise exception 'Finance role required' using errcode='42501'; end if;\n select pledge_id into v_pledge from public.sponsorship_payment_proof where id=p_proof;\n perform 1 from public.sponsorship_pledge where id=v_pledge for update;\n select * into v_source from public.sponsorship_payment_source where proof_id=p_proof;\n if not found then raise exception 'Reconcile the received payment first'; end if;\n update public.donation set receipt_requested=true where id=v_source.donation_id and status='succeeded' and not receipt_requested;\n get diagnostics v_changed=row_count;\n if v_changed>0 then insert into public.audit_log(actor_user_id,action,entity,entity_id,detail) values(p_actor,'sponsorship_pledge.receipt_requested','sponsorship_pledge',v_pledge::text,jsonb_build_object('proofId',p_proof,'donationId',v_source.donation_id,'source','staff_recorded_supporter_request'));end if;\n return v_source.donation_id;\nend; $function$\n",
    "name": "record_sponsorship_receipt_request",
    "owner": "postgres",
    "config": [
      "search_path=public, pg_temp"
    ],
    "result": "uuid",
    "schema": "public",
    "source": "\ndeclare v_source public.sponsorship_payment_source%rowtype;v_pledge uuid;v_changed integer;\nbegin\n if not exists(select 1 from public.admin_user where auth_user_id=p_actor and status='active' and role in ('admin','treasurer')) then raise exception 'Finance role required' using errcode='42501'; end if;\n select pledge_id into v_pledge from public.sponsorship_payment_proof where id=p_proof;\n perform 1 from public.sponsorship_pledge where id=v_pledge for update;\n select * into v_source from public.sponsorship_payment_source where proof_id=p_proof;\n if not found then raise exception 'Reconcile the received payment first'; end if;\n update public.donation set receipt_requested=true where id=v_source.donation_id and status='succeeded' and not receipt_requested;\n get diagnostics v_changed=row_count;\n if v_changed>0 then insert into public.audit_log(actor_user_id,action,entity,entity_id,detail) values(p_actor,'sponsorship_pledge.receipt_requested','sponsorship_pledge',v_pledge::text,jsonb_build_object('proofId',p_proof,'donationId',v_source.donation_id,'source','staff_recorded_supporter_request'));end if;\n return v_source.donation_id;\nend; ",
    "system": false,
    "library": null,
    "language": "plpgsql",
    "arguments": 2,
    "extension": null,
    "argumentTypes": [
      "pg_catalog.uuid",
      "pg_catalog.uuid"
    ],
    "extensionVersion": null
  },
