    "oid": 19895,
    "body": "CREATE OR REPLACE FUNCTION private.require_content_actor(p_actor_user_id uuid)\n RETURNS public.admin_user\n LANGUAGE plpgsql\n STABLE\n SET search_path TO 'public', 'pg_temp'\nAS $function$\ndeclare actor public.admin_user%rowtype;\nbegin\n  select * into actor from public.admin_user\n  where auth_user_id = p_actor_user_id and status = 'active' and role in ('staff', 'admin');\n  if not found then raise exception 'Active staff or admin actor required' using errcode = '42501'; end if;\n  return actor;\nend\n$function$\n",
    "name": "require_content_actor",
    "owner": "postgres",
    "config": [
      "search_path=public, pg_temp"
    ],
    "result": "public.admin_user",
    "schema": "private",
    "source": "\ndeclare actor public.admin_user%rowtype;\nbegin\n  select * into actor from public.admin_user\n  where auth_user_id = p_actor_user_id and status = 'active' and role in ('staff', 'admin');\n  if not found then raise exception 'Active staff or admin actor required' using errcode = '42501'; end if;\n  return actor;\nend\n",
    "system": false,
    "library": null,
    "language": "plpgsql",
    "arguments": 1,
    "extension": null,
    "argumentTypes": [
      "pg_catalog.uuid"
    ],
    "extensionVersion": null
