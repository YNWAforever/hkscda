    "oid": 20577,
    "body": "CREATE OR REPLACE FUNCTION public.volunteer_policy_json_schema()\n RETURNS jsonb\n LANGUAGE sql\n IMMUTABLE\n SET search_path TO 'public', 'pg_temp'\nAS $function$\n select $policy_schema${\"type\":\"object\",\"properties\":{\"schema_version\":{\"const\":1},\"template_key\":{\"type\":\"string\",\"pattern\":\"^[a-z][a-z0-9_-]{0,79}$\"},\"name\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":150},\"shelter\":{\"type\":\"string\",\"pattern\":\"^[a-z][a-z0-9_-]{0,79}$\"},\"inheritance\":{\"type\":\"array\",\"items\":{\"type\":\"string\",\"enum\":[\"timezone\",\"schedule\",\"schedule.start_time\",\"schedule.end_time\",\"schedule.weekdays\",\"schedule.location\",\"schedule.effective_from\",\"schedule.effective_until\",\"schedule.excluded_dates\",\"schedule.enabled\",\"schedule.generation_days\",\"capacity\",\"capacity.volunteers\",\"capacity.visitors\",\"capacity.shared_total\",\"capacity.group_in_shared_total\",\"capacity.group_size\",\"capacity.role_count_model\",\"eligibility\",\"eligibility.allowed_tiers\",\"eligibility.credentials\",\"eligibility.valid_at\",\"eligibility.min_age\",\"eligibility.missing_credentials_message\",\"roles\",\"tier_quotas\",\"daily_limits\",\"release_rules\",\"booking\",\"booking.individual_open\",\"booking.individual_close\",\"booking.group_open\",\"booking.group_close\",\"booking.group_freeze\",\"booking.late_group_change\",\"booking.scenario\",\"booking.scenario_templates\",\"booking.auto_approve\",\"booking.allow_waitlist\",\"booking.waitlist_limit\",\"booking.cancellation_close\",\"remarks\",\"remarks.label\",\"remarks.hint\",\"remarks.required\",\"remarks.max_length\",\"remarks.allow_free_text\",\"remarks.options\",\"terms\",\"terms.version_id\",\"terms.reconsent\"]},\"maxItems\":60},\"timezone\":{\"type\":\"string\",\"maxLength\":100},\"schedule\":{\"type\":\"object\",\"properties\":{\"start_time\":{\"anyOf\":[{\"type\":\"string\",\"pattern\":\"^([01]\\\\d|2[0-3]):[0-5]\\\\d$\"},{\"type\":\"object\",\"properties\":{\"state\":{\"const\":\"unresolved\"},\"reason\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":500},\"options\":{\"type\":\"array\",\"items\":{\"type\":\"string\",\"maxLength\":100},\"maxItems\":20}},\"required\":[\"state\",\"reason\"],\"additionalProperties\":false},{\"type\":\"object\",\"properties\":{\"state\":{\"const\":\"inherit\"}},\"required\":[\"state\"],\"additionalProperties\":false}]},\"end_time\":{\"anyOf\":[{\"type\":\"string\",\"pattern\":\"^([01]\\\\d|2[0-3]):[0-5]\\\\d$\"},{\"type\":\"object\",\"properties\":{\"state\":{\"const\":\"unresolved\"},\"reason\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":500},\"options\":{\"type\":\"array\",\"items\":{\"type\":\"string\",\"maxLength\":100},\"maxItems\":20}},\"required\":[\"state\",\"reason\"],\"additionalProperties\":false},{\"type\":\"object\",\"properties\":{\"state\":{\"const\":\"inherit\"}},\"required\":[\"state\"],\"additionalProperties\":false}]},\"weekdays\":{\"anyOf\":[{\"type\":\"array\",\"items\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":6},\"minItems\":1,\"maxItems\":7},{\"type\":\"object\",\"properties\":{\"state\":{\"const\":\"unresolved\"},\"reason\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":500},\"options\":{\"type\":\"array\",\"items\":{\"type\":\"string\",\"maxLength\":100},\"maxItems\":20}},\"required\":[\"state\",\"reason\"],\"additionalProperties\":false},{\"type\":\"object\",\"properties\":{\"state\":{\"const\":\"inherit\"}},\"required\":[\"state\"],\"additionalProperties\":false}]},\"location\":{\"anyOf\":[{\"type\":\"string\",\"minLength\":1,\"maxLength\":200},{\"type\":\"object\",\"properties\":{\"state\":{\"const\":\"unresolved\"},\"reason\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":500},\"options\":{\"type\":\"array\",\"items\":{\"type\":\"string\",\"maxLength\":100},\"maxItems\":20}},\"required\":[\"state\",\"reason\"],\"additionalProperties\":false},{\"type\":\"object\",\"properties\":{\"state\":{\"const\":\"inherit\"}},\"required\":[\"state\"],\"additionalProperties\":false}]},\"effective_from\":{\"anyOf\":[{\"type\":\"string\",\"pattern\":\"^\\\\d{4}-\\\\d{2}-\\\\d{2}$\"},{\"type\":\"null\"}]},\"effective_until\":{\"anyOf\":[{\"type\":\"string\",\"pattern\":\"^\\\\d{4}-\\\\d{2}-\\\\d{2}$\"},{\"type\":\"null\"}]},\"excluded_dates\":{\"type\":\"array\",\"items\":{\"type\":\"string\",\"pattern\":\"^\\\\d{4}-\\\\d{2}-\\\\d{2}$\"},\"maxItems\":366},\"enabled\":{\"type\":\"boolean\"},\"generation_days\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":100000}},\"required\":[\"start_time\",\"end_time\",\"weekdays\",\"location\",\"effective_from\",\"effective_until\",\"excluded_dates\",\"enabled\",\"generation_days\"],\"additionalProperties\":false},\"capacity\":{\"type\":\"object\",\"properties\":{\"volunteers\":{\"anyOf\":[{\"type\":\"object\",\"properties\":{\"state\":{\"const\":\"value\"},\"value\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":100000}},\"required\":[\"state\",\"value\"],\"additionalProperties\":false},{\"type\":\"object\",\"properties\":{\"state\":{\"const\":\"unlimited\"}},\"required\":[\"state\"],\"additionalProperties\":false},{\"type\":\"object\",\"properties\":{\"state\":{\"const\":\"unresolved\"},\"reason\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":500},\"options\":{\"type\":\"array\",\"items\":{\"type\":\"string\",\"maxLength\":100},\"maxItems\":20}},\"required\":[\"state\",\"reason\"],\"additionalProperties\":false},{\"type\":\"object\",\"properties\":{\"state\":{\"const\":\"inherit\"}},\"required\":[\"state\"],\"additionalProperties\":false}]},\"visitors\":{\"anyOf\":[{\"type\":\"object\",\"properties\":{\"state\":{\"const\":\"value\"},\"value\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":100000}},\"required\":[\"state\",\"value\"],\"additionalProperties\":false},{\"type\":\"object\",\"properties\":{\"state\":{\"const\":\"unlimited\"}},\"required\":[\"state\"],\"additionalProperties\":false},{\"type\":\"object\",\"properties\":{\"state\":{\"const\":\"unresolved\"},\"re