  {
    "oid": 769,
    "body": "CREATE OR REPLACE FUNCTION pg_catalog.int4smaller(integer, integer)\n RETURNS integer\n LANGUAGE internal\n IMMUTABLE PARALLEL SAFE STRICT\nAS $function$int4smaller$function$\n",
