    "oid": 20938,
    "body": "CREATE OR REPLACE FUNCTION private.snapshot_sponsorship_proof_contact()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public', 'pg_temp'\nAS $function$\nbegin\n select jsonb_build_object('name',s.name,'email',s.email,'phone',s.phone,'language',p.language,'source','proof_recorded','capturedAt',clock_timestamp()) into new.contact_snapshot\n from public.sponsorship_pledge p join public.supporter s on s.id=p.supporter_id where p.id=new.pledge_id;\n return new;\nend; $function$\n",
    "name": "snapshot_sponsorship_proof_contact",
    "owner": "postgres",
    "config": [
      "search_path=public, pg_temp"
    ],
    "result": "trigger",
    "schema": "private",
    "source": "\nbegin\n select jsonb_build_object('name',s.name,'email',s.email,'phone',s.phone,'language',p.language,'source','proof_recorded','capturedAt',clock_timestamp()) into new.contact_snapshot\n from public.sponsorship_pledge p join public.supporter s on s.id=p.supporter_id where p.id=new.pledge_id;\n return new;\nend; ",
    "system": false,
    "library": null,
    "language": "plpgsql",
    "arguments": 0,
    "extension": null,
    "argumentTypes": [],
    "extensionVersion": null
