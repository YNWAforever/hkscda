  {
    "oid": 3524,
    "body": "CREATE OR REPLACE FUNCTION pg_catalog.enum_smaller(anyenum, anyenum)\n RETURNS anyenum\n LANGUAGE internal\n IMMUTABLE PARALLEL SAFE STRICT\nAS $function$enum_smaller$function$\n",
    "name": "enum_smaller",
    "owner": "supabase_admin",
    "config": null,
