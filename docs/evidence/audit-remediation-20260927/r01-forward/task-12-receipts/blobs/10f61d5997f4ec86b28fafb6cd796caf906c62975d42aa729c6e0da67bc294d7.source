    "body": "CREATE OR REPLACE FUNCTION pg_catalog.array_in(cstring, oid, integer)\n RETURNS anyarray\n LANGUAGE internal\n STABLE PARALLEL SAFE STRICT\nAS $function$array_in$function$\n",
