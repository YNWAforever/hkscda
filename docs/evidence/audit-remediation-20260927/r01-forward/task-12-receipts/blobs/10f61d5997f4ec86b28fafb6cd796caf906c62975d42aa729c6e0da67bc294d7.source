  {
    "oid": 20723,
    "body": "CREATE OR REPLACE FUNCTION public.finish_volunteer_runtime_job(p_job_key text, p_bucket timestamp with time zone, p_owner uuid, p_status text, p_result jsonb)\n RETURNS boolean\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public', 'pg_temp'\nAS $function$\ndeclare n int;begin if p_status not in('complete','failed') then raise exception 'invalid job status' using errcode='22023';end if;update public.volunteer_runtime_job_run set status=p_status,result=p_result,lease_until=null,lease_owner=null,updated_at=clock_timestamp() where job_key=p_job_key and bucket=p_bucket and status='running' and lease_owner=p_owner and lease_until>=clock_timestamp();get diagnostics n=row_count;return n=1;end $function$\n",
    "name": "finish_volunteer_runtime_job",
    "owner": "postgres",
    "config": [
      "search_path=public, pg_temp"
    ],
    "result": "boolean",
    "schema": "public",
    "source": "\ndeclare n int;begin if p_status not in('complete','failed') then raise exception 'invalid job status' using errcode='22023';end if;update public.volunteer_runtime_job_run set status=p_status,result=p_result,lease_until=null,lease_owner=null,updated_at=clock_timestamp() where job_key=p_job_key and bucket=p_bucket and status='running' and lease_owner=p_owner and lease_until>=clock_timestamp();get diagnostics n=row_count;return n=1;end ",
    "system": false,
    "library": null,
    "language": "plpgsql",
    "arguments": 5,
    "extension": null,
    "argumentTypes": [
      "pg_catalog.text",
      "pg_catalog.timestamptz",
      "pg_catalog.uuid",
      "pg_catalog.text",
      "pg_catalog.jsonb"
    ],
    "extensionVersion": null
  },
  {
    "oid": 17005,
    "body": "CREATE OR REPLACE FUNCTION storage.foldername(name text)\n RETURNS text[]\n LANGUAGE plpgsql\n IMMUTABLE\nAS $function$\nDECLARE\n    _parts text[];\nBEGIN\n    -- Split on \"/\" to get path segments\n    SELECT string_to_array(name, '/') INTO _parts;\n    -- Return everything except the last segment\n    RETURN _parts[1 : array_length(_parts,1) - 1];\nEND\n$function$\n",
    "name": "foldername",
    "owner": "supabase_storage_admin",
    "config": null,
    "result": "text[]",
    "schema": "storage",
    "source": "\nDECLARE\n    _parts text[];\nBEGIN\n    -- Split on \"/\" to get path segments\n    SELECT string_to_array(name, '/') INTO _parts;\n    -- Return everything except the last segment\n    RETURN _parts[1 : array_length(_parts,1) - 1];\nEND\n",
    "system": false,
    "library": null,
    "language": "plpgsql",
    "arguments": 1,
    "extension": null,
    "argumentTypes": [
      "pg_catalog.text"
    ],
    "extensionVersion": null
  },
