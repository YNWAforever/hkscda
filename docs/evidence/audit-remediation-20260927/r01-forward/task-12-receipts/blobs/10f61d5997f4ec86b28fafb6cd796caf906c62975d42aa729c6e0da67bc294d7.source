  {
    "oid": 840,
    "body": "CREATE OR REPLACE FUNCTION pg_catalog.int82div(bigint, smallint)\n RETURNS bigint\n LANGUAGE internal\n IMMUTABLE PARALLEL SAFE STRICT\nAS $function$int82div$function$\n",
