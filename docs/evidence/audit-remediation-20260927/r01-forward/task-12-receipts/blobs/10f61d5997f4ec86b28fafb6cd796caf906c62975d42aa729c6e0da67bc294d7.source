    "oid": 2172,
    "body": "CREATE OR REPLACE FUNCTION pg_catalog.pg_backup_start(label text, fast boolean DEFAULT false)\n RETURNS pg_lsn\n LANGUAGE internal\n PARALLEL RESTRICTED STRICT\nAS $function$pg_backup_start$function$\n",
