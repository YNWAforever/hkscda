  {
    "oid": 13270,
    "body": "CREATE OR REPLACE FUNCTION information_schema._pg_char_max_length(typid oid, typmod integer)\n RETURNS integer\n LANGUAGE sql\n IMMUTABLE PARALLEL SAFE STRICT\nRETURN CASE WHEN (typmod = '-1'::integer) THEN NULL::integer WHEN (typid = ANY (ARRAY[(1042)::oid, (1043)::oid])) THEN (typmod - 4) WHEN (typid = ANY (ARRAY[(1560)::oid, (1562)::oid])) THEN typmod ELSE NULL::integer END\n",
    "name": "_pg_char_max_length",
    "owner": "supabase_admin",
    "config": null,
    "result": "integer",
    "schema": "information_schema",
    "source": "",
    "system": false,
    "library": null,
    "language": "sql",
    "arguments": 2,
    "extension": null,
    "argumentTypes": [
      "pg_catalog.oid",
      "pg_catalog.int4"
    ],
    "extensionVersion": null
  },
  {
    "oid": 13267,
    "body": "CREATE OR REPLACE FUNCTION information_schema._pg_index_position(oid, smallint)\n RETURNS integer\n LANGUAGE sql\n STABLE STRICT\nBEGIN ATOMIC\n SELECT (ss.a).n AS n\n    FROM ( SELECT information_schema._pg_expandarray(pg_index.indkey) AS a\n            FROM pg_index\n           WHERE (pg_index.indexrelid = $1)) ss\n   WHERE ((ss.a).x = $2);\nEND\n",
    "name": "_pg_index_position",
    "owner": "supabase_admin",
    "config": null,
    "result": "integer",
    "schema": "information_schema",
    "source": "",
    "system": false,
    "library": null,
    "language": "sql",
    "arguments": 2,
    "extension": null,
    "argumentTypes": [
      "pg_catalog.oid",
      "pg_catalog.int2"
    ],
    "extensionVersion": null
  },
