  {
    "oid": 4567,
    "body": "CREATE OR REPLACE FUNCTION pg_catalog.pg_event_trigger_table_rewrite_reason()\n RETURNS integer\n LANGUAGE internal\n STABLE PARALLEL RESTRICTED STRICT\nAS $function$pg_event_trigger_table_rewrite_reason$function$\n",
