  {
    "oid": 17941,
    "body": "CREATE OR REPLACE FUNCTION public.replace(public.citext, public.citext, public.citext)\n RETURNS text\n LANGUAGE sql\n IMMUTABLE PARALLEL SAFE STRICT\nAS $function$\n    SELECT pg_catalog.regexp_replace( $1::pg_catalog.text, pg_catalog.regexp_replace($2::pg_catalog.text, '([^a-zA-Z_0-9])', E'\\\\\\\\\\\\1', 'g'), $3::pg_catalog.text, 'gi' );\n$function$\n",
    "name": "replace",
    "owner": "supabase_admin",
    "config": null,
    "result": "text",
    "schema": "public",
    "source": "\n    SELECT pg_catalog.regexp_replace( $1::pg_catalog.text, pg_catalog.regexp_replace($2::pg_catalog.text, '([^a-zA-Z_0-9])', E'\\\\\\\\\\\\1', 'g'), $3::pg_catalog.text, 'gi' );\n",
    "system": false,
    "library": null,
    "language": "sql",
    "arguments": 3,
    "extension": "citext",
    "argumentTypes": [
      "public.citext",
      "public.citext",
      "public.citext"
    ],
    "extensionVersion": "1.6"
  },
  {
    "oid": 17942,
    "body": "CREATE OR REPLACE FUNCTION public.split_part(public.citext, public.citext, integer)\n RETURNS text\n LANGUAGE sql\n IMMUTABLE PARALLEL SAFE STRICT\nAS $function$\n    SELECT (pg_catalog.regexp_split_to_array( $1::pg_catalog.text, pg_catalog.regexp_replace($2::pg_catalog.text, '([^a-zA-Z_0-9])', E'\\\\\\\\\\\\1', 'g'), 'i'))[$3];\n$function$\n",
    "name": "split_part",
    "owner": "supabase_admin",
    "config": null,
    "result": "text",
    "schema": "public",
    "source": "\n    SELECT (pg_catalog.regexp_split_to_array( $1::pg_catalog.text, pg_catalog.regexp_replace($2::pg_catalog.text, '([^a-zA-Z_0-9])', E'\\\\\\\\\\\\1', 'g'), 'i'))[$3];\n",
    "system": false,
    "library": null,
    "language": "sql",
    "arguments": 3,
    "extension": "citext",
    "argumentTypes": [
      "public.citext",
      "public.citext",
      "pg_catalog.int4"
    ],
    "extensionVersion": "1.6"
  },
  {
    "oid": 17943,
    "body": "CREATE OR REPLACE FUNCTION public.translate(public.citext, public.citext, text)\n RETURNS text\n LANGUAGE sql\n IMMUTABLE PARALLEL SAFE STRICT\nAS $function$\n    SELECT pg_catalog.translate( pg_catalog.translate( $1::pg_catalog.text, pg_catalog.lower($2::pg_catalog.text), $3), pg_catalog.upper($2::pg_catalog.text), $3);\n$function$\n",
    "name": "translate",
    "owner": "supabase_admin",
    "config": null,
    "result": "text",
    "schema": "public",
    "source": "\n    SELECT pg_catalog.translate( pg_catalog.translate( $1::pg_catalog.text, pg_catalog.lower($2::pg_catalog.text), $3), pg_catalog.upper($2::pg_catalog.text), $3);\n",
    "system": false,
    "library": null,
    "language": "sql",
    "arguments": 3,
    "extension": "citext",
    "argumentTypes": [
