  {
    "oid": 16834,
    "body": "CREATE OR REPLACE FUNCTION realtime.build_prepared_statement_sql(prepared_statement_name text, entity regclass, columns realtime.wal_column[])\n RETURNS text\n LANGUAGE sql\nAS $function$\n      /*\n      Builds a sql string that, if executed, creates a prepared statement to\n      tests retrive a row from *entity* by its primary key columns.\n      Example\n          select realtime.build_prepared_statement_sql('public.notes', '{\"id\"}'::text[], '{\"bigint\"}'::text[])\n      */\n          select\n      'prepare ' || prepared_statement_name || ' as\n          select\n              exists(\n                  select\n                      1\n                  from\n                      ' || entity || '\n                  where\n                      ' || string_agg(quote_ident(pkc.name) || '=' || quote_nullable(pkc.value #>> '{}') , ' and ') || '\n              )'\n          from\n              unnest(columns) pkc\n          where\n              pkc.is_pkey\n          group by\n              entity\n      $function$\n",
    "name": "build_prepared_statement_sql",
    "owner": "supabase_realtime_admin",
    "config": null,
    "result": "text",
    "schema": "realtime",
    "source": "\n      /*\n      Builds a sql string that, if executed, creates a prepared statement to\n      tests retrive a row from *entity* by its primary key columns.\n      Example\n          select realtime.build_prepared_statement_sql('public.notes', '{\"id\"}'::text[], '{\"bigint\"}'::text[])\n      */\n          select\n      'prepare ' || prepared_statement_name || ' as\n          select\n              exists(\n                  select\n                      1\n                  from\n                      ' || entity || '\n                  where\n                      ' || string_agg(quote_ident(pkc.name) || '=' || quote_nullable(pkc.value #>> '{}') , ' and ') || '\n              )'\n          from\n              unnest(columns) pkc\n          where\n              pkc.is_pkey\n          group by\n              entity\n      ",
    "system": false,
    "library": null,
    "language": "sql",
    "arguments": 3,
    "extension": null,
    "argumentTypes": [
      "pg_catalog.text",
      "pg_catalog.regclass",
      "realtime._wal_column"
    ],
    "extensionVersion": null
  },
  {
    "oid": 21600,
    "body": "CREATE OR REPLACE FUNCTION private.enforce_published_site_document_slot_asset()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\nbegin\n  if new.is_published then\n    perform 1\n    from public.document_assets\n    where id = new.document_asset_id\n      and is_published = true\n    for update;\n\n    if not found then\n      raise exception 'Publish the PDF asset before publishing its site document slot'\n        using errcode = '23514';\n    end if;\n  end if;\n  return new;\nend;\n$function$\n",
    "name": "enforce_published_site_document_slot_asset",
    "owner": "postgres",
    "config": [
      "search_path=\"\""
    ],
    "result": "trigger",
    "schema": "private",
    "source": "\nbegin\n  if new.is_published then\n    perform 1\n    from public.document_assets\n    where id = new.document_asset_id\n      and is_published = true\n    for update;\n\n    if not found then\n      raise exception 'Publish the PDF asset before publishing its site document slot'\n        using errcode = '23514';\n    end if;\n  end if;\n  return new;\nend;\n",
    "system": false,
    "library": null,
    "language": "plpgsql",
    "arguments": 0,
    "extension": null,
    "argumentTypes": [],
    "extensionVersion": null
  },
