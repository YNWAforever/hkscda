  {
    "oid": 21828,
    "body": "CREATE OR REPLACE FUNCTION private.crm_export_actor_allowed(p_actor uuid)\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'public', 'pg_temp'\nAS $function$\n  select exists(\n    select 1 from public.admin_user a join auth.users u on u.id=a.auth_user_id\n    where a.auth_user_id=p_actor and a.status='active' and a.role in ('treasurer','admin')\n      and u.email_confirmed_at is not null\n      and (u.banned_until is null or u.banned_until<=clock_timestamp())\n  );\n$function$\n",
    "name": "crm_export_actor_allowed",
    "owner": "postgres",
    "config": [
      "search_path=public, pg_temp"
    ],
    "result": "boolean",
    "schema": "private",
    "source": "\n  select exists(\n    select 1 from public.admin_user a join auth.users u on u.id=a.auth_user_id\n    where a.auth_user_id=p_actor and a.status='active' and a.role in ('treasurer','admin')\n      and u.email_confirmed_at is not null\n      and (u.banned_until is null or u.banned_until<=clock_timestamp())\n  );\n",
    "system": false,
    "library": null,
    "language": "sql",
    "arguments": 1,
    "extension": null,
    "argumentTypes": [
      "pg_catalog.uuid"
    ],
    "extensionVersion": null
  },
