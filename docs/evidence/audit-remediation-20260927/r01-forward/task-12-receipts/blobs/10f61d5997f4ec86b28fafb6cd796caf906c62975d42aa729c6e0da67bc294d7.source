  {
    "oid": 20586,
    "body": "CREATE OR REPLACE FUNCTION public.volunteer_bind_daily_policy(p_body jsonb, p_date date)\n RETURNS void\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public', 'pg_temp'\nAS $function$\ndeclare q jsonb;rules jsonb;binding public.volunteer_daily_policy_binding%rowtype;day_key text;begin\n perform pg_advisory_xact_lock(hashtextextended('volunteer-domain',0));\n if jsonb_array_length(public.volunteer_validate_policy(p_body))>0 then raise exception 'invalid_daily_policy' using errcode='22023';end if;\n for q in select value from jsonb_array_elements(p_body->'daily_limits') loop\n  day_key:=case when q->>'scope'='all_shelters_day' then 'all' else p_body->>'shelter' end||':'||(q->>'key');\n  select coalesce(jsonb_agg(value order by (value->>'priority')::integer),'[]'::jsonb) into rules from jsonb_array_elements(p_body->'release_rules') where value#>>'{action,type}'='relax_quota' and value#>>'{action,scope}'=q->>'scope' and value#>>'{action,quota}'=q->>'key';\n  insert into public.volunteer_daily_policy_binding(scope_key,service_date,body,release_rules,timezone,source_body,source_release_rules) values(day_key,p_date,q,rules,p_body->>'timezone',q,rules) on conflict do nothing;\n  select * into binding from public.volunteer_daily_policy_binding where scope_key=day_key and service_date=p_date for update;\n  if binding.timezone<>p_body->>'timezone' or not ((binding.body=q and binding.release_rules=rules) or (binding.source_body=q and binding.source_release_rules=rules)) then raise exception 'daily_scope_requires_review' using errcode='22023';end if;\n end loop;\nend $function$\n",
    "name": "volunteer_bind_daily_policy",
    "owner": "postgres",
    "config": [
      "search_path=public, pg_temp"
    ],
    "result": "void",
    "schema": "public",
    "source": "\ndeclare q jsonb;rules jsonb;binding public.volunteer_daily_policy_binding%rowtype;day_key text;begin\n perform pg_advisory_xact_lock(hashtextextended('volunteer-domain',0));\n if jsonb_array_length(public.volunteer_validate_policy(p_body))>0 then raise exception 'invalid_daily_policy' using errcode='22023';end if;\n for q in select value from jsonb_array_elements(p_body->'daily_limits') loop\n  day_key:=case when q->>'scope'='all_shelters_day' then 'all' else p_body->>'shelter' end||':'||(q->>'key');\n  select coalesce(jsonb_agg(value order by (value->>'priority')::integer),'[]'::jsonb) into rules from jsonb_array_elements(p_body->'release_rules') where value#>>'{action,type}'='relax_quota' and value#>>'{action,scope}'=q->>'scope' and value#>>'{action,quota}'=q->>'key';\n  insert into public.volunteer_daily_policy_binding(scope_key,service_date,body,release_rules,timezone,source_body,source_release_rules) values(day_key,p_date,q,rules,p_body->>'timezone',q,rules) on conflict do nothing;\n  select * into binding from public.volunteer_daily_policy_binding where scope_key=day_key and service_date=p_date for update;\n  if binding.timezone<>p_body->>'timezone' or not ((binding.body=q and binding.release_rules=rules) or (binding.source_body=q and binding.source_release_rules=rules)) then raise exception 'daily_scope_requires_review' using errcode='22023';end if;\n end loop;\nend ",
    "system": false,
    "library": null,
    "language": "plpgsql",
    "arguments": 2,
    "extension": null,
    "argumentTypes": [
      "pg_catalog.jsonb",
      "pg_catalog.date"
    ],
    "extensionVersion": null
  },
