  {
    "oid": 21050,
    "body": "CREATE OR REPLACE FUNCTION public.record_exact_sponsorship_payment_proof(p_actor uuid, p_pledge uuid, p_key uuid, p_payment jsonb)\n RETURNS uuid\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public', 'pg_temp'\nAS $function$\ndeclare v_prior public.sponsorship_proof_submission_command%rowtype;v_id uuid;v_status text;\nbegin\n if not exists(select 1 from public.admin_user where auth_user_id=p_actor and status='active' and role in ('admin','staff')) then raise exception 'Coordinator required' using errcode='42501'; end if;\n if p_key is null then raise exception 'Submission idempotency key required'; end if;\n perform 1 from public.sponsorship_pledge where id=p_pledge for update;\n perform pg_advisory_xact_lock(hashtextextended(p_actor::text||p_key::text,713));\n select * into v_prior from public.sponsorship_proof_submission_command where actor_user_id=p_actor and idempotency_key=p_key;\n if found then\n  if v_prior.command<>jsonb_build_object('pledge',p_pledge,'payment',p_payment) then raise exception 'Submission key reused for different facts'; end if;\n  return v_prior.proof_id;\n end if;\n select status into v_status from public.sponsorship_pledge where id=p_pledge;\n if v_status='provisional' then\n  -- The legacy recorder accepts the following state; avoid changing it outside\n  -- this transaction and restore pending status after the insertion.\n  update public.sponsorship_pledge set status='needs_followup' where id=p_pledge;\n end if;\n v_id:=public.record_sponsorship_payment_proof(p_pledge,p_actor,p_payment->>'storagePath',p_payment->>'fileName',p_payment->>'fileType',(p_payment->>'fileSize')::integer,p_payment->>'paymentMethod',p_payment->>'reference',(p_payment->>'amountCents')::integer,(p_payment->>'paymentDate')::date,p_payment->>'note');\n insert into public.sponsorship_proof_submission_command values(p_actor,p_key,jsonb_build_object('pledge',p_pledge,'payment',p_payment),v_id);\n return v_id;\nend; $function$\n",
    "name": "record_exact_sponsorship_payment_proof",
    "owner": "postgres",
    "config": [
      "search_path=public, pg_temp"
    ],
    "result": "uuid",
    "schema": "public",
    "source": "\ndeclare v_prior public.sponsorship_proof_submission_command%rowtype;v_id uuid;v_status text;\nbegin\n if not exists(select 1 from public.admin_user where auth_user_id=p_actor and status='active' and role in ('admin','staff')) then raise exception 'Coordinator required' using errcode='42501'; end if;\n if p_key is null then raise exception 'Submission idempotency key required'; end if;\n perform 1 from public.sponsorship_pledge where id=p_pledge for update;\n perform pg_advisory_xact_lock(hashtextextended(p_actor::text||p_key::text,713));\n select * into v_prior from public.sponsorship_proof_submission_command where actor_user_id=p_actor and idempotency_key=p_key;\n if found then\n  if v_prior.command<>jsonb_build_object('pledge',p_pledge,'payment',p_payment) then raise exception 'Submission key reused for different facts'; end if;\n  return v_prior.proof_id;\n end if;\n select status into v_status from public.sponsorship_pledge where id=p_pledge;\n if v_status='provisional' then\n  -- The legacy recorder accepts the following state; avoid changing it outside\n  -- this transaction and restore pending status after the insertion.\n  update public.sponsorship_pledge set status='needs_followup' where id=p_pledge;\n end if;\n v_id:=public.record_sponsorship_payment_proof(p_pledge,p_actor,p_payment->>'storagePath',p_payment->>'fileName',p_payment->>'fileType',(p_payment->>'fileSize')::integer,p_payment->>'paymentMethod',p_payment->>'reference',(p_payment->>'amountCents')::integer,(p_payment->>'paymentDate')::date,p_payment->>'note');\n insert into public.sponsorship_proof_submission_command values(p_actor,p_key,jsonb_build_object('pledge',p_pledge,'payment',p_payment),v_id);\n return v_id;\nend; ",
    "system": false,
    "library": null,
    "language": "plpgsql",
    "arguments": 4,
    "extension": null,
    "argumentTypes": [
      "pg_catalog.uuid",
      "pg_catalog.uuid",
      "pg_catalog.uuid",
      "pg_catalog.jsonb"
    ],
    "extensionVersion": null
  },
