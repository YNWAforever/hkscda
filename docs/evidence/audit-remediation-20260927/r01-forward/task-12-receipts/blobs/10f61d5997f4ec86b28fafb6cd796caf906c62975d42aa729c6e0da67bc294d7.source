    "oid": 6159,
    "body": "CREATE OR REPLACE FUNCTION pg_catalog.pg_get_catalog_foreign_keys(OUT fktable regclass, OUT fkcols text[], OUT pktable regclass, OUT pkcols text[], OUT is_array boolean, OUT is_opt boolean)\n RETURNS SETOF record\n LANGUAGE internal\n STABLE PARALLEL SAFE STRICT COST 10 ROWS 250\nAS $function$pg_get_catalog_foreign_keys$function$\n",
