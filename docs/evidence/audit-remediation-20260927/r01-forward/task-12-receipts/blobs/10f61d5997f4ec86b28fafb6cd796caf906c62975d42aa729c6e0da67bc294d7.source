  {
    "oid": 22418,
    "body": "CREATE OR REPLACE FUNCTION private.require_crm_supporter_actor(p_actor uuid)\n RETURNS void\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\nbegin\n  -- Own-domain Auth then admin SHARE fences non-key ban/role/status changes.\n  perform 1 from auth.users u\n  where u.id = p_actor and u.email_confirmed_at is not null\n    and (u.banned_until is null or u.banned_until <= pg_catalog.clock_timestamp())\n  for share;\n  if not found then\n    raise exception 'supporter_edit_forbidden' using errcode = '42501';\n  end if;\n  perform 1 from public.admin_user a\n  where a.auth_user_id = p_actor and a.status = 'active'\n    and a.role in ('treasurer', 'admin')\n  for share;\n  if not found then\n    raise exception 'supporter_edit_forbidden' using errcode = '42501';\n  end if;\nend;\n$function$\n",
    "name": "require_crm_supporter_actor",
    "owner": "postgres",
    "config": [
      "search_path=\"\""
    ],
    "result": "void",
    "schema": "private",
    "source": "\nbegin\n  -- Own-domain Auth then admin SHARE fences non-key ban/role/status changes.\n  perform 1 from auth.users u\n  where u.id = p_actor and u.email_confirmed_at is not null\n    and (u.banned_until is null or u.banned_until <= pg_catalog.clock_timestamp())\n  for share;\n  if not found then\n    raise exception 'supporter_edit_forbidden' using errcode = '42501';\n  end if;\n  perform 1 from public.admin_user a\n  where a.auth_user_id = p_actor and a.status = 'active'\n    and a.role in ('treasurer', 'admin')\n  for share;\n  if not found then\n    raise exception 'supporter_edit_forbidden' using errcode = '42501';\n  end if;\nend;\n",
    "system": false,
    "library": null,
    "language": "plpgsql",
    "arguments": 1,
    "extension": null,
    "argumentTypes": [
      "pg_catalog.uuid"
    ],
    "extensionVersion": null
  },
