    "oid": 13275,
    "body": "CREATE OR REPLACE FUNCTION information_schema._pg_numeric_scale(typid oid, typmod integer)\n RETURNS integer\n LANGUAGE sql\n IMMUTABLE PARALLEL SAFE STRICT\nRETURN CASE WHEN (typid = ANY (ARRAY[(21)::oid, (23)::oid, (20)::oid])) THEN 0 WHEN (typid = (1700)::oid) THEN CASE WHEN (typmod = '-1'::integer) THEN NULL::integer ELSE ((typmod - 4) & 65535) END ELSE NULL::integer END\n",
    "name": "_pg_numeric_scale",
    "owner": "supabase_admin",
    "config": null,
    "result": "integer",
    "schema": "information_schema",
