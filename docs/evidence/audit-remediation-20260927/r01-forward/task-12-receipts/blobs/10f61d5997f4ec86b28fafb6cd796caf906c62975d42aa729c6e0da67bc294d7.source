  {
    "oid": 21832,
    "body": "CREATE OR REPLACE FUNCTION public.append_crm_export_job_page(p_job uuid, p_owner uuid, p_csv_chunk text, p_count integer)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public', 'pg_temp'\nAS $function$\ndeclare v_job public.crm_export_job%rowtype; v_ready boolean;\nbegin\n  select * into v_job from public.crm_export_job where id=p_job for update;\n  if not found or v_job.status<>'processing' or v_job.lease_owner is distinct from p_owner\n    or v_job.lease_until<=clock_timestamp() or v_job.expires_at<=clock_timestamp() then\n    return null;\n  end if;\n  if p_count<0 or p_count>500 or (p_count=0 and v_job.total<>0)\n    or v_job.processed_count+p_count>v_job.total\n    or p_count<>least(500,v_job.total-v_job.processed_count) then\n    raise exception 'invalid_crm_export_page' using errcode='22023';\n  end if;\n  if v_job.processed_count=0 then\n    insert into private.crm_export_artifact(job_id,csv) values(p_job,p_csv_chunk);\n  else\n    update private.crm_export_artifact set csv=csv||p_csv_chunk where job_id=p_job;\n    if not found then raise exception 'crm_export_artifact_missing' using errcode='P0001'; end if;\n  end if;\n  v_ready:=v_job.processed_count+p_count=v_job.total;\n  update public.crm_export_job set processed_count=processed_count+p_count,\n    status=case when v_ready then 'ready' else 'pending' end,\n    lease_owner=null,lease_until=null,attempts=0,error_code=null,updated_at=clock_timestamp()\n    where id=p_job;\n  insert into public.audit_log(actor_user_id,action,entity,entity_id,timestamp,detail)\n    values(v_job.actor_user_id,case when v_ready then 'export.job.ready' else 'export.job.page' end,\n      'crm_export',p_job::text,clock_timestamp(),\n      jsonb_build_object('kind',v_job.kind,'processed',v_job.processed_count+p_count,'total',v_job.total));\n  return jsonb_build_object('status',case when v_ready then 'ready' else 'pending' end,\n    'processed',v_job.processed_count+p_count,'total',v_job.total);\nend;\n$function$\n",
    "name": "append_crm_export_job_page",
    "owner": "postgres",
    "config": [
      "search_path=public, pg_temp"
    ],
    "result": "jsonb",
    "schema": "public",
    "source": "\ndeclare v_job public.crm_export_job%rowtype; v_ready boolean;\nbegin\n  select * into v_job from public.crm_export_job where id=p_job for update;\n  if not found or v_job.status<>'processing' or v_job.lease_owner is distinct from p_owner\n    or v_job.lease_until<=clock_timestamp() or v_job.expires_at<=clock_timestamp() then\n    return null;\n  end if;\n  if p_count<0 or p_count>500 or (p_count=0 and v_job.total<>0)\n    or v_job.processed_count+p_count>v_job.total\n    or p_count<>least(500,v_job.total-v_job.processed_count) then\n    raise exception 'invalid_crm_export_page' using errcode='22023';\n  end if;\n  if v_job.processed_count=0 then\n    insert into private.crm_export_artifact(job_id,csv) values(p_job,p_csv_chunk);\n  else\n    update private.crm_export_artifact set csv=csv||p_csv_chunk where job_id=p_job;\n    if not found then raise exception 'crm_export_artifact_missing' using errcode='P0001'; end if;\n  end if;\n  v_ready:=v_job.processed_count+p_count=v_job.total;\n  update public.crm_export_job set processed_count=processed_count+p_count,\n    status=case when v_ready then 'ready' else 'pending' end,\n    lease_owner=null,lease_until=null,attempts=0,error_code=null,updated_at=clock_timestamp()\n    where id=p_job;\n  insert into public.audit_log(actor_user_id,action,entity,entity_id,timestamp,detail)\n    values(v_job.actor_user_id,case when v_ready then 'export.job.ready' else 'export.job.page' end,\n      'crm_export',p_job::text,clock_timestamp(),\n      jsonb_build_object('kind',v_job.kind,'processed',v_job.processed_count+p_count,'total',v_job.total));\n  return jsonb_build_object('status',case when v_ready then 'ready' else 'pending' end,\n    'processed',v_job.processed_count+p_count,'total',v_job.total);\nend;\n",
    "system": false,
    "library": null,
    "language": "plpgsql",
    "arguments": 4,
    "extension": null,
    "argumentTypes": [
      "pg_catalog.uuid",
      "pg_catalog.uuid",
      "pg_catalog.text",
      "pg_catalog.int4"
    ],
    "extensionVersion": null
  },
