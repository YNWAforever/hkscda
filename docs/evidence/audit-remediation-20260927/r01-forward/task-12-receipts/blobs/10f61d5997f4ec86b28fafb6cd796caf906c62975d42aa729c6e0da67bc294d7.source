  {
    "oid": 20059,
    "body": "CREATE OR REPLACE FUNCTION public.volunteer_activity_counts(p_activity_ids uuid[])\n RETURNS jsonb\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'public', 'pg_temp'\nAS $function$\n select coalesce(jsonb_agg(to_jsonb(t)),'[]'::jsonb) from (\n select activity_id,coalesce(sum(participant_count) filter(where status='approved'),0) approved_participants,coalesce(sum(participant_count) filter(where status='pending'),0) pending_participants,coalesce(sum(participant_count) filter(where status='waitlisted'),0) waitlisted_participants\n from public.volunteer_registration where activity_id=any(p_activity_ids) group by activity_id) t;\n$function$\n",
    "name": "volunteer_activity_counts",
    "owner": "postgres",
    "config": [
      "search_path=public, pg_temp"
    ],
    "result": "jsonb",
    "schema": "public",
    "source": "\n select coalesce(jsonb_agg(to_jsonb(t)),'[]'::jsonb) from (\n select activity_id,coalesce(sum(participant_count) filter(where status='approved'),0) approved_participants,coalesce(sum(participant_count) filter(where status='pending'),0) pending_participants,coalesce(sum(participant_count) filter(where status='waitlisted'),0) waitlisted_participants\n from public.volunteer_registration where activity_id=any(p_activity_ids) group by activity_id) t;\n",
    "system": false,
    "library": null,
    "language": "sql",
    "arguments": 1,
    "extension": null,
    "argumentTypes": [
      "pg_catalog._uuid"
    ],
    "extensionVersion": null
  },
