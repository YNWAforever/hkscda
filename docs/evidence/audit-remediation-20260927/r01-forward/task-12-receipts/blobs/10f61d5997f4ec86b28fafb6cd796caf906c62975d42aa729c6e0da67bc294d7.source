    "oid": 21837,
    "body": "CREATE OR REPLACE FUNCTION public.cleanup_expired_crm_export_jobs()\n RETURNS integer\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public', 'pg_temp'\nAS $function$\ndeclare v_count integer;\nbegin\n  delete from public.crm_export_job where expires_at<=clock_timestamp();\n  get diagnostics v_count=row_count;\n  return v_count;\nend;\n$function$\n",
    "name": "cleanup_expired_crm_export_jobs",
    "owner": "postgres",
    "config": [
      "search_path=public, pg_temp"
    ],
    "result": "integer",
    "schema": "public",
    "source": "\ndeclare v_count integer;\nbegin\n  delete from public.crm_export_job where expires_at<=clock_timestamp();\n  get diagnostics v_count=row_count;\n  return v_count;\nend;\n",
    "system": false,
    "library": null,
    "language": "plpgsql",
    "arguments": 0,
    "extension": null,
    "argumentTypes": [],
    "extensionVersion": null
