{
  "statements": [
    "-- Harden the donation receipt lifecycle against duplicate issuance and against\n-- burning IRD sequence numbers on partial failures.\n--\n-- Two problems this fixes:\n--   1. Receipt numbers were allocated by `private.allocate_receipt_number`\n--      (its own committed transaction) BEFORE the PDF/storage/row insert. Any\n--      failure consumed a sequence number with no row, and a retry allocated a\n--      fresh number -> non-contiguous tax-receipt sequence + multiple numbers\n--      per donation.\n--   2. Duplicate issuance was guarded only by a read-then-insert check in\n--      application code with no DB-level uniqueness, so concurrent webhook /\n--      admin issuance could mint two valid receipts for one donation.\n--\n-- Fix: a single atomic RPC that allocates the number AND inserts the receipt\n-- row in one transaction, is idempotent per donation, and is backed by a unique\n-- partial index. The PDF is generated by the caller AFTER the row commits, so a\n-- PDF/storage failure never wastes a number (the row already owns it and a retry\n-- reuses it).\n\n-- One issued receipt per donation. donation_ids is always a single-element array\n-- in current code paths, so the first element identifies the donation. Voided\n-- receipts are excluded so a donation can legitimately be re-receipted after a\n-- void.\n--\n-- NOTE: if any duplicate issued receipts already exist in the target database\n-- this index creation will fail; resolve those duplicates first.\ncreate unique index if not exists receipt_one_issued_per_donation\n  on public.receipt ((donation_ids[1]))\n  where status = 'issued'",
    "-- Defined in `public` (not `private`) so the service-role client can call it\n-- over PostgREST via client.rpc(\"issue_receipt\", ...) — the same pattern as the\n-- working change_adoption_case_status / finalize_successful_adoption RPCs. The\n-- `private` schema is not exposed to PostgREST and service_role lacks USAGE on\n-- it, so a private RPC is unreachable from the app. The SECURITY DEFINER body\n-- still reaches private.allocate_receipt_number because the function owner has\n-- USAGE on private.\ncreate or replace function public.issue_receipt(\n  p_donation_id uuid,\n  p_supporter_id uuid,\n  p_amount_cents integer,\n  p_tax_year integer,\n  p_issued_at timestamptz\n)\nreturns table (\n  receipt_no text,\n  receipt_id uuid,\n  pdf_url text,\n  tax_year integer,\n  issued_at timestamptz,\n  already_existed boolean\n)\nlanguage plpgsql\nsecurity definer\nset search_path = public, pg_temp\nas $$\ndeclare\n  v_existing public.receipt;\n  v_receipt_no text;\n  v_receipt_id uuid;\nbegin\n  -- Idempotent: an issued receipt already exists for this donation.\n  select * into v_existing\n  from public.receipt r\n  where r.status = 'issued'\n    and r.donation_ids[1] = p_donation_id\n  limit 1;\n\n  if found then\n    receipt_no := v_existing.receipt_no;\n    receipt_id := v_existing.id;\n    pdf_url := v_existing.pdf_url;\n    tax_year := v_existing.tax_year;\n    issued_at := v_existing.issued_at;\n    already_existed := true;\n    return next;\n    return;\n  end if;\n\n  -- Allocate the number and insert the row in the same (sub)transaction. If the\n  -- insert hits the unique index because a concurrent caller won the race, the\n  -- exception block rolls back this allocation (no wasted number) and we return\n  -- the winner's row.\n  v_receipt_no := private.allocate_receipt_number(p_tax_year);\n\n  insert into public.receipt (\n    supporter_id,\n    receipt_no,\n    donation_ids,\n    total_amount_cents,\n    tax_year,\n    issued_at,\n    status\n  ) values (\n    p_supporter_id,\n    v_receipt_no,\n    array[p_donation_id],\n    p_amount_cents,\n    p_tax_year,\n    p_issued_at,\n    'issued'\n  )\n  returning id into v_receipt_id;\n\n  receipt_no := v_receipt_no;\n  receipt_id := v_receipt_id;\n  pdf_url := null;\n  tax_year := p_tax_year;\n  issued_at := p_issued_at;\n  already_existed := false;\n  return next;\nexception\n  when unique_violation then\n    select * into v_existing\n    from public.receipt r\n    where r.status = 'issued'\n      and r.donation_ids[1] = p_donation_id\n    limit 1;\n\n    -- The conflicting row must have existed to raise the violation, but it could\n    -- have been voided in the tiny window before this recovery read. Re-raise so\n    -- the caller retries cleanly rather than receiving a NULL-filled row.\n    if not found then\n      raise;\n    end if;\n\n    receipt_no := v_existing.receipt_no;\n    receipt_id := v_existing.id;\n    pdf_url := v_existing.pdf_url;\n    tax_year := v_existing.tax_year;\n    issued_at := v_existing.issued_at;\n    already_existed := true;\n    return next;\nend;\n$$",
    "revoke all on function public.issue_receipt(uuid, uuid, integer, integer, timestamptz) from public",
    "grant execute on function public.issue_receipt(uuid, uuid, integer, integer, timestamptz) to service_role"
  ],
  "transactionMode": "transactional",
  "ownTransaction": false,
  "incompatible": false
}
