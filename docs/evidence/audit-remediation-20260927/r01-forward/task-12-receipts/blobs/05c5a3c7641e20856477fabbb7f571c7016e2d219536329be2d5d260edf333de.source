const result={receiptVersion:1,receiptType:"native-source-qualification",mode:"native-metadata-only",error:null,requiredFinalFlags:[...nativeFlags],failedFinalFlags:[],...Object.fromEntries(nativeFlags.map(k=>[k,true])),sourceAdmission:true,nativeNextObserved:false,domainRowsAfterObserved:false,nativeLocalBunBehaviorRun:false,nextProvenance:"observed-modern-render-only",rulingSha256:rawSha(await readFile(base+"task-12-ruling64.source")),captureSha256:rawSha(await readFile(dir+"f4-group-baseline.json")),originalReceiptSha256:rawSha(await readFile(dir+"receipt.json")),sourceHead:receipt.sourceHead,migrationCount:183,managedKinds:receipt.managedJobs.map((m:Record<string,unknown>)=>m.kind),cleanupCount:4,vector:actual,oldTargets:proposal.oldTargets,nextTargets:proposal.nextExpectedFromModern,bindings,originalFiles:receipt.files,originalDirectory:dir,out};
