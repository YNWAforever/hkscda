{
  "statements": [
    "-- CRM large exports are private, bounded and short-lived. Apply only after catalog/grant rehearsal.\ncreate table public.crm_export_job (\n  id uuid primary key default gen_random_uuid(),\n  actor_user_id uuid not null references auth.users(id),\n  kind text not null check (kind in ('supporters','donations')),\n  filters jsonb not null check (jsonb_typeof(filters) = 'object'),\n  item_ids uuid[] not null check (cardinality(item_ids) <= 20000),\n  total integer generated always as (cardinality(item_ids)) stored,\n  processed_count integer not null default 0 check (processed_count >= 0 and processed_count <= cardinality(item_ids)),\n  status text not null default 'pending' check (status in ('pending','processing','ready','failed','cancelled')),\n  lease_owner uuid,\n  lease_until timestamptz,\n  attempts integer not null default 0,\n  error_code text,\n  created_at timestamptz not null default clock_timestamp(),\n  expires_at timestamptz not null default (clock_timestamp() + interval '24 hours'),\n  updated_at timestamptz not null default clock_timestamp()\n)",
    "create index crm_export_job_claim_idx on public.crm_export_job(status,lease_until,created_at)",
    "create index crm_export_job_expiry_idx on public.crm_export_job(expires_at)",
    "alter table public.crm_export_job enable row level security",
    "revoke all on public.crm_export_job from public,anon,authenticated",
    "grant select on public.crm_export_job to service_role",
    "create table private.crm_export_artifact (\n  job_id uuid primary key references public.crm_export_job(id) on delete cascade,\n  csv text not null check (octet_length(csv) <= 20971520),\n  created_at timestamptz not null default clock_timestamp()\n)",
    "alter table private.crm_export_artifact enable row level security",
    "revoke all on private.crm_export_artifact from public,anon,authenticated",
    "create function private.crm_export_actor_allowed(p_actor uuid)\nreturns boolean language sql stable security definer set search_path=public,pg_temp as $$\n  select exists(\n    select 1 from public.admin_user a join auth.users u on u.id=a.auth_user_id\n    where a.auth_user_id=p_actor and a.status='active' and a.role in ('treasurer','admin')\n      and u.email_confirmed_at is not null\n      and (u.banned_until is null or u.banned_until<=clock_timestamp())\n  );\n$$",
    "revoke all on function private.crm_export_actor_allowed(uuid) from public,anon,authenticated",
    "create function public.enqueue_crm_export_job(p_actor uuid,p_kind text,p_filters jsonb)\nreturns jsonb language plpgsql security definer set search_path=public,pg_temp as $$\ndeclare v_ids uuid[]; v_job public.crm_export_job%rowtype;\nbegin\n  if not private.crm_export_actor_allowed(p_actor) then\n    raise exception 'crm_export_forbidden' using errcode='42501';\n  end if;\n  if p_kind not in ('supporters','donations') or jsonb_typeof(p_filters)<>'object' then\n    raise exception 'invalid_crm_export_request' using errcode='22023';\n  end if;\n  if p_kind='supporters' then\n    select coalesce(array_agg(s.id order by s.created_at desc,s.id desc),'{}'::uuid[])\n      into v_ids from private.crm_matching_supporters(p_filters) s;\n  else\n    select coalesce(array_agg(d.id order by d.created_at desc,d.id desc),'{}'::uuid[])\n      into v_ids from private.crm_matching_supporters(p_filters) s\n      join public.donation d on d.supporter_id=s.id\n      where (p_filters->>'purpose' is null or d.purpose=p_filters->>'purpose')\n        and (p_filters->>'receiptNeeded' is null or d.receipt_requested=(p_filters->>'receiptNeeded')::boolean);\n  end if;\n  if cardinality(v_ids)>20000 then\n    raise exception 'crm_export_too_large' using errcode='P4130';\n  end if;\n  insert into public.crm_export_job(actor_user_id,kind,filters,item_ids)\n    values(p_actor,p_kind,p_filters,v_ids) returning * into v_job;\n  insert into public.audit_log(actor_user_id,action,entity,entity_id,timestamp,detail)\n    values(p_actor,'export.job.create','crm_export',v_job.id::text,clock_timestamp(),\n      jsonb_build_object('kind',p_kind,'rowCount',v_job.total));\n  return jsonb_build_object('id',v_job.id,'kind',v_job.kind,'total',v_job.total,\n    'status',v_job.status,'processed',0,'expiresAt',v_job.expires_at);\nend;\n$$",
    "create function public.claim_crm_export_job(p_owner uuid)\nreturns jsonb language plpgsql security definer set search_path=public,pg_temp as $$\ndeclare v_job public.crm_export_job%rowtype;\nbegin\n  with exhausted as (\n    update public.crm_export_job set status='failed',error_code='retry_exhausted',\n      lease_owner=null,lease_until=null,updated_at=clock_timestamp()\n      where status='processing' and lease_until<clock_timestamp() and attempts>=3\n      returning id,actor_user_id,kind\n  )\n  insert into public.audit_log(actor_user_id,action,entity,entity_id,timestamp,detail)\n    select actor_user_id,'export.job.failed','crm_export',id::text,clock_timestamp(),\n      jsonb_build_object('kind',kind,'errorCode','retry_exhausted') from exhausted;\n  select * into v_job from public.crm_export_job\n    where expires_at>clock_timestamp() and attempts<3\n      and (status='pending' or (status='processing' and lease_until<clock_timestamp()))\n    order by created_at,id for update skip locked limit 1;\n  if not found then return null; end if;\n  update public.crm_export_job set status='processing',lease_owner=p_owner,\n    lease_until=clock_timestamp()+interval '10 minutes',attempts=attempts+1,\n    updated_at=clock_timestamp() where id=v_job.id returning * into v_job;\n  return jsonb_build_object('id',v_job.id,'lease_owner',v_job.lease_owner,\n    'kind',v_job.kind,'total',v_job.total,'processed',v_job.processed_count,'attempts',v_job.attempts);\nend;\n$$",
    "create function public.crm_export_job_page(p_job uuid,p_owner uuid,p_offset integer,p_limit integer)\nreturns jsonb language plpgsql stable security definer set search_path=public,pg_temp as $$\ndeclare v_job public.crm_export_job%rowtype; v_rows jsonb;\nbegin\n  select * into v_job from public.crm_export_job where id=p_job and status='processing'\n    and lease_owner=p_owner and lease_until>clock_timestamp() and expires_at>clock_timestamp();\n  if not found then raise exception 'crm_export_lease_lost' using errcode='42501'; end if;\n  if p_offset<0 or p_limit<1 or p_limit>500 then\n    raise exception 'invalid_crm_export_page' using errcode='22023';\n  end if;\n  if v_job.kind='supporters' then\n    select coalesce(jsonb_agg(private.crm_supporter_summary(i.id) order by i.ord),'[]'::jsonb)\n      into v_rows from unnest(v_job.item_ids[p_offset+1:p_offset+p_limit]) with ordinality i(id,ord);\n  else\n    select coalesce(jsonb_agg(\n      case when d.id is null or s.id is null then null else\n      jsonb_build_object('supporterId',d.supporter_id,'supporterName',s.name,\n        'supporterEmail',s.email,'donationId',d.id,'amountCents',d.amount_cents,\n        'refundedCents',case when d.status='refunded' then d.amount_cents else d.refunded_cents end,\n        'purpose',d.purpose,'customPurpose',d.custom_purpose,'status',d.status,\n        'method',d.method,'receiptRequested',d.receipt_requested,'createdAt',d.created_at,\n        'receiptNo',(select r.receipt_no from public.receipt r where r.supporter_id=d.supporter_id\n          and r.status='issued' and r.donation_ids @> array[d.id]\n          order by r.issued_at desc,r.id desc limit 1))\n      end order by i.ord),'[]'::jsonb) into v_rows\n      from unnest(v_job.item_ids[p_offset+1:p_offset+p_limit]) with ordinality i(id,ord)\n      left join public.donation d on d.id=i.id\n      left join public.supporter s on s.id=d.supporter_id;\n  end if;\n  return v_rows;\nend;\n$$",
    "create function public.append_crm_export_job_page(p_job uuid,p_owner uuid,p_csv_chunk text,p_count integer)\nreturns jsonb language plpgsql security definer set search_path=public,pg_temp as $$\ndeclare v_job public.crm_export_job%rowtype; v_ready boolean;\nbegin\n  select * into v_job from public.crm_export_job where id=p_job for update;\n  if not found or v_job.status<>'processing' or v_job.lease_owner is distinct from p_owner\n    or v_job.lease_until<=clock_timestamp() or v_job.expires_at<=clock_timestamp() then\n    return null;\n  end if;\n  if p_count<0 or p_count>500 or (p_count=0 and v_job.total<>0)\n    or v_job.processed_count+p_count>v_job.total\n    or p_count<>least(500,v_job.total-v_job.processed_count) then\n    raise exception 'invalid_crm_export_page' using errcode='22023';\n  end if;\n  if v_job.processed_count=0 then\n    insert into private.crm_export_artifact(job_id,csv) values(p_job,p_csv_chunk);\n  else\n    update private.crm_export_artifact set csv=csv||p_csv_chunk where job_id=p_job;\n    if not found then raise exception 'crm_export_artifact_missing' using errcode='P0001'; end if;\n  end if;\n  v_ready:=v_job.processed_count+p_count=v_job.total;\n  update public.crm_export_job set processed_count=processed_count+p_count,\n    status=case when v_ready then 'ready' else 'pending' end,\n    lease_owner=null,lease_until=null,attempts=0,error_code=null,updated_at=clock_timestamp()\n    where id=p_job;\n  insert into public.audit_log(actor_user_id,action,entity,entity_id,timestamp,detail)\n    values(v_job.actor_user_id,case when v_ready then 'export.job.ready' else 'export.job.page' end,\n      'crm_export',p_job::text,clock_timestamp(),\n      jsonb_build_object('kind',v_job.kind,'processed',v_job.processed_count+p_count,'total',v_job.total));\n  return jsonb_build_object('status',case when v_ready then 'ready' else 'pending' end,\n    'processed',v_job.processed_count+p_count,'total',v_job.total);\nend;\n$$",
    "create function public.fail_crm_export_job(p_job uuid,p_owner uuid,p_error text)\nreturns boolean language plpgsql security definer set search_path=public,pg_temp as $$\ndeclare v_job public.crm_export_job%rowtype;\nbegin\n  update public.crm_export_job set status='failed',lease_owner=null,lease_until=null,\n    error_code=left(p_error,80),updated_at=clock_timestamp()\n    where id=p_job and status='processing' and lease_owner=p_owner\n    returning * into v_job;\n  if not found then return false; end if;\n  insert into public.audit_log(actor_user_id,action,entity,entity_id,timestamp,detail)\n    values(v_job.actor_user_id,'export.job.failed','crm_export',p_job::text,clock_timestamp(),\n      jsonb_build_object('kind',v_job.kind,'errorCode',v_job.error_code));\n  return true;\nend;\n$$",
    "create function public.crm_export_job_status(p_job uuid,p_actor uuid)\nreturns jsonb language sql stable security definer set search_path=public,pg_temp as $$\n  select case when private.crm_export_actor_allowed(p_actor) then\n    (select jsonb_build_object('id',j.id,'kind',j.kind,'total',j.total,\n      'status',case when j.expires_at<=clock_timestamp() then 'expired' else j.status end,\n      'processed',j.processed_count,'errorCode',j.error_code,'expiresAt',j.expires_at)\n      from public.crm_export_job j where j.id=p_job and j.actor_user_id=p_actor)\n    else null end;\n$$",
    "create function public.crm_export_job_download(p_job uuid,p_actor uuid)\nreturns text language sql stable security definer set search_path=public,pg_temp as $$\n  select a.csv from public.crm_export_job j join private.crm_export_artifact a on a.job_id=j.id\n    where j.id=p_job and j.actor_user_id=p_actor and j.status='ready'\n      and j.expires_at>clock_timestamp() and private.crm_export_actor_allowed(p_actor);\n$$",
    "create function public.cancel_crm_export_job(p_job uuid,p_actor uuid)\nreturns boolean language plpgsql security definer set search_path=public,pg_temp as $$\ndeclare v_job public.crm_export_job%rowtype;\nbegin\n  if not private.crm_export_actor_allowed(p_actor) then return false; end if;\n  select * into v_job from public.crm_export_job\n    where id=p_job and actor_user_id=p_actor and status in ('pending','processing','ready')\n    for update;\n  if not found then return false; end if;\n  update public.crm_export_job set status='cancelled',lease_owner=null,lease_until=null,\n    updated_at=clock_timestamp() where id=p_job;\n  delete from private.crm_export_artifact where job_id=p_job;\n  insert into public.audit_log(actor_user_id,action,entity,entity_id,timestamp,detail)\n    values(p_actor,'export.job.cancel','crm_export',p_job::text,clock_timestamp(),\n      jsonb_build_object('kind',v_job.kind,'rowCount',v_job.total));\n  return true;\nend;\n$$",
    "create function public.cleanup_expired_crm_export_jobs()\nreturns integer language plpgsql security definer set search_path=public,pg_temp as $$\ndeclare v_count integer;\nbegin\n  delete from public.crm_export_job where expires_at<=clock_timestamp();\n  get diagnostics v_count=row_count;\n  return v_count;\nend;\n$$",
    "revoke all on function public.enqueue_crm_export_job(uuid,text,jsonb),\n  public.claim_crm_export_job(uuid),public.crm_export_job_page(uuid,uuid,integer,integer),\n  public.append_crm_export_job_page(uuid,uuid,text,integer),public.fail_crm_export_job(uuid,uuid,text),\n  public.crm_export_job_status(uuid,uuid),public.crm_export_job_download(uuid,uuid),\n  public.cancel_crm_export_job(uuid,uuid),public.cleanup_expired_crm_export_jobs()\n  from public,anon,authenticated",
    "grant execute on function public.enqueue_crm_export_job(uuid,text,jsonb),\n  public.claim_crm_export_job(uuid),public.crm_export_job_page(uuid,uuid,integer,integer),\n  public.append_crm_export_job_page(uuid,uuid,text,integer),public.fail_crm_export_job(uuid,uuid,text),\n  public.crm_export_job_status(uuid,uuid),public.crm_export_job_download(uuid,uuid),\n  public.cancel_crm_export_job(uuid,uuid),public.cleanup_expired_crm_export_jobs()\n  to service_role"
  ],
  "transactionMode": "transactional",
  "ownTransaction": false,
  "incompatible": false
}
