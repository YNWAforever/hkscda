 receipt['domainRowsBefore']=counts;scan=run(['bun',str(scratch/'task-12-native-queries.ts'),'scan',pg,str(out)]);receipt['scanner']=json.loads(scan.stdout);receipt['fullScannerPassed']=receipt['scanner']['fullScannerPassed']is True;save()
 after=capture('after-readonly');receipt['catalogPreserved']=before==after;receipt['zeroRows']=all(x['count']==0 for x in counts);receipt['result']='Fresh Task12 metadata-only f4 group baseline; candidate not applied and product profile not admitted';save()

