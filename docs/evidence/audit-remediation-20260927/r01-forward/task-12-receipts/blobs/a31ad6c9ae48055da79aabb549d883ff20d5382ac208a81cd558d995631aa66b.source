{
  "statements": [
    "-- T18: explicit classification and effective dates; existing published rows remain visible for review.\nalter table public.content_item\n  add column if not exists content_class text not null default 'unreviewed',\n  add column if not exists source_reference text,\n  add column if not exists content_owner text,\n  add column if not exists effective_from timestamptz,\n  add column if not exists effective_until timestamptz",
    "alter table public.content_item\n  add constraint content_item_class_check check (content_class in ('unreviewed','verified','demo')),\n  add constraint content_item_effective_range_check check (effective_from is null or effective_until is null or effective_from <= effective_until),\n  add constraint content_item_verified_provenance_check check (\n    content_class <> 'verified' or\n    (nullif(btrim(source_reference),'') is not null and nullif(btrim(content_owner),'') is not null)\n  )",
    "create or replace function public.set_content_publication_metadata(\n  p_actor_user_id uuid,\n  p_content_id uuid,\n  p_expected_version integer,\n  p_values jsonb\n) returns jsonb language plpgsql security invoker set search_path=public,pg_temp as $$\ndeclare\n  actor public.admin_user%rowtype;\n  item public.content_item%rowtype;\n  v_revision_id uuid;\nbegin\n  actor := private.require_content_actor(p_actor_user_id);\n  if jsonb_typeof(p_values) is distinct from 'object'\n    or p_values ? 'contentClass' is false\n    or p_values ? 'sourceReference' is false\n    or p_values ? 'contentOwner' is false\n    or p_values ? 'effectiveFrom' is false\n    or p_values ? 'effectiveUntil' is false\n    or (select count(*) from jsonb_object_keys(p_values)) <> 5\n  then raise exception 'Invalid publication metadata' using errcode='22023'; end if;\n  select * into item from public.content_item where id=p_content_id for update;\n  if not found then raise exception 'Content item not found' using errcode='P0002'; end if;\n  if item.version is distinct from p_expected_version then\n    raise exception 'Stale content version' using errcode='40001';\n  end if;\n  update public.content_item set\n    content_class=p_values->>'contentClass',\n    source_reference=nullif(btrim(p_values->>'sourceReference'),''),\n    content_owner=nullif(btrim(p_values->>'contentOwner'),''),\n    effective_from=(p_values->>'effectiveFrom')::timestamptz,\n    effective_until=(p_values->>'effectiveUntil')::timestamptz,\n    version=item.version+1,\n    updated_by=actor.id\n  where id=p_content_id;\n  v_revision_id := private.insert_content_revision(p_content_id,item.version+1,'set_publication_metadata',actor.id);\n  insert into public.audit_log(actor_user_id,action,entity,entity_id,detail)\n  values(actor.id,'content.set_publication_metadata','content_item',p_content_id::text,\n    jsonb_build_object('expected_version',p_expected_version,'result_version',item.version+1,\n      'revision_id',v_revision_id,'before_class',item.content_class,\n      'after_class',p_values->>'contentClass'));\n  return jsonb_build_object('content_id',p_content_id,'version',item.version+1,'revision_id',v_revision_id);\nend\n$$",
    "revoke all on function public.set_content_publication_metadata(uuid,uuid,integer,jsonb) from public,anon,authenticated",
    "grant execute on function public.set_content_publication_metadata(uuid,uuid,integer,jsonb) to service_role",
    "create or replace function public.read_published_content_snapshots(p_filters jsonb default '{}'::jsonb)\nreturns jsonb language sql stable security invoker set search_path=public,pg_temp as $$\n  with filtered as (\n    select jsonb_set(\n      private.materialize_published_content_snapshot(\n        revision.public_snapshot #- '{content,source_reference}' #- '{content,content_owner}',revision.id),\n      '{content}',\n      ((revision.public_snapshot->'content') - 'source_reference' - 'content_owner') ||\n      jsonb_build_object('content_class',item.content_class,'effective_from',item.effective_from,'effective_until',item.effective_until)\n    ) as snapshot, item.published_at, item.id\n    from public.content_item item join public.content_revision revision\n      on revision.id=item.published_revision_id and revision.content_item_id=item.id\n    where item.status='published'\n      and item.content_class <> 'demo'\n      and (item.effective_from is null or item.effective_from <= now())\n      and (item.effective_until is null or item.effective_until >= now()\n        or p_filters->>'slug' is not null\n        or (item.type in ('event','charity_market') and p_filters->>'isFeatured' is null and p_filters->>'surface' is distinct from 'promotion'))\n      and (p_filters->>'slug' is null or revision.public_snapshot->'content'->>'slug'=p_filters->>'slug')\n      and (p_filters->>'type' is null or revision.public_snapshot->'content'->>'type'=p_filters->>'type')\n      and (p_filters->>'isFeatured' is null or coalesce((revision.public_snapshot->'profile'->>'is_featured')::boolean,false)=(p_filters->>'isFeatured')::boolean)\n      and (p_filters->>'animalType' is null or revision.public_snapshot->'profile'->>'animal_type'=p_filters->>'animalType')\n      and (p_filters->>'publicStatus' is null or revision.public_snapshot->'profile'->>'public_status'=p_filters->>'publicStatus')\n      and (p_filters->>'rescueRegion' is null or revision.public_snapshot->'profile'->>'rescue_region'=p_filters->>'rescueRegion')\n      and (p_filters->>'q' is null or strpos(lower(coalesce(revision.public_snapshot->'content'->>'title','') || ' ' || coalesce(revision.public_snapshot->'content'->>'summary','')),lower(p_filters->>'q'))>0)\n  ), page as (\n    select * from filtered order by published_at desc nulls last,id\n    limit least(50,greatest(1,coalesce((p_filters->>'pageSize')::integer,25)))\n    offset (greatest(1,coalesce((p_filters->>'page')::integer,1))-1)*least(50,greatest(1,coalesce((p_filters->>'pageSize')::integer,25)))\n  )\n  select jsonb_build_object('total',(select count(*) from filtered),\n    'rows',coalesce((select jsonb_agg(jsonb_build_object('snapshot',case when p_filters->>'detail'='true' then snapshot else private.content_summary_snapshot(snapshot) end,'published_at',published_at) order by published_at desc nulls last,id) from page),'[]'::jsonb))\n$$",
    "revoke all on function public.read_published_content_snapshots(jsonb) from public,anon,authenticated",
    "grant execute on function public.read_published_content_snapshots(jsonb) to service_role"
  ],
  "transactionMode": "transactional",
  "ownTransaction": false,
  "incompatible": false
}
