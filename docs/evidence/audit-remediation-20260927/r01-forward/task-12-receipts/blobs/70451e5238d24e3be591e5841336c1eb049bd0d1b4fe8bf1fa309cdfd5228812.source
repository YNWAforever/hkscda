          {
            "name": "volunteer_shelter_definition_key_check",
            "type": "c",
            "table": "volunteer_shelter_definition",
            "schema": "public",
            "validated": true,
            "definition": "CHECK (key ~ '^[a-z][a-z0-9_-]{0,79}$'::text AND (key <> ALL (ARRAY['all'::text, 'common'::text])))"
          },
          {
            "name": "volunteer_shelter_definition_label_check",
            "type": "c",
            "table": "volunteer_shelter_definition",
