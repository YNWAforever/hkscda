            "definition": "PRIMARY KEY (id)"
          },
          {
            "name": "custom_oauth_providers_authorization_url_https",
            "type": "c",
            "table": "custom_oauth_providers",
            "schema": "auth",
            "validated": true,
            "definition": "CHECK (authorization_url IS NULL OR authorization_url ~~ 'https://%'::text)"
          },
          {
            "name": "custom_oauth_providers_authorization_url_length",
            "type": "c",
            "table": "custom_oauth_providers",
            "schema": "auth",
            "validated": true,
            "definition": "CHECK (authorization_url IS NULL OR char_length(authorization_url) <= 2048)"
          },
          {
            "name": "custom_oauth_providers_client_id_length",
            "type": "c",
            "table": "custom_oauth_providers",
            "schema": "auth",
            "validated": true,
            "definition": "CHECK (char_length(client_id) >= 1 AND char_length(client_id) <= 512)"
          },
          {
            "name": "custom_oauth_providers_discovery_url_length",
            "type": "c",
            "table": "custom_oauth_providers",
            "schema": "auth",
            "validated": true,
            "definition": "CHECK (discovery_url IS NULL OR char_length(discovery_url) <= 2048)"
          },
          {
            "name": "custom_oauth_providers_identifier_format",
            "type": "c",
            "table": "custom_oauth_providers",
            "schema": "auth",
            "validated": true,
            "definition": "CHECK (identifier ~ '^[a-z0-9][a-z0-9:-]{0,48}[a-z0-9]$'::text)"
          },
          {
            "name": "custom_oauth_providers_identifier_key",
            "type": "u",
