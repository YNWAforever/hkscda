        "policies": [
          {
            "name": "admin users can view their own role",
            "check": null,
            "roles": [
              "authenticated"
            ],
            "table": "admin_user",
            "using": "(( SELECT auth.uid() AS uid) = auth_user_id)",
            "schema": "public",
            "command": "r",
            "permissive": true
          },
          {
            "name": "admins can manage admin users",
            "check": "private.has_admin_role(ARRAY['admin'::text])",
            "roles": [
              "authenticated"
            ],
            "table": "admin_user",
            "using": "private.has_admin_role(ARRAY['admin'::text])",
            "schema": "public",
            "command": "*",
            "permissive": true
          },
          {
