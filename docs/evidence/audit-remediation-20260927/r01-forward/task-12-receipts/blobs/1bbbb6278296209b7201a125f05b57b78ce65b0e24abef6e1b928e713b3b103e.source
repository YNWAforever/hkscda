import pathlib,json,sys,subprocess,hashlib
out=pathlib.Path(__file__).parent;raw=(out/'correct.py').read_bytes();old=b"call='composition_observations(mode,r,after,behavior)';assert s.count(call)==1;s=s.replace(call,'inventory=composition_observations(mode,r,after,behavior)')";new=b"call=';composition_observations(mode,r,after,behavior)';assert s.count(call)==1;s=s.replace(call,';inventory=composition_observations(mode,r,after,behavior)')";assert raw.count(old)==1;fixed=raw.replace(old,new);p=out/'correct-generator-fix.py';p.write_bytes(fixed);(out/'correct-generator-executed.source').write_bytes(fixed);cmd=[sys.executable,'-B',str(p)];(out/'correct-generator.invocation.json').write_bytes((json.dumps({'command':cmd,'prearchivedSource':'correct-generator-executed.source','rawSha256':hashlib.sha256(fixed).hexdigest()})+'\n').encode());r=subprocess.run(cmd,capture_output=True);(out/'correct-generator.stdout.log').write_bytes(r.stdout);(out/'correct-generator.stderr.log').write_bytes(r.stderr);(out/'correct-generator.exit.json').write_bytes((json.dumps({'exit':r.returncode,'stdoutSha256':hashlib.sha256(r.stdout).hexdigest(),'stderrSha256':hashlib.sha256(r.stderr).hexdigest()})+'\n').encode());print(r.stderr.decode());sys.exit(r.returncode)
