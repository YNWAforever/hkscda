def collect(paths):
    entries=[]
    for p in paths:
        raw=p.read_bytes();digest=r.sha(raw);target=r.publish_path(raw)
        if digest in r.PINS:
            pin=ROOT/target;assert pin.read_bytes()==raw
            r.validate_pin(digest,raw,r.PINS[digest][1],{'text':'unset','diff':'unset','merge':'unset'})
        else:
            # This detects a newly altered obsolete-bearing input without publishing or exempting it.
            forbidden='\u65e5\u591c\u5805\u5b88\u524d\u7dda\u52d5\u7269\u6551\u63f4'.encode()
            if forbidden in raw:raise ValueError('Unadmitted obsolete-bearing new payload')
            archive=ROOT/target
            if archive.exists():assert archive.read_bytes()==raw
            else:archive.write_bytes(raw)
        entries.append({'originalPath':p.relative_to(ROOT).as_posix(),'archivePath':target,'rawSha256':digest,'canonicalSha256':r.sha(raw.replace(b'\r\n',b'\n')),'rawGitBlob':r.blob(raw),'rawBytes':len(raw),'referenceOrigin':'existing-immutable-f4-input'if digest in r.PINS else 'new-task12-fix2-metadata'})
    return entries
def write(name,value):
    (ROOT/r.PREFIX/name).write_text(json.dumps(value,indent=2)+'\n',encoding='utf8')
