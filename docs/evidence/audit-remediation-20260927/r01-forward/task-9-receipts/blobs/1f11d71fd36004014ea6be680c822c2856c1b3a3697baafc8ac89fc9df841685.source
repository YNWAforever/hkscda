            "definition": "CREATE INDEX animals_public_catalogue_idx ON public.animals USING btree (type) WHERE ((status = ANY (ARRAY['available'::text, 'fostered'::text])) AND (retired_at IS NULL) AND (publication_state = 'published'::text) AND (adoption_eligible OR sponsorship_eligible))"
