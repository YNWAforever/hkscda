import { expect, test } from "bun:test";
import { z } from "zod";
import { createCaseHandlers } from "./http/caseHandlers.server";
const actor="00000000-0000-4000-8000-000000000001";
const request=()=>new Request("https://example.invalid/coordinator/manual-case",{method:"POST",body:JSON.stringify({identity:{kind:'new_supporter'}}),headers:{'content-type':'application/json'}});
function handlers(error:unknown){return createCaseHandlers({requireCoordinator:async()=>({authUserId:actor}) as never,service:{createManualCase:async()=>{throw error;}} as never});}
test("manual actor SQLSTATE42501 returns safe403 through actual coordinator handler",async()=>{
 const r=await handlers({code:'42501',message:'internal actor diagnostic'}).createManualCase({request:request()});
 expect(r.status).toBe(403);expect(r.headers.get('cache-control')).toBe('no-store');expect(await r.json()).toEqual({error:'Forbidden'});
});
const invalid=z.string().uuid().safeParse('invalid');if(invalid.success)throw Error('invalid fixture');
for(const [name,error,status]of [
 ['Response',new Response('Unauthorized',{status:401}),401],['Zod',invalid.error,400],['missing',{code:'P0002'},404],['domain conflict',new Error('System statuses cannot be deleted'),409],['unknown',{code:'XX000',message:'internal diagnostic'},500],['nonobject','42501',500]
]as const)test(`coordinator permission mapping preserves ${name}`,async()=>{const r=await handlers(error).createManualCase({request:request()});expect(r.status).toBe(status);expect(r.headers.get('cache-control')).toBe('no-store');});
test('manual handler preserves201 IDs and task-null response',async()=>{const h=createCaseHandlers({requireCoordinator:async()=>({authUserId:actor})as never,service:{createManualCase:async()=>({caseId:'case-id',supporterId:'supporter-id',adopterProfileId:'adopter-id',taskId:null})}as never});const r=await h.createManualCase({request:request()});expect(r.status).toBe(201);expect(await r.json()).toEqual({case:{id:'case-id'},supporterId:'supporter-id',adopterProfileId:'adopter-id',taskId:null});});
