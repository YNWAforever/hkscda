    {
      "acl": "{postgres=X/postgres,service_role=X/postgres}",
      "name": "allocate_exact_sponsorship_payment",
      "owner": "postgres",
      "result": "jsonb",
      "schema": "public",
      "bodyMd5": "55c748e0ef23b0f36ee49530856b563e",
      "identity": "p_actor uuid, p_proof uuid, p_expected_net bigint, p_key uuid, p_month date, p_amount integer, p_reason text",
      "language": "plpgsql",
      "arguments": "p_actor uuid, p_proof uuid, p_expected_net bigint, p_key uuid, p_month date, p_amount integer, p_reason text",
      "definition": "CREATE OR REPLACE FUNCTION public.allocate_exact_sponsorship_payment(p_actor uuid, p_proof uuid, p_expected_net bigint, p_key uuid, p_month date, p_amount integer, p_reason text)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public', 'pg_temp'\nAS $function$\ndeclare v_actor uuid;v_proof public.sponsorship_payment_proof%rowtype;v_net bigint;v_command jsonb;v_prior public.sponsorship_allocation_command%rowtype;v_result jsonb;\nbegin\n select id into v_actor from public.admin_user where auth_user_id=p_actor and status='active' and role in ('treasurer','admin');\n if v_actor is null then raise exception 'Finance role required' using errcode='42501';end if;\n if p_key is null or p_expected_net is null or p_expected_net<0 or length(trim(coalesce(p_reason,'')))<5 then raise exception 'Expected balance, retry key and reason required';end if;\n perform 1 from public.sponsorship_pledge where id=(select pledge_id from public.sponsorship_payment_proof where id=p_proof) for update;\n perform pg_advisory_xact_lock(hashtextextended(p_actor::text||p_key::text,714));\n v_command:=jsonb_build_object('proof',p_proof,'expectedNet',p_expected_net,'month',p_month,'amount',p_amount,'reason',p_reason);\n select * into v_prior from public.sponsorship_allocation_command where actor_user_id=p_actor and idempotency_key=p_key;\n if found then if v_prior.command<>v_command then raise exception 'Retry key reused for changed allocation';end if;return v_prior.result||jsonb_build_object('replayed',true);end if;\n select * into v_proof from public.sponsorship_payment_proof where id=p_proof for update;\n if not found then raise exception 'Payment proof not found';end if;\n select coalesce(sum(amount_cents),0) into v_net from public.sponsorship_payment_allocation where proof_id=p_proof;\n if v_net<>p_expected_net then raise exception 'Allocation balance changed; reload the ledger';end if;\n if p_amount is null or p_amount<=0 or p_amount>v_proof.amount_cents-v_net then raise exception 'Allocation exceeds the remaining received money';end if;\n v_result:=private.append_sponsorship_allocations(p_proof,v_actor,jsonb_build_array(jsonb_build_object('periodMonth',p_month,'amountCents',p_amount)));\n insert into public.audit_log(actor_user_id,action,entity,entity_id,detail) values(p_actor,'sponsorship_pledge.payment_reallocated','sponsorship_pledge',v_proof.pledge_id::text,jsonb_build_object('proofId',p_proof,'beforeNet',v_net,'allocation',v_result,'reason',p_reason));\n insert into public.sponsorship_allocation_command values(p_actor,p_key,v_command,v_result);\n return v_result;\nend; $function$\n",
      "completeProc": {
        "oid": "31648",
        "proacl": [
          "postgres=X/postgres",
          "service_role=X/postgres"
        ],
        "probin": null,
        "prosrc": "\ndeclare v_actor uuid;v_proof public.sponsorship_payment_proof%rowtype;v_net bigint;v_command jsonb;v_prior public.sponsorship_allocation_command%rowtype;v_result jsonb;\nbegin\n select id into v_actor from public.admin_user where auth_user_id=p_actor and status='active' and role in ('treasurer','admin');\n if v_actor is null then raise exception 'Finance role required' using errcode='42501';end if;\n if p_key is null or p_expected_net is null or p_expected_net<0 or length(trim(coalesce(p_reason,'')))<5 then raise exception 'Expected balance, retry key and reason required';end if;\n perform 1 from public.sponsorship_pledge where id=(select pledge_id from public.sponsorship_payment_proof where id=p_proof) for update;\n perform pg_advisory_xact_lock(hashtextextended(p_actor::text||p_key::text,714));\n v_command:=jsonb_build_object('proof',p_proof,'expectedNet',p_expected_net,'month',p_month,'amount',p_amount,'reason',p_reason);\n select * into v_prior from public.sponsorship_allocation_command where actor_user_id=p_actor and idempotency_key=p_key;\n if found then if v_prior.command<>v_command then raise exception 'Retry key reused for changed allocation';end if;return v_prior.result||jsonb_build_object('replayed',true);end if;\n select * into v_proof from public.sponsorship_payment_proof where id=p_proof for update;\n if not found then raise exception 'Payment proof not found';end if;\n select coalesce(sum(amount_cents),0) into v_net from public.sponsorship_payment_allocation where proof_id=p_proof;\n if v_net<>p_expected_net then raise exception 'Allocation balance changed; reload the ledger';end if;\n if p_amount is null or p_amount<=0 or p_amount>v_proof.amount_cents-v_net then raise exception 'Allocation exceeds the remaining received money';end if;\n v_result:=private.append_sponsorship_allocations(p_proof,v_actor,jsonb_build_array(jsonb_build_object('periodMonth',p_month,'amountCents',p_amount)));\n insert into public.audit_log(actor_user_id,action,entity,entity_id,detail) values(p_actor,'sponsorship_pledge.payment_reallocated','sponsorship_pledge',v_proof.pledge_id::text,jsonb_build_object('proofId',p_proof,'beforeNet',v_net,'allocation',v_result,'reason',p_reason));\n insert into public.sponsorship_allocation_command values(p_actor,p_key,v_command,v_result);\n return v_result;\nend; ",
