    {
      "acl": "{postgres=X/postgres,service_role=X/postgres}",
      "name": "volunteer_verified_attendance_count",
      "owner": "postgres",
      "result": "integer",
      "schema": "public",
      "bodyMd5": "93560ed60c651d131a44436ff2021cf5",
      "identity": "p_profile_id uuid, p_policy jsonb, p_scope_key text, p_before_date date",
      "language": "sql",
      "arguments": "p_profile_id uuid, p_policy jsonb, p_scope_key text, p_before_date date",
      "definition": "CREATE OR REPLACE FUNCTION public.volunteer_verified_attendance_count(p_profile_id uuid, p_policy jsonb, p_scope_key text, p_before_date date)\n RETURNS integer\n LANGUAGE sql\n STABLE\n SET search_path TO 'public', 'pg_temp'\nAS $function$\n select case when p_policy->>'attendance_unit'='once_per_day'\n  then count(distinct (a.starts_at at time zone (p_policy->>'timezone'))::date)\n  else count(distinct r.id) filter(where not exists(\n   select 1 from public.volunteer_registration r2\n   join public.volunteer_activity a2 on a2.id=r2.activity_id\n   where r2.profile_id=r.profile_id and r2.id<>r.id and r2.status='approved'\n   and r2.attendance_status in ('attended','completed')\n   and exists(select 1 from public.volunteer_attendance_event e2 where e2.registration_id=r2.id)\n   and a2.starts_at<coalesce(a.ends_at,a.starts_at) and coalesce(a2.ends_at,a2.starts_at)>a.starts_at\n  )) end::integer\n from public.volunteer_registration r\n join public.volunteer_activity a on a.id=r.activity_id\n join public.volunteer_profile p on p.id=r.profile_id\n where r.profile_id=p_profile_id and r.status='approved'\n and r.attendance_status in ('attended','completed')\n and p.history_coverage_start is not null\n and (a.starts_at at time zone (p_policy->>'timezone'))::date>=p.history_coverage_start\n and (a.starts_at at time zone (p_policy->>'timezone'))::date<p_before_date\n and coalesce(a.ends_at,a.starts_at)<=clock_timestamp()\n and (p_policy->>'shelter_scope'='combined' or a.shelter_key=p_scope_key)\n and exists(select 1 from public.volunteer_attendance_event e where e.registration_id=r.id)\n$function$\n",
      "completeProc": {
        "oid": "31966",
        "proacl": [
          "postgres=X/postgres",
          "service_role=X/postgres"
        ],
        "probin": null,
        "prosrc": "\n select case when p_policy->>'attendance_unit'='once_per_day'\n  then count(distinct (a.starts_at at time zone (p_policy->>'timezone'))::date)\n  else count(distinct r.id) filter(where not exists(\n   select 1 from public.volunteer_registration r2\n   join public.volunteer_activity a2 on a2.id=r2.activity_id\n   where r2.profile_id=r.profile_id and r2.id<>r.id and r2.status='approved'\n   and r2.attendance_status in ('attended','completed')\n   and exists(select 1 from public.volunteer_attendance_event e2 where e2.registration_id=r2.id)\n   and a2.starts_at<coalesce(a.ends_at,a.starts_at) and coalesce(a2.ends_at,a2.starts_at)>a.starts_at\n  )) end::integer\n from public.volunteer_registration r\n join public.volunteer_activity a on a.id=r.activity_id\n join public.volunteer_profile p on p.id=r.profile_id\n where r.profile_id=p_profile_id and r.status='approved'\n and r.attendance_status in ('attended','completed')\n and p.history_coverage_start is not null\n and (a.starts_at at time zone (p_policy->>'timezone'))::date>=p.history_coverage_start\n and (a.starts_at at time zone (p_policy->>'timezone'))::date<p_before_date\n and coalesce(a.ends_at,a.starts_at)<=clock_timestamp()\n and (p_policy->>'shelter_scope'='combined' or a.shelter_key=p_scope_key)\n and exists(select 1 from public.volunteer_attendance_event e where e.registration_id=r.id)\n",
        "procost": 100,
