      "definition": "CREATE OR REPLACE FUNCTION public.protect_legacy_volunteer_attendance()\n RETURNS trigger\n LANGUAGE plpgsql\n SET search_path TO 'public', 'pg_temp'\nAS $function$\nbegin\n if old.attendance_status <> 'not_marked' then raise exception 'Historical attendance cannot be deleted' using errcode='42501'; end if;\n return old;\nend $function$\n",
