    {
      "acl": "{postgres=X/postgres,service_role=X/postgres}",
      "name": "volunteer_policy_evaluate",
      "owner": "postgres",
      "result": "jsonb",
      "schema": "public",
      "bodyMd5": "67ffec5b5f1903adb0bea39131a42399",
      "identity": "p_activity uuid, p_profile uuid, p_role text, p_now timestamp with time zone, p_exclude uuid",
      "language": "plpgsql",
      "arguments": "p_activity uuid, p_profile uuid, p_role text, p_now timestamp with time zone, p_exclude uuid DEFAULT NULL::uuid",
      "definition": "CREATE OR REPLACE FUNCTION public.volunteer_policy_evaluate(p_activity uuid, p_profile uuid, p_role text, p_now timestamp with time zone, p_exclude uuid DEFAULT NULL::uuid)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public', 'pg_temp'\nAS $function$begin\r\n if exists(select 1 from public.volunteer_activity where id=p_activity and registrations_closed_at is not null)\r\n and not exists(select 1 from public.volunteer_registration where id=p_exclude and activity_id=p_activity and status='approved') then\r\n return jsonb_build_object('allowed',false,'reason','registration_closed');end if;\r\n return public.volunteer_policy_evaluate_before_bulk(p_activity,p_profile,p_role,p_now,p_exclude);\r\nend $function$\n",
