      "bodyMd5": "d61f5661d58437aaf9ba566d130d652a",
      "identity": "p_job uuid, p_owner uuid, p_csv_chunk text, p_count integer",
      "language": "plpgsql",
      "arguments": "p_job uuid, p_owner uuid, p_csv_chunk text, p_count integer",
      "definition": "CREATE OR REPLACE FUNCTION public.append_crm_export_job_page(p_job uuid, p_owner uuid, p_csv_chunk text, p_count integer)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public', 'pg_temp'\nAS $function$\r\ndeclare v_job public.crm_export_job%rowtype; v_ready boolean;\r\nbegin\r\n  select * into v_job from public.crm_export_job where id=p_job for update;\r\n  if not found or v_job.status<>'processing' or v_job.lease_owner is distinct from p_owner\r\n    or v_job.lease_until<=clock_timestamp() or v_job.expires_at<=clock_timestamp() then\r\n    return null;\r\n  end if;\r\n  if p_count<0 or p_count>500 or (p_count=0 and v_job.total<>0)\r\n    or v_job.processed_count+p_count>v_job.total\r\n    or p_count<>least(500,v_job.total-v_job.processed_count) then\r\n    raise exception 'invalid_crm_export_page' using errcode='22023';\r\n  end if;\r\n  if v_job.processed_count=0 then\r\n    insert into private.crm_export_artifact(job_id,csv) values(p_job,p_csv_chunk);\r\n  else\r\n    update private.crm_export_artifact set csv=csv||p_csv_chunk where job_id=p_job;\r\n    if not found then raise exception 'crm_export_artifact_missing' using errcode='P0001'; end if;\r\n  end if;\r\n  v_ready:=v_job.processed_count+p_count=v_job.total;\r\n  update public.crm_export_job set processed_count=processed_count+p_count,\r\n    status=case when v_ready then 'ready' else 'pending' end,\r\n    lease_owner=null,lease_until=null,attempts=0,error_code=null,updated_at=clock_timestamp()\r\n    where id=p_job;\r\n  insert into public.audit_log(actor_user_id,action,entity,entity_id,timestamp,detail)\r\n    values(v_job.actor_user_id,case when v_ready then 'export.job.ready' else 'export.job.page' end,\r\n      'crm_export',p_job::text,clock_timestamp(),\r\n      jsonb_build_object('kind',v_job.kind,'processed',v_job.processed_count+p_count,'total',v_job.total));\r\n  return jsonb_build_object('status',case when v_ready then 'ready' else 'pending' end,\r\n    'processed',v_job.processed_count+p_count,'total',v_job.total);\r\nend;\r\n$function$\n",
      "completeProc": {
        "oid": "35276",
        "proacl": [
          "postgres=X/postgres",
          "service_role=X/postgres"
        ],
        "probin": null,
        "prosrc": "\r\ndeclare v_job public.crm_export_job%rowtype; v_ready boolean;\r\nbegin\r\n  select * into v_job from public.crm_export_job where id=p_job for update;\r\n  if not found or v_job.status<>'processing' or v_job.lease_owner is distinct from p_owner\r\n    or v_job.lease_until<=clock_timestamp() or v_job.expires_at<=clock_timestamp() then\r\n    return null;\r\n  end if;\r\n  if p_count<0 or p_count>500 or (p_count=0 and v_job.total<>0)\r\n    or v_job.processed_count+p_count>v_job.total\r\n    or p_count<>least(500,v_job.total-v_job.processed_count) then\r\n    raise exception 'invalid_crm_export_page' using errcode='22023';\r\n  end if;\r\n  if v_job.processed_count=0 then\r\n    insert into private.crm_export_artifact(job_id,csv) values(p_job,p_csv_chunk);\r\n  else\r\n    update private.crm_export_artifact set csv=csv||p_csv_chunk where job_id=p_job;\r\n    if not found then raise exception 'crm_export_artifact_missing' using errcode='P0001'; end if;\r\n  end if;\r\n  v_ready:=v_job.processed_count+p_count=v_job.total;\r\n  update public.crm_export_job set processed_count=processed_count+p_count,\r\n    status=case when v_ready then 'ready' else 'pending' end,\r\n    lease_owner=null,lease_until=null,attempts=0,error_code=null,updated_at=clock_timestamp()\r\n    where id=p_job;\r\n  insert into public.audit_log(actor_user_id,action,entity,entity_id,timestamp,detail)\r\n    values(v_job.actor_user_id,case when v_ready then 'export.job.ready' else 'export.job.page' end,\r\n      'crm_export',p_job::text,clock_timestamp(),\r\n      jsonb_build_object('kind',v_job.kind,'processed',v_job.processed_count+p_count,'total',v_job.total));\r\n  return jsonb_build_object('status',case when v_ready then 'ready' else 'pending' end,\r\n    'processed',v_job.processed_count+p_count,'total',v_job.total);\r\nend;\r\n",
