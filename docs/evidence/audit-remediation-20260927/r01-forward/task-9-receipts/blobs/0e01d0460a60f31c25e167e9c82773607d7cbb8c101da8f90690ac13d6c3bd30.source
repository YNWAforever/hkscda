      "bodyMd5": "a2475c7ad65e9f80cc08116bae4d72b6",
      "identity": "",
      "language": "plpgsql",
      "arguments": "",
      "definition": "CREATE OR REPLACE FUNCTION public.set_animal_catalog_membership_defaults()\n RETURNS trigger\n LANGUAGE plpgsql\n SET search_path TO 'public', 'pg_temp'\nAS $function$\nbegin\n  if tg_op = 'INSERT' then\n    new.adoption_eligible := coalesce(new.adoption_eligible, new.type in ('cat', 'dog'));\n    new.sponsorship_eligible := coalesce(new.sponsorship_eligible, new.type = 'sponsor');\n  end if;\n  return new;\nend;\n$function$\n",
