      "bodyMd5": "1c2de07cac9b20fb73b50ceb5516b2a5",
      "identity": "p_key text, p_date date, p_timezone text, p_rules jsonb, p_now timestamp with time zone",
      "language": "sql",
      "arguments": "p_key text, p_date date, p_timezone text, p_rules jsonb, p_now timestamp with time zone",
      "definition": "CREATE OR REPLACE FUNCTION public.volunteer_daily_fingerprint(p_key text, p_date date, p_timezone text, p_rules jsonb, p_now timestamp with time zone)\n RETURNS text\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'public', 'pg_temp'\nAS $function$\n select md5(\n coalesce((select to_jsonb(d)::text from public.volunteer_daily_policy_binding d where d.scope_key=p_key and d.service_date=p_date),'')||\n coalesce((select jsonb_agg(to_jsonb(a) order by a.id)::text from public.volunteer_activity a where (a.starts_at at time zone p_timezone)::date=p_date and (split_part(p_key,':',1)='all' or a.shelter_key=split_part(p_key,':',1))),'')||\n coalesce((select jsonb_agg(to_jsonb(b) order by b.id)::text from public.volunteer_registration b join public.volunteer_activity a on a.id=b.activity_id where (a.starts_at at time zone p_timezone)::date=p_date and (split_part(p_key,':',1)='all' or a.shelter_key=split_part(p_key,':',1))),'')||\n coalesce((select jsonb_agg(to_jsonb(v) order by v.id)::text from public.volunteer_profile v),'')||\n coalesce((select jsonb_agg(to_jsonb(c) order by c.id)::text from public.volunteer_credential c),'')||\n coalesce((select jsonb_agg(jsonb_build_object('key',r->>'key','late',p_now>=anchors.anchor-make_interval(hours=>(r->>'within_hours')::integer)) order by r->>'key')::text from jsonb_array_elements(p_rules) r cross join lateral (select case when r#>>'{action,daily_anchor}'='first_session' then min(a.starts_at) else max(a.starts_at) end anchor from public.volunteer_activity a where a.status='published' and a.policy_version_id is not null and (a.starts_at at time zone p_timezone)::date=p_date and (split_part(p_key,':',1)='all' or a.shelter_key=split_part(p_key,':',1))) anchors),'')\n );\n$function$\n",
      "completeProc": {
