      "arguments": "p jsonb",
      "definition": "CREATE OR REPLACE FUNCTION public.volunteer_assessment_policy_ready(p jsonb)\n RETURNS boolean\n LANGUAGE sql\n IMMUTABLE\n SET search_path TO 'public', 'pg_temp'\nAS $function$\n select jsonb_typeof(p)='object' and not jsonb_path_exists(p,'$.** ? (@.state == \"unresolved\" || @.state == \"inherit\")')\n and p->>'senior_auto_demotion'='false' and p->>'timezone'='Asia/Hong_Kong'\n and p->>'attendance_unit' in ('once_per_day','each_verified_nonoverlapping_session')\n and p->>'shelter_scope' in ('combined','separate') and p->>'promotion_trigger' in ('verified_attendance','monthly_assessment')\n and p#>>'{assessment_time}' ~ '^([01][0-9]|2[0-3]):[0-5][0-9]$'\n$function$\n",
