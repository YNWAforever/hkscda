d,detail) values(p_actor_user_id,'volunteer_registration.status_update','volunteer_registration',p_registration_id::text,jsonb_build_object('status',p_status));\n return jsonb_build_object('kind','updated','updatedAt',v_registration.updated_at,'registration',to_jsonb(v_registration));\nend ",
