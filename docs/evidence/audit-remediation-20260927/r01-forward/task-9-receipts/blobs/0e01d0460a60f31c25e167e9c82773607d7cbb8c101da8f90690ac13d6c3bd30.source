      "definition": "CREATE OR REPLACE FUNCTION private.protect_published_annual_report_asset()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\r\nbegin\r\n  if (new.kind <> 'annual_report' or not new.is_published)\r\n    and exists (\r\n      select 1\r\n      from public.annual_reports\r\n      where document_asset_id = new.id\r\n        and is_published = true\r\n    )\r\n  then\r\n    raise exception 'Unpublish the annual report before changing its PDF asset'\r\n      using errcode = '23514';\r\n  end if;\r\n  return new;\r\nend;\r\n$function$\n",
      "completeProc": {
        "oid": "31627",
        "proacl": null,
        "probin": null,
