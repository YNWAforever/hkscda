      "definition": "CREATE OR REPLACE FUNCTION public.apply_crm_assignment_bulk_item(p_actor uuid, p_operation uuid, p_supporter uuid)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\ndeclare\n  v_op public.crm_assignment_bulk_operation%rowtype;\n  v_item public.crm_assignment_bulk_item%rowtype;\n  v_row public.supporter%rowtype;\n  v_new_version bigint;\n  v_status text;\n  v_reason text;\nbegin\n  perform private.require_crm_assignment_user(p_actor);\n  select * into v_op from public.crm_assignment_bulk_operation\n  where id=p_operation and actor_user_id=p_actor for update;\n  if not found then\n    raise exception 'CRM assignment operation unavailable' using errcode='42501';\n  end if;\n  perform private.require_crm_assignment_user(v_op.assignee_user_id);\n  if v_op.expires_at<=pg_catalog.clock_timestamp() then\n    raise exception 'CRM assignment snapshot expired' using errcode='P0001';\n  end if;\n  select * into v_item from public.crm_assignment_bulk_item\n  where operation_id=p_operation and supporter_id=p_supporter for update;\n  if not found then\n    raise exception 'CRM assignment item unavailable' using errcode='42501';\n  end if;\n  if v_item.status<>'pending' then\n    return jsonb_build_object('entityId',p_supporter,'status',v_item.status,\n                              'reasonCode',v_item.reason_code);\n  end if;\n  select * into v_row from public.supporter where id=p_supporter for update;\n  if v_op.expires_at<=pg_catalog.clock_timestamp() then\n    raise exception 'CRM assignment snapshot expired' using errcode='P0001';\n  end if;\n  if not found or v_row.deleted_at is not null then\n    v_status:='skipped';v_reason:='unavailable';\n  elsif v_row.edit_version is distinct from v_item.expected_version\n    or v_row.crm_assignee_user_id is distinct from v_item.before_assignee then\n    v_status:='conflict';v_reason:='version_changed';\n  else\n    update public.supporter set crm_assignee_user_id=v_op.assignee_user_id\n    where id=p_supporter returning edit_version into v_new_version;\n    insert into public.audit_log(actor_user_id,action,entity,entity_id,detail)\n    values(p_actor,'supporter.assign_crm_followup','supporter',p_supporter::text,\n      jsonb_build_object('operationId',p_operation,\n        'beforeAssigneeUserId',v_item.before_assignee,\n        'afterAssigneeUserId',v_op.assignee_user_id,\n        'expectedVersion',v_item.expected_version,'newVersion',v_new_version));\n    v_status:='succeeded';v_reason:=null;\n  end if;\n  update public.crm_assignment_bulk_item\n  set status=v_status,reason_code=v_reason,applied_at=clock_timestamp()\n  where operation_id=p_operation and supporter_id=p_supporter;\n  if v_status<>'succeeded' then\n    insert into public.audit_log(actor_user_id,action,entity,entity_id,detail)\n    values(p_actor,'crm_assignment_bulk.item_result','crm_assignment_bulk_item',p_supporter::text,\n      jsonb_build_object('operationId',p_operation,'status',v_status,\n                         'reasonCode',v_reason));\n  end if;\n  return jsonb_build_object('entityId',p_supporter,'status',v_status,\n                            'reasonCode',v_reason);\nend $function$\n",
