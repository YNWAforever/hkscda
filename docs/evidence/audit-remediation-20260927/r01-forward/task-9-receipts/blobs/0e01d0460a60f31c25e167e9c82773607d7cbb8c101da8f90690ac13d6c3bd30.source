      "arguments": "",
      "definition": "CREATE OR REPLACE FUNCTION private.bump_supporter_edit_version_from_role()\n RETURNS trigger\n LANGUAGE plpgsql\n SET search_path TO ''\nAS $function$\nbegin\n  if tg_op = 'UPDATE' and old.supporter_id is distinct from new.supporter_id then\n    update public.supporter set edit_version = edit_version where id = old.supporter_id;\n  end if;\n  update public.supporter set edit_version = edit_version\n  where id = case when tg_op = 'DELETE' then old.supporter_id else new.supporter_id end;\n  return null;\nend;\n$function$\n",
      "completeProc": {
