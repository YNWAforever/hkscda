    {
      "acl": "{postgres=X/postgres,service_role=X/postgres}",
      "name": "volunteer_legacy_identity_command",
      "owner": "postgres",
      "result": "jsonb",
      "schema": "public",
      "bodyMd5": "c80163ded0db7679d4241103f277a98b",
      "identity": "p_actor uuid, p_command jsonb",
      "language": "plpgsql",
      "arguments": "p_actor uuid, p_command jsonb",
      "definition": "CREATE OR REPLACE FUNCTION public.volunteer_legacy_identity_command(p_actor uuid, p_command jsonb)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public', 'pg_temp'\nAS $function$\ndeclare r public.volunteer_registration%rowtype; p public.volunteer_profile%rowtype; a public.volunteer_activity%rowtype; link public.volunteer_legacy_identity_link%rowtype; role_key text;\nbegin\n perform pg_advisory_xact_lock(hashtextextended('volunteer-domain',0));\n if not exists(select 1 from auth.users u join public.admin_user au on au.auth_user_id=u.id where u.id=p_actor and u.email_confirmed_at is not null and (u.banned_until is null or u.banned_until<=clock_timestamp()) and au.status='active' and au.role in ('staff','admin')) then raise exception 'volunteer_forbidden' using errcode='42501'; end if;\n if p_command->>'action'='list_legacy' then return jsonb_build_object('registrations',(select coalesce(jsonb_agg(jsonb_build_object('id',legacy_registration.id,'contact_name',legacy_registration.contact_name,'contact_email',legacy_registration.contact_email,'status',legacy_registration.status,'updated_at',legacy_registration.updated_at,'title',legacy_activity.title,'starts_at',legacy_activity.starts_at,'policy_bound',legacy_activity.policy_version_id is not null) order by legacy_activity.starts_at),'[]') from public.volunteer_registration legacy_registration join public.volunteer_activity legacy_activity on legacy_activity.id=legacy_registration.activity_id where legacy_registration.profile_id is null and legacy_registration.registration_type='individual' and legacy_registration.participant_count=1 and legacy_registration.status in ('pending','waitlisted') and legacy_activity.starts_at>clock_timestamp())); end if;\n if p_command->>'action'<>'link_legacy' or length(trim(coalesce(p_command->>'reason',''))) not between 1 and 1000 then raise exception 'invalid_legacy_link' using errcode='22023'; end if;\n select * into r from public.volunteer_registration where id=(p_command->>'registration_id')::uuid for update;\n if not found then return jsonb_build_object('kind','not_found'); end if;\n select * into link from public.volunteer_legacy_identity_link where registration_id=r.id;\n if found then return jsonb_build_object('kind',case when link.profile_id=(p_command->>'profile_id')::uuid and link.reason=trim(p_command->>'reason') then 'linked' else 'conflict' end); end if;\n if r.updated_at is distinct from (p_command->>'expected_updated_at')::timestamptz then return jsonb_build_object('kind','conflict'); end if;\n select * into a from public.volunteer_activity where id=r.activity_id;\n select * into p from public.volunteer_profile where id=(p_command->>'profile_id')::uuid;\n if p.id is null or p.status<>'active' or not exists(select 1 from auth.users where id=p.auth_user_id and email_confirmed_at is not null and (banned_until is null or banned_until<=clock_timestamp())) then raise exception 'verified_profile_required' using errcode='42501'; end if;\n if r.profile_id is not null or r.registration_type<>'individual' or r.participant_count<>1 or r.status not in ('pending','waitlisted') or a.starts_at<=clock_timestamp() or r.attendance_status<>'not_marked' then raise exception 'legacy_record_not_linkable' using errcode='22023'; end if;\n role_key:=coalesce(r.duty_role,'volunteer');\n if a.policy_version_id is not null and not exists(select 1 from public.volunteer_policy_version v cross join lateral jsonb_array_elements(v.body->'roles') role where v.id=a.policy_version_id and role->>'key'=role_key) then raise exception 'legacy_role_not_in_policy' using errcode='22023'; end if;\n insert into public.volunteer_legacy_identity_link(registration_id,profile_id,actor_user_id,reason,original_snapshot) values(r.id,p.id,p_actor,trim(p_command->>'reason'),to_jsonb(r));\n update public.volunteer_registration set profile_id=p.id,duty_role=role_key where id=r.id;\n insert into public.audit_log(actor_user_id,action,entity,entity_id,detail) values(p_actor,'volunteer_registration.link_legacy','volunteer_registration',r.id::text,jsonb_build_object('profile_id',p.id,'reason',trim(p_command->>'reason'),'original_policy_version_id',r.booking_policy_version_id,'original_terms_acceptance_id',r.terms_acceptance_id));\n return jsonb_build_object('kind','linked','registration_id',r.id,'profile_id',p.id,'requires_policy',a.policy_version_id is null,'requires_current_consent',true);\nend $function$\n",
      "completeProc": {
        "oid": "31919",
        "proacl": [
          "postgres=X/postgres",
          "service_role=X/postgres"
        ],
        "probin": null,
        "prosrc": "\ndeclare r public.volunteer_registration%rowtype; p public.volunteer_profile%rowtype; a public.volunteer_activity%rowtype; link public.volunteer_legacy_identity_link%rowtype; role_key text;\nbegin\n perform pg_advisory_xact_lock(hashtextextended('volunteer-domain',0));\n if not exists(select 1 from auth.users u join public.admin_user au on au.auth_user_id=u.id where u.id=p_actor and u.email_confirmed_at is not null and (u.banned_until is null or u.banned_until<=clock_timestamp()) and au.status='active' and au.role in ('staff','admin')) then raise exception 'volunteer_forbidden' using errcode='42501'; end if;\n if p_command->>'action'='list_legacy' then return jsonb_build_object('registrations',(select coalesce(jsonb_agg(jsonb_build_object('id',legacy_registration.id,'contact_name',legacy_registration.contact_name,'contact_email',legacy_registration.contact_email,'status',legacy_registration.status,'updated_at',legacy_registration.updated_at,'title',legacy_activity.title,'starts_at',legacy_activity.starts_at,'policy_bound',legacy_activity.policy_version_id is not null) order by legacy_activity.starts_at),'[]') from public.volunteer_registration legacy_registration join public.volunteer_activity legacy_activity on legacy_activity.id=legacy_registration.activity_id where legacy_registration.profile_id is null and legacy_registration.registration_type='individual' and legacy_registration.participant_count=1 and legacy_registration.status in ('pending','waitlisted') and legacy_activity.starts_at>clock_timestamp())); end if;\n if p_command->>'action'<>'link_legacy' or length(trim(coalesce(p_command->>'reason',''))) not between 1 and 1000 then raise exception 'invalid_legacy_link' using errcode='22023'; end if;\n select * into r from public.volunteer_registration where id=(p_command->>'registration_id')::uuid for update;\n if not found then return jsonb_build_object('kind','not_found'); end if;\n select * into link from public.volunteer_legacy_identity_link where registration_id=r.id;\n if found then return jsonb_build_object('kind',case when link.profile_id=(p_command->>'profile_id')::uuid and link.reason=trim(p_command->>'reason') then 'linked' else 'conflict' end); end if;\n if r.updated_at is distinct from (p_command->>'expected_updated_at')::timestamptz then return jsonb_build_object('kind','conflict'); end if;\n select * into a from public.volunteer_activity where id=r.activity_id;\n select * into p from public.volunteer_profile where id=(p_command->>'profile_id')::uuid;\n if p.id is null or p.status<>'active' or not exists(select 1 from auth.users where id=p.auth_user_id and email_confirmed_at is not null and (banned_until is null or banned_until<=clock_timestamp())) then raise exception 'verified_profile_required' using errcode='42501'; end if;\n if r.profile_id is not null or r.registration_type<>'individual' or r.participant_count<>1 or r.status not in ('pending','waitlisted') or a.starts_at<=clock_timestamp() or r.attendance_status<>'not_marked' then raise exception 'legacy_record_not_linkable' using errcode='22023'; end if;\n role_key:=coalesce(r.duty_role,'volunteer');\n if a.policy_version_id is not null and not exists(select 1 from public.volunteer_policy_version v cross join lateral jsonb_array_elements(v.body->'roles') role where v.id=a.policy_version_id and role->>'key'=role_key) then raise exception 'legacy_role_not_in_policy' using errcode='22023'; end if;\n insert into public.volunteer_legacy_identity_link(registration_id,profile_id,actor_user_id,reason,original_snapshot) values(r.id,p.id,p_actor,trim(p_command->>'reason'),to_jsonb(r));\n update public.volunteer_registration set profile_id=p.id,duty_role=role_key where id=r.id;\n insert into public.audit_log(actor_user_id,action,entity,entity_id,detail) values(p_actor,'volunteer_registration.link_legacy','volunteer_registration',r.id::text,jsonb_build_object('profile_id',p.id,'reason',trim(p_command->>'reason'),'original_policy_version_id',r.booking_policy_version_id,'original_terms_acceptance_id',r.terms_acceptance_id));\n return jsonb_build_object('kind','linked','registration_id',r.id,'profile_id',p.id,'requires_policy',a.policy_version_id is null,'requires_current_consent',true);\nend ",
