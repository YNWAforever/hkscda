      "identity": "p jsonb",
      "language": "sql",
      "arguments": "p jsonb",
      "definition": "CREATE OR REPLACE FUNCTION public.internship_validate_intake(p jsonb)\n RETURNS boolean\n LANGUAGE sql\n IMMUTABLE\n SET search_path TO 'public', 'pg_temp'\nAS $function$ select jsonb_typeof(p)='object' and (select array_agg(k order by k) from jsonb_object_keys(p) k)=array['closes_at','enabled','instructions','name','opens_at','shelters'] and jsonb_typeof(p->'enabled')='boolean' and length(p->>'name') between 1 and 150 and length(p->>'instructions')<=3000 and jsonb_typeof(p->'shelters')='array' and jsonb_array_length(p->'shelters') between 1 and 2 and p->'shelters'<@'[\"cat\",\"dog\"]'::jsonb $function$\n",
      "completeProc": {
