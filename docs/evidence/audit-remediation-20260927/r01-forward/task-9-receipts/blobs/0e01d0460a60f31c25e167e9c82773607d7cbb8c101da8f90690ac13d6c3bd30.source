    {
      "acl": "{postgres=X/postgres,service_role=X/postgres}",
      "name": "deactivate_faq_entry_with_audit",
      "owner": "postgres",
      "result": "void",
      "schema": "public",
      "bodyMd5": "e702a73f33970995dd7ed02a4940a829",
      "identity": "p_actor_user_id uuid, p_id uuid",
      "language": "plpgsql",
      "arguments": "p_actor_user_id uuid, p_id uuid",
      "definition": "CREATE OR REPLACE FUNCTION public.deactivate_faq_entry_with_audit(p_actor_user_id uuid, p_id uuid)\n RETURNS void\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public', 'pg_temp'\nAS $function$\r\ndeclare\r\n  actor public.admin_user%rowtype;\r\nbegin\r\n  select * into actor\r\n  from public.admin_user\r\n  where auth_user_id = p_actor_user_id\r\n    and status = 'active'\r\n    and role in ('staff', 'admin');\r\n\r\n  if not found then\r\n    raise exception 'Active staff or admin actor required' using errcode = '42501';\r\n  end if;\r\n\r\n  update public.faq_entry set is_active = false where id = p_id;\r\n\r\n  if not found then\r\n    raise exception 'FAQ entry not found' using errcode = 'P0002';\r\n  end if;\r\n\r\n  insert into public.audit_log (actor_user_id, action, entity, entity_id, detail)\r\n  values (p_actor_user_id, 'faq_entry.deactivate', 'faq_entry', p_id::text, '{}'::jsonb);\r\nend;\r\n$function$\n",
      "completeProc": {
        "oid": "31702",
        "proacl": [
          "postgres=X/postgres",
          "service_role=X/postgres"
        ],
        "probin": null,
        "prosrc": "\r\ndeclare\r\n  actor public.admin_user%rowtype;\r\nbegin\r\n  select * into actor\r\n  from public.admin_user\r\n  where auth_user_id = p_actor_user_id\r\n    and status = 'active'\r\n    and role in ('staff', 'admin');\r\n\r\n  if not found then\r\n    raise exception 'Active staff or admin actor required' using errcode = '42501';\r\n  end if;\r\n\r\n  update public.faq_entry set is_active = false where id = p_id;\r\n\r\n  if not found then\r\n    raise exception 'FAQ entry not found' using errcode = 'P0002';\r\n  end if;\r\n\r\n  insert into public.audit_log (actor_user_id, action, entity, entity_id, detail)\r\n  values (p_actor_user_id, 'faq_entry.deactivate', 'faq_entry', p_id::text, '{}'::jsonb);\r\nend;\r\n",
        "procost": 100,
        "prokind": "f",
        "prolang": "13619",
