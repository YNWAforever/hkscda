      "definition": "CREATE OR REPLACE FUNCTION public.finish_volunteer_runtime_job(p_job_key text, p_bucket timestamp with time zone, p_owner uuid, p_status text, p_result jsonb)\n RETURNS boolean\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public', 'pg_temp'\nAS $function$\ndeclare n int;begin if p_status not in('complete','failed') then raise exception 'invalid job status' using errcode='22023';end if;update public.volunteer_runtime_job_run set status=p_status,result=p_result,lease_until=null,lease_owner=null,updated_at=clock_timestamp() where job_key=p_job_key and bucket=p_bucket and status='running' and lease_owner=p_owner and lease_until>=clock_timestamp();get diagnostics n=row_count;return n=1;end $function$\n",
