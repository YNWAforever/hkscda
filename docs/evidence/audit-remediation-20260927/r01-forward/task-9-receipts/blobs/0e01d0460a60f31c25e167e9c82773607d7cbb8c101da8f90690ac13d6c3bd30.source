      "arguments": "p_job uuid, p_actor uuid",
      "definition": "CREATE OR REPLACE FUNCTION public.cancel_crm_export_job(p_job uuid, p_actor uuid)\n RETURNS boolean\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public', 'pg_temp'\nAS $function$\r\ndeclare v_job public.crm_export_job%rowtype;\r\nbegin\r\n  if not private.crm_export_actor_allowed(p_actor) then return false; end if;\r\n  select * into v_job from public.crm_export_job\r\n    where id=p_job and actor_user_id=p_actor and status in ('pending','processing','ready')\r\n    for update;\r\n  if not found then return false; end if;\r\n  update public.crm_export_job set status='cancelled',lease_owner=null,lease_until=null,\r\n    updated_at=clock_timestamp() where id=p_job;\r\n  delete from private.crm_export_artifact where job_id=p_job;\r\n  insert into public.audit_log(actor_user_id,action,entity,entity_id,timestamp,detail)\r\n    values(p_actor,'export.job.cancel','crm_export',p_job::text,clock_timestamp(),\r\n      jsonb_build_object('kind',v_job.kind,'rowCount',v_job.total));\r\n  return true;\r\nend;\r\n$function$\n",
