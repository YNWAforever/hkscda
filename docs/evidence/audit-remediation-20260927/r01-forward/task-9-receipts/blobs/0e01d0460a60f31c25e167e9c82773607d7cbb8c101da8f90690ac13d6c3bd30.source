    {
      "acl": "{postgres=X/postgres,service_role=X/postgres}",
      "name": "volunteer_policy_window",
      "owner": "postgres",
      "result": "timestamp with time zone",
      "schema": "public",
      "bodyMd5": "7d95828e3cb8ac685b59e3ffcbb2f777",
      "identity": "p_window jsonb, p_start timestamp with time zone, p_timezone text",
      "language": "plpgsql",
      "arguments": "p_window jsonb, p_start timestamp with time zone, p_timezone text",
      "definition": "CREATE OR REPLACE FUNCTION public.volunteer_policy_window(p_window jsonb, p_start timestamp with time zone, p_timezone text)\n RETURNS timestamp with time zone\n LANGUAGE plpgsql\n IMMUTABLE\n SET search_path TO 'public', 'pg_temp'\nAS $function$\nbegin\n case p_window->>'mode'\n when 'hours_before' then return p_start-make_interval(hours=>(p_window->>'value')::integer);\n when 'calendar_days_before' then return (((p_start at time zone p_timezone)::date-(p_window->>'value')::integer)+(p_window->>'at')::time) at time zone p_timezone;\n when 'unrestricted' then return '-infinity'::timestamptz;\n when 'disabled' then return 'infinity'::timestamptz;\n else raise exception 'invalid_policy_window' using errcode='22023'; end case;\nend $function$\n",
      "completeProc": {
        "oid": "31952",
        "proacl": [
          "postgres=X/postgres",
          "service_role=X/postgres"
        ],
        "probin": null,
