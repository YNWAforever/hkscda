      "arguments": "p_job uuid, p_actor uuid",
      "definition": "CREATE OR REPLACE FUNCTION public.crm_export_job_status(p_job uuid, p_actor uuid)\n RETURNS jsonb\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'public', 'pg_temp'\nAS $function$\r\n  select case when private.crm_export_actor_allowed(p_actor) then\r\n    (select jsonb_build_object('id',j.id,'kind',j.kind,'total',j.total,\r\n      'status',case when j.expires_at<=clock_timestamp() then 'expired' else j.status end,\r\n      'processed',j.processed_count,'errorCode',j.error_code,'expiresAt',j.expires_at)\r\n      from public.crm_export_job j where j.id=p_job and j.actor_user_id=p_actor)\r\n    else null end;\r\n$function$\n",
