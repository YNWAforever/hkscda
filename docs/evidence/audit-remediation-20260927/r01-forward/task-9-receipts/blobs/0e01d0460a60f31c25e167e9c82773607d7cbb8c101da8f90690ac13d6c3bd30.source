    {
      "acl": "{postgres=X/postgres,service_role=X/postgres}",
      "name": "open_sponsorship_followup_months",
      "owner": "postgres",
      "result": "integer",
      "schema": "public",
      "bodyMd5": "8db7111065a577cbd380602669dcc014",
      "identity": "p_actor uuid, p_pledge uuid",
      "language": "plpgsql",
      "arguments": "p_actor uuid, p_pledge uuid",
      "definition": "CREATE OR REPLACE FUNCTION public.open_sponsorship_followup_months(p_actor uuid, p_pledge uuid)\n RETURNS integer\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public', 'pg_temp'\nAS $function$\ndeclare v_pledge public.sponsorship_pledge%rowtype;v_count integer;\nbegin\n if not exists(select 1 from public.admin_user where auth_user_id=p_actor and status='active' and role in ('admin','staff')) then raise exception 'Coordinator required' using errcode='42501'; end if;\n select * into v_pledge from public.sponsorship_pledge where id=p_pledge for update;\n if not found or v_pledge.status not in ('active','needs_followup') then raise exception 'Only ongoing commitments have follow-up months'; end if;\n insert into public.sponsorship_period(pledge_id,period_month,committed_cents)\n select p_pledge,m::date,v_pledge.amount_cents from generate_series(date_trunc('month',v_pledge.created_at at time zone 'Asia/Hong_Kong'),date_trunc('month',now() at time zone 'Asia/Hong_Kong'),interval '1 month') m\n on conflict(pledge_id,period_month) do nothing;\n get diagnostics v_count=row_count;\n if v_count>0 then insert into public.audit_log(actor_user_id,action,entity,entity_id,detail) values(p_actor,'sponsorship_pledge.followup_months_opened','sponsorship_pledge',p_pledge::text,jsonb_build_object('count',v_count,'classification','service_followup_not_debt')); end if;\n return v_count;\nend; $function$\n",
      "completeProc": {
        "oid": "31734",
        "proacl": [
          "postgres=X/postgres",
          "service_role=X/postgres"
        ],
        "probin": null,
        "prosrc": "\ndeclare v_pledge public.sponsorship_pledge%rowtype;v_count integer;\nbegin\n if not exists(select 1 from public.admin_user where auth_user_id=p_actor and status='active' and role in ('admin','staff')) then raise exception 'Coordinator required' using errcode='42501'; end if;\n select * into v_pledge from public.sponsorship_pledge where id=p_pledge for update;\n if not found or v_pledge.status not in ('active','needs_followup') then raise exception 'Only ongoing commitments have follow-up months'; end if;\n insert into public.sponsorship_period(pledge_id,period_month,committed_cents)\n select p_pledge,m::date,v_pledge.amount_cents from generate_series(date_trunc('month',v_pledge.created_at at time zone 'Asia/Hong_Kong'),date_trunc('month',now() at time zone 'Asia/Hong_Kong'),interval '1 month') m\n on conflict(pledge_id,period_month) do nothing;\n get diagnostics v_count=row_count;\n if v_count>0 then insert into public.audit_log(actor_user_id,action,entity,entity_id,detail) values(p_actor,'sponsorship_pledge.followup_months_opened','sponsorship_pledge',p_pledge::text,jsonb_build_object('count',v_count,'classification','service_followup_not_debt')); end if;\n return v_count;\nend; ",
