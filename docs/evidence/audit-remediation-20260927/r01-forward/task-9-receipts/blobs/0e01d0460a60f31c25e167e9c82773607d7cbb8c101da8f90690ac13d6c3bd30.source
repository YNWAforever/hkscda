        "probin": null,
        "prosrc": "\nbegin\n if tg_op='DELETE' then raise exception 'Sponsorship financial history cannot be deleted'; end if;\n if new.contact_snapshot is distinct from old.contact_snapshot then raise exception 'Proof contact snapshot is immutable'; end if;\n if old.review_status <> 'pending' and (new.pledge_id,new.amount_cents,new.payment_date,new.payment_method,new.reference,new.storage_path,new.review_status)\n  is distinct from (old.pledge_id,old.amount_cents,old.payment_date,old.payment_method,old.reference,old.storage_path,old.review_status) then\n  raise exception 'Reviewed money and proof facts require an append-only correction';\n end if;\n return new;\nend; ",
