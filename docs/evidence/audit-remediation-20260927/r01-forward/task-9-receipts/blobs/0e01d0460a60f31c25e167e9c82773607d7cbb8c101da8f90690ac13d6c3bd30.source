      "identity": "p_reviewer uuid",
      "language": "plpgsql",
      "arguments": "p_reviewer uuid",
      "definition": "CREATE OR REPLACE FUNCTION private.require_volunteer_review_reviewer(p_reviewer uuid)\n RETURNS void\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\r\nbegin\r\n  perform 1 from public.admin_user a join auth.users u on u.id=a.auth_user_id\r\n    where a.auth_user_id=p_reviewer and a.status='active' and a.role in ('staff','admin')\r\n      and u.email_confirmed_at is not null\r\n      and (u.banned_until is null or u.banned_until <= now())\r\n  for share of a,u;\r\n  if not found then raise exception 'Volunteer reviewer unavailable' using errcode='42501'; end if;\r\nend $function$\n",
      "completeProc": {
