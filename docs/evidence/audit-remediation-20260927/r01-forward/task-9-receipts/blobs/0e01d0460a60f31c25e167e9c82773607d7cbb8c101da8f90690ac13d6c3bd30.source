    {
      "acl": "{postgres=X/postgres,service_role=X/postgres}",
      "name": "allocate_receipt_number",
      "owner": "postgres",
      "result": "text",
      "schema": "private",
      "bodyMd5": "f38b296646cf90a4ac5e63bdca4827a6",
      "identity": "p_tax_year integer",
      "language": "plpgsql",
      "arguments": "p_tax_year integer",
      "definition": "CREATE OR REPLACE FUNCTION private.allocate_receipt_number(p_tax_year integer)\n RETURNS text\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public', 'pg_temp'\nAS $function$\ndeclare\n  allocated_sequence integer;\nbegin\n  insert into public.receipt_sequence (tax_year, next_value)\n  values (p_tax_year, 2)\n  on conflict (tax_year) do update\n    set next_value = public.receipt_sequence.next_value + 1,\n        updated_at = now()\n  returning next_value - 1 into allocated_sequence;\n\n  return 'HKSCDA-' || p_tax_year || '-' || lpad(allocated_sequence::text, 6, '0');\nend;\n$function$\n",
      "completeProc": {
        "oid": "31592",
        "proacl": [
          "postgres=X/postgres",
          "service_role=X/postgres"
        ],
        "probin": null,
