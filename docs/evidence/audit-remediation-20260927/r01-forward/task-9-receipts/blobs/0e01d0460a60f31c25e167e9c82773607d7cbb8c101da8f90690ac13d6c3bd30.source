    {
      "acl": "{postgres=X/postgres,service_role=X/postgres}",
      "name": "volunteer_enforce_registration_policy",
      "owner": "postgres",
      "result": "trigger",
      "schema": "public",
      "bodyMd5": "af0bfac688e3fd7f7acaae5376195804",
      "identity": "",
      "language": "plpgsql",
      "arguments": "",
      "definition": "CREATE OR REPLACE FUNCTION public.volunteer_enforce_registration_policy()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public', 'pg_temp'\nAS $function$\r\ndeclare a public.volunteer_activity%rowtype; evaluation jsonb; p jsonb; required_terms uuid;\r\nbegin\r\n if tg_op='UPDATE' and old.attendance_status in ('attended','completed') and new.status<>'approved' then raise exception 'attendance_correction_required' using errcode='22023'; end if;\r\n select * into a from public.volunteer_activity where id=new.activity_id;\r\n if tg_op='UPDATE' and old.profile_id is null and new.profile_id is not null and new.status=old.status and new.activity_id=old.activity_id and new.booking_policy_version_id is not distinct from old.booking_policy_version_id and new.terms_acceptance_id is not distinct from old.terms_acceptance_id and new.duty_role=coalesce(old.duty_role,'volunteer') and exists(select 1 from public.volunteer_legacy_identity_link l where l.registration_id=new.id and l.profile_id=new.profile_id and l.original_snapshot->>'updated_at'=to_jsonb(old)->>'updated_at') then return new; end if;\r\n if a.policy_version_id is null then\r\n  if a.starts_at>clock_timestamp() and new.status in ('pending','approved','waitlisted') and (tg_op='INSERT' or new.status is distinct from old.status or new.activity_id is distinct from old.activity_id) then raise exception 'current_policy_required' using errcode='22023'; end if;\r\n  return new;\r\n end if;\r\n if tg_op='UPDATE' and (new.profile_id,new.booking_policy_version_id,new.terms_acceptance_id) is distinct from (old.profile_id,old.booking_policy_version_id,old.terms_acceptance_id) then raise exception 'immutable_booking_identity' using errcode='42501'; end if;\r\n\r\n if new.status in ('pending','approved','waitlisted') and (tg_op='INSERT' or new.status is distinct from old.status or new.activity_id is distinct from old.activity_id or new.duty_role is distinct from old.duty_role) then\r\n if new.profile_id is null or new.participant_count<>1 or new.registration_type<>'individual' then raise exception 'verified_profile_required' using errcode='42501'; end if;\r\n select body into p from public.volunteer_policy_version where id=a.policy_version_id;\r\n if tg_op='UPDATE' and old.status='waitlisted' and new.status in ('approved','pending') and p#>>'{booking,waitlist_order}'='first_come_first_served' and exists(\r\n  select 1 from public.volunteer_registration earlier\r\n  where earlier.activity_id=a.id and earlier.status='waitlisted' and earlier.id<>new.id\r\n  and (earlier.created_at,earlier.id)<(old.created_at,old.id)\r\n  and coalesce((public.volunteer_policy_evaluate(a.id,earlier.profile_id,earlier.duty_role,clock_timestamp(),earlier.id)->>'allowed')::boolean,false)\r\n  and exists(select 1 from public.volunteer_terms_acceptance ac join public.volunteer_terms_version tv on tv.id=ac.version_id where ac.profile_id=earlier.profile_id and tv.published_at<=clock_timestamp() and (p#>>'{terms,reconsent}'='existing_acceptance_valid' or ac.version_id=coalesce((p#>>'{terms,version_id}')::uuid,(select latest.id from public.volunteer_terms_version latest where latest.published_at<=clock_timestamp() order by latest.published_at desc limit 1))))\r\n ) then raise exception 'waitlist_priority' using errcode='22023';end if;\r\n\r\n if new.status='waitlisted' then\r\n  if coalesce((p#>>'{booking,allow_waitlist}')::boolean,false) is not true then raise exception 'waitlist_disabled' using errcode='22023'; end if;\r\n  if p#>>'{booking,waitlist_limit,state}'='value' and (select count(*) from public.volunteer_registration where activity_id=a.id and status='waitlisted' and id<>new.id)>=(p#>>'{booking,waitlist_limit,value}')::integer then raise exception 'waitlist_full' using errcode='22023'; end if;\r\n end if;\r\n required_terms:=(p#>>'{terms,version_id}')::uuid;\r\n if required_terms is null then select id into required_terms from public.volunteer_terms_version where published_at<=clock_timestamp() order by published_at desc limit 1; end if;\r\n if p#>>'{terms,reconsent}'='require_current' and not exists(select 1 from public.volunteer_terms_acceptance ac join public.volunteer_terms_version tv on tv.id=ac.version_id where ac.profile_id=new.profile_id and ac.version_id=required_terms and tv.published_at<=clock_timestamp()) then raise exception 'current_terms_required' using errcode='22023'; end if;\r\n perform public.volunteer_persist_releases(a.id,clock_timestamp());\r\n evaluation:=public.volunteer_policy_evaluate(a.id,new.profile_id,new.duty_role,clock_timestamp(),case when tg_op='UPDATE' then new.id else null end);\r\n if not (evaluation->>'allowed')::boolean and not (new.status='waitlisted' and evaluation->>'reason' in ('capacity_full','role_full','tier_quota_full','daily_quota_full','reserved_for_core_role')) then raise exception 'volunteer_policy_denied:%',evaluation->>'reason' using errcode='22023'; end if;\r\n if not exists(select 1 from public.volunteer_terms_acceptance where id=new.terms_acceptance_id and profile_id=new.profile_id) and not exists(select 1 from public.volunteer_legacy_identity_link l join public.volunteer_terms_acceptance ac on ac.profile_id=l.profile_id where l.registration_id=new.id and l.profile_id=new.profile_id and ac.version_id=required_terms) then raise exception 'terms_required' using errcode='22023'; end if;\r\n end if;\r\n return new;\r\nend $function$\n",
      "completeProc": {
        "oid": "31914",
        "proacl": [
          "postgres=X/postgres",
          "service_role=X/postgres"
        ],
        "probin": null,
        "prosrc": "\r\ndeclare a public.volunteer_activity%rowtype; evaluation jsonb; p jsonb; required_terms uuid;\r\nbegin\r\n if tg_op='UPDATE' and old.attendance_status in ('attended','completed') and new.status<>'approved' then raise exception 'attendance_correction_required' using errcode='22023'; end if;\r\n select * into a from public.volunteer_activity where id=new.activity_id;\r\n if tg_op='UPDATE' and old.profile_id is null and new.profile_id is not null and new.status=old.status and new.activity_id=old.activity_id and new.booking_policy_version_id is not distinct from old.booking_policy_version_id and new.terms_acceptance_id is not distinct from old.terms_acceptance_id and new.duty_role=coalesce(old.duty_role,'volunteer') and exists(select 1 from public.volunteer_legacy_identity_link l where l.registration_id=new.id and l.profile_id=new.profile_id and l.original_snapshot->>'updated_at'=to_jsonb(old)->>'updated_at') then return new; end if;\r\n if a.policy_version_id is null then\r\n  if a.starts_at>clock_timestamp() and new.status in ('pending','approved','waitlisted') and (tg_op='INSERT' or new.status is distinct from old.status or new.activity_id is distinct from old.activity_id) then raise exception 'current_policy_required' using errcode='22023'; end if;\r\n  return new;\r\n end if;\r\n if tg_op='UPDATE' and (new.profile_id,new.booking_policy_version_id,new.terms_acceptance_id) is distinct from (old.profile_id,old.booking_policy_version_id,old.terms_acceptance_id) then raise exception 'immutable_booking_identity' using errcode='42501'; end if;\r\n\r\n if new.status in ('pending','approved','waitlisted') and (tg_op='INSERT' or new.status is distinct from old.status or new.activity_id is distinct from old.activity_id or new.duty_role is distinct from old.duty_role) then\r\n if new.profile_id is null or new.participant_count<>1 or new.registration_type<>'individual' then raise exception 'verified_profile_required' using errcode='42501'; end if;\r\n select body into p from public.volunteer_policy_version where id=a.policy_version_id;\r\n if tg_op='UPDATE' and old.status='waitlisted' and new.status in ('approved','pending') and p#>>'{booking,waitlist_order}'='first_come_first_served' and exists(\r\n  select 1 from public.volunteer_registration earlier\r\n  where earlier.activity_id=a.id and earlier.status='waitlisted' and earlier.id<>new.id\r\n  and (earlier.created_at,earlier.id)<(old.created_at,old.id)\r\n  and coalesce((public.volunteer_policy_evaluate(a.id,earlier.profile_id,earlier.duty_role,clock_timestamp(),earlier.id)->>'allowed')::boolean,false)\r\n  and exists(select 1 from public.volunteer_terms_acceptance ac join public.volunteer_terms_version tv on tv.id=ac.version_id where ac.profile_id=earlier.profile_id and tv.published_at<=clock_timestamp() and (p#>>'{terms,reconsent}'='existing_acceptance_valid' or ac.version_id=coalesce((p#>>'{terms,version_id}')::uuid,(select latest.id from public.volunteer_terms_version latest where latest.published_at<=clock_timestamp() order by latest.published_at desc limit 1))))\r\n ) then raise exception 'waitlist_priority' using errcode='22023';end if;\r\n\r\n if new.status='waitlisted' then\r\n  if coalesce((p#>>'{booking,allow_waitlist}')::boolean,false) is not true then raise exception 'waitlist_disabled' using errcode='22023'; end if;\r\n  if p#>>'{booking,waitlist_limit,state}'='value' and (select count(*) from public.volunteer_registration where activity_id=a.id and status='waitlisted' and id<>new.id)>=(p#>>'{booking,waitlist_limit,value}')::integer then raise exception 'waitlist_full' using errcode='22023'; end if;\r\n end if;\r\n required_terms:=(p#>>'{terms,version_id}')::uuid;\r\n if required_terms is null then select id into required_terms from public.volunteer_terms_version where published_at<=clock_timestamp() order by published_at desc limit 1; end if;\r\n if p#>>'{terms,reconsent}'='require_current' and not exists(select 1 from public.volunteer_terms_acceptance ac join public.volunteer_terms_version tv on tv.id=ac.version_id where ac.profile_id=new.profile_id and ac.version_id=required_terms and tv.published_at<=clock_timestamp()) then raise exception 'current_terms_required' using errcode='22023'; end if;\r\n perform public.volunteer_persist_releases(a.id,clock_timestamp());\r\n evaluation:=public.volunteer_policy_evaluate(a.id,new.profile_id,new.duty_role,clock_timestamp(),case when tg_op='UPDATE' then new.id else null end);\r\n if not (evaluation->>'allowed')::boolean and not (new.status='waitlisted' and evaluation->>'reason' in ('capacity_full','role_full','tier_quota_full','daily_quota_full','reserved_for_core_role')) then raise exception 'volunteer_policy_denied:%',evaluation->>'reason' using errcode='22023'; end if;\r\n if not exists(select 1 from public.volunteer_terms_acceptance where id=new.terms_acceptance_id and profile_id=new.profile_id) and not exists(select 1 from public.volunteer_legacy_identity_link l join public.volunteer_terms_acceptance ac on ac.profile_id=l.profile_id where l.registration_id=new.id and l.profile_id=new.profile_id and ac.version_id=required_terms) then raise exception 'terms_required' using errcode='22023'; end if;\r\n end if;\r\n return new;\r\nend ",
