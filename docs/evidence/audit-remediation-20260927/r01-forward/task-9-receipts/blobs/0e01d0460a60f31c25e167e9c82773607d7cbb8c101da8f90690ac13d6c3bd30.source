      "bodyMd5": "097a9ec9a5496cb38bf4c794415555bd",
      "identity": "p_job uuid, p_owner uuid, p_offset integer, p_limit integer",
      "language": "plpgsql",
      "arguments": "p_job uuid, p_owner uuid, p_offset integer, p_limit integer",
      "definition": "CREATE OR REPLACE FUNCTION public.crm_export_job_page(p_job uuid, p_owner uuid, p_offset integer, p_limit integer)\n RETURNS jsonb\n LANGUAGE plpgsql\n STABLE SECURITY DEFINER\n SET search_path TO 'public', 'pg_temp'\nAS $function$\r\ndeclare v_job public.crm_export_job%rowtype; v_rows jsonb;\r\nbegin\r\n  select * into v_job from public.crm_export_job where id=p_job and status='processing'\r\n    and lease_owner=p_owner and lease_until>clock_timestamp() and expires_at>clock_timestamp();\r\n  if not found then raise exception 'crm_export_lease_lost' using errcode='42501'; end if;\r\n  if p_offset<0 or p_limit<1 or p_limit>500 then\r\n    raise exception 'invalid_crm_export_page' using errcode='22023';\r\n  end if;\r\n  if v_job.kind='supporters' then\r\n    select coalesce(jsonb_agg(private.crm_supporter_summary(i.id) order by i.ord),'[]'::jsonb)\r\n      into v_rows from unnest(v_job.item_ids[p_offset+1:p_offset+p_limit]) with ordinality i(id,ord);\r\n  else\r\n    select coalesce(jsonb_agg(\r\n      case when d.id is null or s.id is null then null else\r\n      jsonb_build_object('supporterId',d.supporter_id,'supporterName',s.name,\r\n        'supporterEmail',s.email,'donationId',d.id,'amountCents',d.amount_cents,\r\n        'refundedCents',case when d.status='refunded' then d.amount_cents else d.refunded_cents end,\r\n        'purpose',d.purpose,'customPurpose',d.custom_purpose,'status',d.status,\r\n        'method',d.method,'receiptRequested',d.receipt_requested,'createdAt',d.created_at,\r\n        'receiptNo',(select r.receipt_no from public.receipt r where r.supporter_id=d.supporter_id\r\n          and r.status='issued' and r.donation_ids @> array[d.id]\r\n          order by r.issued_at desc,r.id desc limit 1))\r\n      end order by i.ord),'[]'::jsonb) into v_rows\r\n      from unnest(v_job.item_ids[p_offset+1:p_offset+p_limit]) with ordinality i(id,ord)\r\n      left join public.donation d on d.id=i.id\r\n      left join public.supporter s on s.id=d.supporter_id;\r\n  end if;\r\n  return v_rows;\r\nend;\r\n$function$\n",
      "completeProc": {
        "oid": "35275",
        "proacl": [
          "postgres=X/postgres",
          "service_role=X/postgres"
        ],
        "probin": null,
        "prosrc": "\r\ndeclare v_job public.crm_export_job%rowtype; v_rows jsonb;\r\nbegin\r\n  select * into v_job from public.crm_export_job where id=p_job and status='processing'\r\n    and lease_owner=p_owner and lease_until>clock_timestamp() and expires_at>clock_timestamp();\r\n  if not found then raise exception 'crm_export_lease_lost' using errcode='42501'; end if;\r\n  if p_offset<0 or p_limit<1 or p_limit>500 then\r\n    raise exception 'invalid_crm_export_page' using errcode='22023';\r\n  end if;\r\n  if v_job.kind='supporters' then\r\n    select coalesce(jsonb_agg(private.crm_supporter_summary(i.id) order by i.ord),'[]'::jsonb)\r\n      into v_rows from unnest(v_job.item_ids[p_offset+1:p_offset+p_limit]) with ordinality i(id,ord);\r\n  else\r\n    select coalesce(jsonb_agg(\r\n      case when d.id is null or s.id is null then null else\r\n      jsonb_build_object('supporterId',d.supporter_id,'supporterName',s.name,\r\n        'supporterEmail',s.email,'donationId',d.id,'amountCents',d.amount_cents,\r\n        'refundedCents',case when d.status='refunded' then d.amount_cents else d.refunded_cents end,\r\n        'purpose',d.purpose,'customPurpose',d.custom_purpose,'status',d.status,\r\n        'method',d.method,'receiptRequested',d.receipt_requested,'createdAt',d.created_at,\r\n        'receiptNo',(select r.receipt_no from public.receipt r where r.supporter_id=d.supporter_id\r\n          and r.status='issued' and r.donation_ids @> array[d.id]\r\n          order by r.issued_at desc,r.id desc limit 1))\r\n      end order by i.ord),'[]'::jsonb) into v_rows\r\n      from unnest(v_job.item_ids[p_offset+1:p_offset+p_limit]) with ordinality i(id,ord)\r\n      left join public.donation d on d.id=i.id\r\n      left join public.supporter s on s.id=d.supporter_id;\r\n  end if;\r\n  return v_rows;\r\nend;\r\n",
        "procost": 100,
