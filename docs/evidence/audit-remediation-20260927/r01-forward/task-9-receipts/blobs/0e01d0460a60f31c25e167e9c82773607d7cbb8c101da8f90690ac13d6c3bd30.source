    {
      "acl": "{postgres=X/postgres,service_role=X/postgres}",
      "name": "materialize_published_content_snapshot",
      "owner": "postgres",
      "result": "jsonb",
      "schema": "private",
      "bodyMd5": "4135e8e1e0795e89f3e232528d9c8cb6",
      "identity": "p_snapshot jsonb, p_revision_id uuid",
      "language": "sql",
      "arguments": "p_snapshot jsonb, p_revision_id uuid",
      "definition": "CREATE OR REPLACE FUNCTION private.materialize_published_content_snapshot(p_snapshot jsonb, p_revision_id uuid)\n RETURNS jsonb\n LANGUAGE sql\n STABLE\n SET search_path TO 'public', 'pg_temp'\nAS $function$\r\n select jsonb_set(p_snapshot,'{media}',coalesce((select jsonb_agg(case when media->>'storage_bucket'='content-media' then media else media||jsonb_build_object('storage_bucket',asset.public_bucket,'storage_path',asset.public_path) end order by ordinal)\r\n from jsonb_array_elements(p_snapshot->'media') with ordinality as entry(media,ordinal)\r\n left join public.content_public_asset asset on asset.revision_id=p_revision_id and asset.media_id=(media->>'id')::uuid and asset.ready\r\n where media->>'storage_bucket'='content-media' or asset.id is not null),'[]'::jsonb))\r\n$function$\n",
      "completeProc": {
