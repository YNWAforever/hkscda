      "definition": "CREATE OR REPLACE FUNCTION public.fail_crm_export_job(p_job uuid, p_owner uuid, p_error text)\n RETURNS boolean\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public', 'pg_temp'\nAS $function$\r\ndeclare v_job public.crm_export_job%rowtype;\r\nbegin\r\n  update public.crm_export_job set status='failed',lease_owner=null,lease_until=null,\r\n    error_code=left(p_error,80),updated_at=clock_timestamp()\r\n    where id=p_job and status='processing' and lease_owner=p_owner\r\n    returning * into v_job;\r\n  if not found then return false; end if;\r\n  insert into public.audit_log(actor_user_id,action,entity,entity_id,timestamp,detail)\r\n    values(v_job.actor_user_id,'export.job.failed','crm_export',p_job::text,clock_timestamp(),\r\n      jsonb_build_object('kind',v_job.kind,'errorCode',v_job.error_code));\r\n  return true;\r\nend;\r\n$function$\n",
