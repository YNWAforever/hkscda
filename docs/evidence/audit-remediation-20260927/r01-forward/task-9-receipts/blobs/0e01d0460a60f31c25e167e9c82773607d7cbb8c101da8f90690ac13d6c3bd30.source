    {
      "acl": "{postgres=X/postgres,service_role=X/postgres,anon=X/postgres,authenticated=X/postgres}",
      "name": "public_animal_listing_page",
      "owner": "postgres",
      "result": "jsonb",
      "schema": "public",
      "bodyMd5": "ca748f4eeac3f587fca640d132870fe2",
      "identity": "p_filters jsonb",
      "language": "plpgsql",
      "arguments": "p_filters jsonb",
      "definition": "CREATE OR REPLACE FUNCTION public.public_animal_listing_page(p_filters jsonb)\n RETURNS jsonb\n LANGUAGE plpgsql\n STABLE\n SET search_path TO 'public', 'pg_temp'\nAS $function$\ndeclare\n  purpose text := p_filters->>'purpose';\n  species text := p_filters->>'species';\n  age_band text := coalesce(p_filters->>'ageBand','all');\n  sort_order text := coalesce(p_filters->>'sort','newest');\n  gender_filter text := coalesce(p_filters->>'gender','all');\n  neutered_filter text := coalesce(p_filters->>'neutered','all');\n  suitability_filter text := coalesce(p_filters->>'suitability','all');\n  has_photo boolean := coalesce((p_filters->>'hasPhoto')::boolean,false);\n  search_term text := lower(btrim(coalesce(p_filters->>'query','')));\n  requested_page integer := coalesce((p_filters->>'page')::integer,1);\n  page_size integer := coalesce((p_filters->>'pageSize')::integer,16);\n  hk_today date := (now() at time zone 'Asia/Hong_Kong')::date;\n  result jsonb;\nbegin\n  if jsonb_typeof(p_filters) is distinct from 'object'\n    or purpose is null or purpose not in ('adoption','sponsorship')\n    or (purpose='adoption' and (species is null or species not in ('cat','dog')))\n    or (purpose='sponsorship' and species is not null)\n    or age_band not in ('all','bb','adult','senior')\n    or sort_order not in ('newest','oldest')\n    or gender_filter not in ('all','male','female')\n    or neutered_filter not in ('all','yes','no','unknown')\n    or suitability_filter not in ('all','newbie','experienced','unknown')\n    or length(search_term)>80 or requested_page not between 1 and 10000\n    or page_size not between 1 and 48\n    or exists(select 1 from jsonb_object_keys(p_filters) key\n      where key not in ('purpose','species','ageBand','gender','neutered',\n        'suitability','hasPhoto','query','sort','page','pageSize')) then\n    raise exception 'Invalid public listing filters' using errcode='22023';\n  end if;\n  with eligible as (\n    select a.id,a.created_at\n    from public.animals a\n    cross join lateral (select (a.public_profile->>'birthday')::date as birthday) birth\n    cross join lateral (select case\n      when birth.birthday is null then a.public_age_band\n      when birth.birthday>hk_today then 'unknown'\n      when extract(year from age(hk_today,birth.birthday))<1 then 'bb'\n      when extract(year from age(hk_today,birth.birthday))<8 then 'adult'\n      else 'senior' end as band) normalized\n    where a.publication_state='published'\n      and a.status in ('available','fostered') and a.retired_at is null\n      and ((purpose='adoption' and a.adoption_eligible and a.type=species)\n        or (purpose='sponsorship' and a.sponsorship_eligible))\n      and (age_band='all' or normalized.band=age_band)\n      and (gender_filter='all' or a.gender=gender_filter)\n      and (not has_photo or nullif(btrim(a.image_url),'') is not null)\n      and (search_term='' or strpos(lower(a.name),search_term)>0\n        or strpos(lower(coalesce(a.name_en,'')),search_term)>0\n        or strpos(lower(coalesce(a.public_profile->>'code','')),search_term)>0)\n      and (neutered_filter='all'\n        or (neutered_filter='unknown' and a.public_profile->>'neutered' is null)\n        or (neutered_filter='yes' and a.public_profile->>'neutered'='true')\n        or (neutered_filter='no' and a.public_profile->>'neutered'='false'))\n      and (suitability_filter='all'\n        or (suitability_filter='unknown' and a.public_profile->>'suitability' is null)\n        or a.public_profile->>'suitability'=suitability_filter)\n  ), page_ids as (\n    select id,created_at from eligible\n    order by case when sort_order='newest' then created_at end desc,\n      case when sort_order='oldest' then created_at end asc,id\n    limit page_size offset (requested_page-1)*page_size\n  )\n  select jsonb_build_object(\n    'total',(select count(*) from eligible),\n    'page',requested_page,\n    'items',coalesce((select jsonb_agg(\n      jsonb_build_object(\n        'id',a.id,'type',a.type,'name',a.name,'name_en',a.name_en,\n        'gender',a.gender,'age',a.age,'age_en',a.age_en,\n        'description',null,'description_en',null,\n        'status',a.status,'adoption_eligible',a.adoption_eligible,\n        'sponsorship_eligible',a.sponsorship_eligible,'retired_at',null,\n        'publication_state',a.publication_state,'image_url',a.image_url,\n        'created_at',a.created_at,'updated_at',a.updated_at,\n        'public_profile',jsonb_build_object(\n          'code',a.public_profile->>'code','birthday',a.public_profile->>'birthday',\n          'neutered',a.public_profile->'neutered',\n          'suitability',a.public_profile->>'suitability',\n          'personality',left(a.public_profile->>'personality',200),\n          'health',left(a.public_profile->>'health',200),\n          'sponsorUse',left(a.public_profile->>'sponsorUse',200),\n          'recentProgress',left(a.public_profile->>'recentProgress',200))\n      ) order by case when sort_order='newest' then page_ids.created_at end desc,\n        case when sort_order='oldest' then page_ids.created_at end asc,page_ids.id)\n      from page_ids join public.animals a on a.id=page_ids.id),'[]'::jsonb)\n  ) into result;\n  return result;\nend $function$\n",
      "completeProc": {
        "oid": "35524",
        "proacl": [
          "postgres=X/postgres",
          "service_role=X/postgres",
          "anon=X/postgres",
          "authenticated=X/postgres"
        ],
        "probin": null,
        "prosrc": "\ndeclare\n  purpose text := p_filters->>'purpose';\n  species text := p_filters->>'species';\n  age_band text := coalesce(p_filters->>'ageBand','all');\n  sort_order text := coalesce(p_filters->>'sort','newest');\n  gender_filter text := coalesce(p_filters->>'gender','all');\n  neutered_filter text := coalesce(p_filters->>'neutered','all');\n  suitability_filter text := coalesce(p_filters->>'suitability','all');\n  has_photo boolean := coalesce((p_filters->>'hasPhoto')::boolean,false);\n  search_term text := lower(btrim(coalesce(p_filters->>'query','')));\n  requested_page integer := coalesce((p_filters->>'page')::integer,1);\n  page_size integer := coalesce((p_filters->>'pageSize')::integer,16);\n  hk_today date := (now() at time zone 'Asia/Hong_Kong')::date;\n  result jsonb;\nbegin\n  if jsonb_typeof(p_filters) is distinct from 'object'\n    or purpose is null or purpose not in ('adoption','sponsorship')\n    or (purpose='adoption' and (species is null or species not in ('cat','dog')))\n    or (purpose='sponsorship' and species is not null)\n    or age_band not in ('all','bb','adult','senior')\n    or sort_order not in ('newest','oldest')\n    or gender_filter not in ('all','male','female')\n    or neutered_filter not in ('all','yes','no','unknown')\n    or suitability_filter not in ('all','newbie','experienced','unknown')\n    or length(search_term)>80 or requested_page not between 1 and 10000\n    or page_size not between 1 and 48\n    or exists(select 1 from jsonb_object_keys(p_filters) key\n      where key not in ('purpose','species','ageBand','gender','neutered',\n        'suitability','hasPhoto','query','sort','page','pageSize')) then\n    raise exception 'Invalid public listing filters' using errcode='22023';\n  end if;\n  with eligible as (\n    select a.id,a.created_at\n    from public.animals a\n    cross join lateral (select (a.public_profile->>'birthday')::date as birthday) birth\n    cross join lateral (select case\n      when birth.birthday is null then a.public_age_band\n      when birth.birthday>hk_today then 'unknown'\n      when extract(year from age(hk_today,birth.birthday))<1 then 'bb'\n      when extract(year from age(hk_today,birth.birthday))<8 then 'adult'\n      else 'senior' end as band) normalized\n    where a.publication_state='published'\n      and a.status in ('available','fostered') and a.retired_at is null\n      and ((purpose='adoption' and a.adoption_eligible and a.type=species)\n        or (purpose='sponsorship' and a.sponsorship_eligible))\n      and (age_band='all' or normalized.band=age_band)\n      and (gender_filter='all' or a.gender=gender_filter)\n      and (not has_photo or nullif(btrim(a.image_url),'') is not null)\n      and (search_term='' or strpos(lower(a.name),search_term)>0\n        or strpos(lower(coalesce(a.name_en,'')),search_term)>0\n        or strpos(lower(coalesce(a.public_profile->>'code','')),search_term)>0)\n      and (neutered_filter='all'\n        or (neutered_filter='unknown' and a.public_profile->>'neutered' is null)\n        or (neutered_filter='yes' and a.public_profile->>'neutered'='true')\n        or (neutered_filter='no' and a.public_profile->>'neutered'='false'))\n      and (suitability_filter='all'\n        or (suitability_filter='unknown' and a.public_profile->>'suitability' is null)\n        or a.public_profile->>'suitability'=suitability_filter)\n  ), page_ids as (\n    select id,created_at from eligible\n    order by case when sort_order='newest' then created_at end desc,\n      case when sort_order='oldest' then created_at end asc,id\n    limit page_size offset (requested_page-1)*page_size\n  )\n  select jsonb_build_object(\n    'total',(select count(*) from eligible),\n    'page',requested_page,\n    'items',coalesce((select jsonb_agg(\n      jsonb_build_object(\n        'id',a.id,'type',a.type,'name',a.name,'name_en',a.name_en,\n        'gender',a.gender,'age',a.age,'age_en',a.age_en,\n        'description',null,'description_en',null,\n        'status',a.status,'adoption_eligible',a.adoption_eligible,\n        'sponsorship_eligible',a.sponsorship_eligible,'retired_at',null,\n        'publication_state',a.publication_state,'image_url',a.image_url,\n        'created_at',a.created_at,'updated_at',a.updated_at,\n        'public_profile',jsonb_build_object(\n          'code',a.public_profile->>'code','birthday',a.public_profile->>'birthday',\n          'neutered',a.public_profile->'neutered',\n          'suitability',a.public_profile->>'suitability',\n          'personality',left(a.public_profile->>'personality',200),\n          'health',left(a.public_profile->>'health',200),\n          'sponsorUse',left(a.public_profile->>'sponsorUse',200),\n          'recentProgress',left(a.public_profile->>'recentProgress',200))\n      ) order by case when sort_order='newest' then page_ids.created_at end desc,\n        case when sort_order='oldest' then page_ids.created_at end asc,page_ids.id)\n      from page_ids join public.animals a on a.id=page_ids.id),'[]'::jsonb)\n  ) into result;\n  return result;\nend ",
        "procost": 100,
        "prokind": "f",
        "prolang": "13619",
        "proname": "public_animal_listing_page",
        "prorows": 0,
