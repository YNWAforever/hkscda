      "arguments": "p_actor uuid",
      "definition": "CREATE OR REPLACE FUNCTION public.volunteer_policy_admin(p_actor uuid)\n RETURNS void\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public', 'pg_temp'\nAS $function$\nbegin\n if not exists(select 1 from public.admin_user where auth_user_id=p_actor and role='admin' and status='active') then\n raise exception 'volunteer_forbidden' using errcode='42501'; end if;\nend $function$\n",
