      "definition": "CREATE OR REPLACE FUNCTION private.sponsorship_cancel_transition()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public', 'pg_temp'\nAS $function$\nbegin\n if new.status='cancelled' and old.status <> 'cancelled' then\n  perform private.queue_sponsorship_transition(new.id,null,'cancelled','pledge:'||new.id::text||':cancelled:'||new.updated_at::text);\n end if;\n return new;\nend; $function$\n",
