      "definition": "CREATE OR REPLACE FUNCTION public.volunteer_cancellation_reason(p_body jsonb, p_start timestamp with time zone, p_now timestamp with time zone)\n RETURNS text\n LANGUAGE plpgsql\n IMMUTABLE\n SET search_path TO 'public', 'pg_temp'\nAS $function$\r\nbegin\r\n if p_body is null then return 'legacy_session'; end if;\r\n if p_body#>>'{booking,cancellation_close,mode}'='unrestricted' then return null; end if;\r\n if p_body#>>'{booking,cancellation_close,mode}'='disabled' then return 'cancellation_disabled'; end if;\r\n if p_now>=public.volunteer_policy_window(p_body#>'{booking,cancellation_close}',p_start,p_body->>'timezone') then return 'cancellation_closed'; end if;\r\n return null;\r\nend $function$\n",
