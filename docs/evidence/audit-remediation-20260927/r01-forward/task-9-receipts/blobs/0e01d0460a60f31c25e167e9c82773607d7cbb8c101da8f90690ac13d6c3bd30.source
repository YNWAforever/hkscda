    {
      "acl": "{postgres=X/postgres,service_role=X/postgres}",
      "name": "claim_crm_export_job",
      "owner": "postgres",
      "result": "jsonb",
      "schema": "public",
      "bodyMd5": "5ba776bd70ea1b94f5a8f93f71c58e1c",
      "identity": "p_owner uuid",
      "language": "plpgsql",
      "arguments": "p_owner uuid",
      "definition": "CREATE OR REPLACE FUNCTION public.claim_crm_export_job(p_owner uuid)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public', 'pg_temp'\nAS $function$\r\ndeclare v_job public.crm_export_job%rowtype;\r\nbegin\r\n  with exhausted as (\r\n    update public.crm_export_job set status='failed',error_code='retry_exhausted',\r\n      lease_owner=null,lease_until=null,updated_at=clock_timestamp()\r\n      where status='processing' and lease_until<clock_timestamp() and attempts>=3\r\n      returning id,actor_user_id,kind\r\n  )\r\n  insert into public.audit_log(actor_user_id,action,entity,entity_id,timestamp,detail)\r\n    select actor_user_id,'export.job.failed','crm_export',id::text,clock_timestamp(),\r\n      jsonb_build_object('kind',kind,'errorCode','retry_exhausted') from exhausted;\r\n  select * into v_job from public.crm_export_job\r\n    where expires_at>clock_timestamp() and attempts<3\r\n      and (status='pending' or (status='processing' and lease_until<clock_timestamp()))\r\n    order by created_at,id for update skip locked limit 1;\r\n  if not found then return null; end if;\r\n  update public.crm_export_job set status='processing',lease_owner=p_owner,\r\n    lease_until=clock_timestamp()+interval '10 minutes',attempts=attempts+1,\r\n    updated_at=clock_timestamp() where id=v_job.id returning * into v_job;\r\n  return jsonb_build_object('id',v_job.id,'lease_owner',v_job.lease_owner,\r\n    'kind',v_job.kind,'total',v_job.total,'processed',v_job.processed_count,'attempts',v_job.attempts);\r\nend;\r\n$function$\n",
      "completeProc": {
        "oid": "35274",
        "proacl": [
          "postgres=X/postgres",
          "service_role=X/postgres"
        ],
        "probin": null,
        "prosrc": "\r\ndeclare v_job public.crm_export_job%rowtype;\r\nbegin\r\n  with exhausted as (\r\n    update public.crm_export_job set status='failed',error_code='retry_exhausted',\r\n      lease_owner=null,lease_until=null,updated_at=clock_timestamp()\r\n      where status='processing' and lease_until<clock_timestamp() and attempts>=3\r\n      returning id,actor_user_id,kind\r\n  )\r\n  insert into public.audit_log(actor_user_id,action,entity,entity_id,timestamp,detail)\r\n    select actor_user_id,'export.job.failed','crm_export',id::text,clock_timestamp(),\r\n      jsonb_build_object('kind',kind,'errorCode','retry_exhausted') from exhausted;\r\n  select * into v_job from public.crm_export_job\r\n    where expires_at>clock_timestamp() and attempts<3\r\n      and (status='pending' or (status='processing' and lease_until<clock_timestamp()))\r\n    order by created_at,id for update skip locked limit 1;\r\n  if not found then return null; end if;\r\n  update public.crm_export_job set status='processing',lease_owner=p_owner,\r\n    lease_until=clock_timestamp()+interval '10 minutes',attempts=attempts+1,\r\n    updated_at=clock_timestamp() where id=v_job.id returning * into v_job;\r\n  return jsonb_build_object('id',v_job.id,'lease_owner',v_job.lease_owner,\r\n    'kind',v_job.kind,'total',v_job.total,'processed',v_job.processed_count,'attempts',v_job.attempts);\r\nend;\r\n",
        "procost": 100,
        "prokind": "f",
        "prolang": "13619",
