    {
      "acl": null,
      "name": "sponsorship_proof_financial_transition",
      "owner": "postgres",
      "result": "trigger",
      "schema": "private",
      "bodyMd5": "27c46a324776f93c7d739dbc6a709deb",
      "identity": "",
      "language": "plpgsql",
      "arguments": "",
      "definition": "CREATE OR REPLACE FUNCTION private.sponsorship_proof_financial_transition()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public', 'pg_temp'\nAS $function$\ndeclare v_pledge public.sponsorship_pledge%rowtype; v_donation uuid; v_payment uuid; v_method text;\nbegin\n if tg_op='INSERT' then\n  perform private.queue_sponsorship_transition(new.pledge_id,new.id,'proof_recorded','proof:'||new.id::text||':recorded'); return new;\n end if;\n if old.review_status='pending' and new.review_status in ('approved','rejected') then\n  if new.review_status='approved' then\n   select * into v_pledge from public.sponsorship_pledge where id=new.pledge_id for update;\n   -- Preserve bank references so the canonical payment uniqueness rule also\n   -- catches a second proof of the same transfer. No invented receipt consent.\n   v_method := case when new.payment_method in ('fps','payme','paypal') then new.payment_method else 'manual' end;\n   if exists(select 1 from public.sponsorship_payment_source where proof_id=new.id) then raise exception 'Proof already linked to received money'; end if;\n   insert into public.donation(supporter_id,amount_cents,currency,purpose,type,status,method,contact_name,contact_email,contact_phone,contact_language)\n   values(v_pledge.supporter_id,new.amount_cents,'HKD','sponsor','one_time','succeeded',v_method,new.contact_snapshot->>'name',new.contact_snapshot->>'email',new.contact_snapshot->>'phone',new.contact_snapshot->>'language') returning id into v_donation;\n   insert into public.payment(donation_id,provider,provider_ref,amount_cents,status,received_at,reconciled_by,bank_reference)\n   values(v_donation,v_method,nullif(trim(new.reference),''),new.amount_cents,'succeeded',new.payment_date::timestamp at time zone 'Asia/Hong_Kong',new.reviewed_by,new.reference) returning id into v_payment;\n   insert into public.sponsorship_payment_source(proof_id,payment_id,donation_id,source) values(new.id,v_payment,v_donation,'verified_proof');\n  end if;\n  perform private.queue_sponsorship_transition(new.pledge_id,new.id,case new.review_status when 'approved' then 'active' else 'needs_followup' end,'proof:'||new.id::text||':'||new.review_status);\n end if;\n return new;\nend; $function$\n",
      "completeProc": {
        "oid": "31646",
        "proacl": null,
        "probin": null,
        "prosrc": "\ndeclare v_pledge public.sponsorship_pledge%rowtype; v_donation uuid; v_payment uuid; v_method text;\nbegin\n if tg_op='INSERT' then\n  perform private.queue_sponsorship_transition(new.pledge_id,new.id,'proof_recorded','proof:'||new.id::text||':recorded'); return new;\n end if;\n if old.review_status='pending' and new.review_status in ('approved','rejected') then\n  if new.review_status='approved' then\n   select * into v_pledge from public.sponsorship_pledge where id=new.pledge_id for update;\n   -- Preserve bank references so the canonical payment uniqueness rule also\n   -- catches a second proof of the same transfer. No invented receipt consent.\n   v_method := case when new.payment_method in ('fps','payme','paypal') then new.payment_method else 'manual' end;\n   if exists(select 1 from public.sponsorship_payment_source where proof_id=new.id) then raise exception 'Proof already linked to received money'; end if;\n   insert into public.donation(supporter_id,amount_cents,currency,purpose,type,status,method,contact_name,contact_email,contact_phone,contact_language)\n   values(v_pledge.supporter_id,new.amount_cents,'HKD','sponsor','one_time','succeeded',v_method,new.contact_snapshot->>'name',new.contact_snapshot->>'email',new.contact_snapshot->>'phone',new.contact_snapshot->>'language') returning id into v_donation;\n   insert into public.payment(donation_id,provider,provider_ref,amount_cents,status,received_at,reconciled_by,bank_reference)\n   values(v_donation,v_method,nullif(trim(new.reference),''),new.amount_cents,'succeeded',new.payment_date::timestamp at time zone 'Asia/Hong_Kong',new.reviewed_by,new.reference) returning id into v_payment;\n   insert into public.sponsorship_payment_source(proof_id,payment_id,donation_id,source) values(new.id,v_payment,v_donation,'verified_proof');\n  end if;\n  perform private.queue_sponsorship_transition(new.pledge_id,new.id,case new.review_status when 'approved' then 'active' else 'needs_followup' end,'proof:'||new.id::text||':'||new.review_status);\n end if;\n return new;\nend; ",
        "procost": 100,
