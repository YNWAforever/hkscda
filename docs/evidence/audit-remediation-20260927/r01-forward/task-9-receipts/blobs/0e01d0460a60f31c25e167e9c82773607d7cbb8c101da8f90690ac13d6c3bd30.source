    {
      "acl": null,
      "name": "queue_sponsorship_transition",
      "owner": "postgres",
      "result": "void",
      "schema": "private",
      "bodyMd5": "7bec90f55fa05920aef32ea2cbf5992a",
      "identity": "p_pledge uuid, p_proof uuid, p_event text, p_scope text",
      "language": "plpgsql",
      "arguments": "p_pledge uuid, p_proof uuid, p_event text, p_scope text",
      "definition": "CREATE OR REPLACE FUNCTION private.queue_sponsorship_transition(p_pledge uuid, p_proof uuid, p_event text, p_scope text)\n RETURNS void\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public', 'pg_temp'\nAS $function$\ndeclare v_supporter uuid; v_message uuid;v_recipient text;v_name text;v_language text;v_amount integer;\nbegin\n if exists(select 1 from public.sponsorship_delivery_outbox where scope=p_scope) then return; end if;\n select p.supporter_id,s.email,s.name,p.language,p.amount_cents into v_supporter,v_recipient,v_name,v_language,v_amount\n from public.sponsorship_pledge p join public.supporter s on s.id=p.supporter_id where p.id=p_pledge;\n if p_proof is not null then select coalesce(contact_snapshot->>'email',v_recipient),coalesce(contact_snapshot->>'name',v_name),coalesce(contact_snapshot->>'language',v_language),amount_cents into v_recipient,v_name,v_language,v_amount from public.sponsorship_payment_proof where id=p_proof; end if;\n insert into public.message(supporter_id,channel,status,payload) values(v_supporter,'email','queued',\n jsonb_build_object('kind','sponsorship_financial_transition','scope',p_scope,'event',p_event,'pledgeId',p_pledge,'proofId',p_proof)) returning id into v_message;\n insert into public.sponsorship_delivery_outbox(scope,pledge_id,proof_id,message_id,event,recipient_email,recipient_name,language,amount_cents) values(p_scope,p_pledge,p_proof,v_message,p_event,v_recipient,v_name,v_language,v_amount);\nend; $function$\n",
      "completeProc": {
        "oid": "31628",
        "proacl": null,
        "probin": null,
        "prosrc": "\ndeclare v_supporter uuid; v_message uuid;v_recipient text;v_name text;v_language text;v_amount integer;\nbegin\n if exists(select 1 from public.sponsorship_delivery_outbox where scope=p_scope) then return; end if;\n select p.supporter_id,s.email,s.name,p.language,p.amount_cents into v_supporter,v_recipient,v_name,v_language,v_amount\n from public.sponsorship_pledge p join public.supporter s on s.id=p.supporter_id where p.id=p_pledge;\n if p_proof is not null then select coalesce(contact_snapshot->>'email',v_recipient),coalesce(contact_snapshot->>'name',v_name),coalesce(contact_snapshot->>'language',v_language),amount_cents into v_recipient,v_name,v_language,v_amount from public.sponsorship_payment_proof where id=p_proof; end if;\n insert into public.message(supporter_id,channel,status,payload) values(v_supporter,'email','queued',\n jsonb_build_object('kind','sponsorship_financial_transition','scope',p_scope,'event',p_event,'pledgeId',p_pledge,'proofId',p_proof)) returning id into v_message;\n insert into public.sponsorship_delivery_outbox(scope,pledge_id,proof_id,message_id,event,recipient_email,recipient_name,language,amount_cents) values(p_scope,p_pledge,p_proof,v_message,p_event,v_recipient,v_name,v_language,v_amount);\nend; ",
