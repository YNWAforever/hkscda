  "completeUid": [
    {
      "proc": {
        "oid": "24038",
        "proacl": [
          "=X/supabase_auth_admin",
          "supabase_auth_admin=X/supabase_auth_admin",
          "dashboard_user=X/supabase_auth_admin"
        ],
        "probin": null,
        "prosrc": "\r\n  select \r\n  coalesce(\r\n    nullif(current_setting('request.jwt.claim.sub', true), ''),\r\n    (nullif(current_setting('request.jwt.claims', true), '')::jsonb ->> 'sub')\r\n  )::uuid\r\n",
        "procost": 100,
        "prokind": "f",
        "prolang": "14",
        "proname": "uid",
        "prorows": 0,
        "pronargs": 0,
        "proowner": "16504",
        "proconfig": null,
        "proretset": false,
        "prosecdef": false,
        "prorettype": "2950",
        "prosqlbody": null,
        "prosupport": "-",
        "proargmodes": null,
        "proargnames": null,
        "proargtypes": [],
        "proisstrict": false,
        "proparallel": "u",
        "protrftypes": null,
        "provariadic": "0",
        "provolatile": "s",
        "proleakproof": false,
        "pronamespace": "23605",
        "proallargtypes": null,
        "proargdefaults": null,
        "pronargdefaults": 0
      },
      "language": "sql",
      "owner": "supabase_auth_admin",
      "definition": "CREATE OR REPLACE FUNCTION auth.uid()\n RETURNS uuid\n LANGUAGE sql\n STABLE\nAS $function$\r\n  select \r\n  coalesce(\r\n    nullif(current_setting('request.jwt.claim.sub', true), ''),\r\n    (nullif(current_setting('request.jwt.claims', true), '')::jsonb ->> 'sub')\r\n  )::uuid\r\n$function$\n",
      "effective_acl": [
