import datetime, hashlib, json, pathlib, subprocess

ROOT = pathlib.Path(__file__).resolve().parents[3]
PLAN = pathlib.Path(__file__).resolve().parent
OUT = PLAN / ('task-9-fix-4-capture-' + datetime.datetime.now(datetime.timezone.utc).strftime('%Y%m%dT%H%M%SZ'))
OUT.mkdir()

def run(args, stdin=None):
    result = subprocess.run(args, input=stdin, cwd=ROOT, capture_output=True)
    return {'command': args, 'exit': result.returncode, 'stdout': result.stdout.decode('utf-8'), 'stderr': result.stderr.decode('utf-8')}

def save(name, value):
    (OUT / name).write_text(json.dumps(value, ensure_ascii=False, indent=2) + '\n', encoding='utf-8', newline='\n')

query = """BEGIN ISOLATION LEVEL REPEATABLE READ READ ONLY;
SELECT jsonb_build_object(
 'runtime',jsonb_build_object('version',version(),'database',current_database(),'user',current_user,'readonly',current_setting('transaction_read_only')),
 'functions',(select jsonb_agg(jsonb_build_object('schema',n.nspname,'name',p.proname,'identity',pg_get_function_identity_arguments(p.oid),'arguments',pg_get_function_arguments(p.oid),'result',pg_get_function_result(p.oid),'language',l.lanname,'owner',pg_get_userbyid(p.proowner),'completeProc',to_jsonb(p),'definition',pg_get_functiondef(p.oid),'bodyMd5',md5(p.prosrc),'definitionMd5',md5(pg_get_functiondef(p.oid)),'defaultExpression',pg_get_expr(p.proargdefaults,0),'acl',p.proacl::text,'effectiveAcl',(select jsonb_agg(jsonb_build_object('grantor',pg_get_userbyid(a.grantor),'grantee',case when a.grantee=0 then 'PUBLIC' else pg_get_userbyid(a.grantee) end,'privilege',a.privilege_type,'grantable',a.is_grantable) order by a.grantor,a.grantee,a.privilege_type) from aclexplode(coalesce(p.proacl,acldefault('f',p.proowner))) a)) order by n.nspname,p.proname,pg_get_function_identity_arguments(p.oid)) from pg_proc p join pg_namespace n on n.oid=p.pronamespace join pg_language l on l.oid=p.prolang where n.nspname in ('auth','public','private') and p.prokind in ('f','p')),
 'triggers',(select jsonb_agg(to_jsonb(t) order by t.oid) from pg_trigger t),
 'functionAndTriggerDependencies',(select jsonb_agg(to_jsonb(d) order by d.classid,d.objid,d.objsubid,d.refclassid,d.refobjid,d.refobjsubid,d.deptype) from pg_depend d where d.classid in ('pg_proc'::regclass,'pg_trigger'::regclass)),
 'defaults',(select jsonb_agg(to_jsonb(d) order by d.oid) from pg_default_acl d),
 'authRelations',(select jsonb_agg(to_jsonb(c) order by c.oid) from pg_class c join pg_namespace n on n.oid=c.relnamespace where n.nspname='auth'),
 'authColumns',(select jsonb_agg(to_jsonb(a) order by a.attrelid,a.attnum) from pg_attribute a join pg_class c on c.oid=a.attrelid join pg_namespace n on n.oid=c.relnamespace where n.nspname='auth'),
 'roles',(select jsonb_agg(to_jsonb(r) - 'rolpassword' order by r.oid) from pg_roles r),
 'memberships',(select jsonb_agg(to_jsonb(m) order by m.roleid,m.member,m.grantor) from pg_auth_members m)
);
ROLLBACK;
"""
(OUT / 'catalog-query.sql.source').write_text(query, encoding='utf-8', newline='\n')
receipt = {'at': datetime.datetime.now(datetime.timezone.utc).isoformat(), 'sourceCommit': run(['git','rev-parse','HEAD'])['stdout'].strip(), 'qualification': 'Read-only PostgreSQL 17.6 catalog observations; not CI 17.11 metadata or a new accepted profile. No application/Auth data rows or helper execution.', 'captures': []}
for name, container, database in [('modern', 'supabase_db_hkscda-audit-integration-573','postgres'),('template','supabase_db_hkscda-audit-integration-fresh','audit_pr135_20260929')]:
    result = run(['docker','exec','-i',container,'psql','-X','-qAt','-v','ON_ERROR_STOP=1','-U','postgres','-d',database], query.encode())
    save(name+'-command.json',result)
    if result['exit'] != 0:
        receipt['captures'].append({'profile':name,'exit':result['exit'],'error':result['stderr']})
        save('receipt.json',receipt)
        raise RuntimeError(result['stderr'])
    catalog=json.loads(result['stdout'])
    save(name+'-catalog.json',catalog)
    helpers=[f for f in catalog['functions'] if f['schema']=='auth' or (f['schema']=='private' and f['name']=='create_manual_adoption_case')]
    save(name+'-helpers.json',helpers)
    receipt['captures'].append({'profile':name,'command':result['command'],'exit':0,'runtime':catalog['runtime'],'functions':len(catalog['functions']),'triggers':len(catalog['triggers']),'uid':[f for f in helpers if f['name']=='uid'],'privateManual':[f for f in helpers if f['name']=='create_manual_adoption_case']})
receipt['inventory']=run(['docker','image','ls','--format','{{.Repository}}:{{.Tag}}'])
receipt['artifacts']=run(['gh','api','repos/YNWAforever/hkscda/actions/runs/36985370386/artifacts','--jq','{total_count: .total_count, artifacts: [.artifacts[] | {name: .name,id: .id,expired: .expired}]}'])
receipt['files']={p.name:{'bytes':len(p.read_bytes()),'sha256':hashlib.sha256(p.read_bytes()).hexdigest()} for p in OUT.iterdir() if p.is_file()}
save('receipt.json',receipt)
print(json.dumps({'out':str(OUT),'profiles':[{'profile':r['profile'],'exit':r['exit'],'runtime':r['runtime'],'uid':r['uid']} for r in receipt['captures']]}))
