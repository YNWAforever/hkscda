import { mkdir,readFile,writeFile,copyFile } from 'node:fs/promises';
import { resolve } from 'node:path';
import { captureProductionSchema,captureModernLocalSchema,createProductionClone,assertSafeFixtureTables,localSourceState,snapshot,hash } from '../../../supabase/rls-tests/helpers/productionSchemaClone';
const root=resolve(import.meta.dir,'../../..');
const mode=process.argv[2];
if(!['hosted','modern'].includes(mode)||process.env.R01_ADOPTION_ATOMIC_ALLOW_LOCAL_FIXTURES!=='1') throw Error('Own Task9 preflight opt-in required');
const out=resolve(root,'.superpowers/sdd/r01-forward-schema-plan-20261001/task-9-preflight-'+mode+'-'+Date.now());
await mkdir(out,{recursive:true});
const paths=['.superpowers/sdd/r01-forward-schema-plan-20261001/task-9-preflight.ts','supabase/rls-tests/helpers/productionSchemaClone.ts'];
const bindings:Record<string,unknown>={};
for(const [i,p] of paths.entries()){ const bytes=await readFile(resolve(root,p)); bindings[p]={rawSha256:hash(bytes.toString()),canonicalSha256:hash(bytes.toString().replaceAll('\r\n','\n')),copy:'s'+i+'.source'};await copyFile(resolve(root,p),resolve(out,'s'+i+'.source'));}
const modernUrl='postgresql://postgres:postgres@127.0.0.1:57322/postgres';
const modernBefore=await localSourceState(modernUrl);
const cap=mode==='hosted'?await captureProductionSchema():await captureModernLocalSchema();
const clone=await createProductionClone(cap),db=clone.sql;
const scope=['auth.users','admin_user','coordinator_status','supporter','supporter_role','adopter_profile','adoption_case','adoption_followup','animal_match','animal','audit_log'];
const receipt:Record<string,unknown>={mode,at:new Date().toISOString(),bindings,sourceBase:'d0403a1869ea6dead498e62aebe9723e95c3ec19',clone:clone.name,zeroTables:clone.tableCount,catalogHash:hash(cap.catalog),managedPrerequisites:clone.prerequisites,scope,productionActions:'schema/catalog only; no rows, actor calls, mutations',task1Applied:false,task8Applied:false};
try{
 receipt.helper=await db`select pg_get_function_identity_arguments(p.oid) args,pg_get_function_arguments(p.oid) arguments,pg_get_function_result(p.oid) result,pg_get_userbyid(p.proowner) owner,p.proacl::text acl,p.prosecdef definer,p.proconfig config,p.pronargdefaults defaults,pg_get_expr(p.proargdefaults,0) default_expression,md5(p.prosrc) source_md5,md5(pg_get_functiondef(p.oid)) definition_md5 from pg_proc p join pg_namespace n on n.oid=p.pronamespace where n.nspname='private' and p.proname='create_manual_adoption_case'`;
 receipt.defaults=cap.catalog.defaults;
 receipt.auth=await db`select c.relacl::text acl,(select jsonb_agg(jsonb_build_object('name',a.attname,'acl',a.attacl::text,'selectService',has_column_privilege('service_role',c.oid,a.attnum,'SELECT'),'updateService',has_column_privilege('service_role',c.oid,a.attnum,'UPDATE')) order by a.attnum) from pg_attribute a where a.attrelid=c.oid and a.attnum>0 and not a.attisdropped) columns from pg_class c where c.oid='auth.users'::regclass`;
 receipt.writeTriggers=await db.unsafe("select n.nspname||'.'||c.relname table_name,t.tgname,pg_get_triggerdef(t.oid,true) definition,pn.nspname||'.'||p.proname helper,pg_get_function_arguments(p.oid) arguments,pg_get_userbyid(p.proowner) owner,p.proacl::text acl,p.proconfig config,p.pronargdefaults defaults,md5(p.prosrc) body_md5,md5(pg_get_functiondef(p.oid)) definition_md5 from pg_trigger t join pg_class c on c.oid=t.tgrelid join pg_namespace n on n.oid=c.relnamespace join pg_proc p on p.oid=t.tgfoid join pg_namespace pn on pn.oid=p.pronamespace where not t.tgisinternal and n.nspname||'.'||c.relname in ("+scope.map(t=>"'"+(t.includes('.')?t:'public.'+t)+"'").join(',')+") order by 1,2");
 await assertSafeFixtureTables(db,scope);receipt.fullScopeScanner='PASS';
 const [p]=await db`select to_regprocedure('public.mutate_adoption_coordinator_with_audit(uuid,text,text,uuid,jsonb)') coordinator,to_regprocedure('public.search_manual_case_identity(text,integer,integer)') search,to_regprocedure('public.create_manual_adoption_case(uuid,jsonb,jsonb,jsonb)') manual`;
 receipt.targets=p;
 receipt.catalogPreserved=hash(await snapshot(db))===hash(cap.catalog);
}catch(e){receipt.error=String(e);receipt.fullScopeScanner='REFUSED';process.exitCode=1;}
finally{await clone.close();receipt.normalDrop=true;receipt.templatePreserved=clone.templatePreserved;receipt.modernPreserved=(await localSourceState(modernUrl))===modernBefore;await writeFile(resolve(out,'receipt.json'),JSON.stringify(receipt,null,2)+'\n');console.log(JSON.stringify({out,...receipt,auth:'bound in receipt',defaults:'bound in receipt',writeTriggers:'bound in receipt'}));}
