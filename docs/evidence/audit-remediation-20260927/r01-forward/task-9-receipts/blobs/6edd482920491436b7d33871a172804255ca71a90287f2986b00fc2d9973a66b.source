          "definition": "CREATE OR REPLACE FUNCTION auth.uid()\n RETURNS uuid\n LANGUAGE sql\n STABLE\nAS $function$\n  select nullif(current_setting('request.jwt.claim.sub', true), '')::uuid;\n$function$\n",
