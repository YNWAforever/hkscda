from pathlib import Path
import hashlib,json,subprocess,datetime
root=Path.cwd();s=root/'.superpowers/sdd/r01-forward-schema-plan-20261001';out=root/'docs/evidence/audit-remediation-20260927/r01-forward'
def sha(b):return hashlib.sha256(b).hexdigest()
def git(*args):return subprocess.check_output(['git',*args],text=True).strip()
head=git('rev-parse','HEAD');assert head!='8821c8f8facc8146ac61c8b305ab79f41768fec8';assert git('status','--short')==''
b=json.loads((out/'task-9-fix-3-source-binding.json').read_text());pc=json.loads((out/'task-9-fix-3-packaging-check.json').read_text());assert pc['allRawCanonicalGitStagedArchiveBodiesMatch'] is True
manifest='docs/evidence/audit-remediation-20260927/migration-manifest.csv';mb=(root/manifest).read_bytes();body=subprocess.check_output(['git','show',head+':'+manifest]);assert body==mb and sha(body)==b['gateFrozenInputs'][manifest]['sha256'];assert git('rev-parse',head+':'+manifest)==b['gateFrozenInputs'][manifest]['gitBlob']
original=s/'task-9-report.md';prior=original.read_bytes();assert sha(prior)=='c977c12acb38264a4142ce3ee8b043b91944c1304cd83b2c7919cccc6b0125a5'
evidence=(out/'task-9-fix-3-evidence.md').read_text(encoding='utf-8');gp=root/b['gateReceipt']['originalPath'];g=json.loads(gp.read_text());db={m:json.loads((root/v['originalPath']).read_text()) for m,v in b['databaseReceipts'].items()}
lines=['# Task9 Fix3 full implementation report','',f'Written {datetime.datetime.now(datetime.timezone.utc).isoformat()} after packaging. Final HEAD `{head}`; branch `{git("branch","--show-current")}`; `git status --short` exit0 and empty. Source commit `8821c8f8facc8146ac61c8b305ab79f41768fec8`; FIX_BASE `fff2aa600a2d0053e007632bd24ce88a5b517541`; original clean BASE `d0403a1869ea6dead498e62aebe9723e95c3ec19`. Final evidence commit is a descendant of source8821, with the disclosed manifest row and evidence only.','', 'This report is written after the packaging commit. It is separate current evidence and does not replace or relabel any immutable historical translation/runtime proof. Original task-9-report.md retains its entire previous body as an exact byte prefix and receives this covering append. Fix1/Fix2 reports and all previous failure receipts are retained.','', '## Execution and actual environment','', 'Commands in the table use ENV=1 notation for the explicit opt-in. Windows PowerShell supplies `R01_ADOPTION_ATOMIC_ALLOW_LOCAL_FIXTURES=1` to the owned runner/diagnostic; no provider credentials are loaded or printed. The child testCommand/clone environment is recorded verbatim in each receipt below. Gate orchestration runs `python docs/evidence/audit-remediation-20260927/r01-forward/task-9-gates.py`; it clears inherited feature DB and fixture opt-ins, uses loopback57322/52321 and build54329 placeholder configuration. No mutation of dedicated/template data is used to produce a RED. Existing historical component DDL is replayed only in a fresh zero-data owned clone and fully rolled back for diagnosis.','', 'Initial sandbox bootstrap failed before execution (deny-read ACL helper failure). The controller authorized narrowly justified require_escalated reads/tests/source operations in this assigned worktree. No automatic action rejection occurred or was bypassed. Read-only setup failures while inspecting metadata (initial wrong graph argument / cp950 decoding) are qualified as setup issues, not SQL refusal evidence; corrected UTF8/source reads succeeded.','', '## Complete Fix3 evidence', '', evidence, '', '## Packaging, commands and actual committed manifest', '', '`python .superpowers/sdd/r01-forward-schema-plan-20261001/task-9-fix-3-evidence-writer.py`: exit0; evidence/source binding generated from final66/73 maps and gates0; append-only tracker/runbook updates.','', '`python docs/evidence/audit-remediation-20260927/r01-forward/task-9-package.py`: exit0; final actual counts are in the packaging JSON below. Initial package was1611translations/249unique raw/28,884,764bytes; final append additionally retains failed checker source/receipt. Existing1240translation entries are an exact immutable prefix against FIX_BASEfff. All final raw/canonical/size/Gitcontent addresses and staged archive bodies verified by source-only packaging check; all66DB/73gate current raw+canonical+Git and archived-source bindings match; four raw gate log hashes match.','', '`python .superpowers/sdd/r01-forward-schema-plan-20261001/task-9-fix-3-packaging-check.py`: attempt1 exit1 (verifier incorrectly used len on integer applies2; retained original source/qualification), corrected attempt2 exit0; no test/DB rerun. Only tracker row25 fields10/11 append; old fields/other rows preserved. Runbook prior bytes exact prefix. Manifest onlyrow73 SHA e6→e690, all other bytes unchanged. SQL only35byte complete known-profile guard extension, scanner5352 exact. Final source/docs staged diffcheck0 excludes immutable raw .source payloads; older allraw whitespace failures remain honest historical evidence.','', f'Final commit `{head}` contains manifest `{manifest}` raw/canonicalSHA `{sha(body)}`, Git blob `{git("rev-parse",head+":"+manifest)}`, {len(body)}bytes; exact equality with frozen gate map and current working bytes verified. Source8821 manifest is old SHA a7270ab6fbb27ec9212d588cc3b3980427b57d6e7fd91d3575c38047b4e89dc9. Therefore the final73 frozen map is not claimed to be the entirety of HEAD8821; it explicitly binds the tested working manifest later committed here. Ignored raw capture Git addresses are derived content hashes; archives are committed bodies.', '', '## Actual final receipts and runtime bindings', '', '```json', json.dumps({'database':{m:{'receipt':b['databaseReceipts'][m], 'sourceCommit':r['sourceCommit'], 'sourceBase':r['sourceBase'], 'environment':r['environment'], 'testCommand':r['testCommand'], 'testExit':r['testExit'], 'testSummary':r['testSummary'], 'applies':r['applies'], 'preservation':{k:v for k,v in r.items() if k.endswith('Preserved') or k in ['normalDrop','secondApplyIdempotent','baselineAcceptedBeforeNegatives','baselineRollbackPreserved','task1Applied','task8Applied']}, 'gapCounts':[r['beforeGapCount'],r['afterGapCount']], 'metadataRefusals':len(r['refusals'])} for m,r in db.items()}, 'gateReceipt':b['gateReceipt'], 'gateResults':g['gates'], 'gateEnvironment':g['environment'], 'gateFrozenInputsPreserved':g['frozenInputsPreserved'], 'gateTemplatePreserved':g['templatePreserved'], 'gateModernBefore':g['modernBefore'], 'gateModernAfter':g['modernAfter'], 'inputCounts':[66,73], 'packaging':pc},indent=2), '```','', '## Concerns and scope closure','', 'Own unchanged SQL RED is actual55000/supporter, while its expected-defect diagnostic process exits0. Final three own rehearsals and four mandatory gates pass on final frozen executable/SQL bytes. No broader optional suite/predecessor/provider/CI rerun was performed. All391 skips and52existing lintwarnings retained;39DB cases are independently exercised in each ownprofile. M1Minor HTTP diagnostic logging remains deferred to final whole-branch triage.','', 'The original exact-head17.11.0.002 RLSstartup failure remains immutable and aggregateSUCCESS is explicitly not all-five success. Local17.6 complete source-component reconstruction and exact ACL preservation do not establish exact17.11 startup success. SAME scoped independent review and fresh final-head five individual CI jobs are required and remain controller-owned; no dependent task starts before that acceptance.','', 'Original CLI2.118.0 creation remains implementer-reported, exact original migration-new invocation/output independently unavailable from bounded retained artifact/root-record lookup. This does not establish nonperformance; no creation replay or manufactured historical provenance. Original brief8849 version and separate current938/Ruling31 qualification remain immutable; separately bound Ruling32 is the present authority.','', 'No grants/defaults/RLS/Auth/native metadata/helper/scanner/body policy changed; no general allowance, ACL normalization, SQLSECDEF conversion, new helper or provider authorization. No production/provider/main/push/publicpreview/Task1/Task8 operation, release, new parent data repair or mainmerge; no subagents. Root owns review/PR/exact-head CI publication.']
report='\n'.join(lines)+'\n';target=s/'task-9-fix-3-report.md';target.write_text(report,encoding='utf-8',newline='\n');append='\n\n---\n\n## Task9 Fix3 covering commands, outputs and final HEAD\n\n'+report
original.write_bytes(prior+append.encode('utf-8'));assert original.read_bytes().startswith(prior)
proof={'finalHead':head,'cleanStatus':'empty','fullReportPath':str(target.relative_to(root)).replace('\\','/'),'fullReportRawSha256':sha(target.read_bytes()),'fullReportBytes':target.stat().st_size,'originalReportPriorSHA256':sha(prior),'originalReportAppendOnly':True,'originalReportCurrentSHA256':sha(original.read_bytes()),'originalReportCurrentBytes':original.stat().st_size,'manifestCommittedBodyExactFrozen':True,'manifestCommittedGitBlob':git('rev-parse',head+':'+manifest),'reportWrittenAfterPackaging':True,'historicalTranslationCount':1240,'finalTranslationCount':pc['actualTranslations'],'frozenInputCounts':[66,73],'noTestsOrDBRerun':True}
(s/'task-9-fix-3-report-binding.json').write_text(json.dumps(proof,indent=2)+'\n',encoding='utf-8',newline='\n');print(json.dumps(proof))
