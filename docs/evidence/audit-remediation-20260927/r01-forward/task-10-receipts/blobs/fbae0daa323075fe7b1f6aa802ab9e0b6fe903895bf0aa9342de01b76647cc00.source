import {SQL} from "bun";import {writeFile} from "node:fs/promises";
const q="select datname,pg_encoding_to_char(encoding) encoding,datlocprovider,datcollate,datctype,datlocale,datcollversion from pg_database where datname in('postgres','audit_pr135_20260929','r01_task10_fix1') order by datname";
const db=new SQL("postgresql://postgres:postgres@127.0.0.1:52322/postgres");const shared=await db.unsafe(q);await db.close();
const p=Bun.spawn(["docker","exec","-i","r01-task10-fix1-role-20261002-126d7280-v2","psql","-X","-qAt","-h","/tmp","-U","supabase_admin","-d","postgres","-v","ON_ERROR_STOP=1"],{stdin:new Blob(["begin read only;select json_agg(t) from ("+q+")t;commit;"]),stdout:"pipe",stderr:"pipe"});const [out,err,exit]=await Promise.all([new Response(p.stdout).text(),new Response(p.stderr).text(),p.exited]);if(exit)throw Error(err);const own=JSON.parse(out);await writeFile(import.meta.dir+"/task-10-fix1-locale.json",JSON.stringify({shared,own},null,2)+"\n");console.log(JSON.stringify({shared,own}));
