import pathlib,json,hashlib,subprocess,time,sys
root=pathlib.Path.cwd();s=root/".superpowers/sdd/r01-forward-schema-plan-20261001";out=s/("task-10-fix1-role-proof-"+sys.argv[1]+"-"+str(time.time_ns()));out.mkdir();mode=sys.argv[1];container="r01-task10-fix1-role-20261002-126d7280-v2";candidate=(root/"supabase/migrations/20261002111418_r01_admin_access_atomic_forward.sql").read_bytes();r={"mode":mode,"candidateSha256":hashlib.sha256(candidate).hexdigest(),"attempts":[],"ownedContainer":container};(out/"candidate.source").write_bytes(candidate);(out/"runner.source").write_bytes(pathlib.Path(__file__).read_bytes());
base=json.loads((s/"task-10-fix1-cluster-create-1790948623213575900/receipt.json").read_text());actual=json.loads(subprocess.check_output(["docker","inspect",container]))[0];assert actual["Id"]==base["containerID"] and actual["Image"]==base["image"]["Id"] and actual["Config"]["Labels"]==base["inspectedContainer"]["Config"]["Labels"] and actual["HostConfig"]["NetworkMode"]=="none" and not actual["Mounts"] and not actual["HostConfig"].get("PortBindings");r["containerID"]=actual["Id"]
cmd=["docker","exec","-i",container,"psql","-X","-qAt","-h","/tmp","-U","supabase_admin","-d","r01_task10_fix1","-v","ON_ERROR_STOP=1","-v","VERBOSITY=verbose"]
def run(label,sql):
 raw=sql.encode();(out/(label+".sql.source")).write_bytes(raw);p=subprocess.run(cmd,input=raw,capture_output=True);(out/(label+".stdout")).write_bytes(p.stdout);(out/(label+".stderr")).write_bytes(p.stderr);r["attempts"].append({"label":label,"command":cmd,"exit":p.returncode,"inputSha256":hashlib.sha256(raw).hexdigest(),"stdoutSha256":hashlib.sha256(p.stdout).hexdigest(),"stderrSha256":hashlib.sha256(p.stderr).hexdigest()});return p
before=run("before","begin read only;select md5(jsonb_agg(to_jsonb(m) order by roleid,member,grantor)::text) from pg_auth_members m;select count(*) from auth.users;select count(*) from public.admin_user;select count(*) from public.audit_log;commit;")
for label,grant in [("baseline",""),("direct","GRANT service_role TO authenticated WITH INHERIT TRUE, SET TRUE;"),("indirect","GRANT service_role TO r01_task10_indirect WITH INHERIT TRUE, SET TRUE;GRANT r01_task10_indirect TO authenticated WITH INHERIT TRUE, SET TRUE;"),("setonly","GRANT service_role TO r01_task10_setonly WITH INHERIT FALSE, SET TRUE;GRANT r01_task10_setonly TO authenticated WITH INHERIT FALSE, SET TRUE;")]:
 sql="begin;"+grant+"set local role postgres;"+candidate.decode()+"select 'candidateAccepted';select has_function_privilege('authenticated','public.update_admin_user_with_audit(uuid,uuid,text,text)','EXECUTE'),pg_has_role('authenticated','service_role','USAGE'),pg_has_role('authenticated','service_role','SET');"
 if mode=="red" and label!="baseline":
  sql+="set local role postgres;insert into auth.users(id,email,email_confirmed_at) values('11111111-1111-4111-8111-111111111111','admin@example.invalid',now()),('22222222-2222-4222-8222-222222222222','staff@example.invalid',now());insert into public.admin_user(auth_user_id,email,role,status) values('11111111-1111-4111-8111-111111111111','admin@example.invalid','admin','active'),('22222222-2222-4222-8222-222222222222','staff@example.invalid','staff','active');set local request.jwt.claim.sub='22222222-2222-4222-8222-222222222222';set local request.jwt.claim.role='authenticated';set local role authenticated;"
  if label=="setonly":sql+="set local role service_role;"
  sql+="select current_user,(public.update_admin_user_with_audit('11111111-1111-4111-8111-111111111111',(select id from public.admin_user where auth_user_id='22222222-2222-4222-8222-222222222222'),'treasurer',null)).role;select count(*) from public.audit_log;"
 sql+="rollback;";result=run(label,sql)
 if label=="baseline":assert result.returncode==0,result.stderr
 elif mode=="red":assert result.returncode==0 and b"candidateAccepted" in result.stdout,result.stderr
 else:assert result.returncode!=0 and b"55000" in result.stderr,result.stderr
 # Every psql session ends; failedtransaction disconnect rollsback, noFORCE/sessiontermination.
 after=run(label+"-rollback","begin read only;select md5(jsonb_agg(to_jsonb(m) order by roleid,member,grantor)::text) from pg_auth_members m;select count(*) from auth.users;select count(*) from public.admin_user;select count(*) from public.audit_log;commit;");assert after.stdout==before.stdout;assert after.returncode==0
r["allRoleRowRollbackPreserved"]=True;r["expectedAdmissionRefused"]=mode=="green";r["actualCases"]=4
(out/"receipt.json").write_text(json.dumps(r,indent=2)+"\n");print(json.dumps({"out":str(out),"mode":mode,"candidateSHA":r["candidateSha256"],"cases":4,"rollback":True}));sys.exit(1 if mode=="red" else 0)
