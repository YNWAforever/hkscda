/** Reproducible LF-only Task 6 source generation from exact reviewed profiles. */
import {readFile,writeFile} from "node:fs/promises";
import {createHash} from "node:crypto";
import {catalogQuery,hash} from "../../../../supabase/rls-tests/helpers/productionSchemaClone";
const md5=(s:string)=>createHash("md5").update(s).digest("hex"),root=process.cwd();
const legacy=await readFile("supabase/migrations/20260925103937_atomic_crm_supporter_audit.sql","utf8"),versioned=await readFile("supabase/migrations/20260927110000_crm_supporter_edit_version.sql","utf8");
function body(source:string,name:string){const m=source.replaceAll("\r\n","\n").match(new RegExp(`create or replace function public\\.${name}\\([\\s\\S]*?as \\$\\$([\\s\\S]*?)\\$\\$;`,"i"));if(!m)throw new Error(name);return m[1];}
const oldCreate=body(legacy,"mutate_crm_supporter_with_audit"),oldRoles=body(legacy,"replace_supporter_roles_atomic"),oldConsent=body(legacy,"append_crm_consents_with_audit"),oldVersion=body(versioned,"mutate_crm_supporter_if_version_with_audit");
if(md5(oldCreate)!=="a239e42582809956b821b1bfe1fb2962"||md5(oldRoles)!=="f2c7e2d7478e45b8320a59b43b56f818"||md5(oldConsent)!=="65f1847569ad471a239e0c1a1dd60324"||md5(oldVersion)!=="c39e9474fb941717626a0e9e3afd1477")throw new Error("Reviewed LF legacy body changed");
const newCreate=oldCreate.replace("begin\n","begin\n  perform private.require_crm_supporter_actor(p_actor_user_id);\n");
const oldPredicate=`  if not exists (\n    select 1 from public.admin_user\n    where auth_user_id = p_actor_user_id and status = 'active'\n      and role in ('treasurer', 'admin')\n  ) then\n    raise exception 'supporter_edit_forbidden' using errcode = '42501';\n  end if;`;
if(!oldVersion.includes(oldPredicate))throw new Error("Known wrapper predicate changed");
const newVersion=oldVersion.replace(oldPredicate,"  perform private.require_crm_supporter_actor(p_actor_user_id);");
const newConsent=oldConsent.replace(`  if p_rows is null or jsonb_typeof(p_rows) <> 'array' then\n    raise exception 'invalid_consent_rows';\n  end if;`,`  if p_rows is null or jsonb_typeof(p_rows) <> 'array' then\n    raise exception 'invalid_consent_rows' using errcode = '22023';\n  end if;\n  if p_supporter_id is null or jsonb_array_length(p_rows) = 0 or exists (\n    select 1 from jsonb_array_elements(p_rows) as row\n    where jsonb_typeof(row) <> 'object'\n      or row->>'supporter_id' is distinct from p_supporter_id::text\n  ) then\n    raise exception 'invalid_consent_rows' using errcode = '22023';\n  end if;\n  perform private.require_crm_supporter_actor(p_actor_user_id);`);
const helper=`\nbegin\n  -- Own-domain Auth then admin SHARE fences non-key ban/role/status changes.\n  perform 1 from auth.users u\n  where u.id = p_actor and u.email_confirmed_at is not null\n    and (u.banned_until is null or u.banned_until <= pg_catalog.clock_timestamp())\n  for share;\n  if not found then\n    raise exception 'supporter_edit_forbidden' using errcode = '42501';\n  end if;\n  perform 1 from public.admin_user a\n  where a.auth_user_id = p_actor and a.status = 'active'\n    and a.role in ('treasurer', 'admin')\n  for share;\n  if not found then\n    raise exception 'supporter_edit_forbidden' using errcode = '42501';\n  end if;\nend;\n`;
const specs=[
{schema:"public",name:"mutate_crm_supporter_with_audit",args:"p_operation text, p_supporter_id uuid, p_input jsonb, p_roles jsonb, p_actor_user_id uuid, p_at timestamp with time zone, p_detail jsonb",signature:"text,uuid,jsonb,jsonb,uuid,timestamptz,jsonb",returns:"jsonb",old:oldCreate,new:newCreate,required:false,definer:false},
{schema:"public",name:"replace_supporter_roles_atomic",args:"p_supporter_id uuid, p_roles jsonb",signature:"uuid,jsonb",returns:"void",old:oldRoles,new:oldRoles,required:false,definer:false},
{schema:"public",name:"append_crm_consents_with_audit",args:"p_rows jsonb, p_actor_user_id uuid, p_supporter_id uuid, p_at timestamp with time zone, p_detail jsonb",signature:"jsonb,uuid,uuid,timestamptz,jsonb",returns:"void",old:oldConsent,new:newConsent,required:false,definer:false},
{schema:"public",name:"mutate_crm_supporter_if_version_with_audit",args:"p_supporter_id uuid, p_expected_version bigint, p_input jsonb, p_roles jsonb, p_actor_user_id uuid, p_at timestamp with time zone, p_detail jsonb",signature:"uuid,bigint,jsonb,jsonb,uuid,timestamptz,jsonb",returns:"jsonb",old:oldVersion,new:newVersion,required:true,definer:false},
{schema:"private",name:"require_crm_supporter_actor",args:"p_actor uuid",signature:"uuid",returns:"void",old:helper,new:helper,required:false,definer:true}
];
const profiles=await Promise.all(["hosted","modern"].map(async mode=>JSON.parse(await readFile(`docs/evidence/audit-remediation-20260927/r01-forward/task-6-preflight-receipts/${mode}.json`,"utf8"))));
if(profiles.some(p=>p.domainProfiles.some((x:{profileType:string})=>x.profileType!=="object")))throw new Error("Captured PG profile type must be object");
const bootstrap=JSON.parse(await readFile("docs/evidence/audit-remediation-20260927/r01-forward/task-6-fix-2-receipts/diagnosis.json","utf8"));
const supporterAlternative=bootstrap.reconstructedProfiles.find((p:{name:string})=>p.name==="supporter");
const expectedSupporter=structuredClone(profiles[0].domainProfiles.find((p:{name:string})=>p.name==="supporter").profile);
expectedSupporter.relations[0].acl=expectedSupporter.relations[0].acl.filter((a:{grantee:string;privilege:string})=>!(a.grantee==="authenticated"&&["REFERENCES","TRIGGER","TRUNCATE"].includes(a.privilege)));
if(!bootstrap.normalBaselineAccepted||!bootstrap.normalBaselineRollbackPreserved||!bootstrap.fullRollbackPreserved||bootstrap.actualMigrationResult.status!=="55000"||supporterAlternative.profiletype!=="object"||supporterAlternative.md5!=="6283c96ed21f1197474461a8028892e1"||hash(supporterAlternative.profile)!==hash(expectedSupporter))throw new Error("Only ruled complete #150/#177 supporter profile is accepted");
for(const [name,file] of [["maintenance","executed-maintenance-fragment.sql"],["assignment","executed-assignment-column-fragment.sql"]]){const fragment=await readFile("docs/evidence/audit-remediation-20260927/r01-forward/task-6-fix-2-receipts/"+file,"utf8");const expected=name==="maintenance"?bootstrap.sourceFragments.maintenance.sha256:bootstrap.sourceFragments.assignment.fragmentSha256;if(hash(fragment)!==expected)throw new Error("Exact ruled source fragment changed");}
const tables=["supporter","supporter_role","consent","audit_log","admin_user"];
let sql=`-- R01 Task 6: exact CRM atomic contracts and transaction actor fencing.\n-- Only missing commands and ruled known unsafe actor bodies advance.\n-- Every preflight finishes before creation/replacement. Unknown drift fails55000.\nset local search_path = '';\ndo $migration$\ndeclare v_function oid; v_catalog jsonb; v_actual jsonb; v_table oid; v_name text; v_hashes text[]; v_default record; v_public_create boolean; v_private_create boolean;\nbegin\n  if current_user <> 'postgres' then raise exception 'R01 CRM owner context differs' using errcode='55000'; end if;\n  if not pg_catalog.has_schema_privilege('service_role','private','USAGE')\n    or pg_catalog.has_any_column_privilege('service_role','auth.users','SELECT,UPDATE')\n    or not pg_catalog.has_table_privilege('postgres','auth.users','SELECT')\n    or not pg_catalog.has_table_privilege('postgres','auth.users','UPDATE')\n    or (select count(*) from pg_catalog.pg_attribute where attrelid='auth.users'::pg_catalog.regclass and not attisdropped and ((attname='id' and atttypid='uuid'::pg_catalog.regtype and attnotnull) or (attname in ('email_confirmed_at','banned_until') and atttypid='timestamptz'::pg_catalog.regtype)))<>3 then\n    raise exception 'R01 CRM managed Auth prerequisites differ' using errcode='55000';\n  end if;\n  -- Same normalized catalog projection as the reviewed schema clone. Only the\n  -- five CRM write/actor tables below are bound; other domains are not rewritten.\n  select catalog into v_catalog from (${catalogQuery}) captured;\n`;
for(const name of tables){const hashes=[...new Set(profiles.map(p=>p.domainProfiles.find((x:{name:string})=>x.name===name).md5).concat(name==="supporter"?[supporterAlternative.md5]:[]))];sql+=`  v_name := '${name}'; v_table := pg_catalog.to_regclass('public.'||v_name);\n  if v_table is null then raise exception 'R01 CRM prerequisite table absent: ${name}' using errcode='55000'; end if;\n  select pg_catalog.jsonb_object_agg(k,(select pg_catalog.jsonb_agg(e.value order by e.ordinality) from pg_catalog.jsonb_array_elements(v_catalog->k) with ordinality e(value,ordinality) where e.value->>'schema'='public' and coalesce(e.value->>'table',e.value->>'name')=v_name))\n    || pg_catalog.jsonb_build_object('shape',(select pg_catalog.jsonb_build_object('persistence',c.relpersistence,'rules',c.relhasrules,'rewrites',(select count(*) from pg_catalog.pg_rewrite r where r.ev_class=c.oid)) from pg_catalog.pg_class c where c.oid=v_table)) into v_actual\n  from unnest(array['relations','columns','constraints','indexes','triggers','policies']) k;\n  -- Empty facets are [] in the captured profile, never SQL NULL.\n  select pg_catalog.jsonb_object_agg(key,case when value='null'::jsonb then '[]'::jsonb else value end) into v_actual from pg_catalog.jsonb_each(v_actual);\n  if pg_catalog.md5(v_actual::text) not in (${hashes.map(h=>`'${h}'`).join(",")}) then raise exception 'R01 CRM table metadata differs: ${name}' using errcode='55000'; end if;\n`;}
sql+=`  -- Native RI enforcement is not in the public snapshot. All four ordinary\n  -- enabled triggers and their single internal constraint dependency are required.\n  if exists(select 1 from pg_catalog.pg_constraint c where c.conrelid in ('public.supporter'::regclass,'public.supporter_role'::regclass,'public.consent'::regclass,'public.admin_user'::regclass) and c.contype='f' and (\n    c.confupdtype<>'a' or c.confdeltype not in ('a','c') or c.condeferrable or c.condeferred\n    or (select count(*) from pg_catalog.pg_trigger t where t.tgconstraint=c.oid)<>4\n    or exists(select 1 from (values ('pg_catalog."RI_FKey_check_ins"()'::regprocedure,5,true),('pg_catalog."RI_FKey_check_upd"()'::regprocedure,17,true),('pg_catalog."RI_FKey_noaction_upd"()'::regprocedure,17,false),(case when c.confdeltype='c' then 'pg_catalog."RI_FKey_cascade_del"()'::regprocedure else 'pg_catalog."RI_FKey_noaction_del"()'::regprocedure end,9,false)) expected(function_oid,event_type,own_side) where (select count(*) from pg_catalog.pg_trigger t where t.tgconstraint=c.oid and t.tgrelid=case when expected.own_side then c.conrelid else c.confrelid end and t.tgconstrrelid=case when expected.own_side then c.confrelid else c.conrelid end and t.tgconstrindid=c.conindid and t.tgfoid=expected.function_oid and t.tgtype=expected.event_type and t.tgenabled='O' and t.tgisinternal and t.tgparentid=0 and not t.tgdeferrable and not t.tginitdeferred and t.tgnargs=0 and t.tgattr::text='' and t.tgargs=''::bytea and t.tgqual is null and t.tgoldtable is null and t.tgnewtable is null and (select count(*) from pg_catalog.pg_depend d where d.classid='pg_trigger'::regclass and d.objid=t.oid)=1 and exists(select 1 from pg_catalog.pg_depend d where d.classid='pg_trigger'::regclass and d.objid=t.oid and d.objsubid=0 and d.refclassid='pg_constraint'::regclass and d.refobjid=c.oid and d.refobjsubid=0 and d.deptype='i'))<>1)\n  )) then raise exception 'R01 CRM native FK enforcement differs' using errcode='55000'; end if;\n  -- Preserve149/177 version trigger helpers; exact reviewed definitions, postgres ownership and historical effective ACLs.\n  if not exists(select 1 from pg_catalog.pg_proc p where p.oid='private.bump_supporter_edit_version()'::regprocedure and p.proowner='postgres'::regrole and (select count(*) from pg_catalog.aclexplode(coalesce(p.proacl,pg_catalog.acldefault('f',p.proowner))))=1 and not exists(select 1 from pg_catalog.aclexplode(coalesce(p.proacl,pg_catalog.acldefault('f',p.proowner))) a where a.grantor<>p.proowner or a.grantee<>p.proowner or a.privilege_type<>'EXECUTE' or a.is_grantable) and pg_catalog.md5(pg_catalog.pg_get_functiondef(p.oid)) in ('d1fd0a986ef9bb089e9d5025e4177a49','08619e0337db72d3d685130718c47538'))\n    or not exists(select 1 from pg_catalog.pg_proc p where p.oid='private.bump_supporter_edit_version_from_role()'::regprocedure and p.proowner='postgres'::regrole and (select count(*) from pg_catalog.aclexplode(coalesce(p.proacl,pg_catalog.acldefault('f',p.proowner))))=2 and not exists(select 1 from pg_catalog.aclexplode(coalesce(p.proacl,pg_catalog.acldefault('f',p.proowner))) a where a.grantor<>p.proowner or a.grantee not in(0,p.proowner) or a.privilege_type<>'EXECUTE' or a.is_grantable) and pg_catalog.md5(pg_catalog.pg_get_functiondef(p.oid))='3b3d61191955f415e4ed1a22389d71fb') then raise exception 'R01 CRM version trigger helpers differ' using errcode='55000'; end if;\n`;
for(const s of specs){const signature=`${s.schema}.${s.name}(${s.signature})`,hashes=[...new Set([md5(s.old),md5(s.new)])];sql+=`  v_function := pg_catalog.to_regprocedure('${signature}');\n  if ${s.required?"v_function is null or ":""}(select count(*) from pg_catalog.pg_proc where pronamespace='${s.schema}'::regnamespace and proname='${s.name}')<>(case when v_function is null then 0 else 1 end) then raise exception 'R01 CRM overload/required function differs: ${s.name}' using errcode='55000'; end if;\n  if v_function is not null and (\n    not exists(select 1 from pg_catalog.pg_proc p join pg_catalog.pg_language l on l.oid=p.prolang where p.oid=v_function and p.prokind='f' and p.pronargdefaults=0 and p.proargdefaults is null and p.proowner='postgres'::regrole and p.prosecdef=${s.definer} and p.proconfig=array['search_path=""']::text[] and p.provolatile='v' and p.proparallel='u' and not p.proisstrict and not p.proleakproof and p.procost=100 and p.prorows=0 and p.prosupport=0 and l.lanname='plpgsql' and pg_catalog.pg_get_function_identity_arguments(p.oid)='${s.args}' and pg_catalog.pg_get_function_result(p.oid)='${s.returns}' and pg_catalog.md5(p.prosrc) in (${hashes.map(h=>`'${h}'`).join(",")}))\n    or (select count(*) from pg_catalog.pg_proc p,lateral pg_catalog.aclexplode(coalesce(p.proacl,pg_catalog.acldefault('f',p.proowner))) a where p.oid=v_function)<>2\n    or exists(select 1 from pg_catalog.pg_proc p,lateral pg_catalog.aclexplode(coalesce(p.proacl,pg_catalog.acldefault('f',p.proowner))) a where p.oid=v_function and (a.grantor<>p.proowner or a.grantee not in(p.proowner,'service_role'::regrole) or a.privilege_type<>'EXECUTE' or a.is_grantable))\n    or not pg_catalog.has_function_privilege('service_role',v_function,'EXECUTE') or pg_catalog.has_function_privilege('anon',v_function,'EXECUTE') or pg_catalog.has_function_privilege('authenticated',v_function,'EXECUTE')\n  ) then raise exception 'R01 CRM function contract differs: ${s.name}' using errcode='55000'; end if;\n`;}
sql+=`  v_public_create := ${specs.filter(s=>s.schema==="public").map(s=>`pg_catalog.to_regprocedure('${s.schema}.${s.name}(${s.signature})') is null`).join(" or ")};\n  v_private_create := pg_catalog.to_regprocedure('private.require_crm_supporter_actor(uuid)') is null;\n  -- Current postgres creation defaults: global baseline plus schema additions.\n  -- Never strip an unfamiliar recipient or modify creator defaults.\n  for v_default in select d.* from pg_catalog.pg_default_acl d where d.defaclrole='postgres'::regrole and d.defaclobjtype='f' and ((d.defaclnamespace=0 and (v_public_create or v_private_create)) or (d.defaclnamespace='public'::regnamespace and v_public_create) or (d.defaclnamespace='private'::regnamespace and v_private_create)) loop\n    if exists(select 1 from pg_catalog.aclexplode(v_default.defaclacl) a where a.grantor<>'postgres'::regrole or a.is_grantable or a.grantee not in(0,'postgres'::regrole,'anon'::regrole,'authenticated'::regrole,'service_role'::regrole) or a.privilege_type<>'EXECUTE') or (v_default.defaclnamespace=0 and (select array_agg(a.privilege_type order by a.privilege_type) from pg_catalog.aclexplode(v_default.defaclacl) a where a.grantee='postgres'::regrole) is distinct from array['EXECUTE']::text[]) then raise exception 'R01 CRM function creation default ACL differs' using errcode='55000'; end if;\n  end loop;\n  -- No writes precede this line. Exact good definitions retain their OIDs/ACLs.\n`;
for(const s of [...specs.slice(-1),...specs.slice(0,-1)]){const signature=`${s.schema}.${s.name}(${s.signature})`;sql+=`  v_function := pg_catalog.to_regprocedure('${signature}');\n  if v_function is null or (select pg_catalog.md5(prosrc) from pg_catalog.pg_proc where oid=v_function)<>'${md5(s.new)}' then\n    execute $definition$create or replace function ${s.schema}.${s.name}(${s.args})\nreturns ${s.returns}\nlanguage plpgsql\nsecurity ${s.definer?"definer":"invoker"}\nset search_path = ''\nas $function$${s.new}$function$;$definition$;\n    if v_function is null then\n      revoke all on function ${signature} from public,anon,authenticated,service_role;\n      grant execute on function ${signature} to service_role;\n    end if;\n  end if;\n`;}
sql+="end;\n$migration$;\n";
const file="20261001213914_r01_crm_atomic_forward.sql";
await writeFile("supabase/migrations/"+file,sql);
await writeFile("docs/evidence/audit-remediation-20260927/r01-forward/task-6-fix-2-generated-profiles.json",JSON.stringify({file,supporterAlternative:{...supporterAlternative,sourceFragments:bootstrap.sourceFragments,qualification:"PG17.6 source-component reconstruction; not exact CI17.11 bootstrap proof"},sourceGeneration:"exact LF historical body hashes plus controller ruled own-domain fence/consent guard; utility unchanged",versionHelperMetadata:[{name:'private.bump_supporter_edit_version',owner:'postgres',effectiveExecuteRecipients:['postgres'],grantOptions:false},{name:'private.bump_supporter_edit_version_from_role',owner:'postgres',effectiveExecuteRecipients:['PUBLIC','postgres'],grantOptions:false}],argumentDefaults:0,versionHelperMetadata:[{name:'private.bump_supporter_edit_version',owner:'postgres',effectiveExecuteRecipients:['postgres'],grantOptions:false},{name:'private.bump_supporter_edit_version_from_role',owner:'postgres',effectiveExecuteRecipients:['PUBLIC','postgres'],grantOptions:false}],argumentDefaults:0,functions:specs.map(s=>({name:s.schema+"."+s.name,oldMd5:md5(s.old),newMd5:md5(s.new)})),tableProfiles:profiles.map(p=>({mode:p.mode,profiles:p.domainProfiles.map((x:{name:string;md5:string})=>({name:x.name,md5:x.md5}))}))},null,2)+"\n");
console.log(JSON.stringify({file,bytes:Buffer.byteLength(sql),sha256:createHash("sha256").update(sql).digest("hex")}));
