import ts from "typescript";import {SQL} from "bun";import {readFile,writeFile,mkdir} from "node:fs/promises";import {hash} from "../../../supabase/rls-tests/helpers/productionSchemaClone";
const source=await readFile("supabase/rls-tests/helpers/productionSchemaClone.ts","utf8");const ast=ts.createSourceFile("scanner.ts",source,ts.ScriptTarget.Latest,true);const queries:string[]=[];
const scanner=ast.statements.find(n=>ts.isFunctionDeclaration(n)&&n.name?.text==="assertSafeFixtureTables");if(!scanner)throw Error("function absent");
const visit=(n:ts.Node)=>{if(ts.isCallExpression(n)&&ts.isPropertyAccessExpression(n.expression)&&n.expression.name.text==="unsafe"&&ts.isStringLiteral(n.arguments[0]))queries.push(n.arguments[0].text);ts.forEachChild(n,visit)};visit(scanner);
const db=new SQL("postgresql://postgres:postgres@127.0.0.1:52322/audit_pr135_20260929");const container="r01-task10-fix1-role-20261002-126d7280-v2";
const own=async(q:string)=>{const p=Bun.spawn(["docker","exec","-i",container,"psql","-X","-qAt","-h","/tmp","-U","supabase_admin","-d","r01_task10_fix1","-v","ON_ERROR_STOP=1"],{stdin:new Blob(["begin read only;set local search_path=pg_catalog;select json_agg(row_to_json(t)) from ("+q+")t;commit;"]),stdout:"pipe",stderr:"pipe"});const [out,err,exit]=await Promise.all([new Response(p.stdout).text(),new Response(p.stderr).text(),p.exited]);if(exit)throw Error(err);return JSON.parse(out) as Record<string,unknown>[]};
const out=import.meta.dir+"/task-10-fix1-oid-array-protocol-"+Date.now();await mkdir(out);const result:unknown[]=[];
const qualified=["auth.users","public.admin_user","public.audit_log"];let expressionQuery="";
const visitTemplate=(n:ts.Node)=>{if(ts.isCallExpression(n)&&ts.isPropertyAccessExpression(n.expression)&&n.expression.name.text==="unsafe"&&ts.isTemplateExpression(n.arguments[0])&&n.arguments[0].getText(ast).includes("pg_get_expr(d.adbin"))expressionQuery=new Function("qualified","return "+n.arguments[0].getText(ast))(qualified);ts.forEachChild(n,visitTemplate)};visitTemplate(scanner);if(!expressionQuery)throw Error("Exact expression query absent");
const sourceRows=await db.begin(async tx=>{await tx.unsafe("set local search_path=pg_catalog");return tx.unsafe(expressionQuery)});const ownRows=await own(expressionQuery);
const pick=(rs:Record<string,unknown>[])=>rs.map(r=>({expressionSHA:hash(r.expression),value:r.operatorOids,type:typeof r.operatorOids,isArray:Array.isArray(r.operatorOids),elementTypes:Array.isArray(r.operatorOids)?r.operatorOids.map(v=>typeof v):null}));
result.push({querySha256:hash(expressionQuery),source:pick(sourceRows),ownedPsql:pick(ownRows)});
await db.close();await writeFile(out+"/receipt.json",JSON.stringify({scannerSHA:hash(source),result},null,2)+"\n");console.log(JSON.stringify({out,result}));
