    'admin_user.invite_resend',
    'admin_user',
    resent_user_row.id::text,
    p_sent_at,
    pg_catalog.jsonb_build_object(
      'targetEmail', resent_user_row.email,
      'role', resent_user_row.role,
      'status', resent_user_row.status
    )
  );

  return resent_user_row;
end;
