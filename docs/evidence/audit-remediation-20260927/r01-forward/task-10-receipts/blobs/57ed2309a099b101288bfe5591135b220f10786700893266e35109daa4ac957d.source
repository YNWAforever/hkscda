import {SQL} from "bun";
import {assertSafeFixtureTables} from "../../../supabase/rls-tests/helpers/productionSchemaClone";
const container="r01-task10-fix1-role-20261002-126d7280-v2";
const unsafe=async(query:string)=>{
 if(query==="set local search_path=pg_catalog")return [];
 if(!/^select\s/i.test(query))throw Error("Scanner adapter read-only SELECT allowlist");
 // Exclusive owned cluster; no concurrent mutation during these metadata snapshots.
 const input="begin read only;set local search_path=pg_catalog;select coalesce(json_agg(row_to_json(q)),'[]'::json) from ("+query+") q;commit;";
 const p=Bun.spawn(["docker","exec","-i",container,"psql","-X","-qAt","-h","/tmp","-U","supabase_admin","-d","r01_task10_fix1","-v","ON_ERROR_STOP=1"],{stdin:new Blob([input]),stdout:"pipe",stderr:"pipe"});
 const [out,err,exit]=await Promise.all([new Response(p.stdout).text(),new Response(p.stderr).text(),p.exited]);if(exit)throw Error(err);const rows=JSON.parse(out) as Record<string,unknown>[];
 // PostgreSQL oid's JSON representation is a decimal string; Bun SQL decodes oid as number.
 // Decode only declared scanner OID fields; null and all other metadata remain exact.
 const oid=(value:unknown):number|null=>{if(value===null)return null;if(typeof value!=="string"||!/^\d+$/.test(value))throw Error("Unexpected psql oid wire type");const n=Number(value);if(!Number.isInteger(n)||n<0||n>4294967295)throw Error("Invalid psql oid wire value");return n;};
 for(const row of rows){for(const key of ["oid","implementationOid","restrictionOid","joinOid"]){if(key in row)row[key]=oid(row[key]);}if("operatorOids" in row){if(!Array.isArray(row.operatorOids))throw Error("Unexpected operator OID array");row.operatorOids=row.operatorOids.map(oid);}}
 return rows;
};
const adapter={unsafe,begin:async(run:(tx:unknown)=>Promise<unknown>)=>run({unsafe})};
await assertSafeFixtureTables(adapter as unknown as SQL,["auth.users","public.admin_user","public.audit_log"]);
console.log("UNCHANGED5352 FULL THREE-TABLE SCANNER PASS");
