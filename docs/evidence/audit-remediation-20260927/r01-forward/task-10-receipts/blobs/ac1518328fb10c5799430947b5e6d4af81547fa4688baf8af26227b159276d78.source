-- Name: recurring_mandate; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.recurring_mandate (
    id uuid DEFAULT gen_random_uuid() NOT NULL,
    supporter_id uuid NOT NULL,
    amount_cents integer NOT NULL,
    provider text NOT NULL,
    provider_ref text NOT NULL,
    status text DEFAULT 'active'::text NOT NULL,
    next_charge_at timestamp with time zone,
    created_at timestamp with time zone DEFAULT now() NOT NULL,
    updated_at timestamp with time zone DEFAULT now() NOT NULL,
    CONSTRAINT recurring_mandate_amount_cents_check CHECK ((amount_cents > 0)),
    CONSTRAINT recurring_mandate_provider_check CHECK ((provider = ANY (ARRAY['stripe'::text, 'paypal'::text]))),
    CONSTRAINT recurring_mandate_status_check CHECK ((status = ANY (ARRAY['active'::text, 'failed'::text, 'cancelled'::text])))
);


ALTER TABLE public.recurring_mandate OWNER TO postgres;

--
-- Name: rescue_story_profile; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.rescue_story_profile (
    content_item_id uuid NOT NULL,
    animal_type text NOT NULL,
    public_status text NOT NULL,
    rescue_region text NOT NULL,
    rescue_date date,
    show_on_map boolean DEFAULT false NOT NULL,
    public_map_label text,
    public_lat numeric(9,6),
    public_lng numeric(9,6),
    internal_address text,
    internal_location_notes text,
    is_featured boolean DEFAULT false NOT NULL,
    created_at timestamp with time zone DEFAULT now() NOT NULL,
    updated_at timestamp with time zone DEFAULT now() NOT NULL,
    CONSTRAINT rescue_story_profile_animal_type_check CHECK ((animal_type = ANY (ARRAY['cat'::text, 'dog'::text, 'mixed'::text, 'unknown'::text]))),
    CONSTRAINT rescue_story_profile_check CHECK (((show_on_map = false) OR ((public_map_label IS NOT NULL) AND (public_lat IS NOT NULL) AND (public_lng IS NOT NULL)))),
    CONSTRAINT rescue_story_profile_public_lat_check CHECK (((public_lat IS NULL) OR ((public_lat >= ('-90'::integer)::numeric) AND (public_lat <= (90)::numeric)))),
    CONSTRAINT rescue_story_profile_public_lng_check CHECK (((public_lng IS NULL) OR ((public_lng >= ('-180'::integer)::numeric) AND (public_lng <= (180)::numeric)))),
    CONSTRAINT rescue_story_profile_public_status_check CHECK ((public_status = ANY (ARRAY['rescued'::text, 'medical_care'::text, 'foster_recovery'::text, 'ready_for_adoption'::text, 'adopted'::text, 'sponsor_needed'::text, 'closed'::text])))
);


ALTER TABLE public.rescue_story_profile OWNER TO postgres;

