--
-- Name: animals public read available; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "public read available" ON public.animals FOR SELECT USING (((status = ANY (ARRAY['available'::text, 'fostered'::text])) AND (retired_at IS NULL) AND (publication_state = 'published'::text) AND (adoption_eligible OR sponsorship_eligible)));


