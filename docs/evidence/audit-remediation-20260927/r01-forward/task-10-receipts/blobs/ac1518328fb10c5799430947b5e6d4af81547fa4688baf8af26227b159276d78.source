--

CREATE TABLE public.sponsorship_assignment (
    id uuid DEFAULT gen_random_uuid() NOT NULL,
    pledge_id uuid NOT NULL,
    animal_id uuid,
    animal_name_snapshot text NOT NULL,
    started_on date DEFAULT ((now() AT TIME ZONE 'Asia/Hong_Kong'::text))::date NOT NULL,
    ended_on date,
    end_reason text,
    end_note text,
    note text,
    created_by uuid,
    ended_by uuid,
    created_at timestamp with time zone DEFAULT now() NOT NULL,
    updated_at timestamp with time zone DEFAULT now() NOT NULL,
    CONSTRAINT sponsorship_assignment_end_reason_known CHECK (((end_reason IS NULL) OR (end_reason = ANY (ARRAY['adopted'::text, 'deceased'::text, 'ineligible'::text, 'retired'::text, 'supporter_request'::text, 'transferred'::text, 'other'::text])))),
    CONSTRAINT sponsorship_assignment_ends_after_start CHECK (((ended_on IS NULL) OR (ended_on >= started_on))),
    CONSTRAINT sponsorship_assignment_reason_with_end CHECK (((ended_on IS NULL) = (end_reason IS NULL)))
);


ALTER TABLE public.sponsorship_assignment OWNER TO postgres;

