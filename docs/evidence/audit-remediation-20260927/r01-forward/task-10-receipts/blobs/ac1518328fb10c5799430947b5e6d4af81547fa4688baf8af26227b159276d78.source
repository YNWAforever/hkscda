--
-- Name: adoption_instruction_revisions staff can create adoption instruction drafts; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "staff can create adoption instruction drafts" ON public.adoption_instruction_revisions FOR INSERT TO authenticated WITH CHECK (((state = 'draft'::text) AND private.has_admin_role(ARRAY['staff'::text, 'admin'::text])));


--
-- Name: adoption_guide_releases staff can create draft adoption guide releases; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "staff can create draft adoption guide releases" ON public.adoption_guide_releases FOR INSERT TO authenticated WITH CHECK (((state = 'draft'::text) AND private.has_admin_role(ARRAY['staff'::text, 'admin'::text]) AND (EXISTS ( SELECT 1
   FROM public.admin_user actor
  WHERE ((actor.id = adoption_guide_releases.created_by) AND (actor.id = adoption_guide_releases.updated_by) AND (actor.auth_user_id = ( SELECT auth.uid() AS uid)) AND (actor.status = 'active'::text) AND (actor.role = ANY (ARRAY['staff'::text, 'admin'::text])))))));


--
-- Name: payment_public_config staff can create draft payment public config; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "staff can create draft payment public config" ON public.payment_public_config FOR INSERT TO authenticated WITH CHECK (((state = 'draft'::text) AND private.has_admin_role(ARRAY['staff'::text, 'treasurer'::text, 'admin'::text]) AND (EXISTS ( SELECT 1
   FROM public.admin_user actor
  WHERE ((actor.id = payment_public_config.created_by) AND (actor.id = payment_public_config.updated_by) AND (actor.auth_user_id = auth.uid()) AND (actor.status = 'active'::text) AND (actor.role = ANY (ARRAY['staff'::text, 'treasurer'::text, 'admin'::text])))))));


