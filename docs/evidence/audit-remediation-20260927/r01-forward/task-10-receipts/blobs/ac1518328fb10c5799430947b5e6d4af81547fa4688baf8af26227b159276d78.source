    supporter_id uuid NOT NULL,
    channel text NOT NULL,
    template_id uuid,
    status text DEFAULT 'queued'::text NOT NULL,
    payload jsonb DEFAULT '{}'::jsonb NOT NULL,
    sent_at timestamp with time zone,
    created_at timestamp with time zone DEFAULT now() NOT NULL,
    updated_at timestamp with time zone DEFAULT now() NOT NULL,
    CONSTRAINT message_channel_check CHECK ((channel = ANY (ARRAY['email'::text, 'whatsapp'::text]))),
    CONSTRAINT message_status_check CHECK ((status = ANY (ARRAY['queued'::text, 'sent'::text, 'delivered'::text, 'failed'::text])))
);


ALTER TABLE public.message OWNER TO postgres;

--
-- Name: message_delivery_status; Type: VIEW; Schema: public; Owner: postgres
--

CREATE VIEW public.message_delivery_status AS
 SELECT m.id,
    m.supporter_id,
    m.channel,
    m.template_id,
        CASE
            WHEN (e.state = 'delivered'::text) THEN 'delivered'::text
            ELSE m.status
        END AS status,
    (m.payload || jsonb_build_object('deliveryState', e.state, 'deliveryObservedAt', e.occurred_at)) AS payload,
    m.sent_at,
    m.created_at,
    m.updated_at,
    e.state AS delivery_state,
    e.occurred_at AS delivery_observed_at
   FROM (public.message m
     LEFT JOIN public.mail_delivery_latest e ON ((e.provider_message_id = (m.payload ->> 'providerMessageId'::text))));


ALTER VIEW public.message_delivery_status OWNER TO postgres;

