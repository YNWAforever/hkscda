-- Name: volunteer_activity; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.volunteer_activity (
    id uuid DEFAULT gen_random_uuid() NOT NULL,
    type text NOT NULL,
    title text NOT NULL,
    description text,
    starts_at timestamp with time zone NOT NULL,
    ends_at timestamp with time zone,
    location text NOT NULL,
    capacity integer NOT NULL,
    min_age integer,
    underage_policy text DEFAULT 'allow_with_guardian_pending'::text NOT NULL,
    auto_approve boolean DEFAULT false NOT NULL,
    allow_waitlist boolean DEFAULT true NOT NULL,
    status text DEFAULT 'draft'::text NOT NULL,
    registration_modes text[] DEFAULT ARRAY['individual'::text] NOT NULL,
    created_at timestamp with time zone DEFAULT now() NOT NULL,
    updated_at timestamp with time zone DEFAULT now() NOT NULL,
    policy_version_id uuid,
    policy_revision bigint DEFAULT 0 NOT NULL,
    template_key text,
    shelter_key text,
    group_headcount integer DEFAULT 0 NOT NULL,
    registrations_closed_at timestamp with time zone,
    registrations_closed_reason text,
    CONSTRAINT volunteer_activity_capacity_check CHECK ((capacity > 0)),
    CONSTRAINT volunteer_activity_check CHECK (((ends_at IS NULL) OR (ends_at >= starts_at))),
    CONSTRAINT volunteer_activity_group_headcount_check CHECK ((group_headcount >= 0)),
    CONSTRAINT volunteer_activity_min_age_check CHECK (((min_age IS NULL) OR (min_age >= 0))),
    CONSTRAINT volunteer_activity_registration_modes_check CHECK ((array_length(registration_modes, 1) IS NOT NULL)),
    CONSTRAINT volunteer_activity_registration_modes_check1 CHECK ((registration_modes <@ ARRAY['individual'::text, 'group'::text])),
    CONSTRAINT volunteer_activity_status_check CHECK ((status = ANY (ARRAY['draft'::text, 'published'::text, 'closed'::text, 'cancelled'::text]))),
    CONSTRAINT volunteer_activity_type_check CHECK ((type = ANY (ARRAY['volunteer_shift'::text, 'group_activity'::text, 'cleaning_day'::text]))),
    CONSTRAINT volunteer_activity_underage_policy_check CHECK ((underage_policy = ANY (ARRAY['block'::text, 'allow_with_guardian_pending'::text])))
);


