-- Name: sponsorship_delivery_outbox; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.sponsorship_delivery_outbox (
    id uuid DEFAULT gen_random_uuid() NOT NULL,
    scope text NOT NULL,
    pledge_id uuid NOT NULL,
    message_id uuid NOT NULL,
    recipient_email text NOT NULL,
    recipient_name text NOT NULL,
    language text NOT NULL,
    amount_cents integer NOT NULL,
    event text NOT NULL,
    proof_id uuid,
    attempts integer DEFAULT 0 NOT NULL,
    status text DEFAULT 'queued'::text NOT NULL,
    lease_token uuid,
    lease_until timestamp with time zone,
    next_attempt_at timestamp with time zone DEFAULT now() NOT NULL,
    provider_message_id text,
    last_error text,
    sent_at timestamp with time zone,
    created_at timestamp with time zone DEFAULT now() NOT NULL,
    CONSTRAINT sponsorship_delivery_outbox_event_check CHECK ((event = ANY (ARRAY['proof_recorded'::text, 'active'::text, 'needs_followup'::text, 'cancelled'::text, 'refund_recorded'::text]))),
    CONSTRAINT sponsorship_delivery_outbox_status_check CHECK ((status = ANY (ARRAY['queued'::text, 'processing'::text, 'sent'::text, 'failed'::text])))
);


ALTER TABLE public.sponsorship_delivery_outbox OWNER TO postgres;

--
-- Name: sponsorship_delivery_status; Type: VIEW; Schema: public; Owner: postgres
--

CREATE VIEW public.sponsorship_delivery_status AS
 SELECT o.id,
    o.scope,
    o.pledge_id,
    o.message_id,
    o.recipient_email,
    o.recipient_name,
    o.language,
    o.amount_cents,
    o.event,
    o.proof_id,
    o.attempts,
    o.status,
    o.lease_token,
    o.lease_until,
    o.next_attempt_at,
    o.provider_message_id,
    o.last_error,
    o.sent_at,
    o.created_at,
    e.state AS delivery_state,
    e.occurred_at AS delivery_observed_at
   FROM (public.sponsorship_delivery_outbox o
     LEFT JOIN public.mail_delivery_latest e ON ((e.provider_message_id = o.provider_message_id)));


ALTER VIEW public.sponsorship_delivery_status OWNER TO postgres;

