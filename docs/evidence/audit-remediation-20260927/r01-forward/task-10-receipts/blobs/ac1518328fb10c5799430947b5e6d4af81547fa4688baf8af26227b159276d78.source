--
-- Name: sponsorship_payment_proof; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.sponsorship_payment_proof (
    id uuid DEFAULT gen_random_uuid() NOT NULL,
    pledge_id uuid NOT NULL,
    storage_bucket text DEFAULT 'sponsorship-payment-proof'::text NOT NULL,
    storage_path text,
    file_name text,
    file_type text,
    file_size integer,
    payment_method text NOT NULL,
    reference text,
    amount_cents integer NOT NULL,
    payment_date date NOT NULL,
    review_status text DEFAULT 'pending'::text NOT NULL,
    created_at timestamp with time zone DEFAULT now() NOT NULL,
    reviewed_by uuid,
    reviewed_at timestamp with time zone,
    review_note text,
    source text DEFAULT 'public'::text NOT NULL,
    revision bigint DEFAULT 1 NOT NULL,
    contact_snapshot jsonb,
    CONSTRAINT sponsorship_payment_proof_amount_cents_check CHECK ((amount_cents > 0)),
    CONSTRAINT sponsorship_payment_proof_file_size_check CHECK (((file_size IS NULL) OR ((file_size > 0) AND (file_size <= 8388608)))),
    CONSTRAINT sponsorship_payment_proof_file_type_check CHECK (((file_type IS NULL) OR (file_type = ANY (ARRAY['image/jpeg'::text, 'image/png'::text, 'image/webp'::text, 'application/pdf'::text])))),
    CONSTRAINT sponsorship_payment_proof_payment_method_check CHECK ((payment_method = ANY (ARRAY['fps'::text, 'bank_transfer'::text, 'payme'::text, 'paypal'::text, 'give_asia'::text]))),
    CONSTRAINT sponsorship_payment_proof_review_status_check CHECK ((review_status = ANY (ARRAY['pending'::text, 'approved'::text, 'rejected'::text]))),
    CONSTRAINT sponsorship_payment_proof_revision_check CHECK ((revision > 0)),
    CONSTRAINT sponsorship_payment_proof_source_check CHECK ((source = ANY (ARRAY['public'::text, 'staff'::text]))),
    CONSTRAINT sponsorship_payment_proof_storage_bucket_check CHECK ((storage_bucket = 'sponsorship-payment-proof'::text))
);


ALTER TABLE public.sponsorship_payment_proof OWNER TO postgres;

