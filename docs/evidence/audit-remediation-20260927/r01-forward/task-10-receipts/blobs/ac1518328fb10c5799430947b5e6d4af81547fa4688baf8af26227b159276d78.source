--
-- Name: donation; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.donation (
    id uuid DEFAULT gen_random_uuid() NOT NULL,
    supporter_id uuid NOT NULL,
    amount_cents integer NOT NULL,
    currency text DEFAULT 'HKD'::text NOT NULL,
    purpose text NOT NULL,
    type text DEFAULT 'one_time'::text NOT NULL,
    recurring_id uuid,
    status text DEFAULT 'pending'::text NOT NULL,
    method text NOT NULL,
    receipt_requested boolean DEFAULT false NOT NULL,
    created_at timestamp with time zone DEFAULT now() NOT NULL,
    updated_at timestamp with time zone DEFAULT now() NOT NULL,
    acquisition_source text,
    acquisition_context text,
    acquisition_placement text,
    acquisition_trigger text,
    custom_purpose text,
    contact_name text,
    contact_email public.citext,
    contact_phone text,
    contact_language text,
    consent_email_requested boolean DEFAULT false NOT NULL,
    consent_whatsapp_requested boolean DEFAULT false NOT NULL,
    refunded_cents integer DEFAULT 0 NOT NULL,
    idempotency_key uuid,
    idempotency_fingerprint text,
    CONSTRAINT donation_acquisition_context_check CHECK (((acquisition_context IS NULL) OR (acquisition_context = ANY (ARRAY['general'::text, 'story'::text, 'animal'::text, 'sponsor'::text, 'transparency'::text, 'community'::text])))),
    CONSTRAINT donation_acquisition_placement_check CHECK (((acquisition_placement IS NULL) OR (acquisition_placement = ANY (ARRAY['mobile-bottom'::text, 'desktop-left'::text])))),
    CONSTRAINT donation_acquisition_source_check CHECK (((acquisition_source IS NULL) OR (acquisition_source = 'contextual-cta'::text))),
    CONSTRAINT donation_acquisition_trigger_check CHECK (((acquisition_trigger IS NULL) OR (acquisition_trigger = ANY (ARRAY['scroll'::text, 'timer'::text])))),
    CONSTRAINT donation_amount_cents_check CHECK ((amount_cents > 0)),
    CONSTRAINT donation_check CHECK (((refunded_cents >= 0) AND (refunded_cents <= amount_cents))),
    CONSTRAINT donation_contact_language_check CHECK (((contact_language IS NULL) OR (contact_language = ANY (ARRAY['zh-HK'::text, 'en'::text])))),
    CONSTRAINT donation_contact_snapshot_length_check CHECK ((((contact_name IS NULL) OR ((char_length(contact_name) >= 1) AND (char_length(contact_name) <= 120))) AND ((contact_email IS NULL) OR (char_length((contact_email)::text) <= 254)) AND ((contact_phone IS NULL) OR (char_length(contact_phone) <= 40)))),
    CONSTRAINT donation_currency_check CHECK ((currency = 'HKD'::text)),
    CONSTRAINT donation_custom_purpose_length_check CHECK (((custom_purpose IS NULL) OR (char_length(custom_purpose) <= 200))),
    CONSTRAINT donation_idempotency_fingerprint_check CHECK ((((idempotency_key IS NULL) AND (idempotency_fingerprint IS NULL)) OR ((idempotency_key IS NOT NULL) AND (idempotency_fingerprint ~ '^[0-9a-f]{64}$'::text)))),
    CONSTRAINT donation_method_check CHECK ((method = ANY (ARRAY['stripe'::text, 'payme'::text, 'fps'::text, 'paypal'::text, 'manual'::text, 'alipayhk'::text]))),
    CONSTRAINT donation_purpose_check CHECK ((purpose = ANY (ARRAY['general'::text, 'medical'::text, 'sponsor'::text]))),
    CONSTRAINT donation_status_check CHECK ((status = ANY (ARRAY['pending'::text, 'succeeded'::text, 'failed'::text, 'refunded'::text]))),
    CONSTRAINT donation_type_check CHECK ((type = ANY (ARRAY['one_time'::text, 'recurring'::text])))
);


