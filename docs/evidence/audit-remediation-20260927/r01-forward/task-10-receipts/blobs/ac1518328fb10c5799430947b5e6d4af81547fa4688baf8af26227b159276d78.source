-- Name: mail_delivery_event; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.mail_delivery_event (
    event_id text NOT NULL,
    provider_message_id text NOT NULL,
    event_type text NOT NULL,
    occurred_at timestamp with time zone NOT NULL,
    body_hash text NOT NULL,
    received_at timestamp with time zone DEFAULT clock_timestamp() NOT NULL,
    CONSTRAINT mail_delivery_event_body_hash_check CHECK ((body_hash ~ '^[a-f0-9]{64}$'::text)),
    CONSTRAINT mail_delivery_event_event_id_check CHECK (((length(event_id) >= 1) AND (length(event_id) <= 200))),
    CONSTRAINT mail_delivery_event_event_type_check CHECK ((event_type = ANY (ARRAY['email.delivered'::text, 'email.bounced'::text, 'email.failed'::text, 'email.complained'::text, 'email.delivery_delayed'::text]))),
    CONSTRAINT mail_delivery_event_provider_message_id_check CHECK (((length(provider_message_id) >= 1) AND (length(provider_message_id) <= 200)))
);


ALTER TABLE public.mail_delivery_event OWNER TO postgres;

--
-- Name: mail_delivery_latest; Type: VIEW; Schema: public; Owner: postgres
--

CREATE VIEW public.mail_delivery_latest AS
 SELECT DISTINCT ON (provider_message_id) provider_message_id,
    event_id,
    replace(event_type, 'email.'::text, ''::text) AS state,
    occurred_at
   FROM public.mail_delivery_event
  ORDER BY provider_message_id, (event_type <> 'email.delivery_delayed'::text) DESC, occurred_at DESC,
        CASE event_type
            WHEN 'email.complained'::text THEN 4
            WHEN 'email.bounced'::text THEN 3
            WHEN 'email.failed'::text THEN 2
            WHEN 'email.delivered'::text THEN 1
            ELSE 0
        END DESC, event_id;


ALTER VIEW public.mail_delivery_latest OWNER TO postgres;

