--
-- Name: coordinator_status_history; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.coordinator_status_history (
    id uuid DEFAULT gen_random_uuid() NOT NULL,
    entity_type text NOT NULL,
    entity_id uuid NOT NULL,
    status_category text GENERATED ALWAYS AS (
CASE entity_type
    WHEN 'adoption_case'::text THEN 'adoption_case'::text
    WHEN 'animal_match'::text THEN 'match'::text
    WHEN 'animal'::text THEN 'animal_lifecycle'::text
    ELSE NULL::text
END) STORED,
    status_id uuid NOT NULL,
    actor_user_id uuid,
    note text,
    created_at timestamp with time zone DEFAULT now() NOT NULL,
    CONSTRAINT coordinator_status_history_entity_type_check CHECK ((entity_type = ANY (ARRAY['adoption_case'::text, 'animal_match'::text, 'animal'::text])))
);


