CREATE FUNCTION public.claim_expired_sponsorship_proof_uploads(p_cutoff timestamp with time zone, p_limit integer DEFAULT 50) RETURNS TABLE(pledge_id uuid, storage_path text, claimed_at timestamp with time zone)
