    subtitle text,
    summary text NOT NULL,
    body text,
    cover_media_id uuid,
    status text DEFAULT 'draft'::text NOT NULL,
    published_at timestamp with time zone,
    cta_label text,
    cta_url text,
    seo_title text,
    seo_description text,
    og_title text,
    og_description text,
    created_by uuid,
    updated_by uuid,
    created_at timestamp with time zone DEFAULT now() NOT NULL,
    updated_at timestamp with time zone DEFAULT now() NOT NULL,
    version integer DEFAULT 0 NOT NULL,
    published_slug text,
    published_revision_id uuid,
    draft_revision_id uuid,
    content_class text DEFAULT 'unreviewed'::text NOT NULL,
    source_reference text,
    content_owner text,
    effective_from timestamp with time zone,
    effective_until timestamp with time zone,
    CONSTRAINT content_item_check CHECK (((status <> 'published'::text) OR (published_at IS NOT NULL))),
    CONSTRAINT content_item_class_check CHECK ((content_class = ANY (ARRAY['unreviewed'::text, 'verified'::text, 'demo'::text]))),
    CONSTRAINT content_item_effective_range_check CHECK (((effective_from IS NULL) OR (effective_until IS NULL) OR (effective_from <= effective_until))),
    CONSTRAINT content_item_slug_check CHECK ((slug ~ '^[a-z0-9]+(?:-[a-z0-9]+)*$'::text)),
    CONSTRAINT content_item_status_check CHECK ((status = ANY (ARRAY['draft'::text, 'published'::text, 'archived'::text]))),
    CONSTRAINT content_item_type_check CHECK ((type = ANY (ARRAY['rescue_story'::text, 'event'::text, 'charity_market'::text, 'report'::text]))),
    CONSTRAINT content_item_verified_provenance_check CHECK (((content_class <> 'verified'::text) OR ((NULLIF(btrim(source_reference), ''::text) IS NOT NULL) AND (NULLIF(btrim(content_owner), ''::text) IS NOT NULL)))),
    CONSTRAINT content_item_version_check CHECK ((version >= 0))
);


