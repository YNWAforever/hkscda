CREATE ROLE "pgbouncer" NOSUPERUSER INHERIT LOGIN NOBYPASSRLS NOCREATEDB NOCREATEROLE NOREPLICATION CONNECTION LIMIT -1;
CREATE ROLE "service_role" NOSUPERUSER INHERIT NOLOGIN BYPASSRLS NOCREATEDB NOCREATEROLE NOREPLICATION CONNECTION LIMIT -1;
