CREATE ROLE "supabase_replication_admin" NOSUPERUSER INHERIT LOGIN NOBYPASSRLS NOCREATEDB NOCREATEROLE REPLICATION CONNECTION LIMIT -1;
CREATE ROLE "supabase_storage_admin" NOSUPERUSER NOINHERIT LOGIN NOBYPASSRLS NOCREATEDB CREATEROLE NOREPLICATION CONNECTION LIMIT -1;
CREATE DATABASE r01_task10_fix1 OWNER postgres;
