ALTER ROLE supabase_admin SUPERUSER INHERIT LOGIN BYPASSRLS CREATEDB CREATEROLE REPLICATION;
CREATE ROLE postgres NOSUPERUSER INHERIT LOGIN BYPASSRLS CREATEDB CREATEROLE REPLICATION CONNECTION LIMIT -1;
