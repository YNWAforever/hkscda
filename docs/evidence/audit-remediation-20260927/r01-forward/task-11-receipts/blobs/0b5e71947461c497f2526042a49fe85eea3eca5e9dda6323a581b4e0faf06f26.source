import hashlib,json,pathlib,re
root=pathlib.Path.cwd();scratch=root/'.superpowers/sdd/r01-forward-schema-plan-20261001';out=scratch/'task-11-fix3-baseline-1cea764774294eb6bc9c9c41edffbe85';target=out/'complete-handoff-v2/target-check';target.mkdir();bindings=[]
def read(path):
 raw=path.read_bytes();archive='i'+str(len(bindings))+'.source';(target/archive).write_bytes(raw);bindings.append({'path':str(path.relative_to(root)).replace('\\','/'),'rawSha256':hashlib.sha256(raw).hexdigest(),'bytes':len(raw),'archive':archive});return raw
read(pathlib.Path(__file__));capture=json.loads(read(out/'d45-baseline.json'));finance=read(root/'supabase/migrations/20261002170945_r01_finance_callback_forward.sql');profile=read(root/'docs/evidence/audit-remediation-20260927/r01-forward/task-11-profile.ts');names=json.loads(re.search(rb'export const names = (\[[^\]]+\]);',profile).group(1));results=[]
for name in names:
 pattern=rb"if v_actual<>'\[\]'::jsonb and v_actual not in\(([\s\S]*?)\) then raise exception 'R01 finance target tuple differs:"+name.encode()+rb"'";literals=re.search(pattern,finance).group(1);admitted=[json.loads(m.replace(b"''",b"'").decode())for m in re.findall(rb"'((?:[^']|'')*)'::jsonb",literals)];actual=[f for f in capture['functions']if f['schema']=='public'and f['name']==name];results.append({'name':name,'actual':actual,'admitted':admitted,'actualCardinality':len(actual),'matchesExactAllowedTuple':actual in admitted})
assert len(results)==5;receipt={'qualification':'Offline exact full target tuple check from actual v5 baseline; not finance execution or actor/behavior proof.','results':results,'allFiveExist':all(r['actualCardinality']==1 for r in results),'allFiveMatchKnownTuples':all(r['matchesExactAllowedTuple']for r in results),'bindings':bindings};(target/'receipt.json').write_text(json.dumps(receipt,indent=2)+'\n',encoding='utf-8',newline='\n');print(json.dumps({k:receipt[k]for k in ['allFiveExist','allFiveMatchKnownTuples']}))
