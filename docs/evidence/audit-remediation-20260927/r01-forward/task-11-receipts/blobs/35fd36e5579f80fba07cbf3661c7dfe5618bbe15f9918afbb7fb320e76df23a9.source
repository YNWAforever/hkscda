import { afterAll, describe, expect, test } from "bun:test";
import { SQL } from "bun";
import { randomUUID } from "node:crypto";
import { assertCloneUrl } from "../../../supabase/rls-tests/helpers/productionSchemaClone";

const url = process.env.R01_FINANCE_CALLBACK_TEST_DATABASE_URL;
const enabled = !!url && process.env.R01_FINANCE_CALLBACK_ALLOW_LOCAL_FIXTURES === "1";
if (enabled) assertCloneUrl(url!);
const db = enabled ? new SQL(url!, { max: 5 }) : null;
const rollback = new Error("Task11 fixture rollback");

describe.skipIf(!db)("Task11 finance callback production gaps", () => {
  const calls = [
    [
      "fail_pending_provider_payment",
      "select public.fail_pending_provider_payment(null::uuid,null::uuid)",
    ],
    [
      "refund_provider_payment_atomically",
      "select public.refund_provider_payment_atomically(null::uuid,null::uuid)",
    ],
    [
      "void_receipt_with_audit",
      "select * from public.void_receipt_with_audit(null::uuid,null::uuid)",
    ],
    [
      "void_donation_receipts_with_audit",
      "select * from public.void_donation_receipts_with_audit(null::uuid)",
    ],
    [
      "issue_receipt_with_audit",
      "select * from public.issue_receipt_with_audit(null::uuid,null::uuid,10000,2026,now(),null::uuid)",
    ],
  ] as const;
  for (const [name, statement] of calls)
    test(`${name} resolves current API signature before input rejection`, async () => {
      try {
        await db!.begin(async (tx) => {
          await tx`set local role service_role`;
          let error: unknown;
          await tx.unsafe("savepoint task11_missing");
          try {
            await tx.unsafe(statement);
          } catch (e) {
            error = e;
          }
          await tx.unsafe("rollback to savepoint task11_missing");
          expect((error as { errno?: string } | undefined)?.errno).not.toBe("42883");
          expect(error).toBeDefined();
          throw rollback;
        });
      } catch (e) {
        if (e !== rollback) throw e;
      }
    });
});

describe.skipIf(!db)("Task11 manual receipt Auth fence", () => {
  for (const command of ["void", "issue"] as const)
    for (const banned of [true, false])
      test(`${banned ? "banned" : "unconfirmed"} finance actor cannot ${command} a receipt`, async () => {
        try {
          await db!.begin(async (tx) => {
            await tx`set local role postgres`;
            const actor = randomUUID(),
              supporter = randomUUID(),
              donation = randomUUID(),
              receipt = randomUUID();
            await tx`insert into auth.users(id,email,email_confirmed_at,banned_until) values(${actor}::uuid,${actor + "@example.invalid"},${banned ? new Date() : null},${banned ? new Date(Date.now() + 86400000) : null})`;
            await tx`insert into public.admin_user(auth_user_id,email,role,status) values(${actor}::uuid,${actor + "@example.invalid"},'treasurer','active')`;
            await tx`insert into public.supporter(id,name,email) values(${supporter}::uuid,'Task11 synthetic supporter',${supporter + "@example.invalid"})`;
            await tx`insert into public.donation(id,supporter_id,amount_cents,purpose,method) values(${donation}::uuid,${supporter}::uuid,10000,'general','fps')`;
            if (command === "void")
              await tx`insert into public.receipt(id,supporter_id,receipt_no,donation_ids,total_amount_cents,tax_year,issued_at,status) values(${receipt}::uuid,${supporter}::uuid,${"T11-" + receipt},array[${donation}::uuid],10000,2026,now(),'issued')`;
            else
              await tx`update public.donation set status='succeeded',receipt_requested=true where id=${donation}::uuid`;
            await tx`set local role service_role`;
            await tx.unsafe("savepoint task11_fence");
            let error: unknown;
            let result: unknown;
            let observation: unknown;
            try {
              result =
                command === "void"
                  ? await tx`select * from public.void_receipt_with_audit(${receipt}::uuid,${actor}::uuid,${supporter}::uuid)`
                  : await tx`select * from public.issue_receipt_with_audit(${donation}::uuid,${supporter}::uuid,10000,2026,now(),${actor}::uuid)`;
              await tx`set local role postgres`;
              observation =
                await tx`select r.status,(select count(*)::text from public.audit_log a where a.action=${"receipt." + command} and a.entity_id=${command === "void" ? receipt : donation}) audits from public.receipt r where r.donation_ids @> array[${donation}::uuid]`;
              console.log(
                JSON.stringify({
                  command,
                  actorState: banned ? "banned" : "unconfirmed",
                  result,
                  observation,
                }),
              );
            } catch (e) {
              error = e;
            }
            await tx.unsafe("rollback to savepoint task11_fence");
            expect((error as { errno?: string } | undefined)?.errno).toBe("42501");
            throw rollback;
          });
        } catch (e) {
          if (e !== rollback) throw e;
        }
      });
});
type FinanceFixture = {
  actor: string;
  supporter: string;
  donation: string;
  payment: string;
  receipt: string;
};
type ManualCommand = "void" | "issue";
async function seedFinance(
  tx: SQL,
  issued = false,
  role = "treasurer",
  backstopRequired = true,
  receiptId = randomUUID(),
): Promise<FinanceFixture> {
  const f = {
    actor: randomUUID(),
    supporter: randomUUID(),
    donation: randomUUID(),
    payment: randomUUID(),
    receipt: receiptId,
  };
  const backstop = randomUUID();
  for (const actor of backstopRequired ? [f.actor, backstop] : [f.actor])
    await tx`insert into auth.users(id,email,email_confirmed_at) values(${actor}::uuid,${actor + "@example.invalid"},now())`;
  for (const [actor, actorRole] of backstopRequired
    ? [
        [f.actor, role],
        [backstop, "admin"],
      ]
    : [[f.actor, role]])
    await tx`insert into public.admin_user(auth_user_id,email,role,status) values(${actor}::uuid,${actor + "@example.invalid"},${actorRole},'active')`;
  await tx`insert into public.supporter(id,name,email) values(${f.supporter}::uuid,'Task11 synthetic supporter',${f.supporter + "@example.invalid"})`;
  await tx`insert into public.donation(id,supporter_id,amount_cents,purpose,method,receipt_requested) values(${f.donation}::uuid,${f.supporter}::uuid,10000,'general','fps',true)`;
  await tx`insert into public.payment(id,donation_id,provider,amount_cents) values(${f.payment}::uuid,${f.donation}::uuid,'fps',10000)`;
  await tx`update public.payment set status='succeeded',received_at='2026-01-01T00:00:00Z' where id=${f.payment}::uuid`;
  await tx`update public.donation set status='succeeded' where id=${f.donation}::uuid`;
  if (issued)
    await tx`insert into public.receipt(id,supporter_id,receipt_no,donation_ids,total_amount_cents,tax_year,issued_at,status) values(${f.receipt}::uuid,${f.supporter}::uuid,${"T11-" + f.receipt},array[${f.donation}::uuid],10000,2026,now(),'issued')`;
  return f;
}
async function financeFixture(
  run: (tx: SQL, f: FinanceFixture) => Promise<void>,
  issued = false,
  role = "treasurer",
  receiptId?: string,
) {
  try {
    await db!.begin(async (sql) => {
      const tx = sql as SQL;
      await tx`set local role postgres`;
      const f = await seedFinance(tx, issued, role, true, receiptId);
      await run(tx, f);
      throw rollback;
    });
  } catch (e) {
    if (e !== rollback) throw e;
  }
}
async function manual(tx: SQL, command: ManualCommand, f: FinanceFixture) {
  return command === "void"
    ? await tx`select * from public.void_receipt_with_audit(${f.receipt}::uuid,${f.actor}::uuid,${f.supporter}::uuid)`
    : await tx`select * from public.issue_receipt_with_audit(${f.donation}::uuid,${f.supporter}::uuid,10000,2026,'2026-01-01T00:00:00Z',${f.actor}::uuid)`;
}
async function fail(tx: SQL, run: () => Promise<unknown>, errno: string) {
  await tx.unsafe("savepoint task11_reject");
  let error: unknown;
  try {
    await run();
  } catch (e) {
    error = e;
  }
  await tx.unsafe("rollback to savepoint task11_reject");
  await tx.unsafe("release savepoint task11_reject");
  expect((error as { errno?: string } | undefined)?.errno).toBe(errno);
}
async function money(tx: SQL, f: FinanceFixture) {
  const [r] =
    await tx`select jsonb_build_object('payment',to_jsonb(p),'donation',to_jsonb(d)) value from public.payment p join public.donation d on d.id=p.donation_id where p.id=${f.payment}::uuid`;
  return r.value;
}

describe.skipIf(!db)("Task11 finance behavior and transaction contracts", () => {
  for (const command of ["void", "issue"] as const) {
    for (const role of ["treasurer", "admin"])
      test(`${command} confirmed ${role} succeeds with one atomic audit and immutable money`, () =>
        financeFixture(
          async (tx, f) => {
            const before = await money(tx, f);
            await tx`set local role service_role`;
            const rows = await manual(tx, command, f);
            expect(rows).toHaveLength(1);
            expect(rows[0].receipt_id).toBeString();
            await tx`set local role postgres`;
            expect(await money(tx, f)).toEqual(before);
            const [audit] =
              await tx`select count(*)::integer n from public.audit_log where action=${"receipt." + command} and actor_user_id=${f.actor}::uuid`;
            expect(audit.n).toBe(1);
          },
          command === "void",
          role,
        ));
    for (const change of ["role='staff'", "status='disabled'"])
      test(`${command} rejects stale finance ${change}`, () =>
        financeFixture(async (tx, f) => {
          await tx.unsafe(
            "update public.admin_user set " + change + " where auth_user_id=$1::uuid",
            [f.actor],
          );
          await tx`set local role service_role`;
          await fail(tx, () => manual(tx, command, f), "42501");
        }, command === "void"));
    test(`${command} audit failure rolls back receipt and sequence but preserves settled payment`, () =>
      financeFixture(async (tx, f) => {
        const beforeMoney = await money(tx, f);
        const beforeReceipts = await tx`select to_jsonb(r) value from public.receipt r order by id`;
        const beforeSequence =
          await tx`select to_jsonb(r) value from public.receipt_sequence r order by tax_year`;
        await tx.unsafe(
          "alter table public.audit_log add constraint task11_forced_audit_failure check(action not in('receipt.issue','receipt.void'))",
        );
        await tx`set local role service_role`;
        await fail(tx, () => manual(tx, command, f), "23514");
        await tx`set local role postgres`;
        expect(await money(tx, f)).toEqual(beforeMoney);
        expect(await tx`select to_jsonb(r) value from public.receipt r order by id`).toEqual(
          beforeReceipts,
        );
        expect(
          await tx`select to_jsonb(r) value from public.receipt_sequence r order by tax_year`,
        ).toEqual(beforeSequence);
      }, command === "void"));
  }
  for (const role of ["anon", "authenticated"])
    for (const command of ["deny", "refund", "void", "system-void", "issue"])
      test(`${role} cannot directly invoke ${command} with trusted actor ids`, () =>
        financeFixture(async (tx, f) => {
          await tx.unsafe("set local role " + role);
          await fail(
            tx,
            async () => {
              if (command === "deny")
                return tx`select public.fail_pending_provider_payment(${f.payment}::uuid,${f.donation}::uuid)`;
              if (command === "refund")
                return tx`select public.refund_provider_payment_atomically(${f.payment}::uuid,${f.donation}::uuid)`;
              if (command === "system-void")
                return tx`select * from public.void_donation_receipts_with_audit(${f.donation}::uuid)`;
              return manual(tx, command as ManualCommand, f);
            },
            "42501",
          );
        }, true));
  test("issue retry after missing PDF returns same receipt and no second audit or number", () =>
    financeFixture(async (tx, f) => {
      await tx`set local role service_role`;
      const first = await manual(tx, "issue", f),
        second = await manual(tx, "issue", f);
      expect(first[0].already_existed).toBe(false);
      expect(second[0].already_existed).toBe(true);
      expect(second[0].receipt_id).toBe(first[0].receipt_id);
      expect(second[0].receipt_no).toBe(first[0].receipt_no);
      expect(second[0].pdf_url).toBeNull();
      await tx`set local role postgres`;
      expect(
        (
          await tx`select count(*)::integer n from public.audit_log where action='receipt.issue' and actor_user_id=${f.actor}::uuid`
        )[0].n,
      ).toBe(1);
      expect(
        (await tx`select next_value from public.receipt_sequence where tax_year=2026`)[0]
          .next_value,
      ).toBe(2);
    }));
  test("manual void replay rejects without second audit; signed void retry returns zero rows", () =>
    financeFixture(async (tx, f) => {
      await tx`set local role service_role`;
      expect(await manual(tx, "void", f)).toHaveLength(1);
      await fail(tx, () => manual(tx, "void", f), "22023");
      expect(
        await tx`select * from public.void_donation_receipts_with_audit(${f.donation}::uuid)`,
      ).toHaveLength(0);
      await tx`set local role postgres`;
      expect(
        (await tx`select count(*)::integer n from public.audit_log where action='receipt.void'`)[0]
          .n,
      ).toBe(1);
    }, true));
  test("system void audit failure preserves issued receipt and paid money", () =>
    financeFixture(async (tx, f) => {
      const before = await money(tx, f);
      await tx.unsafe(
        "alter table public.audit_log add constraint task11_system_audit_failure check(action<>'receipt.void')",
      );
      await tx`set local role service_role`;
      await fail(
        tx,
        () => tx`select * from public.void_donation_receipts_with_audit(${f.donation}::uuid)`,
        "23514",
      );
      await tx`set local role postgres`;
      expect(
        (await tx`select status from public.receipt where id=${f.receipt}::uuid`)[0].status,
      ).toBe("issued");
      expect(await money(tx, f)).toEqual(before);
    }, true));
  test("manual void rejects cross-supporter identity before audit", () =>
    financeFixture(async (tx, f) => {
      await tx`set local role service_role`;
      await fail(
        tx,
        () =>
          tx`select * from public.void_receipt_with_audit(${f.receipt}::uuid,${f.actor}::uuid,${randomUUID()}::uuid)`,
        "22023",
      );
    }, true));
  for (const input of ["supporter", "amount"])
    test(`issue rejects mismatched ${input} without receipt allocation`, () =>
      financeFixture(async (tx, f) => {
        await tx`set local role service_role`;
        await fail(
          tx,
          () =>
            tx`select * from public.issue_receipt_with_audit(${f.donation}::uuid,${input === "supporter" ? randomUUID() : f.supporter}::uuid,${input === "amount" ? 9000 : 10000},2026,now(),${f.actor}::uuid)`,
          "P0001",
        );
        await tx`set local role postgres`;
        expect((await tx`select count(*)::integer n from public.receipt`)[0].n).toBe(0);
        expect((await tx`select count(*)::integer n from public.receipt_sequence`)[0].n).toBe(0);
      }));
  for (const command of ["void", "issue"] as const)
    test(`${command} ignores caller temporary Auth/admin/receipt relation shadows`, () =>
      financeFixture(async (tx, f) => {
        await tx.unsafe(
          "create temp table users(dummy text);create temp table admin_user(dummy text);create temp table receipt(dummy text);create temp table donation(dummy text);set local search_path=pg_temp,public",
        );
        await tx`set local role service_role`;
        expect(await manual(tx, command, f)).toHaveLength(1);
      }, command === "void"));
  for (const state of ["pending", "failed", "succeeded", "refunded"])
    for (const command of ["deny", "refund"] as const)
      test(`${command} ${state} pair preserves immutable money and settles retry consistently`, () =>
        financeFixture(async (tx, f) => {
          await tx`update public.payment set status=${state} where id=${f.payment}::uuid`;
          await tx`update public.donation set status=${state} where id=${f.donation}::uuid`;
          const before = await money(tx, f);
          const invoke = async () =>
            command === "deny"
              ? (
                  await tx`select public.fail_pending_provider_payment(${f.payment}::uuid,${f.donation}::uuid) value`
                )[0].value
              : (
                  await tx`select public.refund_provider_payment_atomically(${f.payment}::uuid,${f.donation}::uuid) value`
                )[0].value;
          await tx`set local role service_role`;
          const first = await invoke(),
            retry = await invoke();
          const expected =
            command === "deny"
              ? state === "pending"
                ? "failed"
                : state === "failed"
                  ? "already_failed"
                  : "state_conflict"
              : state === "failed"
                ? "state_conflict"
                : state === "refunded"
                  ? "already_refunded"
                  : "refunded";
          expect(first.kind).toBe(expected);
          expect(retry.kind).toBe(
            command === "deny" && state === "pending"
              ? "already_failed"
              : command === "refund" && ["pending", "succeeded"].includes(state)
                ? "already_refunded"
                : expected,
          );
          await tx`set local role postgres`;
          const after = await money(tx, f);
          for (const key of ["payment", "donation"]) {
            const clean = (v: Record<string, unknown>) =>
              Object.fromEntries(
                Object.entries(v).filter(([k]) => !["status", "updated_at"].includes(k)),
              );
            expect(clean(after[key])).toEqual(clean(before[key]));
          }
          if (expected === "state_conflict") expect(after).toEqual(before);
        }));
  test("signed callbacks reject identity mismatch and malformed ids without ledger change", () =>
    financeFixture(async (tx, f) => {
      const before = await money(tx, f);
      await tx`set local role service_role`;
      expect(
        (
          await tx`select public.fail_pending_provider_payment(${f.payment}::uuid,${randomUUID()}::uuid) value`
        )[0].value.kind,
      ).toBe("not_found");
      expect(
        (
          await tx`select public.refund_provider_payment_atomically(${f.payment}::uuid,${randomUUID()}::uuid) value`
        )[0].value.kind,
      ).toBe("not_found");
      await fail(
        tx,
        () => tx`select public.fail_pending_provider_payment(null::uuid,${f.donation}::uuid)`,
        "22023",
      );
      await fail(
        tx,
        () => tx`select public.refund_provider_payment_atomically(${f.payment}::uuid,null::uuid)`,
        "22023",
      );
      await fail(
        tx,
        () => tx`select * from public.void_donation_receipts_with_audit(${f.donation}::uuid,' ')`,
        "22023",
      );
      await tx`set local role postgres`;
      expect(await money(tx, f)).toEqual(before);
    }));
  for (const command of ["void", "issue"] as const)
    test(`${command} permits an expired Auth ban and rejects an absent actor`, () =>
      financeFixture(async (tx, f) => {
        await tx`update auth.users set banned_until=now()-interval '1 day' where id=${f.actor}::uuid`;
        await tx`set local role service_role`;
        await fail(tx, () => manual(tx, command, { ...f, actor: randomUUID() }), "42501");
        expect(await manual(tx, command, f)).toHaveLength(1);
      }, command === "void"));
  test("system void late audit failure rolls back both receipts and earlier audit", () =>
    financeFixture(async (tx, f) => {
      const second = "00000000-0000-0000-0000-000000000002",
        otherDonation = randomUUID(),
        beforeMoney = await money(tx, f);
      await tx`insert into public.donation(id,supporter_id,amount_cents,purpose,method) values(${otherDonation}::uuid,${f.supporter}::uuid,10000,'general','fps')`;
      await tx`insert into public.receipt(id,supporter_id,receipt_no,donation_ids,total_amount_cents,tax_year,issued_at,status) values(${second}::uuid,${f.supporter}::uuid,${"T11-" + second},array[${otherDonation}::uuid,${f.donation}::uuid],20000,2026,now()+interval '1 day','issued')`;
      const before = await tx`select to_jsonb(r) value from public.receipt r order by id`;
      const processingOrder = (
        await tx`select id from public.receipt where donation_ids @> array[${f.donation}::uuid] and status='issued' order by id`
      ).map((r) => r.id);
      expect(processingOrder).toEqual([f.receipt, second]);
      // The nontransactional sequence survives rollback to the RPC savepoint.
      // Its AFTER INSERT probe advances only once a real first audit row and
      // the first voided receipt both exist, before the later constraint fails.
      await tx.unsafe("create temporary sequence task11_first_audit_progress");
      await tx.unsafe(`create function pg_temp.task11_first_audit_probe() returns trigger
        language plpgsql as $$ begin
          if new.action='receipt.void' and new.entity_id='${f.receipt}'::text then
            if not exists(select 1 from public.receipt where id=new.entity_id::uuid and status='void')
              or not exists(select 1 from public.audit_log where id=new.id) then
              raise exception 'first receipt/audit path not completed';
            end if;
            perform nextval('pg_temp.task11_first_audit_progress');
          end if;
          return new;
        end $$`);
      await tx.unsafe("create trigger task11_first_audit_probe after insert on public.audit_log for each row execute function pg_temp.task11_first_audit_probe()");
      await tx.unsafe(
        "alter table public.audit_log add constraint task11_second_audit_failure check(action<>'receipt.void' or entity_id<>'" +
          second +
          "')",
      );
      await tx`set local role service_role`;
      await fail(
        tx,
        () => tx`select * from public.void_donation_receipts_with_audit(${f.donation}::uuid)`,
        "23514",
      );
      await tx`set local role postgres`;
      expect(
        await tx`select last_value::integer value,is_called from pg_temp.task11_first_audit_progress`,
      ).toEqual([{ value: 1, is_called: true }]);
      console.log(JSON.stringify({ lateAuditFailure: { processingOrder, firstAuditPathReached: true, failedReceipt: second } }));
      expect(await tx`select to_jsonb(r) value from public.receipt r order by id`).toEqual(before);
      expect(
        (await tx`select count(*)::integer n from public.audit_log where action='receipt.void'`)[0]
          .n,
      ).toBe(0);
      expect(await money(tx, f)).toEqual(beforeMoney);
    }, true, "treasurer", "00000000-0000-0000-0000-000000000001"));
});
function latch() {
  let release!: () => void;
  const promise = new Promise<void>((resolve) => {
    release = resolve;
  });
  return { promise, release };
}
async function errno(run: () => Promise<unknown>) {
  try {
    await run();
    return undefined;
  } catch (e) {
    return (e as { errno?: string }).errno;
  }
}
async function waitBlocked(pid: number) {
  for (let i = 0; i < 200; i++) {
    const [r] = await db!`select cardinality(pg_blocking_pids(${pid}::integer)) n`;
    if (r.n > 0) {
      expect(r.n).toBeGreaterThan(0);
      return;
    }
    await Bun.sleep(10);
  }
  throw Error("Task11 expected actual row lock blocking absent");
}
async function committedFixture(run: (f: FinanceFixture) => Promise<void>, issued: boolean) {
  let f: FinanceFixture | undefined;
  try {
    await db!.begin(async (sql) => {
      const tx = sql as SQL;
      await tx`set local role postgres`;
      f = await seedFinance(tx, issued, "treasurer", false);
    });
    await run(f!);
  } finally {
    if (f)
      await db!.begin(async (tx) => {
        await tx`set local role postgres`;
        await tx`delete from public.audit_log where actor_user_id=${f!.actor}::uuid or entity_id in(${f!.receipt},${f!.donation},${f!.payment}) or entity_id in(select id::text from public.donation_delivery_job where donation_id=${f!.donation}::uuid)`;
        await tx`delete from public.donation_delivery_job where donation_id=${f!.donation}::uuid`;
        await tx`delete from public.receipt where donation_ids @> array[${f!.donation}::uuid]`;
        await tx`delete from public.receipt_sequence where tax_year=2026`;
        await tx`delete from public.supporter_consent_intent where supporter_id=${f!.supporter}::uuid`;
        await tx`delete from public.payment where id=${f!.payment}::uuid`;
        await tx`delete from public.donation where id=${f!.donation}::uuid`;
        await tx`delete from public.supporter where id=${f!.supporter}::uuid`;
        await tx`delete from public.admin_user where auth_user_id=${f!.actor}::uuid`;
        await tx`delete from auth.users where id=${f!.actor}::uuid`;
      });
  }
}
describe.skipIf(!db)("Task11 actual finance concurrency fences", () => {
  for (const command of ["void", "issue"] as const)
    for (const kind of ["ban", "role", "disable"] as const)
      for (const order of ["mutation-first", "command-first"] as const)
        test(`${command} ${kind} ${order} observes row blocking and correct commit order`, () =>
          committedFixture(async (f) => {
            const ready = latch(),
              release = latch(),
              waiting = latch();
            let pid = 0;
            const change = async (tx: SQL) => {
              if (kind === "ban")
                await tx`update auth.users set banned_until=clock_timestamp()+interval '1 day' where id=${f.actor}::uuid`;
              else if (kind === "role")
                await tx`update public.admin_user set role='staff' where auth_user_id=${f.actor}::uuid`;
              else
                await tx`update public.admin_user set status='disabled' where auth_user_id=${f.actor}::uuid`;
            };
            const first = db!.begin(async (sql) => {
              const tx = sql as SQL;
              await tx.unsafe("set local statement_timeout='10s'");
              await tx.unsafe(
                "set local role " + (order === "command-first" ? "service_role" : "postgres"),
              );
              if (order === "command-first") expect(await manual(tx, command, f)).toHaveLength(1);
              else await change(tx);
              ready.release();
              await release.promise;
            });
            await ready.promise;
            const second = errno(() =>
              db!.begin(async (sql) => {
                const tx = sql as SQL;
                await tx.unsafe("set local statement_timeout='10s'");
                pid = (await tx`select pg_backend_pid() pid`)[0].pid;
                waiting.release();
                await tx.unsafe(
                  "set local role " + (order === "mutation-first" ? "service_role" : "postgres"),
                );
                if (order === "mutation-first") await manual(tx, command, f);
                else await change(tx);
              }),
            );
            try {
              await waiting.promise;
              await waitBlocked(pid);
              release.release();
              await first;
              expect(await second).toBe(order === "mutation-first" ? "42501" : undefined);
              const [a] =
                await db!`select count(*)::integer n from public.audit_log where action=${"receipt." + command} and actor_user_id=${f.actor}::uuid`;
              expect(a.n).toBe(order === "command-first" ? 1 : 0);
              const rows =
                await db!`select status from public.receipt where donation_ids @> array[${f.donation}::uuid]`;
              expect(rows).toHaveLength(command === "void" || order === "command-first" ? 1 : 0);
              if (rows.length)
                expect(rows[0].status).toBe(
                  command === "void" && order === "command-first" ? "void" : "issued",
                );
              expect((await money(db!, f)).payment.status).toBe("succeeded");
            } finally {
              release.release();
              await Promise.allSettled([first, second]);
            }
          }, command === "void"));
  test("concurrent same-actor issue retries commit one receipt number and one issue audit", () =>
    committedFixture(async (f) => {
      const invoke = () =>
        db!.begin(async (sql) => {
          const tx = sql as SQL;
          await tx`set local role service_role`;
          return manual(tx, "issue", f);
        });
      const results = await Promise.all([invoke(), invoke()]);
      expect(results[0][0].receipt_id).toBe(results[1][0].receipt_id);
      expect(results.map((r) => r[0].already_existed).sort()).toEqual([false, true]);
      expect(
        (
          await db!`select count(*)::integer n from public.audit_log where action='receipt.issue' and actor_user_id=${f.actor}::uuid`
        )[0].n,
      ).toBe(1);
      expect(
        (await db!`select next_value from public.receipt_sequence where tax_year=2026`)[0]
          .next_value,
      ).toBe(2);
    }, false));
  for (const firstCommand of ["deny", "refund"] as const)
    for (const secondCommand of [
      firstCommand,
      firstCommand === "deny" ? "refund" : "deny",
    ] as const)
      test(`signed ${firstCommand} then concurrent ${secondCommand} serializes retries without money drift`, () =>
        committedFixture(async (f) => {
          await db!`update public.payment set status='pending' where id=${f.payment}::uuid`;
          await db!`update public.donation set status='pending' where id=${f.donation}::uuid`;
          const before = await money(db!, f),
            ready = latch(),
            release = latch(),
            waiting = latch();
          let pid = 0;
          const invoke = async (tx: SQL, command: "deny" | "refund") =>
            command === "deny"
              ? (
                  await tx`select public.fail_pending_provider_payment(${f.payment}::uuid,${f.donation}::uuid) value`
                )[0].value
              : (
                  await tx`select public.refund_provider_payment_atomically(${f.payment}::uuid,${f.donation}::uuid) value`
                )[0].value;
          const first = db!.begin(async (sql) => {
            const tx = sql as SQL;
            await tx.unsafe("set local statement_timeout='10s'");
            await tx`set local role service_role`;
            const result = await invoke(tx, firstCommand);
            ready.release();
            await release.promise;
            return result;
          });
          await ready.promise;
          const second = db!.begin(async (sql) => {
            const tx = sql as SQL;
            await tx.unsafe("set local statement_timeout='10s'");
            pid = (await tx`select pg_backend_pid() pid`)[0].pid;
            waiting.release();
            await tx`set local role service_role`;
            return invoke(tx, secondCommand);
          });
          try {
            await waiting.promise;
            await waitBlocked(pid);
            release.release();
            expect((await first).kind).toBe(firstCommand === "deny" ? "failed" : "refunded");
            expect((await second).kind).toBe(
              firstCommand === secondCommand
                ? firstCommand === "deny"
                  ? "already_failed"
                  : "already_refunded"
                : "state_conflict",
            );
            const after = await money(db!, f);
            for (const key of ["payment", "donation"]) {
              const clean = (value: Record<string, unknown>) =>
                Object.fromEntries(
                  Object.entries(value).filter(([k]) => !["status", "updated_at"].includes(k)),
                );
              expect(clean(after[key])).toEqual(clean(before[key]));
              expect(after[key].status).toBe(firstCommand === "deny" ? "failed" : "refunded");
            }
          } finally {
            release.release();
            await Promise.allSettled([first, second]);
          }
        }, false));
  test("concurrent signed receipt void retries commit one audit", () =>
    committedFixture(async (f) => {
      const ready = latch(),
        release = latch(),
        waiting = latch();
      let pid = 0;
      const first = db!.begin(async (sql) => {
        const tx = sql as SQL;
        await tx`set local role service_role`;
        const rows =
          await tx`select * from public.void_donation_receipts_with_audit(${f.donation}::uuid)`;
        ready.release();
        await release.promise;
        return rows;
      });
      await ready.promise;
      const second = db!.begin(async (sql) => {
        const tx = sql as SQL;
        await tx.unsafe("set local statement_timeout='10s'");
        pid = (await tx`select pg_backend_pid() pid`)[0].pid;
        waiting.release();
        await tx`set local role service_role`;
        return tx`select * from public.void_donation_receipts_with_audit(${f.donation}::uuid)`;
      });
      try {
        await waiting.promise;
        await waitBlocked(pid);
        release.release();
        expect(await first).toHaveLength(1);
        expect(await second).toHaveLength(0);
        expect(
          (
            await db!`select count(*)::integer n from public.audit_log where action='receipt.void' and entity_id=${f.receipt}`
          )[0].n,
        ).toBe(1);
        expect((await money(db!, f)).payment.status).toBe("succeeded");
      } finally {
        release.release();
        await Promise.allSettled([first, second]);
      }
    }, true));
});
afterAll(async () => {
  await db?.close();
});
