import { execFileSync } from "node:child_process";
import { existsSync, readFileSync } from "node:fs";
import { mkdtemp, readFile, rm, writeFile } from "node:fs/promises";
import { tmpdir } from "node:os";
import { join, relative } from "node:path";

import { describe, expect, test } from "bun:test";

const obsoleteServiceSlogan = "日夜堅守前線動物救援";
const correctedServiceSlogan = "本會以預約方式進行拯救與援助服務，並非 24 小時當值。";
const migrationPath = join(
  process.cwd(),
  "supabase/migrations/20260718122000_correct_service_slogan.sql",
);

const excludedAuditPaths = new Set([
  "src/lib/content/serviceSloganCopy.test.ts",
  "supabase/migrations/20260718122000_correct_service_slogan.sql",
]);

function isPlanOrSpecDocumentation(repositoryPath: string): boolean {
  return (
    repositoryPath.startsWith(".superpowers/sdd/") ||
    /(?:^|\/)(?:plans?|specs?)(?:\/|$)|(?:^|\/)[^/]*(?:plan|spec)[^/]*\.(?:md|mdx|txt)$/i.test(
      repositoryPath,
    )
  );
}

function trackedContentFiles(): string[] {
  return execFileSync("git", ["ls-files", "-z"], { cwd: process.cwd(), encoding: "utf8" })
    .split("\0")
    .filter((repositoryPath) => repositoryPath.length > 0)
    .filter((repositoryPath) => !excludedAuditPaths.has(repositoryPath))
    .filter((repositoryPath) => !isPlanOrSpecDocumentation(repositoryPath))
    .map((repositoryPath) => join(process.cwd(), repositoryPath));
}

async function readTrackedTextFile(filePath: string): Promise<string> {
  const contents = await readFile(filePath);
  return contents.includes(0) ? "" : contents.toString("utf8");
}

type ProofAttributes = { text?: string; diff?: string; merge?: string };
const proofPath =
  /^docs\/evidence\/audit-remediation-20260927\/r01-forward\/task-11-receipts\/blobs\/[a-f0-9]{64}\.source$/;
function isExplicitBinaryProof(repositoryPath: string, attributes?: ProofAttributes): boolean {
  return (
    proofPath.test(repositoryPath.replaceAll("\\", "/")) &&
    attributes?.text === "unset" &&
    attributes.diff === "unset" &&
    attributes.merge === "unset"
  );
}

function parseProofAttributes(output: string, paths: string[]): Map<string, ProofAttributes> {
  const fields = output.split("\0");
  if (fields.pop() !== "" || fields.length !== paths.length * 9)
    throw new Error("Incomplete Git proof attributes");
  const expected = new Set(paths),
    result = new Map<string, ProofAttributes>();
  for (let i = 0; i < fields.length; i += 3) {
    const [path, name, value] = fields.slice(i, i + 3);
    if (!expected.has(path) || !["text", "diff", "merge"].includes(name))
      throw new Error("Unexpected Git proof attributes");
    const entry = result.get(path) ?? {};
    if (Object.hasOwn(entry, name)) throw new Error("Duplicate Git proof attributes");
    entry[name as keyof ProofAttributes] = value;
    result.set(path, entry);
  }
  for (const path of paths)
    if (
      !result.has(path) ||
      ["text", "diff", "merge"].some((key) => !Object.hasOwn(result.get(path)!, key))
    )
      throw new Error("Missing Git proof attribute path");
  return result;
}

function proofAttributes(filePaths: string[]): Map<string, ProofAttributes> {
  const paths = filePaths
    .map((path) => relative(process.cwd(), path).replaceAll("\\", "/"))
    .filter((path) => proofPath.test(path));
  if (!paths.length) return new Map();
  // stdin avoids Windows command-line limits; all three records for every
  // candidate must be present. Git failures propagate, just like ls-files.
  const output = execFileSync("git", ["check-attr", "-z", "--stdin", "text", "diff", "merge"], {
    cwd: process.cwd(),
    encoding: "utf8",
    input: paths.join("\0") + "\0",
  });
  return parseProofAttributes(output, paths);
}

async function readTrackedTextFiles(
  filePaths: string[],
  readText = readTrackedTextFile,
): Promise<string[]> {
  const contents = new Array<string>(filePaths.length);
  let next = 0;
  async function worker() {
    while (next < filePaths.length) {
      const index = next++;
      contents[index] = await readText(filePaths[index]);
    }
  }
  await Promise.all(Array.from({ length: Math.min(8, filePaths.length) }, () => worker()));
  return contents;
}

describe("service slogan correction", () => {
  test("uses the approved replacement for the exact obsolete slogan without touching unrelated 24-hour content", async () => {
    expect(existsSync(migrationPath)).toBe(true);
    if (!existsSync(migrationPath)) return;

    const migration = readFileSync(migrationPath, "utf8");
    expect(migration).toContain(obsoleteServiceSlogan);
    expect(migration).toContain(correctedServiceSlogan);
    expect(migration).toContain("update public.content_item");
    expect(migration).toContain("select id, slug, title");

    const auditFilePaths = trackedContentFiles();
    expect(
      auditFilePaths.map((filePath) => relative(process.cwd(), filePath).replaceAll("\\", "/")),
    ).toEqual(
      expect.arrayContaining(["scripts/seed-admin.js", "vite.config.ts", "eslint.config.js"]),
    );

    const attributes = proofAttributes(auditFilePaths);
    const contents = await readTrackedTextFiles(auditFilePaths, async (path) => {
      const repositoryPath = relative(process.cwd(), path).replaceAll("\\", "/");
      return isExplicitBinaryProof(repositoryPath, attributes.get(repositoryPath))
        ? ""
        : await readTrackedTextFile(path);
    });
    const obsoleteFiles = auditFilePaths.filter((_, index) =>
      contents[index].includes(obsoleteServiceSlogan),
    );
    expect(obsoleteFiles).toEqual([]);
    // Exact whole tracked tree is still audited. Task11 observed 5067 files /
    // 320330934 bytes before packaging; at most eight reads run concurrently.
  }, 30_000);

  test("publishes volunteer group and knowledge routes while retaining the audit report", () => {
    // The sitemap is generated by a route now; the static public/sitemap.xml was
    // removed because it shadowed that route on Vercel (defect G-21). The intent
    // is unchanged: these three routes must stay advertised. The origin is no
    // longer asserted here - it is decision D-1 and belongs in one constant.
    const sitemap = readFileSync(join(process.cwd(), "src/routes/sitemap[.]xml.ts"), "utf8");
    expect(sitemap).toContain('"/knowledge"');
    expect(sitemap).toContain('"/volunteer/group"');
    expect(sitemap).toContain('"/report/audit"');
  });
});

test("bounded slogan reads preserve UTF8, binary-NUL filtering, order and read errors", async () => {
  const directory = await mkdtemp(join(tmpdir(), "hkscda-slogan-equivalence-"));
  try {
    const fixtures = [
      "plain text",
      obsoleteServiceSlogan,
      "",
      "\0" + obsoleteServiceSlogan,
      "香港 UTF8",
    ];
    const paths = fixtures.map((_, i) => join(directory, String(i)));
    await Promise.all(paths.map((path, i) => writeFile(path, fixtures[i])));
    const expected = paths.map((path) => {
      const content = readFileSync(path);
      return content.includes(0) ? "" : content.toString("utf8");
    });
    expect(await readTrackedTextFiles(paths)).toEqual(expected);
    expect(await readTrackedTextFiles([])).toEqual([]);
    await expect(readTrackedTextFiles([join(directory, "missing")])).rejects.toMatchObject({
      code: "ENOENT",
    });
  } finally {
    await rm(directory, { recursive: true, force: true });
  }
});

test("slogan scan awaits every ordered result with at most eight active reads", async () => {
  const paths = Array.from({ length: 19 }, (_, i) => String(i));
  let active = 0,
    maximum = 0;
  const calls: string[] = [];
  const actual = await readTrackedTextFiles(paths, async (path) => {
    calls.push(path);
    active++;
    maximum = Math.max(maximum, active);
    await Bun.sleep(1);
    active--;
    return path;
  });
  expect(actual).toEqual(paths);
  expect(calls).toEqual(paths);
  expect(active).toBe(0);
  expect(maximum).toBe(8);
});

test("only exact Task11 proof paths with all three explicit binary attributes are opaque", () => {
  const path =
    "docs/evidence/audit-remediation-20260927/r01-forward/task-11-receipts/blobs/" +
    "a".repeat(64) +
    ".source";
  const binary = { text: "unset", diff: "unset", merge: "unset" };
  expect(isExplicitBinaryProof(path, binary)).toBe(true);
  for (const ordinary of [
    "src/routes/index.tsx",
    "supabase/migrations/a.sql",
    "docs/source.source",
    path.replace("task-11", "task-10"),
    path.replace("/blobs/", "/"),
    path.replace("a".repeat(64), "unknown"),
    path.replace("a".repeat(64), "A".repeat(64)),
    path.replace(/blobs\/.*$/, "translation.json"),
  ])
    expect(isExplicitBinaryProof(ordinary, binary)).toBe(false);
  for (const attributes of [
    undefined,
    {},
    { text: "unset" },
    { ...binary, diff: "unspecified" },
    { ...binary, merge: "unspecified" },
    { ...binary, text: "auto" },
  ])
    expect(isExplicitBinaryProof(path, attributes)).toBe(false);
});

test("actual slogan scan rejects obsolete ordinary and unqualified proof text", async () => {
  const directory = await mkdtemp(join(tmpdir(), "hkscda-slogan-product-fixtures-"));
  const exact = "docs/evidence/audit-remediation-20260927/r01-forward/task-11-receipts/blobs/" + "a".repeat(64) + ".source";
  const binary = { text: "unset", diff: "unset", merge: "unset" };
  const fixtures = [
    { path: "src/routes/ordinary.tsx", attributes: undefined },
    { path: "src/routes/arbitrary-text.tsx", attributes: { text: "unset" } },
    { path: exact, attributes: { ...binary, diff: "unspecified" } },
    { path: exact, attributes: undefined },
    { path: exact.replace("task-11", "task-10"), attributes: binary },
    { path: exact, attributes: binary },
  ];
  try {
    const files = fixtures.map((_, i) => join(directory, String(i)));
    await Promise.all(files.map((file) => writeFile(file, obsoleteServiceSlogan)));
    const obsolete = await scanObsoleteFiles(files, new Map(), async (file) => {
      const fixture = fixtures[files.indexOf(file)];
      return isExplicitBinaryProof(fixture.path, fixture.attributes) ? "" : readTrackedTextFile(file);
    });
    expect(obsolete).toEqual(files.slice(0, 5));
  } finally {
    await rm(directory, { recursive: true, force: true });
  }
});

test("Git proof attribute batches require every path and record without hiding errors", () => {
  const paths = ["a", "b"];
  const output = paths
    .map((path) =>
      ["text", "diff", "merge"].map((name) => [path, name, "unset"].join("\0") + "\0").join(""),
    )
    .join("");
  expect([...parseProofAttributes(output, paths).keys()]).toEqual(paths);
  for (const malformed of [
    output.slice(0, -1),
    output.replace("merge", "text"),
    output.replace("a\0", "c\0"),
    output.split("b\0")[0],
  ])
    expect(() => parseProofAttributes(malformed, paths)).toThrow();
});
