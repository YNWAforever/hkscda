      "triggers": [
        {
          "name": "audit_admin_user",
          "table": "admin_user",
          "schema": "public",
          "enabled": "O",
          "definition": "CREATE TRIGGER audit_admin_user AFTER INSERT OR DELETE OR UPDATE ON public.admin_user FOR EACH ROW EXECUTE FUNCTION public.log_animal_mutation()"
        },
        {
          "name": "lock_admin_user_mutation",
          "table": "admin_user",
          "schema": "public",
          "enabled": "O",
          "definition": "CREATE TRIGGER lock_admin_user_mutation BEFORE DELETE OR UPDATE ON public.admin_user FOR EACH STATEMENT EXECUTE FUNCTION private.lock_admin_user_mutation()"
