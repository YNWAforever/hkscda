        "command": "r",
        "permissive": true
      },
      {
        "name": "treasurers can reconcile payments",
        "check": "private.has_admin_role(ARRAY['treasurer'::text, 'admin'::text])",
        "roles": [
          "authenticated"
        ],
        "table": "payment",
        "using": "private.has_admin_role(ARRAY['treasurer'::text, 'admin'::text])",
        "schema": "public",
        "command": "w",
        "permissive": true
      },
      {
        "name": "treasurers can manage receipts",
        "check": "private.has_admin_role(ARRAY['treasurer'::text, 'admin'::text])",
        "roles": [
          "authenticated"
        ],
        "table": "receipt",
        "using": "private.has_admin_role(ARRAY['treasurer'::text, 'admin'::text])",
        "schema": "public",
        "command": "*",
        "permissive": true
      },
      {
        "name": "staff can read supporters",
