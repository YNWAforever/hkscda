    "policies": [
      {
        "name": "admin users can view their own role",
        "check": null,
        "roles": [
          "authenticated"
        ],
        "table": "admin_user",
        "using": "(( SELECT auth.uid() AS uid) = auth_user_id)",
        "schema": "public",
        "command": "r",
        "permissive": true
      },
      {
        "name": "admins can view admin users",
        "check": null,
        "roles": [
          "authenticated"
        ],
        "table": "admin_user",
        "using": "private.has_admin_role(ARRAY['admin'::text])",
        "schema": "public",
        "command": "r",
        "permissive": true
      },
      {
        "name": "staff can read audit log",
        "check": null,
        "roles": [
          "authenticated"
        ],
        "table": "audit_log",
        "using": "private.has_admin_role(ARRAY['staff'::text, 'treasurer'::text, 'admin'::text])",
        "schema": "public",
        "command": "r",
        "permissive": true
      },
      {
        "name": "staff can read donations",
        "check": null,
        "roles": [
          "authenticated"
        ],
        "table": "donation",
        "using": "private.has_admin_role(ARRAY['staff'::text, 'treasurer'::text, 'admin'::text])",
        "schema": "public",
        "command": "r",
        "permissive": true
      },
      {
        "name": "treasurers can update donations",
        "check": "private.has_admin_role(ARRAY['treasurer'::text, 'admin'::text])",
        "roles": [
          "authenticated"
        ],
        "table": "donation",
        "using": "private.has_admin_role(ARRAY['treasurer'::text, 'admin'::text])",
        "schema": "public",
        "command": "w",
