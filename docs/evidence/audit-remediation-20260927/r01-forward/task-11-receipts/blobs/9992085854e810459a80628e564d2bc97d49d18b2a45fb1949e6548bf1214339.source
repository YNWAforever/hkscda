    "triggers": [
      {
        "name": "audit_admin_user",
        "table": "admin_user",
        "schema": "public",
        "enabled": "O",
        "definition": "CREATE TRIGGER audit_admin_user AFTER INSERT OR DELETE OR UPDATE ON public.admin_user FOR EACH ROW EXECUTE FUNCTION public.log_animal_mutation()"
