        "table": "donation",
        "schema": "public",
        "enabled": "O",
        "definition": "CREATE TRIGGER donation_success_delivery_job AFTER UPDATE OF status ON public.donation FOR EACH ROW WHEN (new.status = 'succeeded'::text AND old.status IS DISTINCT FROM new.status) EXECUTE FUNCTION public.queue_donation_delivery_on_success()"
      },
