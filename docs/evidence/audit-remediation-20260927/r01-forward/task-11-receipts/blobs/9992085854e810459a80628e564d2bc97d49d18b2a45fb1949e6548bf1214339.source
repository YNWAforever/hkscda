      "constraints": [
        {
          "name": "admin_user_auth_user_id_key",
          "type": "u",
          "table": "admin_user",
          "schema": "public",
          "validated": true,
          "definition": "UNIQUE (auth_user_id)"
        },
        {
          "name": "admin_user_email_key",
          "type": "u",
          "table": "admin_user",
          "schema": "public",
          "validated": true,
          "definition": "UNIQUE (email)"
        },
        {
          "name": "admin_user_last_invited_by_fkey",
          "type": "f",
          "table": "admin_user",
          "schema": "public",
          "validated": true,
          "definition": "FOREIGN KEY (last_invited_by) REFERENCES auth.users(id)"
        },
        {
          "name": "admin_user_pkey",
          "type": "p",
          "table": "admin_user",
          "schema": "public",
          "validated": true,
          "definition": "PRIMARY KEY (id)"
        },
        {
          "name": "admin_user_role_check",
          "type": "c",
          "table": "admin_user",
          "schema": "public",
          "validated": true,
          "definition": "CHECK (role = ANY (ARRAY['staff'::text, 'treasurer'::text, 'admin'::text]))"
        },
        {
          "name": "admin_user_status_check",
          "type": "c",
          "table": "admin_user",
          "schema": "public",
          "validated": true,
          "definition": "CHECK (status = ANY (ARRAY['pending'::text, 'active'::text, 'disabled'::text]))"
        },
        {
          "name": "audit_log_pkey",
          "type": "p",
          "table": "audit_log",
          "schema": "public",
          "validated": true,
          "definition": "PRIMARY KEY (id)"
        },
        {
          "name": "donation_acquisition_context_check",
          "type": "c",
          "table": "donation",
          "schema": "public",
          "validated": true,
          "definition": "CHECK (acquisition_context IS NULL OR (acquisition_context = ANY (ARRAY['general'::text, 'story'::text, 'animal'::text, 'sponsor'::text, 'transparency'::text, 'community'::text])))"
        },
        {
          "name": "donation_acquisition_placement_check",
          "type": "c",
          "table": "donation",
          "schema": "public",
          "validated": true,
          "definition": "CHECK (acquisition_placement IS NULL OR (acquisition_placement = ANY (ARRAY['mobile-bottom'::text, 'desktop-left'::text])))"
        },
        {
          "name": "donation_acquisition_source_check",
          "type": "c",
          "table": "donation",
          "schema": "public",
          "validated": true,
          "definition": "CHECK (acquisition_source IS NULL OR acquisition_source = 'contextual-cta'::text)"
        },
        {
          "name": "donation_acquisition_trigger_check",
          "type": "c",
          "table": "donation",
          "schema": "public",
          "validated": true,
          "definition": "CHECK (acquisition_trigger IS NULL OR (acquisition_trigger = ANY (ARRAY['scroll'::text, 'timer'::text])))"
        },
        {
          "name": "donation_amount_cents_check",
          "type": "c",
          "table": "donation",
          "schema": "public",
          "validated": true,
          "definition": "CHECK (amount_cents > 0)"
        },
        {
          "name": "donation_check",
          "type": "c",
          "table": "donation",
          "schema": "public",
          "validated": true,
          "definition": "CHECK (refunded_cents >= 0 AND refunded_cents <= amount_cents)"
        },
        {
          "name": "donation_contact_language_check",
          "type": "c",
          "table": "donation",
          "schema": "public",
          "validated": true,
          "definition": "CHECK (contact_language IS NULL OR (contact_language = ANY (ARRAY['zh-HK'::text, 'en'::text])))"
        },
        {
          "name": "donation_contact_snapshot_length_check",
          "type": "c",
          "table": "donation",
          "schema": "public",
          "validated": true,
          "definition": "CHECK ((contact_name IS NULL OR char_length(contact_name) >= 1 AND char_length(contact_name) <= 120) AND (contact_email IS NULL OR char_length(contact_email::text) <= 254) AND (contact_phone IS NULL OR char_length(contact_phone) <= 40))"
        },
        {
          "name": "donation_currency_check",
          "type": "c",
          "table": "donation",
          "schema": "public",
          "validated": true,
          "definition": "CHECK (currency = 'HKD'::text)"
        },
        {
          "name": "donation_custom_purpose_length_check",
          "type": "c",
          "table": "donation",
          "schema": "public",
          "validated": true,
          "definition": "CHECK (custom_purpose IS NULL OR char_length(custom_purpose) <= 200)"
        },
        {
          "name": "donation_idempotency_fingerprint_check",
          "type": "c",
          "table": "donation",
          "schema": "public",
          "validated": true,
          "definition": "CHECK (idempotency_key IS NULL AND idempotency_fingerprint IS NULL OR idempotency_key IS NOT NULL AND idempotency_fingerprint ~ '^[0-9a-f]{64}$'::text)"
        },
        {
          "name": "donation_method_check",
          "type": "c",
          "table": "donation",
          "schema": "public",
          "validated": true,
          "definition": "CHECK (method = ANY (ARRAY['stripe'::text, 'payme'::text, 'fps'::text, 'paypal'::text, 'manual'::text, 'alipayhk'::text]))"
        },
        {
          "name": "donation_pkey",
