      },
      {
        "name": "staff can read payments",
        "check": null,
        "roles": [
          "authenticated"
        ],
        "table": "payment",
        "using": "private.has_admin_role(ARRAY['staff'::text, 'treasurer'::text, 'admin'::text])",
