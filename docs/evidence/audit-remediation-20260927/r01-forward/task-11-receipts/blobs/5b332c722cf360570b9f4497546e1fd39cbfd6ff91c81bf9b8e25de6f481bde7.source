  const unsafe = new Set(
    rows
      .filter(
        (r) =>
          network(r.body) ||
          (!r.system && unsafeOperator(r.body, undefined, ownCoreScope(r))) ||
          network(`${r.schema}.${r.name}(`) ||
          (!r.system &&
            !reviewedUuid(r) &&
