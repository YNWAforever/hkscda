  const afterUnknown = new Set(unsafe);
  let changed = true;
  while (changed) {
    changed = false;
    for (const r of rows)
      if (
        !r.system &&
        !reviewedUuid(r) &&
        !reviewedNative(r) &&
        !unsafe.has(`${r.schema}.${r.name}`) &&
        [...unsafe].some((name) => calls(r.body, name))
