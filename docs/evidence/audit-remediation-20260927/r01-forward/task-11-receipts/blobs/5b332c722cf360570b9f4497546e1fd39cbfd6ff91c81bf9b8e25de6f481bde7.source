      !!contract &&
      r.schema === "public" &&
      r.language === "c" &&
      r.source === r.name &&
      r.library === (trgm ? "$libdir/pg_trgm" : "$libdir/citext") &&
      r.extension === (trgm ? "pg_trgm" : "citext") &&
      r.extensionVersion === "1.6" &&
