def sha(raw):return hashlib.sha256(raw).hexdigest()
def blob(raw):return hashlib.sha1(b'blob '+str(len(raw)).encode()+b'\0'+raw).hexdigest()
def save():(out/'receipt.json').write_text(json.dumps(receipt,indent=2)+'\n',encoding='utf-8',newline='\n')
def run(args,stdin=None,required=True,timeout=120):
 i=len(receipt['commands']);r=subprocess.run(args,input=stdin,capture_output=True,timeout=timeout);stem='command-'+str(i).zfill(4);(out/(stem+'.stdout.log')).write_bytes(r.stdout);(out/(stem+'.stderr.log')).write_bytes(r.stderr);d={'command':args,'exit':r.returncode,'stdout':stem+'.stdout.log','stderr':stem+'.stderr.log','stdoutSha256':sha(r.stdout),'stderrSha256':sha(r.stderr)};receipt['commands'].append(d);save()
 if required and r.returncode:raise RuntimeError('Owned command failed '+str(args)+' stderr='+r.stderr.decode('utf-8',errors='replace')[-2500:])
 return r
