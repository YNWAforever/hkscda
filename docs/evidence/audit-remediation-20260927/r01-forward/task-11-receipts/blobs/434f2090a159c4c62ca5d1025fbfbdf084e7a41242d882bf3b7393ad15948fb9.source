def project(c):
 tables=['admin_user','supporter','donation','payment','receipt','receipt_sequence','audit_log','supporter_consent_intent','donation_delivery_job'];glob=['schemas','defaults','roles','memberships','extensions','extensionMembers','databaseOwner','sequences'];scope=['relations','columns','constraints','indexes','triggers','policies'];p={k:c[k]for k in glob};p.update({k:[f for f in c[k]if f['schema']=='public'and f.get('table',f.get('name'))in tables]for k in scope});p['types']=[f for f in c['types']if f['schema']=='public'and(f['name']in tables or f['name']in ['_'+t for t in tables]or(f['kind']!='c'and not f['name'].startswith('_')))];return p
def differences(a,b,path=''):
 if type(a)!=type(b):return[{'path':path,'expected':a,'actual':b}]
 if isinstance(a,dict):return sum((differences(a.get(k),b.get(k),path+'/'+k)for k in sorted(set(a)|set(b))),[])
 if isinstance(a,list):
  if len(a)!=len(b):return[{'path':path,'expected':a,'actual':b,'expectedCount':len(a),'actualCount':len(b)}]
  return sum((differences(x,y,path+'/'+str(i))for i,(x,y)in enumerate(zip(a,b))),[])
 return[]if a==b else[{'path':path,'expected':a,'actual':b}]
