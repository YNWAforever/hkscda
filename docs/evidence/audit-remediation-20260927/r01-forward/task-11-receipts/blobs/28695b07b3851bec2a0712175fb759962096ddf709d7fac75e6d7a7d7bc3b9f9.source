{
  "statements": [
    "-- T21: server-side public catalogue filtering, exact count and stable pagination.\n-- Strict age normalization preserves unknown legacy text; generated column backfills\n-- automatically and follows edits without changing historic age copy.\ncreate function private.normalize_public_animal_age(p_age text)\nreturns text language plpgsql immutable strict set search_path=pg_catalog,pg_temp as $$\ndeclare\n  value text := lower(btrim(p_age));\n  matched text[];\n  amount numeric;\nbegin\n  if length(value)>50 then return 'unknown'; end if;\n  matched := regexp_match(value,\n    '^(約[[:space:]]*|大約[[:space:]]*|about[[:space:]]+)?([0-9]+([.][0-9]+)?)[[:space:]]*(個月|个月|月|months?|mos?)([[:space:]]+old)?$');\n  if matched is not null then\n    amount := matched[2]::numeric;\n    if amount>600 then return 'unknown'; end if;\n    if amount<12 then return 'bb'; end if;\n    if amount<96 then return 'adult'; end if;\n    return 'senior';\n  end if;\n  matched := regexp_match(value,\n    '^(約[[:space:]]*|大約[[:space:]]*|about[[:space:]]+)?([0-9]+([.][0-9]+)?)[[:space:]]*(歲|岁|years?|yrs?)([[:space:]]+old)?$');\n  if matched is not null then amount := matched[2]::numeric;\n  elsif value ~ '^[0-9]+([.][0-9]+)?$' then amount := value::numeric;\n  else return 'unknown'; end if;\n  if amount>50 then return 'unknown'; end if;\n  if amount<1 then return 'bb'; end if;\n  if amount<8 then return 'adult'; end if;\n  return 'senior';\nend $$",
    "revoke all on function private.normalize_public_animal_age(text) from public,anon,authenticated",
    "grant execute on function private.normalize_public_animal_age(text) to service_role",
    "-- The generated column is an additive backfill at migration time. Review rewrite\n-- time and locks against a data-bearing clone before applying to production.\nalter table public.animals\n  add column public_age_band text generated always as (private.normalize_public_animal_age(age)) stored",
    "grant select(public_age_band) on public.animals to anon,authenticated",
    "create index animals_public_listing_adoption_idx\n  on public.animals(type,created_at desc,id)\n  where publication_state='published' and status in ('available','fostered')\n    and retired_at is null and adoption_eligible",
    "create index animals_public_listing_sponsor_idx\n  on public.animals(created_at desc,id)\n  where publication_state='published' and status in ('available','fostered')\n    and retired_at is null and sponsorship_eligible",
    "create function public.public_animal_listing_page(p_filters jsonb)\nreturns jsonb language plpgsql stable security invoker set search_path=public,pg_temp as $$\ndeclare\n  purpose text := p_filters->>'purpose';\n  species text := p_filters->>'species';\n  age_band text := coalesce(p_filters->>'ageBand','all');\n  sort_order text := coalesce(p_filters->>'sort','newest');\n  gender_filter text := coalesce(p_filters->>'gender','all');\n  neutered_filter text := coalesce(p_filters->>'neutered','all');\n  suitability_filter text := coalesce(p_filters->>'suitability','all');\n  has_photo boolean := coalesce((p_filters->>'hasPhoto')::boolean,false);\n  search_term text := lower(btrim(coalesce(p_filters->>'query','')));\n  requested_page integer := coalesce((p_filters->>'page')::integer,1);\n  page_size integer := coalesce((p_filters->>'pageSize')::integer,16);\n  hk_today date := (now() at time zone 'Asia/Hong_Kong')::date;\n  result jsonb;\nbegin\n  if jsonb_typeof(p_filters) is distinct from 'object'\n    or purpose is null or purpose not in ('adoption','sponsorship')\n    or (purpose='adoption' and (species is null or species not in ('cat','dog')))\n    or (purpose='sponsorship' and species is not null)\n    or age_band not in ('all','bb','adult','senior')\n    or sort_order not in ('newest','oldest')\n    or gender_filter not in ('all','male','female')\n    or neutered_filter not in ('all','yes','no','unknown')\n    or suitability_filter not in ('all','newbie','experienced','unknown')\n    or length(search_term)>80 or requested_page not between 1 and 10000\n    or page_size not between 1 and 48\n    or exists(select 1 from jsonb_object_keys(p_filters) key\n      where key not in ('purpose','species','ageBand','gender','neutered',\n        'suitability','hasPhoto','query','sort','page','pageSize')) then\n    raise exception 'Invalid public listing filters' using errcode='22023';\n  end if;\n  with eligible as (\n    select a.id,a.created_at\n    from public.animals a\n    cross join lateral (select (a.public_profile->>'birthday')::date as birthday) birth\n    cross join lateral (select case\n      when birth.birthday is null then a.public_age_band\n      when birth.birthday>hk_today then 'unknown'\n      when extract(year from age(hk_today,birth.birthday))<1 then 'bb'\n      when extract(year from age(hk_today,birth.birthday))<8 then 'adult'\n      else 'senior' end as band) normalized\n    where a.publication_state='published'\n      and a.status in ('available','fostered') and a.retired_at is null\n      and ((purpose='adoption' and a.adoption_eligible and a.type=species)\n        or (purpose='sponsorship' and a.sponsorship_eligible))\n      and (age_band='all' or normalized.band=age_band)\n      and (gender_filter='all' or a.gender=gender_filter)\n      and (not has_photo or nullif(btrim(a.image_url),'') is not null)\n      and (search_term='' or strpos(lower(a.name),search_term)>0\n        or strpos(lower(coalesce(a.name_en,'')),search_term)>0\n        or strpos(lower(coalesce(a.public_profile->>'code','')),search_term)>0)\n      and (neutered_filter='all'\n        or (neutered_filter='unknown' and a.public_profile->>'neutered' is null)\n        or (neutered_filter='yes' and a.public_profile->>'neutered'='true')\n        or (neutered_filter='no' and a.public_profile->>'neutered'='false'))\n      and (suitability_filter='all'\n        or (suitability_filter='unknown' and a.public_profile->>'suitability' is null)\n        or a.public_profile->>'suitability'=suitability_filter)\n  ), page_ids as (\n    select id,created_at from eligible\n    order by case when sort_order='newest' then created_at end desc,\n      case when sort_order='oldest' then created_at end asc,id\n    limit page_size offset (requested_page-1)*page_size\n  )\n  select jsonb_build_object(\n    'total',(select count(*) from eligible),\n    'page',requested_page,\n    'items',coalesce((select jsonb_agg(\n      jsonb_build_object(\n        'id',a.id,'type',a.type,'name',a.name,'name_en',a.name_en,\n        'gender',a.gender,'age',a.age,'age_en',a.age_en,\n        'description',null,'description_en',null,\n        'status',a.status,'adoption_eligible',a.adoption_eligible,\n        'sponsorship_eligible',a.sponsorship_eligible,'retired_at',null,\n        'publication_state',a.publication_state,'image_url',a.image_url,\n        'created_at',a.created_at,'updated_at',a.updated_at,\n        'public_profile',jsonb_build_object(\n          'code',a.public_profile->>'code','birthday',a.public_profile->>'birthday',\n          'neutered',a.public_profile->'neutered',\n          'suitability',a.public_profile->>'suitability',\n          'personality',left(a.public_profile->>'personality',200),\n          'health',left(a.public_profile->>'health',200),\n          'sponsorUse',left(a.public_profile->>'sponsorUse',200),\n          'recentProgress',left(a.public_profile->>'recentProgress',200))\n      ) order by case when sort_order='newest' then page_ids.created_at end desc,\n        case when sort_order='oldest' then page_ids.created_at end asc,page_ids.id)\n      from page_ids join public.animals a on a.id=page_ids.id),'[]'::jsonb)\n  ) into result;\n  return result;\nend $$",
    "revoke all on function public.public_animal_listing_page(jsonb) from public,anon,authenticated",
    "grant execute on function public.public_animal_listing_page(jsonb) to anon,authenticated,service_role"
  ],
  "transactionMode": "transactional",
  "ownTransaction": false,
  "incompatible": false
}
