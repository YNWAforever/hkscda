import{test,expect}from'bun:test';import{readFileSync}from'node:fs';import{decodeScannerRows}from'./task-11-fix3-oid-codec';
const base='.superpowers/sdd/r01-forward-schema-plan-20261001/task-11-fix3-baseline-1cea764774294eb6bc9c9c41edffbe85/';const query=(i:number)=>{const wrapped=readFileSync(base+'scanner-'+i+'.sql.source','utf8');const start="begin read only;set local search_path=pg_catalog;select coalesce(jsonb_agg(to_jsonb(q)),'[]'::jsonb) from (";const end=')q;rollback;\n';if(!wrapped.startsWith(start)||!wrapped.endsWith(end))throw Error('Saved exact wrapper differs');return wrapped.slice(start.length,-end.length)};const expressions=readFileSync('.superpowers/sdd/r01-forward-schema-plan-20261001/task-11-fix3-expression-oid-probe-1790978253961/wire-query.sql.source','utf8');
test('actual saved raw rows preserve all other fields and receive exact numeric OIDs',()=>{for(const i of [0,1,2]){const raw=JSON.parse(readFileSync(base+'scanner-'+i+'.stdout.log','utf8')),before=JSON.stringify(raw),typed=decodeScannerRows(query(i),raw);expect(JSON.stringify(raw)).toBe(before);expect(typed.length).toBe(raw.length);if(i<2)expect(typed.every(r=>typeof r.oid==='number')).toBe(true);else expect(typed).toEqual(raw);}const raw=[{oid:'101',markerNumericString:'123',nested:{oid:'456'}}];expect(decodeScannerRows(query(0),raw)).toEqual([{oid:101,markerNumericString:'123',nested:{oid:'456'}}]);});
test('finite operator scalar/null contract and boundaries',()=>{expect(decodeScannerRows(query(1),[{oid:'0',implementationOid:'4294967295',restrictionOid:null,joinOid:'105'}])).toEqual([{oid:0,implementationOid:4294967295,restrictionOid:null,joinOid:105}]);for(const bad of ['-1','4294967296','1.5','01','+1','1e2','0x10','',null,undefined,true,{},NaN,Infinity])expect(()=>decodeScannerRows(query(0),[{oid:bad}])).toThrow();for(const missing of ['oid','implementationOid','restrictionOid','joinOid']){const row:any={oid:'1',implementationOid:'2',restrictionOid:null,joinOid:null};delete row[missing];expect(()=>decodeScannerRows(query(1),[row])).toThrow();}});
test('exact expression OID arrays stay arrays with strict elements and required fields',()=>{expect(decodeScannerRows(expressions,[{expression:'x',operatorOids:['101','105']},{expression:'y',operatorOids:[]}])).toEqual([{expression:'x',operatorOids:[101,105]},{expression:'y',operatorOids:[]}]);for(const bad of [null,{},'101',undefined])expect(()=>decodeScannerRows(expressions,[{expression:'x',operatorOids:bad}])).toThrow();for(const bad of [null,'01','-1','4294967296',{},undefined])expect(()=>decodeScannerRows(expressions,[{expression:'x',operatorOids:[bad]}])).toThrow();expect(()=>decodeScannerRows(expressions,[{operatorOids:[]}])).toThrow();expect(()=>decodeScannerRows(expressions,[{expression:'x'}])).toThrow();});
test('query/row/trigger mismatch fails closed, never general recursive coercion',()=>{expect(()=>decodeScannerRows('select 1',[])).toThrow();expect(()=>decodeScannerRows(query(0)+' ',[])).toThrow();for(const rows of [null,{},[null],[[]]])expect(()=>decodeScannerRows(query(0),rows)).toThrow();expect(()=>decodeScannerRows(query(2),[{table_name:'public.receipt'}])).toThrow();expect(()=>decodeScannerRows(query(2),[{table_name:'public.receipt',function_name:null}])).toThrow();});
