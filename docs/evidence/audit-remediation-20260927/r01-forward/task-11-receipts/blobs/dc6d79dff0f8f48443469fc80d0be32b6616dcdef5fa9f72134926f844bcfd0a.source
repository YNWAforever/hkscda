CREATE SCHEMA
[local] 2026-10-02 21:18:58.550 UTC [104] supabase_admin@postgres LOG:  statement: drop function if exists graphql_public.graphql(text, text, jsonb);
DROP FUNCTION
[local] 2026-10-02 21:18:58.551 UTC [104] supabase_admin@postgres LOG:  statement: create or replace function graphql_public.graphql(
	    "operationName" text default null,
	    query text default null,
	    variables jsonb default null,
	    extensions jsonb default null
	)
	    returns jsonb
	    language plpgsql
	as $$
	    DECLARE
	        server_version float;
	    BEGIN
	        server_version = (SELECT (SPLIT_PART((select version()), ' ', 2))::float);
	
	        IF server_version >= 14 THEN
	            RETURN jsonb_build_object(
	                'data', null::jsonb,
	                'errors', array['pg_graphql extension is not enabled.']
	            );
	        ELSE
	            RETURN jsonb_build_object(
	                'data', null::jsonb,
	                'errors', array['pg_graphql is only available on projects running Postgres 14 onwards.']
	            );
	        END IF;
	    END;
	$$;
CREATE FUNCTION
