	RETURNS TABLE(username TEXT, password TEXT) AS
	$$
	BEGIN
	    RAISE WARNING 'PgBouncer auth request: %', p_usename;
	
	    RETURN QUERY
	    SELECT usename::TEXT, passwd::TEXT FROM pg_catalog.pg_shadow
	    WHERE usename = p_usename;
	END;
	$$ LANGUAGE plpgsql 
	SET search_path = ''
	SECURITY DEFINER;
CREATE FUNCTION
