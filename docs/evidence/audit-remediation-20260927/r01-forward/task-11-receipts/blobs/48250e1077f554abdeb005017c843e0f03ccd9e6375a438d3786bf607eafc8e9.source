/** R57: one observed native catalogue/helper pair, never independent alternatives. */
import { createHash } from "node:crypto";
import { readFile } from "node:fs/promises";
import { resolve } from "node:path";
import { names, tables } from "./task-11-profile";
export const nativeFlags = ["redReceiptBound", "captureBound", "sourceBound", "nativeAssemblyBound", "managedJobsBound", "migrationsBound", "fullScannerPassed", "zeroRows", "rollbackPreserved", "normalCleanup", "protectedSourcesPreserved", "prerequisitePairBound"] as const;
export const nativePins = {
  originalReceiptSha256: "73096312212377aa25832dd015aba8e4c247241b3d34d76719a90d9282d0a798",
  captureSha256: "9fcfed1ba69e1752c58110cc549ca90d0af74d66dddc014ee38cbd0aedcae603",
  pairSha256: "9891db66252af4f637c2d9499df3dd0cec5c6665a5d7d5112720ad112ff75dcc",
  migrationInventorySha256: "a1f21ec32b43429971369b7b59ee301e20711c7cdfecdd9bf8edb0f8c864263a",
  inputInventorySha256: "15004fffe8993a8f1438d278c3d071d98e851093c5dc7868706260ad20d7769c",
  sourceHead: "18c3c6ea06a25292b6e172e99cd381ed7d4409dc",
  baselineSource: "d45b849d300f76700efcf5450a9b426e32cc372f",
} as const;
export const nativeREDDirectory = ".superpowers/sdd/r01-forward-schema-plan-20261001/task-11-fix3-baseline-c4f39419e50b416b8077becd931767c6";
export const nativeRuntime = { version: "PostgreSQL 17.11 on x86_64-pc-linux-gnu, compiled by gcc (GCC) 15.2.0, 64-bit", user: "postgres", owner: "postgres", database: "postgres" };
export const nativeFixtureScope = ["auth.users", "public.admin_user", "public.supporter", "public.donation", "public.payment", "public.receipt", "public.receipt_sequence", "public.audit_log", "public.supporter_consent_intent", "public.donation_delivery_job"];
export const sha = (v: Uint8Array | string) => createHash("sha256").update(v).digest("hex");
const same = (a: unknown, b: unknown) => JSON.stringify(a) === JSON.stringify(b);
function object(value: unknown): Record<string, unknown> {
  if (!value || typeof value !== "object" || Array.isArray(value)) throw Error("Native prerequisite object required");
  return value as Record<string, unknown>;
}
function rows(value: unknown): Record<string, unknown>[] {
  if (!Array.isArray(value)) throw Error("Native prerequisite array required");
  return value.map(object);
}
export function assertNativeQualification(value: unknown) {
  const r = object(value);
  if (r.receiptType !== "native-prerequisite-qualification-v1" || r.mode !== "full-native-d45" || r.error !== null || !same(r.failedFinalFlags, []) || !same(r.requiredFinalFlags, nativeFlags) || nativeFlags.some((k) => r[k] !== true)) throw Error("Ineligible exact native qualification flags/mode/type");
  for (const [k, v] of Object.entries(nativePins)) if (r[k] !== v) throw Error("Native prerequisite pin differs:" + k);
  for (const k of ["originalTransportPreArchived", "CLIIdentityKnown", "nativeLocalBunBehaviorRun", "productionApplied", "deployed", "operationallyEnabled", "heldTask1FiveColumnRepairApplied", "heldTask8ScannerProposalApplied"]) if (r[k] !== false) throw Error("Native qualification exceeds observed authority:" + k);
  if (r.committedPartialTask1SourceApplied !== true || r.financeExit !== 3 || r.sqlstate !== "55000" || r.prerequisiteError !== "R01 finance complete prerequisite catalog differs" || r.baselineMigrationCount !== 182 || !same(r.managedKinds, ["realtime", "storage", "auth"]) || r.normalCleanupCount !== 4 || !same(r.fixtureScope, nativeFixtureScope)) throw Error("Native complete source/job/scanner/cleanup cardinality differs");
  const runtime = object(r.runtime);
  if (Object.keys(runtime).length !== 4 || Object.entries(nativeRuntime).some(([k,v]) => runtime[k] !== v)) throw Error("Native actual runtime differs");
  const pair = object(r.pair), catalog = object(pair.catalog), helpers = rows(pair.helpers);
  if (Object.keys(pair).sort().join(",") !== "catalog,helpers" || Object.keys(catalog).length !== 15 || helpers.length !== 11 || sha(JSON.stringify(pair)) !== nativePins.pairSha256) throw Error("Native complete correlated prerequisite pair differs");
  return { ...r, pair: { catalog, helpers } };
