export function prerequisiteProjection(catalog: Record<string, unknown>) {
  const globalKeys = ["schemas", "defaults", "roles", "memberships", "extensions", "extensionMembers", "databaseOwner", "sequences"];
  return Object.fromEntries([
    ...globalKeys.map((k) => [k, catalog[k]]),
    ...["relations", "columns", "constraints", "indexes", "triggers", "policies"].map((k) => [k, rows(catalog[k]).filter((f) => f.schema === "public" && tables.includes(String(f.table ?? f.name)))]),
    ["types", rows(catalog.types).filter((f) => f.schema === "public" && (tables.includes(String(f.name)) || tables.some((t) => "_" + t === f.name) || (f.kind !== "c" && !String(f.name).startsWith("_"))))],
  ]);
}
export function assertNativeArchiveBinding(bytes: Buffer, entry: Record<string, unknown>, canonicalRequired = true) {
  const blob = createHash("sha1").update("blob " + bytes.length + "\0").update(bytes).digest("hex");
  if (sha(bytes) !== entry.rawSha256 || blob !== entry.rawGitBlob || bytes.length !== (entry.bytes ?? entry.rawBytes)) throw Error("Native raw archive binding differs");
  if ((canonicalRequired || entry.canonicalSha256 !== undefined) && sha(bytes.toString().replaceAll("\r\n", "\n")) !== entry.canonicalSha256) throw Error("Native canonical source binding differs");
}
/** Read every original immutable proof byte; historical tracked source binds to D45/18 Git, not current amended SQL. */
export async function verifyNativeRED(root: string) {
  const directory = resolve(root, nativeREDDirectory);
  const receiptBytes = await readFile(resolve(directory, "receipt.json"));
  if (sha(receiptBytes) !== nativePins.originalReceiptSha256) throw Error("Original native RED receipt differs");
  const r = object(JSON.parse(receiptBytes.toString()));
  if (r.mode !== "owned-full1711-d45-diagnostic" || r.authority !== "Ruling55" || r.sourceHead !== nativePins.sourceHead || r.baselineSource !== nativePins.baselineSource || r.error !== null) throw Error("Original native RED identity differs");
  for (const k of ["fullD45BaselineObserved", "ownedRED", "completeMetadataAfterRollbackPreserved", "allTenRowsPreserved", "protectedSourcesPreserved", "all57CurrentInputsPreserved", "committedPartialTask1SourceApplied"]) if (r[k] !== true) throw Error("Original native RED preservation missing:" + k);
  for (const k of ["productionApplied", "deployed", "operationallyEnabled", "heldTask1FiveColumnRepairApplied", "heldTask8ScannerProposalApplied"]) if (r[k] !== false) throw Error("Original native RED authority differs:" + k);
  const runtime = object(JSON.parse(String(r.runtime))), scanner = object(r.scanner), assembly = object(r.nativeAssembly);
  if (Object.entries(nativeRuntime).some(([k,v]) => runtime[k] !== v) || r.financeExit !== 3 || r.baselineMigrationCount !== 182 || scanner.fullScannerPassed !== true || scanner.metadataReads !== 4 || !same(scanner.fixtureScope, nativeFixtureScope.map((t) => t.replace(/^public\./, ""))) || ["nativeTemplateAssembly", "nativeParserCopied", "nativeClassifiersExactSlice"].some((k) => assembly[k] !== true)) throw Error("Original native runtime/scanner/assembly differs");
  const jobs = rows(r.managedJobs), cleanup = rows(r.cleanup), inventory = rows(r.migrationInventory), inputs = rows(r.inputBindings);
  if (!same(jobs.map((j) => j.kind), ["realtime", "storage", "auth"]) || jobs.some((j) => j.exit !== 0) || cleanup.length !== 4 || cleanup.some((c) => c.normalRemoved !== true) || inventory.length !== 182 || inventory.some((m) => m.exit !== 0) || inputs.length !== 41 || sha(JSON.stringify(inventory)) !== nativePins.migrationInventorySha256 || sha(JSON.stringify(inputs)) !== nativePins.inputInventorySha256 || !same(r.protectedBefore, r.protectedAfter)) throw Error("Original native managed/source/cleanup inventory differs");
  const beforeRows = rows(r.domainRowsBefore), afterRows = rows(r.domainRowsAfter);
  if (!same(beforeRows.map((t) => t.table), nativeFixtureScope) || beforeRows.some((t) => t.count !== 0) || !same(beforeRows, afterRows)) throw Error("Original native ten rows differ");
  const files = object(r.files), proofPaths = [nativeREDDirectory + "/receipt.json"];
  if (Object.keys(files).length !== 1912) throw Error("Original native proof file cardinality differs");
  for (const [name, entry] of Object.entries(files)) {
    if (!/^[a-zA-Z0-9_.-]+$/.test(name)) throw Error("Unsafe original native proof leaf");
    assertNativeArchiveBinding(await readFile(resolve(directory, name)), object(entry), false);
    proofPaths.push(nativeREDDirectory + "/" + name);
  }
  for (const entry of inputs) assertNativeArchiveBinding(await readFile(resolve(directory, String(entry.archive))), entry);
  const before = await readFile(resolve(directory, "d45-baseline.json")), after = await readFile(resolve(directory, "after-rollback.json"));
  if (sha(before) !== nativePins.captureSha256 || !before.equals(after)) throw Error("Original native complete rollback capture differs");
  const stderr = await readFile(resolve(directory, "command-0603.stderr.log"));
  if (sha(stderr) !== "599224c390c5484bdac74983ec012ec05c2b5cddee3bb8cc855256bdf73293da") throw Error("Original native raw 55000 differs");
  const actual = object(JSON.parse(before.toString()));
  const pair = { catalog: prerequisiteProjection(object(actual.catalog)), helpers: rows(actual.functions).filter((f) => !(f.schema === "public" && names.includes(String(f.name)))) };
  if (sha(JSON.stringify(pair)) !== nativePins.pairSha256) throw Error("Original native complete pair differs");
  return { original: r, runtime, pair, proofPaths };
}
/** Generator and qualification consumer both verify original evidence and every frozen archive. */
export async function verifyNativeQualification(value: unknown, root: string, qualificationDirectory: string) {
  const q = assertNativeQualification(value), proof = await verifyNativeRED(root);
  if (!same(q.pair, proof.pair)) throw Error("Native qualified pair not observed");
  const bindings = object(q.bindings);
  const sourcePaths = ["task-11-native-profile.ts", "task-11-native-qualify.ts", "task-11-native-prerequisites.json"].map((n) => "docs/evidence/audit-remediation-20260927/r01-forward/" + n);
  if (!same(Object.keys(bindings).sort(), [...proof.proofPaths, ...sourcePaths].sort())) throw Error("Native complete qualification frozen path set differs");
  for (const [path, value] of Object.entries(bindings)) {
    const entry = object(value);
    if (!/^s\d+\.source$/.test(String(entry.archive))) throw Error("Unsafe native frozen archive leaf");
    const current = await readFile(resolve(root, path)), archive = await readFile(resolve(qualificationDirectory, String(entry.archive)));
    if (!current.equals(archive)) throw Error("Native qualification current/archive differs:" + path);
    assertNativeArchiveBinding(current, entry);
  }
  return { ...q, bindings };
}
export function correlatedNativeGuards(historicalCatalogs: string[], historicalHelpers: string[], nativeCatalog: string, nativeHelpers: string) {
  if (!historicalCatalogs.length || !historicalHelpers.length) throw Error("Historical Task11 triple guard required");
  return {
    catalog: ` v_native:=(v_before=${nativeCatalog});\n if not v_native and v_before not in(${historicalCatalogs.join(",")}) then raise exception 'R01 finance complete prerequisite catalog differs' using errcode='55000';end if;\n`,
    helpers: ` if (v_native and v_actual<>${nativeHelpers}) or (not v_native and v_actual not in(${historicalHelpers.join(",")})) then raise exception 'R01 finance complete helper tuples differ' using errcode='55000';end if;\n`,
  };
}
