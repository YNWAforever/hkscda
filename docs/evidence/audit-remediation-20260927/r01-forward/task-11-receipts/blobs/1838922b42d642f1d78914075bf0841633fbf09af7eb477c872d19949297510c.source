 args=['gh','api','repos/supabase/cli/contents/apps/cli/src/'+path+'?ref=v2.118.0'];r=subprocess.run(args,capture_output=True);stem='native-'+path.rsplit('/',1)[1];(out/(stem+'.github.json')).write_bytes(r.stdout);(out/(stem+'.stderr.log')).write_bytes(r.stderr);assert r.returncode==0;info=json.loads(r.stdout);raw=base64.b64decode(info['content']);assert hashlib.sha1(b'blob '+str(len(raw)).encode()+b'\0'+raw).hexdigest()==info['sha'];(out/(stem+'.source')).write_bytes(raw);(out/(stem+'.receipt.json')).write_text(json.dumps({'command':args,'exit':r.returncode,'upstreamGitBlob':info['sha'],'rawSha256':hashlib.sha256(raw).hexdigest(),'bytes':len(raw)},indent=2)+'\n',encoding='utf-8',newline='\n');print(stem,info['sha'],len(raw))
