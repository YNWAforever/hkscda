{
  "qualification": "Offline pure classifier extraction over saved metadata; no stored DB helpers executed. Five observed OID scalar fields mapped only to exact Bun numeric representation. Not a fresh full scanner pass or profile normalization.",
  "scannerSHA256": "5352ca4c2660e341b88bb34519e369aa7420711bb9df7c80daff5dadd9387519",
  "raw": {
    "function": {
      "oid": "18196",
      "body": "CREATE OR REPLACE FUNCTION public.set_updated_at()\n RETURNS trigger\n LANGUAGE plpgsql\nAS $function$\nbegin\n  new.updated_at = now();\n  return new;\nend;\n$function$\n",
      "name": "set_updated_at",
      "owner": "postgres",
      "config": null,
      "result": "trigger",
      "schema": "public",
      "source": "\nbegin\n  new.updated_at = now();\n  return new;\nend;\n",
      "system": false,
      "library": null,
      "language": "plpgsql",
      "arguments": 0,
