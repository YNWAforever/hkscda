"""Archive admitted Task11 executable sources before each covering step."""
import hashlib,json,pathlib,subprocess,sys,time
s=pathlib.Path('.superpowers/sdd/r01-forward-schema-plan-20261001');e=pathlib.Path('docs/evidence/audit-remediation-20260927/r01-forward');o=s/('task-11-fix3-step-'+sys.argv[1]+'-'+str(time.time_ns()));o.mkdir();cmd=sys.argv[2:]
paths=sorted(set([pathlib.Path(__file__),pathlib.Path('supabase/rls-tests/helpers/productionSchemaClone.ts'),pathlib.Path('supabase/migrations/20261002170945_r01_finance_callback_forward.sql'),s/'task-11-fix3-diagnosis-1790974606735/ruling57.source',*e.glob('task-11-*.ts'),e/'task-11-native-prerequisites.json',e/'task-11-profile-inputs.json']),key=str)
paths=sorted(set(paths+[pathlib.Path(a)for a in cmd if pathlib.Path(a).is_file()]),key=str)
bindings=[]
for i,p in enumerate(paths):
 b=p.read_bytes();a=f's{i}.source';(o/a).write_bytes(b);bindings.append({'path':p.as_posix(),'archive':a,'bytes':len(b),'rawSha256':hashlib.sha256(b).hexdigest(),'canonicalSha256':hashlib.sha256(b.replace(b'\r\n',b'\n')).hexdigest(),'rawGitBlob':subprocess.check_output(['git','hash-object','--no-filters',str(p)],text=True).strip()})
t=time.monotonic();r=subprocess.run(cmd,capture_output=True);(o/'stdout.log').write_bytes(r.stdout);(o/'stderr.log').write_bytes(r.stderr)
receipt={'command':cmd,'exit':r.returncode,'elapsedSeconds':time.monotonic()-t,'bindings':bindings,'stdoutSha256':hashlib.sha256(r.stdout).hexdigest(),'stderrSha256':hashlib.sha256(r.stderr).hexdigest()};(o/'receipt.json').write_text(json.dumps(receipt,indent=2)+'\n',newline='\n');print(json.dumps({'out':str(o),'exit':r.returncode}));print(r.stdout.decode('utf-8',errors='replace')[-3000:]);print(r.stderr.decode('utf-8',errors='replace')[-3000:]);sys.exit(r.returncode)
