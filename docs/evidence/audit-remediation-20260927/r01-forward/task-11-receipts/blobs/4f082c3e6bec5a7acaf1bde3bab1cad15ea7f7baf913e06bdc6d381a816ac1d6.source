begin read only;set local search_path=pg_catalog;select coalesce(jsonb_agg(to_jsonb(q)),'[]'::jsonb) from (select coalesce(jsonb_agg(jsonb_build_object('table',i.indrelid::regclass::text,'name',c.relname,'owner',pg_get_userbyid(c.relowner),'kind',c.relkind,'persistence',c.relpersistence,'options',c.reloptions,'access',am.amname,'definition',pg_get_indexdef(i.indexrelid),'nkeys',i.indnkeyatts,'natts',i.indnatts,'unique',i.indisunique,'nullsNotDistinct',i.indnullsnotdistinct,'primary',i.indisprimary,'exclusion',i.indisexclusion,'immediate',i.indimmediate,'clustered',i.indisclustered,'valid',i.indisvalid,'ready',i.indisready,'live',i.indislive,'replicaIdentity',i.indisreplident,'keys',i.indkey::text,'flags',i.indoption::text,'predicate',pg_get_expr(i.indpred,i.indrelid),'expressions',pg_get_expr(i.indexprs,i.indrelid)) order by i.indrelid::regclass::text,c.relname),'[]'::jsonb) value from pg_index i join pg_class c on c.oid=i.indexrelid join pg_am am on am.oid=c.relam where i.indrelid in('auth.users'::regclass,'public.admin_user'::regclass,'public.supporter'::regclass,'public.donation'::regclass,'public.payment'::regclass,'public.receipt'::regclass,'public.receipt_sequence'::regclass,'public.audit_log'::regclass,'public.supporter_consent_intent'::regclass,'public.donation_delivery_job'::regclass))q;rollback;
