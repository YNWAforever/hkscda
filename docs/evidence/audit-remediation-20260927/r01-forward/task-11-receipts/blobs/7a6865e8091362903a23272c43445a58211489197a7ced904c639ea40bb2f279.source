	  check (edit_version > 0);
[local] 2026-10-02 23:12:17.955 UTC [1274] postgres@postgres LOG:  statement: create or replace function private.bump_supporter_edit_version()
	returns trigger language plpgsql set search_path = ''
	as $$
	begin
	  new.edit_version := old.edit_version + 1;
	  return new;
	end;
	$$;
[local] 2026-10-02 23:12:17.955 UTC [1274] postgres@postgres LOG:  statement: drop trigger if exists bump_supporter_edit_version on public.supporter;
[local] 2026-10-02 23:12:17.956 UTC [1274] postgres@postgres LOG:  statement: create trigger bump_supporter_edit_version
	  before update on public.supporter
	  for each row execute function private.bump_supporter_edit_version();
[local] 2026-10-02 23:12:17.956 UTC [1274] postgres@postgres LOG:  statement: create or replace function private.bump_supporter_edit_version_from_role()
	returns trigger language plpgsql set search_path = ''
	as $$
	begin
	  if tg_op = 'UPDATE' and old.supporter_id is distinct from new.supporter_id then
	    update public.supporter set edit_version = edit_version where id = old.supporter_id;
	  end if;
	  update public.supporter set edit_version = edit_version
	  where id = case when tg_op = 'DELETE' then old.supporter_id else new.supporter_id end;
	  return null;
	end;
	$$;
