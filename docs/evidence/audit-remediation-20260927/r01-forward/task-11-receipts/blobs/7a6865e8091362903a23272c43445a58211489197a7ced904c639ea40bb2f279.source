[local] 2026-10-02 23:11:52.001 UTC [803] postgres@postgres LOG:  statement: create function private.queue_sponsorship_transition(p_pledge uuid,p_proof uuid,p_event text,p_scope text)
	returns void language plpgsql security definer set search_path=public,pg_temp as $$
	declare v_supporter uuid; v_message uuid;v_recipient text;v_name text;v_language text;v_amount integer;
	begin
	 if exists(select 1 from public.sponsorship_delivery_outbox where scope=p_scope) then return; end if;
	 select p.supporter_id,s.email,s.name,p.language,p.amount_cents into v_supporter,v_recipient,v_name,v_language,v_amount
	 from public.sponsorship_pledge p join public.supporter s on s.id=p.supporter_id where p.id=p_pledge;
	 if p_proof is not null then select coalesce(contact_snapshot->>'email',v_recipient),coalesce(contact_snapshot->>'name',v_name),coalesce(contact_snapshot->>'language',v_language),amount_cents into v_recipient,v_name,v_language,v_amount from public.sponsorship_payment_proof where id=p_proof; end if;
	 insert into public.message(supporter_id,channel,status,payload) values(v_supporter,'email','queued',
	 jsonb_build_object('kind','sponsorship_financial_transition','scope',p_scope,'event',p_event,'pledgeId',p_pledge,'proofId',p_proof)) returning id into v_message;
	 insert into public.sponsorship_delivery_outbox(scope,pledge_id,proof_id,message_id,event,recipient_email,recipient_name,language,amount_cents) values(p_scope,p_pledge,p_proof,v_message,p_event,v_recipient,v_name,v_language,v_amount);
	end; $$;
[local] 2026-10-02 23:11:52.001 UTC [803] postgres@postgres LOG:  statement: create function private.sponsorship_proof_financial_transition() returns trigger
	language plpgsql security definer set search_path=public,pg_temp as $$
	declare v_pledge public.sponsorship_pledge%rowtype; v_donation uuid; v_payment uuid; v_method text;
	begin
	 if tg_op='INSERT' then
	  perform private.queue_sponsorship_transition(new.pledge_id,new.id,'proof_recorded','proof:'||new.id::text||':recorded'); return new;
	 end if;
	 if old.review_status='pending' and new.review_status in ('approved','rejected') then
	  if new.review_status='approved' then
	   select * into v_pledge from public.sponsorship_pledge where id=new.pledge_id for update;
	   -- Preserve bank references so the canonical payment uniqueness rule also
	   -- catches a second proof of the same transfer. No invented receipt consent.
	   v_method := case when new.payment_method in ('fps','payme','paypal') then new.payment_method else 'manual' end;
	   if exists(select 1 from public.sponsorship_payment_source where proof_id=new.id) then raise exception 'Proof already linked to received money'; end if;
	   insert into public.donation(supporter_id,amount_cents,currency,purpose,type,status,method,contact_name,contact_email,contact_phone,contact_language)
	   values(v_pledge.supporter_id,new.amount_cents,'HKD','sponsor','one_time','succeeded',v_method,new.contact_snapshot->>'name',new.contact_snapshot->>'email',new.contact_snapshot->>'phone',new.contact_snapshot->>'language') returning id into v_donation;
	   insert into public.payment(donation_id,provider,provider_ref,amount_cents,status,received_at,reconciled_by,bank_reference)
	   values(v_donation,v_method,nullif(trim(new.reference),''),new.amount_cents,'succeeded',new.payment_date::timestamp at time zone 'Asia/Hong_Kong',new.reviewed_by,new.reference) returning id into v_payment;
	   insert into public.sponsorship_payment_source(proof_id,payment_id,donation_id,source) values(new.id,v_payment,v_donation,'verified_proof');
	  end if;
	  perform private.queue_sponsorship_transition(new.pledge_id,new.id,case new.review_status when 'approved' then 'active' else 'needs_followup' end,'proof:'||new.id::text||':'||new.review_status);
	 end if;
	 return new;
	end; $$;
[local] 2026-10-02 23:11:52.002 UTC [803] postgres@postgres LOG:  statement: create trigger sponsorship_proof_financial_transition after insert or update on public.sponsorship_payment_proof
	for each row execute function private.sponsorship_proof_financial_transition();
[local] 2026-10-02 23:11:52.002 UTC [803] postgres@postgres LOG:  statement: create function private.sponsorship_cancel_transition() returns trigger
	language plpgsql security definer set search_path=public,pg_temp as $$
	begin
	 if new.status='cancelled' and old.status <> 'cancelled' then
	  perform private.queue_sponsorship_transition(new.id,null,'cancelled','pledge:'||new.id::text||':cancelled:'||new.updated_at::text);
	 end if;
	 return new;
	end; $$;
[local] 2026-10-02 23:11:52.002 UTC [803] postgres@postgres LOG:  statement: create trigger sponsorship_cancel_transition after update on public.sponsorship_pledge
	for each row execute function private.sponsorship_cancel_transition();
[local] 2026-10-02 23:11:52.002 UTC [803] postgres@postgres LOG:  statement: create function private.preserve_sponsorship_financial_history() returns trigger
	language plpgsql set search_path=public,pg_temp as $$
	begin
	 if tg_op='DELETE' then raise exception 'Sponsorship financial history cannot be deleted'; end if;
	 if new.contact_snapshot is distinct from old.contact_snapshot then raise exception 'Proof contact snapshot is immutable'; end if;
	 if old.review_status <> 'pending' and (new.pledge_id,new.amount_cents,new.payment_date,new.payment_method,new.reference,new.storage_path,new.review_status)
	  is distinct from (old.pledge_id,old.amount_cents,old.payment_date,old.payment_method,old.reference,old.storage_path,old.review_status) then
	  raise exception 'Reviewed money and proof facts require an append-only correction';
	 end if;
	 return new;
	end; $$;
