[local] 2026-10-02 23:12:02.006 UTC [986] postgres@postgres LOG:  statement: create function public.volunteer_member_registrations(p_actor uuid,p_upcoming_page integer default 1,p_history_page integer default 1,p_size integer default 25) returns jsonb
	language plpgsql stable security definer set search_path=public,pg_temp as $$
	declare result jsonb;
	begin
	 if p_size not between 1 and 100 or p_upcoming_page<1 or p_history_page<1 then raise exception 'invalid_page' using errcode='22023';end if;
	 if not exists(select 1 from auth.users u where u.id=p_actor and u.email_confirmed_at is not null and (u.banned_until is null or u.banned_until<=now())) then raise exception 'verified_actor_required' using errcode='42501';end if;
	 with owned as (
	 select r.id,r.activity_id,r.status,r.attendance_status,r.notes,r.created_at,r.updated_at,
	 jsonb_build_object('id',a.id,'title',a.title,'starts_at',a.starts_at,'ends_at',a.ends_at,'location',a.location) activity,
	 a.starts_at,
	 (a.starts_at>=now() and r.status in ('pending','approved','waitlisted') and r.attendance_status not in ('attended','completed','absent','no_show','excused')) upcoming,
	 case when r.status not in ('pending','approved','waitlisted') then 'registration_closed' when r.attendance_status in ('attended','completed') then 'attendance_correction_required' else public.volunteer_cancellation_reason(v.body,a.starts_at,now()) end cancellation_reason
	 from public.volunteer_registration r join public.volunteer_profile p on p.id=r.profile_id join public.volunteer_activity a on a.id=r.activity_id left join public.volunteer_policy_version v on v.id=a.policy_version_id where p.auth_user_id=p_actor
	 ), ranked as (select *,row_number() over(partition by upcoming order by case when upcoming then starts_at end asc,case when not upcoming then starts_at end desc,id) n from owned)
	 select jsonb_build_object('registrations',coalesce((select jsonb_agg((to_jsonb(x)-'n'-'upcoming'-'starts_at'-'cancellation_reason')||jsonb_build_object('actions',jsonb_build_object('cancel',x.cancellation_reason is null,'cancel_reason',x.cancellation_reason)) order by x.upcoming desc,x.n) from ranked x where (x.upcoming and x.n between (p_upcoming_page-1)*p_size+1 and p_upcoming_page*p_size) or (not x.upcoming and x.n between (p_history_page-1)*p_size+1 and p_history_page*p_size)),'[]'::jsonb),
	 'upcoming_total',(select count(*) from owned where upcoming),'history_total',(select count(*) from owned where not upcoming),'upcoming_page',p_upcoming_page,'history_page',p_history_page,'page_size',p_size) into result;
	 return result;
	end $$;
