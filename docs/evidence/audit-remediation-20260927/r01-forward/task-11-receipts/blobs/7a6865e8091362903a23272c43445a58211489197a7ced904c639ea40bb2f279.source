[local] 2026-10-02 23:12:23.290 UTC [1358] postgres@postgres LOG:  statement: create function private.require_crm_tag_bulk_actor(p_actor uuid)
	returns void language plpgsql security definer set search_path = '' as $$
	begin
	  perform 1 from public.admin_user a
	    join auth.users u on u.id=a.auth_user_id
	    where a.auth_user_id=p_actor and a.status='active'
	      and a.role in ('treasurer','admin')
	      and u.email_confirmed_at is not null
	      and (u.banned_until is null or u.banned_until <= now())
	    for share of a,u;
	  if not found then
	    raise exception 'CRM bulk actor unavailable' using errcode='42501';
	  end if;
	end $$;
