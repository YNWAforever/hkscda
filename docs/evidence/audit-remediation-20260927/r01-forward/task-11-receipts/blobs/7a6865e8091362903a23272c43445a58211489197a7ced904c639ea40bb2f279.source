ion_receipts_with_audit','issue_receipt_with_audit','issue_receipt')) order by n.nspname,p.proname,pg_get_function_identity_arguments(p.oid)) f where f.schema='public' and f.name='void_receipt_with_audit';
	 if v_actual not in('[{"schema":"public","name":"void_receipt_with_audit","args":"p_receipt_id uuid, p_actor uuid, p_supporter_id uuid","allargs":"p_receipt_id uuid, p_actor uuid, p_supporter_id uuid DEFAULT NULL::uuid","defaults":1,"default_expression":"NULL::uuid","result":"TABLE(receipt_id uuid, pdf_url text)","owner":"postgres","acl":"{postgres=X/postgres,service_role=X/postgres}","full_acl":[{"grantee":"postgres","grantor":"postgres","grantable":false,"privilege":"EXECUTE"},{"grantee":"service_role","grantor":"postgres","grantable":false,"privilege":"EXECUTE"}],"config":["search_path=\"\""],"definer":true,"language":"plpgsql","kind":"f","cost":100,"rows":1000,"strict":false,"leakproof":false,"parallel":"u","volatility":"v","support":"-","variadic":"-","modes":["i","i","i","t","t"],"body":"c120cd972f5c6bcb9ad822b1e61b1168","definition":"6e159b4b6d2b50514401d99e3dd54b7b"}]'::jsonb) then
	 execute $definition$create or replace function public.void_receipt_with_audit(
	  p_receipt_id uuid,
	  p_actor uuid,
	  p_supporter_id uuid default null
	)
	returns table (receipt_id uuid, pdf_url text)
	language plpgsql
	security definer
	set search_path = ''
	as $$
	declare
	  v_receipt public.receipt%rowtype;
	  v_voided_at timestamptz;
	begin
	  perform 1 from auth.users u
	  where u.id = p_actor
	    and u.email_confirmed_at is not null
	    and (u.banned_until is null or u.banned_until <= pg_catalog.clock_timestamp())
	  for share;
	  if not found then
	    raise exception 'receipt_void_admin_required' using errcode = '42501';
	  end if;
	
	  perform 1 from public.admin_user a
	  where a.auth_user_id = p_actor
	    and a.status = 'active'
	    and a.role in ('treasurer', 'admin')
	  for share;
	  if not found then
	    raise exception 'receipt_void_admin_required' using errcode = '42501';
	  end if;
	
	  select * into v_receipt
	  from public.receipt
	  where id = p_receipt_id
	  for update;
	  if not found or v_receipt.status <> 'issued' then
	    raise exception 'receipt_not_issued' using errcode = '22023';
	  end if;
	  if p_supporter_id is not null and p_supporter_id <> v_receipt.supporter_id then
	    raise exception 'receipt_supporter_mismatch' using errcode = '22023';
	  end if;
	
	  v_voided_at := pg_catalog.clock_timestamp();
	  update public.receipt
	  set status = 'void', voided_at = v_voided_at, voided_by = p_actor
	  where id = v_receipt.id;
	
	  insert into public.audit_log(actor_user_id, action, entity, entity_id, detail)
	  values (
	    p_actor, 'receipt.void', 'receipt', v_receipt.id::text,
	    pg_catalog.jsonb_build_object(
	      'voidedAt', v_voided_at,
	      'supporterId', v_receipt.supporter_id,
	      'reason', 'manual'
	    )
	  );
	
	  return query select v_receipt.id, v_receipt.pdf_url;
	end;
	$$;
	revoke all on function public.void_receipt_with_audit(uuid,uuid,uuid) from public,anon,authenticated,service_role;
	grant execute on function public.void_receipt_with_audit(uuid,uuid,uuid) to service_role;
	$definition$;
	 end if;
	 select coalesce(pg_catalog.jsonb_agg(to_jsonb(f) order by f.schema,f.name,f.args),'[]'::jsonb) into v_actual from (select n.nspname schema,p.proname name,pg_get_function_identity_arguments(p.oid) args,pg_get_function_arguments(p.oid) allargs,p.pronargdefaults defaults,pg_get_expr(p.proargdefaults,0) default_expression,pg_get_function_result(p.oid) result,pg_get_userbyid(p.proowner) owner,p.proacl::text acl,(select jsonb_agg(jsonb_build_object('grantor',pg_get_userbyid(a.grantor),'grantee',case when a.grantee=0 then 'PUBLIC' else pg_get_userbyid(a.grantee) end,'privilege',a.privilege_type,'grantable',a.is_grantable) order by pg_get_userbyid(a.grantor),case when a.grantee=0 then 'PUBLIC' else pg_get_userbyid(a.grantee) end,a.privilege_type) from aclexplode(coalesce(p.proacl,acldefault('f',p.proowner))) a) full_acl,p.proconfig config,p.prosecdef definer,l.lanname language,p.prokind kind,p.procost cost,p.prorows rows,p.proisstrict strict,p.proleakproof leakproof,p.proparallel parallel,p.provolatile volatility,p.prosupport::text support,p.provariadic::regtype::text variadic,p.proargmodes modes,md5(p.prosrc) body,md5(pg_get_functiondef(p.oid)) definition from pg_proc p join pg_namespace n on n.oid=p.pronamespace join pg_language l on l.oid=p.prolang where p.oid in(select t.tgfoid from pg_trigger t where t.tgrelid in('auth.users'::regclass,'public.admin_user'::regclass,'public.supporter'::regclass,'public.donation'::regclass,'public.payment'::regclass,'public.receipt'::regclass,'public.receipt_sequence'::regclass,'public.audit_log'::regclass,'public.supporter_consent_intent'::regclass,'public.donation_delivery_job'::regclass) and not t.tgisinternal) or (n.nspname='auth' and p.proname='uid') or(n.nspname='private' and p.proname in('has_admin_role','allocate_receipt_number','lock_admin_user_mutation','require_active_admin_user')) or(n.nspname='public' and p.proname in('fail_pending_provider_payment','refund_provider_payment_atomically','void_receipt_with_audit','void_donation_receipts_with_audit','issue_receipt_with_audit','issue_receipt')) order by n.nspname,p.proname,pg_get_function_identity_arguments(p.oid)) f where f.schema='public' and f.name='void_donation_receipts_with_audit';
	 if v_actual not in('[{"schema":"public","name":"void_donation_receipts_with_audit","args":"p_donation_id uuid, p_reason text","allargs":"p_donation_id uuid, p_reason text DEFAULT ''refund''::text","defaults":1,"default_expression":"''refund''::text","result":"TABLE(receipt_id uuid, pdf_url text)","owner":"postgres","acl":"{postgres=X/postgres,service_role=X/postgres}","full_acl":[{"grantee":"postgres","grantor":"postgres","grantable":false,"privilege":"EXECUTE"},{"grantee":"service_role","grantor":"postgres","grantable":false,"privilege":"EXECUTE"}],"config":["search_path=\"\""],"definer":true,"language":"plpgsql","kind":"f","cost":100,"rows":1000,"strict":false,"leakproof":false,"parallel":"u","volatility":"v","support":"-","variadic":"-","modes":["i","i","t","t"],"body":"1230adf731882717d9effee345cb547c","definition":"57ac6952d627e347f33a95ce79e6750c"}]'::jsonb) then
	 execute $definition$create or replace function public.void_donation_receipts_with_audit(
	  p_donation_id uuid,
	  p_reason text default 'refund'
	)
	returns table (receipt_id uuid, pdf_url text)
	language plpgsql
	security definer
	set search_path = ''
	as $$
	declare
	  v_receipt public.receipt%rowtype;
	  v_voided_at timestamptz;
	begin
	  if p_donation_id is null or p_reason is null or pg_catalog.length(pg_catalog.btrim(p_reason)) = 0 then
	    raise exception 'invalid_receipt_void_request' using errcode = '22023';
	  end if;
	
	  for v_receipt in
	    select * from public.receipt
	    where donation_ids @> array[p_donation_id]
	      and status = 'issued'
	    order by id
	    for update
	  loop
	    v_voided_at := pg_catalog.clock_timestamp();
	    update public.receipt
	    set status = 'void', voided_at = v_voided_at, voided_by = null
	    where id = v_receipt.id;
	
	    insert into public.audit_log(actor_user_id, action, entity, entity_id, detail)
	    values (
	      null, 'receipt.void', 'receipt', v_receipt.id::text,
	      pg_catalog.jsonb_build_object(
	        'voidedAt', v_voided_at,
	        'donationId', p_donation_id,
	        'reason', p_reason
	      )
	    );
	
	    return query select v_receipt.id, v_receipt.pdf_url;
	  end loop;
	end;
	$$;
	revoke all on function public.void_donation_receipts_with_audit(uuid,text) from public,anon,authenticated,service_role;
	grant execute on function public.void_donation_receipts_with_audit(uuid,text) to service_role;
	$definition$;
	 end if;
	 select coalesce(pg_catalog.jsonb_agg(to_jsonb(f) order by f.schema,f.name,f.args),'[]'::jsonb) into v_actual from (select n.nspname schema,p.proname name,pg_get_function_identity_arguments(p.oid) args,pg_get_function_arguments(p.oid) allargs,p.pronargdefaults defaults,pg_get_expr(p.proargdefaults,0) default_expression,pg_get_function_result(p.oid) result,pg_get_userbyid(p.proowner) owner,p.proacl::text acl,(select jsonb_agg(jsonb_build_object('grantor',pg_get_userbyid(a.grantor),'grantee',case when a.grantee=0 then 'PUBLIC' else pg_get_userbyid(a.grantee) end,'privilege',a.privilege_type,'grantable',a.is_grantable) order by pg_get_userbyid(a.grantor),case when a.grantee=0 then 'PUBLIC' else pg_get_userbyid(a.grantee) end,a.privilege_type) from aclexplode(coalesce(p.proacl,acldefault('f',p.proowner))) a) full_acl,p.proconfig config,p.prosecdef definer,l.lanname language,p.prokind kind,p.procost cost,p.prorows rows,p.proisstrict strict,p.proleakproof leakproof,p.proparallel parallel,p.provolatile volatility,p.prosupport::text support,p.provariadic::regtype::text variadic,p.proargmodes modes,md5(p.prosrc) body,md5(pg_get_functiondef(p.oid)) definition from pg_proc p join pg_namespace n on n.oid=p.pronamespace join pg_language l on l.oid=p.prolang where p.oid in(select t.tgfoid from pg_trigger t where t.tgrelid in('auth.users'::regclass,'public.admin_user'::regclass,'public.supporter'::regclass,'public.donation'::regclass,'public.payment'::regclass,'public.receipt'::regclass,'public.receipt_sequence'::regclass,'public.audit_log'::regclass,'public.supporter_consent_intent'::regclass,'public.donation_delivery_job'::regclass) and not t.tgisinternal) or (n.nspname='auth' and p.proname='uid') or(n.nspname='private' and p.proname in('has_admin_role','allocate_receipt_number','lock_admin_user_mutation','require_active_admin_user')) or(n.nspname='public' and p.proname in('fail_pending_provider_payment','refund_provider_payment_atomically','void_receipt_with_audit','void_donation_receipts_with_audit','issue_receipt_with_audit','issue_receipt')) order by n.nspname,p.proname,pg_get_function_identity_arguments(p.oid)) f where f.schema='public' and f.name='issue_receipt_with_audit';
	 if v_actual not in('[{"schema":"public","name":"issue_receipt_with_audit","args":"p_donation_id uuid, p_supporter_id uuid, p_amount_cents integer, p_tax_year integer, p_issued_at timestamp with time zone, p_actor uuid","allargs":"p_donation_id uuid, p_supporter_id uuid, p_amount_cents integer, p_tax_year integer, p_issued_at timestamp with time zone, p_actor uuid","defaults":0,"default_expression":null,"result":"TABLE(receipt_no text, receipt_id uuid, pdf_url text, tax_year integer, issued_at timestamp with time zone, already_existed boolean)","owner":"postgres","acl":"{postgres=X/postgres,service_role=X/postgres}","full_acl":[{"grantee":"postgres","grantor":"postgres","grantable":false,"privilege":"EXECUTE"},{"grantee":"service_role","grantor":"postgres","grantable":false,"privilege":"EXECUTE"}],"config":["search_path=\"\""],"definer":true,"language":"plpgsql","kind":"f","cost":100,"rows":1000,"strict":false,"leakproof":false,"parallel":"u","volatility":"v","support":"-","variadic":"-","modes":["i","i","i","i","i","i","t","t","t","t","t","t"],"body":"24f6b476f60f05ba71059aea3ef93311","definition":"8481089b62570b4386281c161bb4a20e"}]'::jsonb) then
	 execute $definition$create or replace function public.issue_receipt_with_audit(
	  p_donation_id uuid,
	  p_supporter_id uuid,
	  p_amount_cents integer,
	  p_tax_year integer,
	  p_issued_at timestamptz,
	  p_actor uuid
	)
	returns table (
	  receipt_no text,
	  receipt_id uuid,
	  pdf_url text,
	  tax_year integer,
	  issued_at timestamptz,
	  already_existed boolean
	)
	language plpgsql
	security definer
	set search_path = ''
	as $$
	declare
	  v_receipt record;
	begin
	  perform 1 from auth.users u
	  where u.id = p_actor
	    and u.email_confirmed_at is not null
	    and (u.banned_until is null or u.banned_until <= pg_catalog.clock_timestamp())
	  for share;
	  if not found then
	    raise exception 'receipt_issue_admin_required' using errcode = '42501';
	  end if;
	
	  perform 1 from public.admin_user a
	  where a.auth_user_id = p_actor
	    and a.status = 'active'
	    and a.role in ('treasurer', 'admin')
	  for share;
	  if not found then
	    raise exception 'receipt_issue_admin_required' using errcode = '42501';
	  end if;
	
	  select * into v_receipt
	  from public.issue_receipt(
	    p_donation_id, p_supporter_id, p_amount_cents, p_tax_year, p_issued_at
	  );
	  if not found then
	    raise exception 'receipt_issue_returned_no_row' using errcode = '22023';
	  end if;
	
	  -- A retry after PDF upload failure must not create a second issue fact.
	  if not exists (
	    select 1 from public.audit_log a
	    where a.action = 'receipt.issue'
	      and a.entity = 'donation'
	      and a.entity_id = p_donation_id::text
	      and a.actor_user_id = p_actor
	      and a.detail ->> 'receiptNo' = v_receipt.receipt_no
	  ) then
	    insert into public.audit_log(actor_user_id, action, entity, entity_id, detail)
	    values (
	      p_actor, 'receipt.issue', 'donation', p_donation_id::text,
	      pg_catalog.jsonb_build_object(
	        'receiptNo', v_receipt.receipt_no,
	        'supporterId', p_supporter_id
	      )
	    );
	  end if;
	
	  return query select
	    v_receipt.receipt_no::text,
	    v_receipt.receipt_id::uuid,
	    v_receipt.pdf_url::text,
	    v_receipt.tax_year::integer,
	    v_receipt.issued_at::timestamptz,
	    v_receipt.already_existed::boolean;
	end;
	$$;
	revoke all on function public.issue_receipt_with_audit(uuid,uuid,integer,integer,timestamptz,uuid) from public,anon,authenticated,service_role;
	grant execute on function public.issue_receipt_with_audit(uuid,uuid,integer,integer,timestamptz,uuid) to service_role;
	$definition$;
	 end if;
