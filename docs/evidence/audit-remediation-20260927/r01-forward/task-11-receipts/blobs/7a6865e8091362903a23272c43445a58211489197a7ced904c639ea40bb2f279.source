[local] 2026-10-02 23:11:48.649 UTC [740] postgres@postgres LOG:  statement: create function public.volunteer_bind_daily_policy(p_body jsonb,p_date date) returns void
	language plpgsql security definer set search_path=public,pg_temp as $$
	declare q jsonb;rules jsonb;binding public.volunteer_daily_policy_binding%rowtype;day_key text;begin
	 perform pg_advisory_xact_lock(hashtextextended('volunteer-domain',0));
	 if jsonb_array_length(public.volunteer_validate_policy(p_body))>0 then raise exception 'invalid_daily_policy' using errcode='22023';end if;
	 for q in select value from jsonb_array_elements(p_body->'daily_limits') loop
	  day_key:=case when q->>'scope'='all_shelters_day' then 'all' else p_body->>'shelter' end||':'||(q->>'key');
	  select coalesce(jsonb_agg(value order by (value->>'priority')::integer),'[]'::jsonb) into rules from jsonb_array_elements(p_body->'release_rules') where value#>>'{action,type}'='relax_quota' and value#>>'{action,scope}'=q->>'scope' and value#>>'{action,quota}'=q->>'key';
	  insert into public.volunteer_daily_policy_binding(scope_key,service_date,body,release_rules,timezone,source_body,source_release_rules) values(day_key,p_date,q,rules,p_body->>'timezone',q,rules) on conflict do nothing;
	  select * into binding from public.volunteer_daily_policy_binding where scope_key=day_key and service_date=p_date for update;
	  if binding.timezone<>p_body->>'timezone' or not ((binding.body=q and binding.release_rules=rules) or (binding.source_body=q and binding.source_release_rules=rules)) then raise exception 'daily_scope_requires_review' using errcode='22023';end if;
	 end loop;
	end $$;
