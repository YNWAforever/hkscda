[local] 2026-10-02 23:11:52.015 UTC [803] postgres@postgres LOG:  statement: create function public.record_exact_sponsorship_payment_proof(p_actor uuid,p_pledge uuid,p_key uuid,p_payment jsonb)
	returns uuid language plpgsql security definer set search_path=public,pg_temp as $$
	declare v_prior public.sponsorship_proof_submission_command%rowtype;v_id uuid;v_status text;
	begin
	 if not exists(select 1 from public.admin_user where auth_user_id=p_actor and status='active' and role in ('admin','staff')) then raise exception 'Coordinator required' using errcode='42501'; end if;
	 if p_key is null then raise exception 'Submission idempotency key required'; end if;
	 perform 1 from public.sponsorship_pledge where id=p_pledge for update;
	 perform pg_advisory_xact_lock(hashtextextended(p_actor::text||p_key::text,713));
	 select * into v_prior from public.sponsorship_proof_submission_command where actor_user_id=p_actor and idempotency_key=p_key;
	 if found then
	  if v_prior.command<>jsonb_build_object('pledge',p_pledge,'payment',p_payment) then raise exception 'Submission key reused for different facts'; end if;
	  return v_prior.proof_id;
	 end if;
	 select status into v_status from public.sponsorship_pledge where id=p_pledge;
	 if v_status='provisional' then
	  -- The legacy recorder accepts the following state; avoid changing it outside
	  -- this transaction and restore pending status after the insertion.
	  update public.sponsorship_pledge set status='needs_followup' where id=p_pledge;
	 end if;
	 v_id:=public.record_sponsorship_payment_proof(p_pledge,p_actor,p_payment->>'storagePath',p_payment->>'fileName',p_payment->>'fileType',(p_payment->>'fileSize')::integer,p_payment->>'paymentMethod',p_payment->>'reference',(p_payment->>'amountCents')::integer,(p_payment->>'paymentDate')::date,p_payment->>'note');
	 insert into public.sponsorship_proof_submission_command values(p_actor,p_key,jsonb_build_object('pledge',p_pledge,'payment',p_payment),v_id);
	 return v_id;
	end; $$;
