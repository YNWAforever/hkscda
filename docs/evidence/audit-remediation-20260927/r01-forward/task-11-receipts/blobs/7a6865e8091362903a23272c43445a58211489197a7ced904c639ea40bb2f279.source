	returns trigger
	language plpgsql
	set search_path = ''
	as $$
	declare
	  v_claimed_at timestamptz;
	begin
	  select intent.cleanup_claimed_at into v_claimed_at
	  from public.internship_attachment_upload_intent as intent
	  where intent.storage_path = new.object_path
