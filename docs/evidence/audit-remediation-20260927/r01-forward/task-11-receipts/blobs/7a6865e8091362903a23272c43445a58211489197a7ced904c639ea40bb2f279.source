[local] 2026-10-02 23:11:52.010 UTC [803] postgres@postgres LOG:  statement: create function public.record_sponsorship_full_refund(p_actor uuid,p_proof uuid,p_expected_revision bigint,p_reference text,p_reason text)
	returns jsonb language plpgsql security definer set search_path=public,pg_temp as $$
	declare v_proof public.sponsorship_payment_proof%rowtype;v_source public.sponsorship_payment_source%rowtype;v_actor uuid;v_refund uuid;v_entry record;v_prior public.sponsorship_refund%rowtype;
	begin
	 select id into v_actor from public.admin_user where auth_user_id=p_actor and status='active' and role in ('admin','treasurer');
	 if v_actor is null then raise exception 'Finance role required' using errcode='42501'; end if;
	 if length(trim(coalesce(p_reason,'')))<5 or length(trim(coalesce(p_reference,'')))<3 then raise exception 'Refund transfer reference and reason required'; end if;
	 perform 1 from public.sponsorship_pledge where id=(select pledge_id from public.sponsorship_payment_proof where id=p_proof) for update;
	 select * into v_proof from public.sponsorship_payment_proof where id=p_proof for update;
	 select * into v_prior from public.sponsorship_refund where proof_id=p_proof;
	 if found then
	  if v_prior.bank_reference=p_reference and v_prior.reason=p_reason then return jsonb_build_object('kind','refunded','id',v_prior.id,'replayed',true); end if;
	  raise exception 'Refund already recorded with different facts';
	 end if;
	 if v_proof.id is null or v_proof.review_status <> 'approved' or v_proof.revision<>p_expected_revision then raise exception 'Stale or unapproved proof'; end if;
	 select * into v_source from public.sponsorship_payment_source where proof_id=p_proof;
	 if not found then raise exception 'Legacy payment must be reconciled before refund'; end if;
	 perform 1 from public.payment where id=v_source.payment_id and status='succeeded' for update;
	 if not found then raise exception 'Payment is not refundable'; end if;
	 for v_entry in select a.id,a.period_id,a.amount_cents+coalesce((select sum(r.amount_cents) from public.sponsorship_payment_allocation r where r.reverses_allocation_id=a.id),0) net
	 from public.sponsorship_payment_allocation a where a.proof_id=p_proof and a.reverses_allocation_id is null loop
	  if v_entry.net>0 then insert into public.sponsorship_payment_allocation(period_id,proof_id,amount_cents,reverses_allocation_id,created_by,note)
	   values(v_entry.period_id,p_proof,-v_entry.net,v_entry.id,v_actor,p_reason); end if;
	 end loop;
	 insert into public.sponsorship_refund(proof_id,payment_id,amount_cents,bank_reference,reason,actor_user_id)
	 values(p_proof,v_source.payment_id,v_proof.amount_cents,p_reference,p_reason,p_actor) returning id into v_refund;
	 update public.payment set status='refunded' where id=v_source.payment_id;
	 update public.donation set status='refunded' where id=v_source.donation_id;
	 update public.receipt set status='void',voided_at=now(),voided_by=v_actor where v_source.donation_id=any(donation_ids) and status='issued';
	 insert into public.audit_log(actor_user_id,action,entity,entity_id,detail) values(p_actor,'sponsorship_pledge.refund_recorded','sponsorship_pledge',v_proof.pledge_id::text,jsonb_build_object('proofId',p_proof,'paymentId',v_source.payment_id,'refundId',v_refund,'amountCents',v_proof.amount_cents,'reason',p_reason,'reference',p_reference));
	 return jsonb_build_object('kind','refunded','id',v_refund);
	end; $$;
[local] 2026-10-02 23:11:52.011 UTC [803] postgres@postgres LOG:  statement: revoke all on function public.record_sponsorship_full_refund(uuid,uuid,bigint,text,text) from public,anon,authenticated;
