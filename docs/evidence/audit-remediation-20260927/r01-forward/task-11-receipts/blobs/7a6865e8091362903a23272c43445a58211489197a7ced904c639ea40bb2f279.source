[local] 2026-10-02 23:11:39.472 UTC [564] postgres@postgres LOG:  statement: create policy "staff can create draft payment public config"
	  on public.payment_public_config for insert
	  to authenticated
	  with check (
	    state = 'draft'
	    and private.has_admin_role(array['staff', 'treasurer', 'admin'])
