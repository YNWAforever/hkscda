[local] 2026-10-02 23:11:42.666 UTC [628] postgres@postgres LOG:  statement: CREATE OR REPLACE FUNCTION public.set_animal_catalog_membership_defaults()
	RETURNS trigger LANGUAGE plpgsql SET search_path=public,pg_temp AS $$
	BEGIN
	  IF TG_OP='INSERT' THEN
	    NEW.adoption_eligible:=coalesce(NEW.adoption_eligible,NEW.type IN ('cat','dog'));
	    NEW.sponsorship_eligible:=coalesce(NEW.sponsorship_eligible,NEW.type='sponsor');
	  ELSIF NEW.type IS DISTINCT FROM OLD.type
	    AND (OLD.type='sponsor' OR NEW.type='sponsor')
	    AND NEW.adoption_eligible IS NOT DISTINCT FROM OLD.adoption_eligible
	    AND NEW.sponsorship_eligible IS NOT DISTINCT FROM OLD.sponsorship_eligible THEN
	    NEW.adoption_eligible:=(NEW.type IN ('cat','dog'));
	    NEW.sponsorship_eligible:=(NEW.type='sponsor');
	  END IF;
	  RETURN NEW;
	END;
	$$;
[local] 2026-10-02 23:11:42.667 UTC [628] postgres@postgres LOG:  statement: REVOKE ALL ON FUNCTION public.set_animal_catalog_membership_defaults() FROM PUBLIC;
[local] 2026-10-02 23:11:42.667 UTC [628] postgres@postgres LOG:  statement: DROP TRIGGER IF EXISTS animal_catalog_membership_defaults ON public.animals;
[local] 2026-10-02 23:11:42.667 UTC [628] postgres@postgres LOG:  statement: CREATE TRIGGER animal_catalog_membership_defaults BEFORE INSERT OR UPDATE OF type ON public.animals
	FOR EACH ROW EXECUTE FUNCTION public.set_animal_catalog_membership_defaults();
