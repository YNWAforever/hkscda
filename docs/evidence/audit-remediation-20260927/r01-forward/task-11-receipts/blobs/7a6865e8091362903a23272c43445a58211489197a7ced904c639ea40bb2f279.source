[local] 2026-10-02 23:11:51.994 UTC [803] postgres@postgres LOG:  statement: create function private.snapshot_sponsorship_proof_contact() returns trigger
	language plpgsql security definer set search_path=public,pg_temp as $$
	begin
	 select jsonb_build_object('name',s.name,'email',s.email,'phone',s.phone,'language',p.language,'source','proof_recorded','capturedAt',clock_timestamp()) into new.contact_snapshot
	 from public.sponsorship_pledge p join public.supporter s on s.id=p.supporter_id where p.id=new.pledge_id;
	 return new;
	end; $$;
