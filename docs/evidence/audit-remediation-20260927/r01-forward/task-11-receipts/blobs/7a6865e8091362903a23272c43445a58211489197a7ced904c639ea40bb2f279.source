[local] 2026-10-02 23:11:50.445 UTC [775] postgres@postgres LOG:  statement: create function private.increment_sponsorship_proof_revision() returns trigger
	language plpgsql set search_path=public,pg_temp as $$
	begin new.revision := old.revision+1; return new; end; $$;
