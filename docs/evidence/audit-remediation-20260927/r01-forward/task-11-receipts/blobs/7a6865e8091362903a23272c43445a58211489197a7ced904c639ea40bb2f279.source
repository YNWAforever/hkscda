[local] 2026-10-02 23:12:19.114 UTC [1288] postgres@postgres LOG:  statement: create or replace function public.bump_dog_friendly_estate_version()
	returns trigger
	language plpgsql
	set search_path = public, pg_temp
	as $$
	begin
	  if new.version = old.version then
	    new.version := old.version + 1;
	  elsif new.version <> old.version + 1 then
	    raise exception 'Invalid estate version increment' using errcode = 'P4090';
	  end if;
	  return new;
	end;
	$$;
[local] 2026-10-02 23:12:19.114 UTC [1288] postgres@postgres LOG:  statement: revoke all on function public.bump_dog_friendly_estate_version()
