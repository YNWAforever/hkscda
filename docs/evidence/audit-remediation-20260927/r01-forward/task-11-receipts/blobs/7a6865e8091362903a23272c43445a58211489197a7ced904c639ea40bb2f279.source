[local] 2026-10-02 23:11:52.016 UTC [803] postgres@postgres LOG:  statement: create function public.record_sponsorship_receipt_request(p_actor uuid,p_proof uuid)
	returns uuid language plpgsql security definer set search_path=public,pg_temp as $$
	declare v_source public.sponsorship_payment_source%rowtype;v_pledge uuid;v_changed integer;
	begin
	 if not exists(select 1 from public.admin_user where auth_user_id=p_actor and status='active' and role in ('admin','treasurer')) then raise exception 'Finance role required' using errcode='42501'; end if;
	 select pledge_id into v_pledge from public.sponsorship_payment_proof where id=p_proof;
	 perform 1 from public.sponsorship_pledge where id=v_pledge for update;
	 select * into v_source from public.sponsorship_payment_source where proof_id=p_proof;
	 if not found then raise exception 'Reconcile the received payment first'; end if;
	 update public.donation set receipt_requested=true where id=v_source.donation_id and status='succeeded' and not receipt_requested;
	 get diagnostics v_changed=row_count;
	 if v_changed>0 then insert into public.audit_log(actor_user_id,action,entity,entity_id,detail) values(p_actor,'sponsorship_pledge.receipt_requested','sponsorship_pledge',v_pledge::text,jsonb_build_object('proofId',p_proof,'donationId',v_source.donation_id,'source','staff_recorded_supporter_request'));end if;
	 return v_source.donation_id;
	end; $$;
