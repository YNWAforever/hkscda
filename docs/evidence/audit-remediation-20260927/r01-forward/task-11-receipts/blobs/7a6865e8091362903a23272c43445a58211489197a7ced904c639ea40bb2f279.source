[local] 2026-10-02 23:11:24.394 UTC [276] postgres@postgres LOG:  statement: create or replace function private.has_admin_role(allowed_roles text[])
	returns boolean
	language sql
	security definer
	set search_path = public, pg_temp
	as $$
	  select exists (
	    select 1
	    from public.admin_user au
	    where au.auth_user_id = (select auth.uid())
	      and au.status = 'active'
	      and au.role = any(allowed_roles)
	  );
	$$;
