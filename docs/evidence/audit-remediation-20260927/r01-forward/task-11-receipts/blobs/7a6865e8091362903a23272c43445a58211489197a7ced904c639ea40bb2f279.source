[local] 2026-10-02 23:11:36.133 UTC [501] postgres@postgres LOG:  statement: create policy "staff can create draft adoption guide releases"
	  on public.adoption_guide_releases for insert
	  to authenticated
	  with check (
	    state = 'draft'
	    and private.has_admin_role(array['staff', 'admin'])
