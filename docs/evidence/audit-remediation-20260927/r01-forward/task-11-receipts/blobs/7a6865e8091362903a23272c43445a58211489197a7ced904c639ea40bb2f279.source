[local] 2026-10-02 23:11:52.012 UTC [803] postgres@postgres LOG:  statement: create function public.open_sponsorship_followup_months(p_actor uuid,p_pledge uuid)
	returns integer language plpgsql security definer set search_path=public,pg_temp as $$
	declare v_pledge public.sponsorship_pledge%rowtype;v_count integer;
	begin
	 if not exists(select 1 from public.admin_user where auth_user_id=p_actor and status='active' and role in ('admin','staff')) then raise exception 'Coordinator required' using errcode='42501'; end if;
	 select * into v_pledge from public.sponsorship_pledge where id=p_pledge for update;
	 if not found or v_pledge.status not in ('active','needs_followup') then raise exception 'Only ongoing commitments have follow-up months'; end if;
	 insert into public.sponsorship_period(pledge_id,period_month,committed_cents)
	 select p_pledge,m::date,v_pledge.amount_cents from generate_series(date_trunc('month',v_pledge.created_at at time zone 'Asia/Hong_Kong'),date_trunc('month',now() at time zone 'Asia/Hong_Kong'),interval '1 month') m
	 on conflict(pledge_id,period_month) do nothing;
	 get diagnostics v_count=row_count;
	 if v_count>0 then insert into public.audit_log(actor_user_id,action,entity,entity_id,detail) values(p_actor,'sponsorship_pledge.followup_months_opened','sponsorship_pledge',p_pledge::text,jsonb_build_object('count',v_count,'classification','service_followup_not_debt')); end if;
	 return v_count;
	end; $$;
[local] 2026-10-02 23:11:52.012 UTC [803] postgres@postgres LOG:  statement: revoke all on function public.open_sponsorship_followup_months(uuid,uuid) from public,anon,authenticated;
[local] 2026-10-02 23:11:52.012 UTC [803] postgres@postgres LOG:  statement: grant execute on function public.open_sponsorship_followup_months(uuid,uuid) to service_role;
[local] 2026-10-02 23:11:52.013 UTC [803] postgres@postgres LOG:  statement: create or replace function public.cancel_sponsorship_pledge(
	  p_pledge_id uuid,
	  p_actor_user_id uuid,
	  p_note text
	) returns void
	language plpgsql
	security definer
	set search_path = public, pg_temp
	as $$
	declare
	  v_pledge public.sponsorship_pledge%rowtype;
	begin
	  if not exists (
	    select 1
	    from public.admin_user
	    where auth_user_id = p_actor_user_id
	      and status = 'active'
	      and role in ('staff', 'admin')
	  ) then
	    raise exception 'Actor % is not an active staff/admin user', p_actor_user_id
	      using errcode = '42501';
	  end if;
	
	  select *
	  into v_pledge
	  from public.sponsorship_pledge
	  where id = p_pledge_id
	  for update;
	
	  if not found then
	    raise exception 'Sponsorship pledge not found';
	  end if;
	
	  if v_pledge.status = 'cancelled' then
	    raise exception 'Sponsorship pledge is already cancelled';
	  end if;
	
	  update public.sponsorship_pledge
	  set status = 'cancelled'
	  where id = p_pledge_id;
	
	  -- Cancelling future commitment does not decide whether past money arrived.
	  insert into public.audit_log (
	    actor_user_id,
	    action,
	    entity,
	    entity_id,
	    detail
	  ) values (
	    p_actor_user_id,
	    'sponsorship_pledge.cancelled',
	    'sponsorship_pledge',
	    p_pledge_id::text,
	    jsonb_build_object('note', p_note)
	  );
	end;
	$$;
