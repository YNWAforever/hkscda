BEGIN;
-- Read-only UI projection: one statement snapshot, never a promise of write-time eligibility.
-- Mutating policy/booking commands retain their existing locks and authoritative revalidation.
-- Rollback: restore the previous app before dropping this additive function.
create function public.volunteer_policy_settings_read(p_actor uuid)
returns jsonb language plpgsql stable security definer set search_path=public,pg_temp as $$
begin
 if not exists(select 1 from public.admin_user a join auth.users u on u.id=a.auth_user_id
  where a.auth_user_id=p_actor and a.status='active' and a.role='admin'
  and u.email_confirmed_at is not null and (u.banned_until is null or u.banned_until<=now()))
 then raise exception 'volunteer_forbidden' using errcode='42501'; end if;
 return jsonb_build_object(
  'drafts',(select coalesce(jsonb_agg(to_jsonb(d) order by d.template_key),'[]'::jsonb) from public.volunteer_policy_draft d),
  'versions',(select coalesce(jsonb_agg(jsonb_build_object('id',v.id,'template_key',v.template_key,'effective_from',v.effective_from,'reason',v.reason) order by v.created_at desc,v.id),'[]'::jsonb) from public.volunteer_policy_version v),
  'activities',(select coalesce(jsonb_agg(to_jsonb(s) order by s.starts_at,s.id),'[]'::jsonb) from (
   select a.id,a.title,a.starts_at,a.ends_at,a.capacity,a.policy_version_id,a.policy_revision,a.template_key,a.shelter_key,
    coalesce(r.approved_participants,0) approved_participants,coalesce(r.waitlisted_participants,0) waitlisted_participants
   from (select * from public.volunteer_activity where starts_at>now() order by starts_at,id limit 500) a
   left join lateral(select sum(participant_count) filter(where status='approved') approved_participants,
    sum(participant_count) filter(where status='waitlisted') waitlisted_participants
    from public.volunteer_registration where activity_id=a.id and status in('approved','waitlisted'))r on true) s),
  'activity_total',(select count(*) from public.volunteer_activity where starts_at>now()),
  'activity_limit',500);
end $$;
revoke all on function public.volunteer_policy_settings_read(uuid) from public,anon,authenticated;
grant execute on function public.volunteer_policy_settings_read(uuid) to service_role;
COMMIT;
