BEGIN;
-- T23 CRM follow-up owner only. Identity, consent, gifts and messages are untouched.
alter table public.supporter
  add column crm_assignee_user_id uuid references auth.users(id);
-- Existing authenticated table-wide writes must not expose the new guarded
-- assignment column. Preserve INSERT/UPDATE on every prior supporter column.
revoke insert, update on public.supporter from public, anon, authenticated;
do $$
declare v_columns text;
begin
  select string_agg(quote_ident(attname), ', ' order by attnum) into v_columns
  from pg_attribute where attrelid='public.supporter'::regclass
    and attnum>0 and not attisdropped and attname<>'crm_assignee_user_id';
  execute format('grant insert (%s), update (%s) on public.supporter to authenticated',
    v_columns, v_columns);
end $$;
create index supporter_crm_assignee_active_idx
  on public.supporter(crm_assignee_user_id) where deleted_at is null;
create table public.crm_assignment_bulk_operation (
  id uuid primary key default gen_random_uuid(),
  actor_user_id uuid not null references auth.users(id),
  assignee_user_id uuid not null references auth.users(id),
  filter_hash text not null check (filter_hash ~ '^[0-9a-f]{64}$'),
  created_at timestamptz not null default now(),
  expires_at timestamptz not null default (now() + interval '15 minutes')
);
create table public.crm_assignment_bulk_item (
  operation_id uuid not null references public.crm_assignment_bulk_operation(id),
  supporter_id uuid not null,
  ordinal integer not null,
  expected_version bigint,
  before_assignee uuid,
  after_assignee uuid,
  status text not null check (status in ('pending','succeeded','skipped','conflict','failed')),
  reason_code text,
  applied_at timestamptz,
  primary key(operation_id,supporter_id),
  unique(operation_id,ordinal)
);
create index crm_assignment_bulk_operation_actor_idx
  on public.crm_assignment_bulk_operation(actor_user_id,created_at desc);
create index crm_assignment_bulk_item_pending_idx
  on public.crm_assignment_bulk_item(operation_id,ordinal) where status='pending';
alter table public.crm_assignment_bulk_operation enable row level security;
alter table public.crm_assignment_bulk_item enable row level security;
revoke all on public.crm_assignment_bulk_operation, public.crm_assignment_bulk_item
  from public,anon,authenticated,service_role;
grant select on public.crm_assignment_bulk_operation, public.crm_assignment_bulk_item
  to service_role;
create function private.require_crm_assignment_user(p_user uuid)
returns void language plpgsql security definer set search_path='' as $$
begin
  perform 1 from public.admin_user a join auth.users u on u.id=a.auth_user_id
  where a.auth_user_id=p_user and a.status='active'
    and a.role in ('treasurer','admin')
    and u.email_confirmed_at is not null
    and (u.banned_until is null or u.banned_until<=now())
  for share of a,u;
  if not found then
    raise exception 'CRM assignment user unavailable' using errcode='42501';
  end if;
end $$;
revoke all on function private.require_crm_assignment_user(uuid)
  from public,anon,authenticated,service_role;
create function public.get_crm_assignment_bulk_operation(p_actor uuid,p_operation uuid)
returns jsonb language plpgsql security definer set search_path='' as $$
declare
  v_op public.crm_assignment_bulk_operation%rowtype;
  v_items jsonb;
  v_pending integer;
  v_succeeded integer;
begin
  perform private.require_crm_assignment_user(p_actor);
  select * into v_op from public.crm_assignment_bulk_operation
  where id=p_operation and actor_user_id=p_actor;
  if not found then
    raise exception 'CRM assignment operation unavailable' using errcode='42501';
  end if;
  select coalesce(jsonb_agg(jsonb_build_object(
    'entityId',i.supporter_id,'status',i.status,'reasonCode',i.reason_code,
    'expectedVersion',i.expected_version,'beforeAssignee',i.before_assignee,
    'afterAssignee',i.after_assignee
  ) order by i.ordinal),'[]'::jsonb),
    count(*) filter(where i.status='pending'),
    count(*) filter(where i.status='succeeded')
  into v_items,v_pending,v_succeeded
  from public.crm_assignment_bulk_item i where i.operation_id=p_operation;
  return jsonb_build_object(
    'operationId',v_op.id,'assigneeUserId',v_op.assignee_user_id,
    'filterHash',v_op.filter_hash,'createdAt',v_op.created_at,
    'expiresAt',v_op.expires_at,
    'state',case when v_pending=0 then 'done'
                 when v_succeeded=0 then 'queued' else 'partial' end,
    'items',v_items
  );
end $$;
revoke all on function public.get_crm_assignment_bulk_operation(uuid,uuid)
  from public,anon,authenticated;
grant execute on function public.get_crm_assignment_bulk_operation(uuid,uuid)
  to service_role;
create function public.create_crm_assignment_bulk_preview(
  p_actor uuid,p_ids uuid[],p_assignee uuid,p_filter_hash text
)
returns jsonb language plpgsql security definer set search_path='' as $$
declare
  v_op uuid;
  v_id uuid;
  v_row public.supporter%rowtype;
  v_status text;
  v_reason text;
  v_ordinal integer:=0;
begin
  perform private.require_crm_assignment_user(p_actor);
  perform private.require_crm_assignment_user(p_assignee);
  if p_ids is null or cardinality(p_ids)<1 or cardinality(p_ids)>1000
    or exists(select 1 from unnest(p_ids) id where id is null)
    or (select count(distinct id) from unnest(p_ids) id)<>cardinality(p_ids)
    or coalesce(p_filter_hash,'') !~ '^[0-9a-f]{64}$' then
    raise exception 'Invalid CRM assignment preview' using errcode='22023';
  end if;
  insert into public.crm_assignment_bulk_operation(actor_user_id,assignee_user_id,filter_hash)
  values(p_actor,p_assignee,p_filter_hash) returning id into v_op;
  foreach v_id in array p_ids loop
    v_ordinal:=v_ordinal+1;
    select * into v_row from public.supporter where id=v_id;
    if not found then v_status:='skipped';v_reason:='not_found';
    elsif v_row.deleted_at is not null then v_status:='skipped';v_reason:='deleted';
    elsif v_row.crm_assignee_user_id=p_assignee then
      v_status:='skipped';v_reason:='already_assigned';
    else v_status:='pending';v_reason:=null;
    end if;
    insert into public.crm_assignment_bulk_item(
      operation_id,supporter_id,ordinal,expected_version,before_assignee,
      after_assignee,status,reason_code
    ) values(
      v_op,v_id,v_ordinal,
      case when v_status='pending' then v_row.edit_version else null end,
      v_row.crm_assignee_user_id,
      case when v_status='pending' then p_assignee else v_row.crm_assignee_user_id end,
      v_status,v_reason
    );
  end loop;
  insert into public.audit_log(actor_user_id,action,entity,entity_id,detail)
  values(p_actor,'crm_assignment_bulk.preview','crm_assignment_bulk_operation',v_op::text,
    jsonb_build_object('assigneeUserId',p_assignee,'filterHash',p_filter_hash,
                       'selectionCount',cardinality(p_ids)));
  return public.get_crm_assignment_bulk_operation(p_actor,v_op);
end $$;
revoke all on function public.create_crm_assignment_bulk_preview(uuid,uuid[],uuid,text)
  from public,anon,authenticated;
grant execute on function public.create_crm_assignment_bulk_preview(uuid,uuid[],uuid,text)
  to service_role;
create function public.apply_crm_assignment_bulk_item(
  p_actor uuid,p_operation uuid,p_supporter uuid
)
returns jsonb language plpgsql security definer set search_path='' as $$
declare
  v_op public.crm_assignment_bulk_operation%rowtype;
  v_item public.crm_assignment_bulk_item%rowtype;
  v_row public.supporter%rowtype;
  v_new_version bigint;
  v_status text;
  v_reason text;
begin
  perform private.require_crm_assignment_user(p_actor);
  select * into v_op from public.crm_assignment_bulk_operation
  where id=p_operation and actor_user_id=p_actor for update;
  if not found then
    raise exception 'CRM assignment operation unavailable' using errcode='42501';
  end if;
  perform private.require_crm_assignment_user(v_op.assignee_user_id);
  if v_op.expires_at<=pg_catalog.clock_timestamp() then
    raise exception 'CRM assignment snapshot expired' using errcode='P0001';
  end if;
  select * into v_item from public.crm_assignment_bulk_item
  where operation_id=p_operation and supporter_id=p_supporter for update;
  if not found then
    raise exception 'CRM assignment item unavailable' using errcode='42501';
  end if;
  if v_item.status<>'pending' then
    return jsonb_build_object('entityId',p_supporter,'status',v_item.status,
                              'reasonCode',v_item.reason_code);
  end if;
  select * into v_row from public.supporter where id=p_supporter for update;
  if v_op.expires_at<=pg_catalog.clock_timestamp() then
    raise exception 'CRM assignment snapshot expired' using errcode='P0001';
  end if;
  if not found or v_row.deleted_at is not null then
    v_status:='skipped';v_reason:='unavailable';
  elsif v_row.edit_version is distinct from v_item.expected_version
    or v_row.crm_assignee_user_id is distinct from v_item.before_assignee then
    v_status:='conflict';v_reason:='version_changed';
  else
    update public.supporter set crm_assignee_user_id=v_op.assignee_user_id
    where id=p_supporter returning edit_version into v_new_version;
    insert into public.audit_log(actor_user_id,action,entity,entity_id,detail)
    values(p_actor,'supporter.assign_crm_followup','supporter',p_supporter::text,
      jsonb_build_object('operationId',p_operation,
        'beforeAssigneeUserId',v_item.before_assignee,
        'afterAssigneeUserId',v_op.assignee_user_id,
        'expectedVersion',v_item.expected_version,'newVersion',v_new_version));
    v_status:='succeeded';v_reason:=null;
  end if;
  update public.crm_assignment_bulk_item
  set status=v_status,reason_code=v_reason,applied_at=clock_timestamp()
  where operation_id=p_operation and supporter_id=p_supporter;
  if v_status<>'succeeded' then
    insert into public.audit_log(actor_user_id,action,entity,entity_id,detail)
    values(p_actor,'crm_assignment_bulk.item_result','crm_assignment_bulk_item',p_supporter::text,
      jsonb_build_object('operationId',p_operation,'status',v_status,
                         'reasonCode',v_reason));
  end if;
  return jsonb_build_object('entityId',p_supporter,'status',v_status,
                            'reasonCode',v_reason);
end $$;
revoke all on function public.apply_crm_assignment_bulk_item(uuid,uuid,uuid)
  from public,anon,authenticated;
grant execute on function public.apply_crm_assignment_bulk_item(uuid,uuid,uuid)
  to service_role;
create function public.list_crm_assignment_assignees(p_actor uuid)
returns jsonb language plpgsql security definer set search_path='' as $$
begin
  perform private.require_crm_assignment_user(p_actor);
  return (
    select coalesce(jsonb_agg(jsonb_build_object(
      'authUserId',eligible.auth_user_id,'email',eligible.email,'role',eligible.role
    ) order by eligible.email),'[]'::jsonb)
    from (
      select a.auth_user_id,a.email,a.role
      from public.admin_user a join auth.users u on u.id=a.auth_user_id
      where a.status='active' and a.role in ('treasurer','admin')
        and u.email_confirmed_at is not null
        and (u.banned_until is null or u.banned_until<=now())
      order by a.email limit 1000
    ) eligible
  );
end $$;
revoke all on function public.list_crm_assignment_assignees(uuid)
  from public,anon,authenticated;
grant execute on function public.list_crm_assignment_assignees(uuid)
  to service_role;
COMMIT;
