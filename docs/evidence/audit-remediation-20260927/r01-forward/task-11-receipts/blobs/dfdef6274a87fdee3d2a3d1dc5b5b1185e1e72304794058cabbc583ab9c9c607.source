import { SQL } from "bun";
import { writeFile, readFile } from "node:fs/promises";
const sql = new SQL("postgresql://postgres:postgres@127.0.0.1:57322/postgres", {max:1});
try {
 await sql.unsafe("begin read only;set local statement_timeout='30s'");
 const policy=await sql.unsafe("select enabled,version,approved_by is null approved_by_null,approved_at is null approved_at_null from public.checkout_policy where singleton=true");
 const audits=await sql.unsafe("select md5(actor_user_id::text) actor_hash,count(*)::int total from public.audit_log where action in ('checkout_policy.set','checkout_method_approval.set') group by actor_user_id order by actor_hash");
 const actions=await sql.unsafe("select action,count(*)::int total from public.audit_log where action in ('checkout_policy.set','checkout_method_approval.set') group by action order by action");
 const residue=await sql.unsafe("select (select count(*)::int from public.admin_user where email like 'checkout-%@example.test') checkout_test_admins,(select count(*)::int from public.checkout_admission) admissions,(select count(*)::int from public.checkout_method_approval where method='stripe' and purpose='donation') stripe_donation_approvals,(select count(*)::int from public.payment_public_config where method='stripe' and state='published' and is_publicly_visible and published_by is null) reset_published_stripe_configs");
 await sql.unsafe("rollback");
 const gate=JSON.parse(await readFile(".superpowers/sdd/r01-forward-schema-plan-20261001/task-11-gates-1790966853807654300/receipt.json","utf8"));
 await writeFile(".superpowers/sdd/r01-forward-schema-plan-20261001/task-11-modern-suite-diagnostic.json",JSON.stringify({observation:"Read-only after-suite synthetic state; no before component snapshots exist",at:new Date().toISOString(),modernBefore:gate.modernBefore,modernAfter:gate.modernAfter,modernPreserved:false,stateHelper:"Hashes catalog, managed prerequisites, all non-system table row counts/content hashes, and sequence metadata/last_value",fixture:"src/lib/donations/checkoutPolicy.database.test.ts",fixtureWrites:"Six committed audit entries and four checkout-policy audited version increments per successful run. finally disables policy/clears approval actor+time; removes its admission keys/stripe approval/admin; restores config published+visible+published_by null. It intentionally does not remove audit entries or restore policy version.",policy,audits,actions,residue,qualification:"Observed aggregate transition is consistent with the actual passing fixture committed audit/version data. Aggregate hashes do not identify each changed component; absent pre-suite component snapshots, no exact catalog/Auth/ACL/native preservation or exclusive-delta claim is made. No DB repair/reset or DML performed by this diagnostic.",templatePreserved:gate.templatePreserved,productionApplied:false,deployed:false,operationallyEnabled:false},null,2)+"\n");
 console.log(JSON.stringify({policy,actions,residue,actorGroups:audits.length}));
} finally { await sql.close(); }
