import { SQL } from 'bun';import {writeFile,copyFile,mkdir}from'node:fs/promises';import{resolve}from'node:path';import{createHash}from'node:crypto';
const out=resolve('.superpowers/sdd/r01-forward-schema-plan-20261001/task-11-fix3-oid-type-probe-'+Date.now());await mkdir(out);await copyFile(import.meta.path,resolve(out,'executed.source'));
