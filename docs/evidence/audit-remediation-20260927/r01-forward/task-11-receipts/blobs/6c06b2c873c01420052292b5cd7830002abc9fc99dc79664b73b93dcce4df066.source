try {const rows=await sql.begin(async tx=>{await tx.unsafe('set transaction read only');return await tx.unsafe(query)});const receipt={qualification:'Read-only Bun SQL metadata representation probe; no helper or fixture execution.',out,query,rows,types:rows.map(r=>({oid:typeof r.oid,oid_array:typeof r.oid_array,oid_array_elements:r.oid_array.map((v:unknown)=>typeof v),proc_oid:typeof r.proc_oid})),querySha256:createHash('sha256').update(query).digest('hex'),error:null};await writeFile(resolve(out,'receipt.json'),JSON.stringify(receipt,null,2)+'\n');console.log(JSON.stringify(receipt))}finally{await sql.close();}
