import {mkdir,readFile,writeFile} from 'node:fs/promises';
import {resolve} from 'node:path';
import {captureModernLocalSchema,createProductionClone,assertSafeFixtureTables,snapshot,hash,localSourceState} from '../../../supabase/rls-tests/helpers/productionSchemaClone';
import {fixtureScope,dependencies} from '../../../docs/evidence/audit-remediation-20260927/r01-forward/task-11-profile';
const out=resolve(process.argv[2]); await mkdir(out,{recursive:true});
const paths=['.superpowers/sdd/r01-forward-schema-plan-20261001/task-11-fix1-focused.ts','src/lib/donations/financeCallbackForward.database.test.ts','supabase/rls-tests/helpers/productionSchemaClone.ts','docs/evidence/audit-remediation-20260927/r01-forward/task-11-profile.ts','supabase/migrations/20261002170945_r01_finance_callback_forward.sql',...dependencies.map(([p])=>'supabase/migrations/'+p)];
const frozen:Record<string,string>={};for(const [i,p]of paths.entries()){const raw=await readFile(p);frozen[p]=hash(raw.toString());await writeFile(resolve(out,'s'+i+'.source'),raw)}
const flags=['fullScannerPassed','dependenciesBound','migrationApplied','catalogPreserved','zeroRowsAfter','normalDrop','templatePreserved','modernPreserved','frozenInputsPreserved'];const r:Record<string,any>={receiptType:'fix1-focused',mode:'modern',requiredFinalFlags:flags,error:null,failedFinalFlags:[],frozenInputs:frozen,sourceHead:process.env.FIX1_SOURCE_HEAD,expectedTestExit:Number(process.argv[3]),productionApplied:false,deployed:false,operationallyEnabled:false};
const modern='postgresql://postgres:postgres@127.0.0.1:57322/postgres';const beforeModern=await localSourceState(modern);let c:Awaited<ReturnType<typeof createProductionClone>>|undefined;
try{c=await createProductionClone(await captureModernLocalSchema());r.schemaParity=true;r.clone=c.name;const db=c.sql;await assertSafeFixtureTables(db,fixtureScope);r.fullScannerPassed=true;
for(const[p,h]of dependencies){const b=await readFile('supabase/migrations/'+p);if(hash(b.toString())!==h)throw Error('dependency differs');await db.begin(async tx=>{await tx`set local role postgres`;await tx.unsafe(b.toString())})}r.dependenciesBound=true;await assertSafeFixtureTables(db,fixtureScope);
await db.begin(async tx=>{await tx`set local role postgres`;await tx.unsafe(await readFile('supabase/migrations/20261002170945_r01_finance_callback_forward.sql','utf8'))});r.migrationApplied=true;const before=await snapshot(db);
const args=['bun','test','--timeout','15000','src/lib/donations/financeCallbackForward.database.test.ts','--test-name-pattern','system void late audit failure'];r.command=args;const p=Bun.spawn(args,{stdout:'pipe',stderr:'pipe',env:{...process.env,R01_FINANCE_CALLBACK_TEST_DATABASE_URL:c.url,R01_FINANCE_CALLBACK_ALLOW_LOCAL_FIXTURES:'1'}});const[stdout,stderr,exit]=await Promise.all([new Response(p.stdout).text(),new Response(p.stderr).text(),p.exited]);await writeFile(resolve(out,'test.stdout'),stdout);await writeFile(resolve(out,'test.stderr'),stderr);r.testExit=exit;r.expectedTestObserved=exit===r.expectedTestExit;r.catalogPreserved=hash(before)===hash(await snapshot(db));
const rows=[];for(const path of fixtureScope){const[schema,table]=(path.includes('.')?path:'public.'+path).split('.');const[v]=await db.unsafe('select count(*)::int count from "'+schema+'"."'+table+'"');rows.push({path,count:v.count})}r.rows=rows;r.zeroRowsAfter=rows.length===10&&rows.every(v=>v.count===0);
}catch(e){r.error=String(e)}finally{if(c){try{await c.close();r.normalDrop=true}catch(e){r.normalDrop=false;r.error=[r.error,String(e)].filter(Boolean).join(';')}r.templatePreserved=c.templatePreserved}try{r.modernPreserved=beforeModern===await localSourceState(modern)}catch(e){r.modernPreserved=false;r.error=String(e)}r.frozenInputsPreserved=true;for(const[p,h]of Object.entries(frozen))if(hash(await readFile(p,'utf8'))!==h)r.frozenInputsPreserved=false;r.failedFinalFlags=flags.filter(f=>r[f]!==true);r.eligible=r.error===null&&r.failedFinalFlags.length===0&&r.expectedTestObserved===true;await writeFile(resolve(out,'receipt.json'),JSON.stringify(r,null,2)+'\n');console.log(JSON.stringify({out,testExit:r.testExit,eligible:r.eligible,error:r.error,failed:r.failedFinalFlags}));process.exitCode=r.eligible?0:1}
