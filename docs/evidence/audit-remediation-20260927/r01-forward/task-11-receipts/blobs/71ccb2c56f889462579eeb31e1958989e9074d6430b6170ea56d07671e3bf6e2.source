"""Metadata-only proposal/transport derivation; no DB or source amendment."""
import hashlib,json,pathlib,shutil,subprocess
s=pathlib.Path('.superpowers/sdd/r01-forward-schema-plan-20261001')
v=s/'task-11-fix3-baseline-c4f39419e50b416b8077becd931767c6'
o=s/'task-11-fix3-v6-profile-proposal';o.mkdir(exist_ok=False)
def sha(b):return hashlib.sha256(b).hexdigest()
def bind(p):
 b=p.read_bytes();return {'path':p.as_posix(),'bytes':len(b),'rawSha256':sha(b),'canonicalSha256':sha(b.replace(b'\r\n',b'\n')),'rawGitBlob':subprocess.check_output(['git','hash-object','--no-filters',str(p)],text=True).strip()}
r=json.loads((v/'receipt.json').read_text());b=(v/'d45-baseline.json').read_bytes();actual=json.loads(b)
assert sha((v/'receipt.json').read_bytes())=='73096312212377aa25832dd015aba8e4c247241b3d34d76719a90d9282d0a798'
assert b==(v/'after-rollback.json').read_bytes() and sha(b)=='9fcfed1ba69e1752c58110cc549ca90d0af74d66dddc014ee38cbd0aedcae603'
driver=(v/'i000.source').read_bytes();finance=(v/'i040.source').read_bytes()
assert b"red=psql(b'\\\\set VERBOSITY verbose\\nBEGIN;\\n'+finance+b'\\nROLLBACK;\\n',required=False)" in driver
assert sha(finance)=='33a8588cbbee435b3fa0d02aab5b47b841689477aa4cd08ce0645b71eea6e8e4'
transport=b'\\set VERBOSITY verbose\nBEGIN;\n'+finance+b'\nROLLBACK;\n'
(o/'finance-transaction.postexecution-derived.source').write_bytes(transport)
profile=(pathlib.Path('docs/evidence/audit-remediation-20260927/r01-forward/task-11-profile.ts')).read_text()
import re
names=re.search(r'export const names = \[([\s\S]*?)\]',profile).group(1);names=re.findall(r'"([^"]+)"',names)
tables=re.search(r'export const tables = \[([\s\S]*?)\]',profile).group(1);tables=re.findall(r'"([^"]+)"',tables)
assert len(names)==5 and len(tables)==9
globalKeys=['schemas','defaults','roles','memberships','extensions','extensionMembers','databaseOwner','sequences']
c=actual['catalog'];projection={k:c[k]for k in globalKeys}
for k in ['relations','columns','constraints','indexes','triggers','policies']:projection[k]=[f for f in c[k]if f['schema']=='public'and(f.get('table')or f.get('name'))in tables]
projection['types']=[f for f in c['types']if f['schema']=='public'and(f['name']in tables or f['name'].startswith('_')and f['name'][1:]in tables or f['kind']!='c'and not f['name'].startswith('_'))]
helpers=[f for f in actual['functions']if not(f['schema']=='public'and f['name']in names)]
assert len(helpers)==11
(o/'proposed-complete-native-prerequisites.json').write_text(json.dumps({'catalog':projection,'helpers':helpers},indent=2)+'\n',encoding='utf-8',newline='\n')
aligned=s/'task-11-fix3-baseline-1cea764774294eb6bc9c9c41edffbe85/complete-handoff-v2/aligned-metadata-differences.json'
a=json.loads(aligned.read_text());changed=a['catalogAligned'][1]['differences']['columns']['changed']
assert len(changed)==16 and sum(x['key'][1]=='supporter'for x in changed)==11
p={'status':'PROPOSAL_ONLY_PENDING_CONTROLLER_RULING','sourceUnchanged':'18c3c6ea06a25292b6e172e99cd381ed7d4409dc','actualRED':{'exit':3,'error':'55000 R01 finance complete prerequisite catalog differs','receipt':bind(v/'receipt.json'),'before':bind(v/'d45-baseline.json'),'after':bind(v/'after-rollback.json'),'stderr':bind(v/'command-0603.stderr.log')},'transportQualification':{'originalCombinedArchiveExists':False,'derivedAfterExecution':bind(o/'finance-transaction.postexecution-derived.source'),'exactArchivedExecutedDriver':bind(v/'i000.source'),'preboundFinance':bind(v/'i040.source'),'qualification':'Deterministic post-execution derivation from archived executed driver and prebound SQL, not an original pre-execution transport archive. ON_ERROR_STOP terminated at 55000; connection closure aborted transaction, literal trailing ROLLBACK not executed. Future GREEN must archive combined transport before execution.'},'proposedProfile':bind(o/'proposed-complete-native-prerequisites.json'),'exactChangedScope':['Task11-only supplemental full-native RED receipt/profile validator and portable tests','task-11-profile-inputs.json one separately named native prerequisite pointer retaining exact historical capture triple','task-11-generate.ts additional complete catalog/helper alternatives only; supplemental input/archive/source binding','regenerated finance migration from same five target definitions and same guards','owned final proof drivers: exact transport archive before launch; final packaging/report provenance'],'preserve':['Exact historical three assertCapture receipts, modes and cardinalities','All five old/new target alternatives exclusively existing historical triple','Existing Auth/native/index/shape alternatives unchanged','Unknown complete catalog/helper tuples rejected with 55000','All catalogue facets, ordering, complete helper tuples, body/definition/ownership/effective grants/defaults/native metadata','5352 scanner, full ten table closure, two manual actor fences and three system callback bodies','Historical archives immutable; existing Task1 partial source identified separately from held five-column repair; held Task8 proposal unapplied'],'strictSupplementalValidatorProposal':['Pin exact actual v6 raw receipt/capture hashes and verify all consumed raw source/archive bindings rather than infer a profile','Exact mode owned-full1711-d45-diagnostic, D45 baseline, source18 and actual PG17.11 runtime; pinned2.118 assembly qualification retained and no exact CI CLI identity','Error null; fullD45BaselineObserved/ownedRED/completeMetadataAfterRollbackPreserved/allTenRowsPreserved/protectedSourcesPreserved/all57CurrentInputsPreserved literal true','Exactly three managed jobs with exit0; exact182 D45 Git migrations and separately bound native transport; four normal cleanup records true; fullScannerPassed true/full10/fourreads','No production/deploy/operational/held repair flags; exact before/after and ten zero rows; finance actual exit3 and exact55000 raw stderr','Original v6 receipt has no requiredFinalFlags/failedFinalFlags: preserve it unchanged, bind a new supplemental qualification receipt with fixed literal flags and error:null/failed:[]; do not retroactively invent original fields','No new target/Auth/native/index/shape tuple; complete actual native helper array includes known component UID plus exact legacy supporter bump from D45 m0144'],'portableRegressionProposal':['Real bound v6 profile accepted; one-field mutations of source/hash/mode/flags/errors/cleanup/scanner/managed/migration/raw archive rejected','Complete catalogue/helper body/definition/ACL/order mutation remains ineligible, no normalization or generic waiver','Existing exact triple remains mandatory; supplemental data cannot inject target/Auth/native/index/shape alternatives','Generator emits exact additional full native catalog/helper tuple and unchanged five definition bytes; unknown tuple guards remain fail-closed'],'verificationProposedPendingAuthority':['Fresh uniquely owned native D45 environment, unchanged scanner before DML, archive exact transaction transport pre-execution','Two applies and immutable complete catalog/helper/Auth/ACL/native/index/shape preservation outside five targets, actual finance behavior and all14 refusals, zero rows/normal cleanup/protected source preservation','Fresh final hosted/modern/component compositions and four local gates against amended frozen bytes; SAME scoped reviewer; controller later fresh five CI and non-skipped actual full17.11 finance step'],'exactCountCorrection':'16 column ACL changes = five committed Task1 service columns plus eleven supporter columns; earlier 17/12 prose was incorrect. Additional supporter table ACL and donation fingerprint constraint differ. Helpers actual11/expected11, no missing/extra.'}
(o/'proposal.json').write_text(json.dumps(p,indent=2)+'\n',encoding='utf-8',newline='\n')
report=s/'task-11-fix3-diagnosis-report.md'
with report.open('a',encoding='utf-8',newline='\n')as f:f.write('\n\n## R56 v6 actual RED and source proposal (pending admission)\n\nActual driver exit0; managed3 exit0,182 D45 migrations exit0,unchanged5352 scanner PASS/full10. Unchanged finance exit3 at55000 complete prerequisite catalog differs. Complete before/after captures identical SHA9fcfed1ba69e1752c58110cc549ca90d0af74d66dddc014ee38cbd0aedcae603,ten rows zero and four normal cleanup records. Protected template/modern/current57 exact; source18 unchanged.\n\nThere was no pre-execution combined finance transaction archive. New post-execution derived bytes are explicitly qualified and bound to archived executed driver+i040; they are not an original transport archive. Literal trailing ROLLBACK did not run after ON_ERROR_STOP: connection closure aborted the failed transaction.\n\nExact v2 metadata count correction:16 column ACL changes (five committed Task1 service columns plus ELEVEN supporter columns), not earlier17/12. One supporter table ACL and fingerprint constraint also differ. V2 exact helper11/11 has no missing/extra functions.\n\nProposal only: task-11-fix3-v6-profile-proposal/proposal.json and proposed-complete-native-prerequisites.json. Add only the complete actual native catalogue/helper tuple through a separately qualified supplemental input, preserving historical triple and all five target/Auth/native/index/shape alternatives. No source/profile change admitted or performed. Native2.118 assembly qualification remains; CI CLI identity unknown. Future proof must archive transport before launch.\n')
print(json.dumps({'proposal':bind(o/'proposal.json'),'profile':bind(o/'proposed-complete-native-prerequisites.json'),'derivedTransport':bind(o/'finance-transaction.postexecution-derived.source'),'report':bind(report)}))
