import hashlib,json,pathlib,subprocess,time
root=pathlib.Path.cwd();scratch=root/'.superpowers/sdd/r01-forward-schema-plan-20261001';out=scratch/('task-11-fix3-codec-test-'+str(time.time_ns()));out.mkdir();paths=[pathlib.Path(__file__),scratch/'task-11-fix3-oid-codec.ts',scratch/'task-11-fix3-oid-codec.test.ts'];bindings=[]
for p in paths:
 raw=p.read_bytes();archive='i'+str(len(bindings))+'.source';(out/archive).write_bytes(raw);bindings.append({'path':str(p.relative_to(root)).replace('\\','/'),'archive':archive,'rawSha256':hashlib.sha256(raw).hexdigest(),'bytes':len(raw)})
command=['bun','test',str(scratch/'task-11-fix3-oid-codec.test.ts')];r=subprocess.run(command,capture_output=True);(out/'stdout.log').write_bytes(r.stdout);(out/'stderr.log').write_bytes(r.stderr);(out/'receipt.json').write_text(json.dumps({'command':command,'exit':r.returncode,'bindings':bindings,'stdoutSha256':hashlib.sha256(r.stdout).hexdigest(),'stderrSha256':hashlib.sha256(r.stderr).hexdigest()},indent=2)+'\n',encoding='utf-8',newline='\n');print(json.dumps({'out':str(out),'exit':r.returncode,'stdout':r.stdout.decode('utf-8',errors='replace'),'stderr':r.stderr.decode('utf-8',errors='replace')}));raise SystemExit(r.returncode)
