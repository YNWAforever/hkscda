begin read only;set local search_path=pg_catalog;select coalesce(jsonb_agg(to_jsonb(q)),'[]'::jsonb) from (select coalesce(jsonb_agg(jsonb_build_object('name',n.nspname||'.'||c.relname,'persistence',c.relpersistence,'rules',c.relhasrules,'rewrites',(select count(*) from pg_rewrite r where r.ev_class=c.oid)) order by n.nspname,c.relname),'[]'::jsonb) value from pg_class c join pg_namespace n on n.oid=c.relnamespace where c.oid in('auth.users'::regclass,'public.admin_user'::regclass,'public.supporter'::regclass,'public.donation'::regclass,'public.payment'::regclass,'public.receipt'::regclass,'public.receipt_sequence'::regclass,'public.audit_log'::regclass,'public.supporter_consent_intent'::regclass,'public.donation_delivery_job'::regclass))q;rollback;
