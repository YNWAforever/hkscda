def binding(path):
 raw=path.read_bytes();return{'path':str(path.relative_to(root)).replace('\\','/'),'rawSha256':hashlib.sha256(raw).hexdigest(),'canonicalLFSha256':hashlib.sha256(raw.replace(b'\r\n',b'\n')).hexdigest(),'rawGitBlob':hashlib.sha1(b'blob '+str(len(raw)).encode()+b'\0'+raw).hexdigest(),'bytes':len(raw)}
def read(path):
 raw=path.read_bytes();b=binding(path);b['archive']='i'+str(len(inputs)).zfill(3)+'.source';(target/b['archive']).write_bytes(raw);inputs.append(b);return raw
def differences(a,b,path=''):
 if type(a)!=type(b):return[{'path':path,'expected':a,'actual':b}]
 if isinstance(a,dict):return sum((differences(a.get(k),b.get(k),path+'/'+k)for k in sorted(set(a)|set(b))),[])
 if isinstance(a,list):
  if len(a)!=len(b):return[{'path':path,'expected':a,'actual':b,'expectedCount':len(a),'actualCount':len(b)}]
  return sum((differences(x,y,path+'/'+str(i))for i,(x,y)in enumerate(zip(a,b))),[])
 return[]if a==b else[{'path':path,'expected':a,'actual':b}]
