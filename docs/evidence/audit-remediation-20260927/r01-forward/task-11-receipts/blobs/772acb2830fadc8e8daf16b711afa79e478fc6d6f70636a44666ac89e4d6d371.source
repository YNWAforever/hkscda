 admitted=[json.loads(m.replace(b"''",b"'").decode())for m in re.findall(rb"'((?:[^']|'')*)'::jsonb",literals)];key={'R01 finance Auth prerequisite differs':'auth','R01 finance native prerequisite differs':'native','R01 finance indexes prerequisite differs':'indexes','R01 finance relation shapes prerequisite differs':'shapes','R01 finance complete helper tuples differ':'functions'}[label.decode()];actual=capture[key]if key!='functions'else[f for f in capture[key]if not(f['schema']=='public'and f['name']in names)];guards.append({'label':label.decode(),'actual':actual,'admitted':admitted,'differences':[differences(e,actual)for e in admitted]})
assert len(guards)==5,len(guards)
