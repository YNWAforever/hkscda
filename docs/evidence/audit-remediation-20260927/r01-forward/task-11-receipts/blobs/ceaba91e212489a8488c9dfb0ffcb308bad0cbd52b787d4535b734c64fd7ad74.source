{
  "statements": [
    "-- Admin identities remain readable according to RLS, but are changed only by\n-- server-side service-role operations. Browser JWTs cannot bypass access rules.\ndrop policy if exists \"admins can manage admin users\" on public.admin_user",
    "create policy \"admins can view admin users\"\n  on public.admin_user for select\n  to authenticated\n  using (private.has_admin_role(array['admin']))",
    "revoke insert, update, delete on public.admin_user from anon, authenticated",
    "-- A statement lock serializes all role/status updates and deletes, including\n-- service-role writes outside the application RPC. The row trigger checks the\n-- final statement state, so bulk writes cannot remove every active admin.\ncreate or replace function private.lock_admin_user_mutation()\nreturns trigger\nlanguage plpgsql\nsecurity definer\nset search_path = public, pg_temp\nas $$\nbegin\n  perform pg_advisory_xact_lock(hashtextextended('public.admin_user.active_admin', 0));\n  return null;\nend;\n$$",
    "create trigger lock_admin_user_mutation\n  before update or delete on public.admin_user\n  for each statement execute function private.lock_admin_user_mutation()",
    "create or replace function private.require_active_admin_user()\nreturns trigger\nlanguage plpgsql\nsecurity definer\nset search_path = public, pg_temp\nas $$\ndeclare\n  removed_active_admin boolean;\nbegin\n  if tg_op = 'DELETE' then\n    removed_active_admin := old.role = 'admin' and old.status = 'active';\n  else\n    removed_active_admin := old.role = 'admin' and old.status = 'active'\n      and (new.role <> 'admin' or new.status <> 'active');\n  end if;\n\n  if removed_active_admin and not exists (\n    select 1 from public.admin_user\n    where role = 'admin' and status = 'active'\n  ) then\n    raise exception 'last_active_admin' using errcode = 'P0001';\n  end if;\n  return null;\nend;\n$$",
    "create trigger require_active_admin_user\n  after update or delete on public.admin_user\n  for each row execute function private.require_active_admin_user()",
    "-- PostgREST invokes each RPC in one database transaction. The actor, current\n-- target state, mutation, and audit record are checked and written together.\ncreate or replace function public.update_admin_user_with_audit(\n  p_actor_user_id uuid,\n  p_target_id uuid,\n  p_role text default null,\n  p_status text default null\n)\nreturns public.admin_user\nlanguage plpgsql\nsecurity definer\nset search_path = public, pg_temp\nas $$\ndeclare\n  current_user_row public.admin_user%rowtype;\n  updated_user_row public.admin_user%rowtype;\n  next_role text;\n  next_status text;\n  audit_action text;\nbegin\n  perform pg_advisory_xact_lock(hashtextextended('public.admin_user.active_admin', 0));\n\n  if not exists (\n    select 1 from public.admin_user\n    where auth_user_id = p_actor_user_id and role = 'admin' and status = 'active'\n  ) then\n    raise exception 'admin_actor_denied' using errcode = 'P0001';\n  end if;\n\n  select * into current_user_row\n  from public.admin_user\n  where id = p_target_id\n  for update;\n  if not found then\n    raise exception 'admin_user_not_found' using errcode = 'P0001';\n  end if;\n\n  if p_role is null and p_status is null then\n    raise exception 'empty_admin_user_update' using errcode = 'P0001';\n  end if;\n  if p_role is not null and p_role not in ('staff', 'treasurer', 'admin') then\n    raise exception 'invalid_role' using errcode = 'P0001';\n  end if;\n  if p_status is not null and p_status not in ('pending', 'active', 'disabled') then\n    raise exception 'invalid_status' using errcode = 'P0001';\n  end if;\n\n  next_role := coalesce(p_role, current_user_row.role);\n  next_status := coalesce(p_status, current_user_row.status);\n\n  if current_user_row.auth_user_id = p_actor_user_id and p_role is not null\n     and p_role <> 'admin' then\n    raise exception 'self_demote' using errcode = 'P0001';\n  end if;\n  if current_user_row.auth_user_id = p_actor_user_id and p_status = 'disabled' then\n    raise exception 'self_disable' using errcode = 'P0001';\n  end if;\n  if p_status = 'pending' and current_user_row.status <> 'pending' then\n    raise exception 'invalid_status_transition' using errcode = 'P0001';\n  end if;\n  if current_user_row.status = 'pending' and p_status = 'active' then\n    raise exception 'invalid_status_transition' using errcode = 'P0001';\n  end if;\n\n  if current_user_row.role = 'admin' and current_user_row.status = 'active'\n     and (next_role <> 'admin' or next_status <> 'active')\n     and not exists (\n       select 1 from public.admin_user\n       where id <> p_target_id and role = 'admin' and status = 'active'\n     ) then\n    raise exception 'last_active_admin' using errcode = 'P0001';\n  end if;\n\n  audit_action := case\n    when p_role is not null and p_role <> current_user_row.role\n      then 'admin_user.role_update'\n    when p_status = 'disabled' and current_user_row.status <> 'disabled'\n      then 'admin_user.disable'\n    when p_status = 'active' and current_user_row.status = 'disabled'\n      then 'admin_user.reactivate'\n    else 'admin_user.update'\n  end;\n\n  update public.admin_user\n  set role = next_role, status = next_status\n  where id = p_target_id\n  returning * into updated_user_row;\n\n  insert into public.audit_log (\n    actor_user_id, action, entity, entity_id, timestamp, detail\n  ) values (\n    p_actor_user_id,\n    audit_action,\n    'admin_user',\n    p_target_id::text,\n    now(),\n    jsonb_build_object(\n      'targetEmail', current_user_row.email,\n      'oldRole', current_user_row.role,\n      'newRole', updated_user_row.role,\n      'oldStatus', current_user_row.status,\n      'newStatus', updated_user_row.status\n    )\n  );\n\n  return updated_user_row;\nend;\n$$",
    "revoke all on function public.update_admin_user_with_audit(uuid, uuid, text, text)\n  from public, anon, authenticated",
    "grant execute on function public.update_admin_user_with_audit(uuid, uuid, text, text)\n  to service_role",
    "-- Invitations keep the external Auth delivery step in the application, then\n-- commit the admin_user row and audit_log entry in one database transaction.\ncreate or replace function public.invite_admin_user_with_audit(\n  p_actor_user_id uuid,\n  p_auth_user_id uuid,\n  p_email text,\n  p_role text,\n  p_sent_at timestamptz\n)\nreturns public.admin_user\nlanguage plpgsql\nsecurity definer\nset search_path = public, pg_temp\nas $$\ndeclare\n  current_user_row public.admin_user%rowtype;\n  invited_user_row public.admin_user%rowtype;\nbegin\n  perform pg_advisory_xact_lock(hashtextextended('public.admin_user.active_admin', 0));\n\n  if not exists (\n    select 1 from public.admin_user\n    where auth_user_id = p_actor_user_id and role = 'admin' and status = 'active'\n  ) then\n    raise exception 'admin_actor_denied' using errcode = 'P0001';\n  end if;\n  if p_email is null or btrim(p_email) = '' then\n    raise exception 'invalid_email' using errcode = 'P0001';\n  end if;\n  if p_role is null or p_role not in ('staff', 'treasurer', 'admin') then\n    raise exception 'invalid_role' using errcode = 'P0001';\n  end if;\n  if p_auth_user_id is null or p_sent_at is null then\n    raise exception 'invalid_invite_input' using errcode = 'P0001';\n  end if;\n\n  select * into current_user_row\n  from public.admin_user\n  where email = p_email::citext\n  for update;\n\n  if found and current_user_row.status <> 'disabled' then\n    raise exception 'duplicate_admin_user' using errcode = 'P0001';\n  end if;\n\n  if found then\n    update public.admin_user\n    set auth_user_id = p_auth_user_id,\n        role = p_role,\n        status = 'pending',\n        invited_at = p_sent_at,\n        invite_sent_at = p_sent_at,\n        invite_accepted_at = null,\n        last_invited_by = p_actor_user_id\n    where id = current_user_row.id\n    returning * into invited_user_row;\n  else\n    insert into public.admin_user (\n      auth_user_id, email, role, status, invited_at, invite_sent_at,\n      invite_accepted_at, last_invited_by\n    ) values (\n      p_auth_user_id, p_email, p_role, 'pending', p_sent_at, p_sent_at,\n      null, p_actor_user_id\n    )\n    returning * into invited_user_row;\n  end if;\n\n  insert into public.audit_log (\n    actor_user_id, action, entity, entity_id, timestamp, detail\n  ) values (\n    p_actor_user_id,\n    'admin_user.invite',\n    'admin_user',\n    invited_user_row.id::text,\n    p_sent_at,\n    jsonb_build_object(\n      'targetEmail', invited_user_row.email,\n      'role', invited_user_row.role,\n      'status', invited_user_row.status\n    )\n  );\n\n  return invited_user_row;\nend;\n$$",
    "revoke all on function public.invite_admin_user_with_audit(uuid, uuid, text, text, timestamptz)\n  from public, anon, authenticated",
    "grant execute on function public.invite_admin_user_with_audit(uuid, uuid, text, text, timestamptz)\n  to service_role",
    "create or replace function public.resend_admin_invite_with_audit(\n  p_actor_user_id uuid,\n  p_target_id uuid,\n  p_sent_at timestamptz\n)\nreturns public.admin_user\nlanguage plpgsql\nsecurity definer\nset search_path = public, pg_temp\nas $$\ndeclare\n  current_user_row public.admin_user%rowtype;\n  resent_user_row public.admin_user%rowtype;\nbegin\n  perform pg_advisory_xact_lock(hashtextextended('public.admin_user.active_admin', 0));\n\n  if not exists (\n    select 1 from public.admin_user\n    where auth_user_id = p_actor_user_id and role = 'admin' and status = 'active'\n  ) then\n    raise exception 'admin_actor_denied' using errcode = 'P0001';\n  end if;\n  if p_sent_at is null then\n    raise exception 'invalid_invite_input' using errcode = 'P0001';\n  end if;\n\n  select * into current_user_row\n  from public.admin_user\n  where id = p_target_id\n  for update;\n  if not found then\n    raise exception 'admin_user_not_found' using errcode = 'P0001';\n  end if;\n  if current_user_row.status <> 'pending' then\n    raise exception 'invite_not_pending' using errcode = 'P0001';\n  end if;\n\n  update public.admin_user\n  set invite_sent_at = p_sent_at,\n      last_invited_by = p_actor_user_id\n  where id = p_target_id\n  returning * into resent_user_row;\n\n  insert into public.audit_log (\n    actor_user_id, action, entity, entity_id, timestamp, detail\n  ) values (\n    p_actor_user_id,\n    'admin_user.invite_resend',\n    'admin_user',\n    resent_user_row.id::text,\n    p_sent_at,\n    jsonb_build_object(\n      'targetEmail', resent_user_row.email,\n      'role', resent_user_row.role,\n      'status', resent_user_row.status\n    )\n  );\n\n  return resent_user_row;\nend;\n$$",
    "revoke all on function public.resend_admin_invite_with_audit(uuid, uuid, timestamptz)\n  from public, anon, authenticated",
    "grant execute on function public.resend_admin_invite_with_audit(uuid, uuid, timestamptz)\n  to service_role"
  ],
  "transactionMode": "transactional",
  "ownTransaction": false,
  "incompatible": false
}
