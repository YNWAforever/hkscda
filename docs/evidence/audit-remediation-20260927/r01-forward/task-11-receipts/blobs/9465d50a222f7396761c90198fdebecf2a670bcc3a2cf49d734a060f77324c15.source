 args=['gh','api','repos/supabase/cli/contents/apps/cli-go/'+path+'?ref='+ref];r=subprocess.run(args,capture_output=True);stem=ref+'-'+path.replace('/','_');(vendor/(stem+'.github.json')).write_bytes(r.stdout);(vendor/(stem+'.stderr.log')).write_bytes(r.stderr);commands.append({'command':args,'exit':r.returncode,'stdout':stem+'.github.json','stderr':stem+'.stderr.log'})
