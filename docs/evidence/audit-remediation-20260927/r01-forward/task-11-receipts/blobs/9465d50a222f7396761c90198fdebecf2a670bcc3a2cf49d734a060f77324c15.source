 (vendor/'receipt.json').write_text(json.dumps({'qualification':'Official source only. Pinned2.118 assembly reproduction perR55; actual CI unpinned bunx version not emitted. No baseline observation claimed.','commands':commands,'bindings':bindings},indent=2)+'\n',encoding='utf-8',newline='\n')
