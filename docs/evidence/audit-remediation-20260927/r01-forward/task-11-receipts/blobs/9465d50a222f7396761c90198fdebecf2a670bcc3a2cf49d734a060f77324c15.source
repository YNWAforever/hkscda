root=pathlib.Path.cwd();out=root/'.superpowers/sdd/r01-forward-schema-plan-20261001/task-11-fix3-diagnosis-1790974606735';vendor=out/'vendor';vendor.mkdir(exist_ok=True);commands=[];bindings=[]
paths=['internal/db/start/start.go','internal/db/start/templates/schema.sql','internal/db/start/templates/webhook.sql','internal/db/start/templates/_supabase.sql','pkg/config/storage.go','pkg/config/constants.go','pkg/config/config.go','pkg/config/auth.go']
