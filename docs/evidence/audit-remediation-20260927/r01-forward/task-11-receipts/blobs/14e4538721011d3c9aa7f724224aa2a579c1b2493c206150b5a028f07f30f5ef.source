import hashlib,json,pathlib,subprocess,time
root=pathlib.Path.cwd();scratch=root/'.superpowers/sdd/r01-forward-schema-plan-20261001';out=scratch/('task-11-fix3-typing-binding-'+str(time.time_ns()));out.mkdir();receipt={'out':str(out),'qualification':'Supplementary read-only probe interval with actual stdout/exits/runtime; prior probes/raw v5 retained. No owned environment launch or source/scanner amendment.','commands':[],'inputs':[],'error':None}
def sha(b):return hashlib.sha256(b).hexdigest()
def run(args):
 r=subprocess.run(args,capture_output=True);stem='command-'+str(len(receipt['commands']));(out/(stem+'.stdout.log')).write_bytes(r.stdout);(out/(stem+'.stderr.log')).write_bytes(r.stderr);receipt['commands'].append({'command':args,'exit':r.returncode,'stdout':stem+'.stdout.log','stderr':stem+'.stderr.log','stdoutSha256':sha(r.stdout),'stderrSha256':sha(r.stderr)});assert r.returncode==0,r.stderr.decode('utf-8',errors='replace');return r.stdout
try:
 for name in [pathlib.Path(__file__).name,'task-11-fix3-queries.ts','task-11-fix3-oid-type-probe.ts','task-11-fix3-expression-oid-probe.ts','task-11-fix3-operator-diagnosis.ts']:
  raw=(scratch/name).read_bytes();archive='i'+str(len(receipt['inputs']))+'.source';(out/archive).write_bytes(raw);receipt['inputs'].append({'path':str((scratch/name).relative_to(root)).replace('\\','/'),'archive':archive,'rawSha256':sha(raw),'bytes':len(raw)})
 receipt['protectedBefore']=json.loads(run(['bun',str(scratch/'task-11-fix3-queries.ts'),'states','unused',str(out)]));receipt['bunVersion']=run(['bun','--version']).decode().strip();receipt['scalarProbe']=json.loads(run(['bun',str(scratch/'task-11-fix3-oid-type-probe.ts')]));receipt['expressionProbe']=json.loads(run(['bun',str(scratch/'task-11-fix3-expression-oid-probe.ts')]));receipt['offlineDiagnosis']=json.loads(run(['bun',str(scratch/'task-11-fix3-operator-diagnosis.ts')]));receipt['protectedAfter']=json.loads(run(['bun',str(scratch/'task-11-fix3-queries.ts'),'states','unused',str(out)]));receipt['protectedSourcesPreserved']=receipt['protectedBefore']==receipt['protectedAfter'];assert receipt['protectedSourcesPreserved'];manifest=json.loads((root/'docs/evidence/audit-remediation-20260927/r01-forward/task-11-fix1-source-binding.json').read_text(encoding='utf-8'));receipt['all57CurrentInputsPreserved']=all(sha((root/b['path']).read_bytes())==b['rawSha256']for b in manifest['currentBindings']);assert receipt['all57CurrentInputsPreserved'];receipt['head']=run(['git','rev-parse','HEAD']).decode().strip();receipt['clean']=not run(['git','status','--porcelain']);assert receipt['clean']
except Exception as e:receipt['error']=str(e);raise
finally:(out/'receipt.json').write_text(json.dumps(receipt,indent=2)+'\n',encoding='utf-8',newline='\n');print(json.dumps({'out':str(out),'commands':len(receipt['commands']),'error':receipt['error'],'protectedSourcesPreserved':receipt.get('protectedSourcesPreserved'),'all57CurrentInputsPreserved':receipt.get('all57CurrentInputsPreserved')}))
