import{SQL}from'bun';import{readFileSync,writeFileSync,mkdirSync,copyFileSync}from'node:fs';import{resolve,join}from'node:path';import{createHash}from'node:crypto';
const out=resolve('.superpowers/sdd/r01-forward-schema-plan-20261001/task-11-fix3-expression-oid-probe-'+Date.now());mkdirSync(out);copyFileSync(import.meta.path,join(out,'executed.source'));
const source=readFileSync('supabase/rls-tests/helpers/productionSchemaClone.ts','utf8');writeFileSync(join(out,'unchanged-scanner.source'),source);const start=source.indexOf('`select pg_get_expr(d.adbin,d.adrelid) expression,array(');const end=source.indexOf('`,',start);if(start<0||end<start)throw Error('Exact expression-query extraction boundary differs');const template=source.slice(start,end+1);const scope=JSON.parse(readFileSync('.superpowers/sdd/r01-forward-schema-plan-20261001/task-11-fix3-diagnosis-1790974606735/queries.json','utf8')).fixtureScope;const qualified=scope.map((t:string)=>t.includes('.')?t:'public.'+t);writeFileSync(join(out,'exact-expression-query.ts'),'const qualified='+JSON.stringify(qualified)+';\nexport const query='+template+';\n');const{query}=await import(join(out,'exact-expression-query.ts'));writeFileSync(join(out,'wire-query.sql.source'),query);const jsonQuery="select coalesce(jsonb_agg(to_jsonb(q)),'[]'::jsonb) value from ("+query+')q';writeFileSync(join(out,'json-query.sql.source'),jsonQuery);
const sql=new SQL('postgresql://postgres:postgres@127.0.0.1:52322/audit_pr135_20260929');try{const actual=await sql.begin(async tx=>{await tx.unsafe('set transaction read only');await tx.unsafe('set local search_path=pg_catalog');const runtime=await tx.unsafe('select version() version,current_user actor,current_database() database');const wire=await tx.unsafe(query);const json=await tx.unsafe(jsonQuery);return{runtime,wire,json:json[0].value}});const receipt={out,qualification:'Read-only exact unchanged-scanner expression query on protected metadata; no helper or fixture execution. V5 stopped before this query and has no expression rows.',scope,actual,wireTypes:actual.wire.map((r:any)=>({array:Array.isArray(r.operatorOids),types:r.operatorOids.map((v:unknown)=>typeof v)})),jsonTypes:actual.json.map((r:any)=>({array:Array.isArray(r.operatorOids),types:r.operatorOids.map((v:unknown)=>typeof v)})),querySha256:createHash('sha256').update(query).digest('hex'),error:null};writeFileSync(join(out,'receipt.json'),JSON.stringify(receipt,null,2)+'\n');console.log(JSON.stringify({out,rows:actual.wire.length,wireElementTypes:[...new Set(receipt.wireTypes.flatMap((r:any)=>r.types))],jsonElementTypes:[...new Set(receipt.jsonTypes.flatMap((r:any)=>r.types))],runtime:actual.runtime,querySha256:receipt.querySha256,error:null}))}finally{await sql.close()}
