{
  "statements": [
    "-- T23 CRM follow-up owner only. Identity, consent, gifts and messages are untouched.\nalter table public.supporter\n  add column crm_assignee_user_id uuid references auth.users(id)",
    "-- Existing authenticated table-wide writes must not expose the new guarded\n-- assignment column. Preserve INSERT/UPDATE on every prior supporter column.\nrevoke insert, update on public.supporter from public, anon, authenticated",
    "do $$\ndeclare v_columns text;\nbegin\n  select string_agg(quote_ident(attname), ', ' order by attnum) into v_columns\n  from pg_attribute where attrelid='public.supporter'::regclass\n    and attnum>0 and not attisdropped and attname<>'crm_assignee_user_id';\n  execute format('grant insert (%s), update (%s) on public.supporter to authenticated',\n    v_columns, v_columns);\nend $$",
    "create index supporter_crm_assignee_active_idx\n  on public.supporter(crm_assignee_user_id) where deleted_at is null",
    "create table public.crm_assignment_bulk_operation (\n  id uuid primary key default gen_random_uuid(),\n  actor_user_id uuid not null references auth.users(id),\n  assignee_user_id uuid not null references auth.users(id),\n  filter_hash text not null check (filter_hash ~ '^[0-9a-f]{64}$'),\n  created_at timestamptz not null default now(),\n  expires_at timestamptz not null default (now() + interval '15 minutes')\n)",
    "create table public.crm_assignment_bulk_item (\n  operation_id uuid not null references public.crm_assignment_bulk_operation(id),\n  supporter_id uuid not null,\n  ordinal integer not null,\n  expected_version bigint,\n  before_assignee uuid,\n  after_assignee uuid,\n  status text not null check (status in ('pending','succeeded','skipped','conflict','failed')),\n  reason_code text,\n  applied_at timestamptz,\n  primary key(operation_id,supporter_id),\n  unique(operation_id,ordinal)\n)",
    "create index crm_assignment_bulk_operation_actor_idx\n  on public.crm_assignment_bulk_operation(actor_user_id,created_at desc)",
    "create index crm_assignment_bulk_item_pending_idx\n  on public.crm_assignment_bulk_item(operation_id,ordinal) where status='pending'",
    "alter table public.crm_assignment_bulk_operation enable row level security",
    "alter table public.crm_assignment_bulk_item enable row level security",
    "revoke all on public.crm_assignment_bulk_operation, public.crm_assignment_bulk_item\n  from public,anon,authenticated,service_role",
    "grant select on public.crm_assignment_bulk_operation, public.crm_assignment_bulk_item\n  to service_role",
    "create function private.require_crm_assignment_user(p_user uuid)\nreturns void language plpgsql security definer set search_path='' as $$\nbegin\n  perform 1 from public.admin_user a join auth.users u on u.id=a.auth_user_id\n  where a.auth_user_id=p_user and a.status='active'\n    and a.role in ('treasurer','admin')\n    and u.email_confirmed_at is not null\n    and (u.banned_until is null or u.banned_until<=now())\n  for share of a,u;\n  if not found then\n    raise exception 'CRM assignment user unavailable' using errcode='42501';\n  end if;\nend $$",
    "revoke all on function private.require_crm_assignment_user(uuid)\n  from public,anon,authenticated,service_role",
    "create function public.get_crm_assignment_bulk_operation(p_actor uuid,p_operation uuid)\nreturns jsonb language plpgsql security definer set search_path='' as $$\ndeclare\n  v_op public.crm_assignment_bulk_operation%rowtype;\n  v_items jsonb;\n  v_pending integer;\n  v_succeeded integer;\nbegin\n  perform private.require_crm_assignment_user(p_actor);\n  select * into v_op from public.crm_assignment_bulk_operation\n  where id=p_operation and actor_user_id=p_actor;\n  if not found then\n    raise exception 'CRM assignment operation unavailable' using errcode='42501';\n  end if;\n  select coalesce(jsonb_agg(jsonb_build_object(\n    'entityId',i.supporter_id,'status',i.status,'reasonCode',i.reason_code,\n    'expectedVersion',i.expected_version,'beforeAssignee',i.before_assignee,\n    'afterAssignee',i.after_assignee\n  ) order by i.ordinal),'[]'::jsonb),\n    count(*) filter(where i.status='pending'),\n    count(*) filter(where i.status='succeeded')\n  into v_items,v_pending,v_succeeded\n  from public.crm_assignment_bulk_item i where i.operation_id=p_operation;\n  return jsonb_build_object(\n    'operationId',v_op.id,'assigneeUserId',v_op.assignee_user_id,\n    'filterHash',v_op.filter_hash,'createdAt',v_op.created_at,\n    'expiresAt',v_op.expires_at,\n    'state',case when v_pending=0 then 'done'\n                 when v_succeeded=0 then 'queued' else 'partial' end,\n    'items',v_items\n  );\nend $$",
    "revoke all on function public.get_crm_assignment_bulk_operation(uuid,uuid)\n  from public,anon,authenticated",
    "grant execute on function public.get_crm_assignment_bulk_operation(uuid,uuid)\n  to service_role",
    "create function public.create_crm_assignment_bulk_preview(\n  p_actor uuid,p_ids uuid[],p_assignee uuid,p_filter_hash text\n)\nreturns jsonb language plpgsql security definer set search_path='' as $$\ndeclare\n  v_op uuid;\n  v_id uuid;\n  v_row public.supporter%rowtype;\n  v_status text;\n  v_reason text;\n  v_ordinal integer:=0;\nbegin\n  perform private.require_crm_assignment_user(p_actor);\n  perform private.require_crm_assignment_user(p_assignee);\n  if p_ids is null or cardinality(p_ids)<1 or cardinality(p_ids)>1000\n    or exists(select 1 from unnest(p_ids) id where id is null)\n    or (select count(distinct id) from unnest(p_ids) id)<>cardinality(p_ids)\n    or coalesce(p_filter_hash,'') !~ '^[0-9a-f]{64}$' then\n    raise exception 'Invalid CRM assignment preview' using errcode='22023';\n  end if;\n  insert into public.crm_assignment_bulk_operation(actor_user_id,assignee_user_id,filter_hash)\n  values(p_actor,p_assignee,p_filter_hash) returning id into v_op;\n  foreach v_id in array p_ids loop\n    v_ordinal:=v_ordinal+1;\n    select * into v_row from public.supporter where id=v_id;\n    if not found then v_status:='skipped';v_reason:='not_found';\n    elsif v_row.deleted_at is not null then v_status:='skipped';v_reason:='deleted';\n    elsif v_row.crm_assignee_user_id=p_assignee then\n      v_status:='skipped';v_reason:='already_assigned';\n    else v_status:='pending';v_reason:=null;\n    end if;\n    insert into public.crm_assignment_bulk_item(\n      operation_id,supporter_id,ordinal,expected_version,before_assignee,\n      after_assignee,status,reason_code\n    ) values(\n      v_op,v_id,v_ordinal,\n      case when v_status='pending' then v_row.edit_version else null end,\n      v_row.crm_assignee_user_id,\n      case when v_status='pending' then p_assignee else v_row.crm_assignee_user_id end,\n      v_status,v_reason\n    );\n  end loop;\n  insert into public.audit_log(actor_user_id,action,entity,entity_id,detail)\n  values(p_actor,'crm_assignment_bulk.preview','crm_assignment_bulk_operation',v_op::text,\n    jsonb_build_object('assigneeUserId',p_assignee,'filterHash',p_filter_hash,\n                       'selectionCount',cardinality(p_ids)));\n  return public.get_crm_assignment_bulk_operation(p_actor,v_op);\nend $$",
    "revoke all on function public.create_crm_assignment_bulk_preview(uuid,uuid[],uuid,text)\n  from public,anon,authenticated",
    "grant execute on function public.create_crm_assignment_bulk_preview(uuid,uuid[],uuid,text)\n  to service_role",
    "create function public.apply_crm_assignment_bulk_item(\n  p_actor uuid,p_operation uuid,p_supporter uuid\n)\nreturns jsonb language plpgsql security definer set search_path='' as $$\ndeclare\n  v_op public.crm_assignment_bulk_operation%rowtype;\n  v_item public.crm_assignment_bulk_item%rowtype;\n  v_row public.supporter%rowtype;\n  v_new_version bigint;\n  v_status text;\n  v_reason text;\nbegin\n  perform private.require_crm_assignment_user(p_actor);\n  select * into v_op from public.crm_assignment_bulk_operation\n  where id=p_operation and actor_user_id=p_actor for update;\n  if not found then\n    raise exception 'CRM assignment operation unavailable' using errcode='42501';\n  end if;\n  perform private.require_crm_assignment_user(v_op.assignee_user_id);\n  if v_op.expires_at<=pg_catalog.clock_timestamp() then\n    raise exception 'CRM assignment snapshot expired' using errcode='P0001';\n  end if;\n  select * into v_item from public.crm_assignment_bulk_item\n  where operation_id=p_operation and supporter_id=p_supporter for update;\n  if not found then\n    raise exception 'CRM assignment item unavailable' using errcode='42501';\n  end if;\n  if v_item.status<>'pending' then\n    return jsonb_build_object('entityId',p_supporter,'status',v_item.status,\n                              'reasonCode',v_item.reason_code);\n  end if;\n  select * into v_row from public.supporter where id=p_supporter for update;\n  if v_op.expires_at<=pg_catalog.clock_timestamp() then\n    raise exception 'CRM assignment snapshot expired' using errcode='P0001';\n  end if;\n  if not found or v_row.deleted_at is not null then\n    v_status:='skipped';v_reason:='unavailable';\n  elsif v_row.edit_version is distinct from v_item.expected_version\n    or v_row.crm_assignee_user_id is distinct from v_item.before_assignee then\n    v_status:='conflict';v_reason:='version_changed';\n  else\n    update public.supporter set crm_assignee_user_id=v_op.assignee_user_id\n    where id=p_supporter returning edit_version into v_new_version;\n    insert into public.audit_log(actor_user_id,action,entity,entity_id,detail)\n    values(p_actor,'supporter.assign_crm_followup','supporter',p_supporter::text,\n      jsonb_build_object('operationId',p_operation,\n        'beforeAssigneeUserId',v_item.before_assignee,\n        'afterAssigneeUserId',v_op.assignee_user_id,\n        'expectedVersion',v_item.expected_version,'newVersion',v_new_version));\n    v_status:='succeeded';v_reason:=null;\n  end if;\n  update public.crm_assignment_bulk_item\n  set status=v_status,reason_code=v_reason,applied_at=clock_timestamp()\n  where operation_id=p_operation and supporter_id=p_supporter;\n  if v_status<>'succeeded' then\n    insert into public.audit_log(actor_user_id,action,entity,entity_id,detail)\n    values(p_actor,'crm_assignment_bulk.item_result','crm_assignment_bulk_item',p_supporter::text,\n      jsonb_build_object('operationId',p_operation,'status',v_status,\n                         'reasonCode',v_reason));\n  end if;\n  return jsonb_build_object('entityId',p_supporter,'status',v_status,\n                            'reasonCode',v_reason);\nend $$",
    "revoke all on function public.apply_crm_assignment_bulk_item(uuid,uuid,uuid)\n  from public,anon,authenticated",
    "grant execute on function public.apply_crm_assignment_bulk_item(uuid,uuid,uuid)\n  to service_role",
    "create function public.list_crm_assignment_assignees(p_actor uuid)\nreturns jsonb language plpgsql security definer set search_path='' as $$\nbegin\n  perform private.require_crm_assignment_user(p_actor);\n  return (\n    select coalesce(jsonb_agg(jsonb_build_object(\n      'authUserId',eligible.auth_user_id,'email',eligible.email,'role',eligible.role\n    ) order by eligible.email),'[]'::jsonb)\n    from (\n      select a.auth_user_id,a.email,a.role\n      from public.admin_user a join auth.users u on u.id=a.auth_user_id\n      where a.status='active' and a.role in ('treasurer','admin')\n        and u.email_confirmed_at is not null\n        and (u.banned_until is null or u.banned_until<=now())\n      order by a.email limit 1000\n    ) eligible\n  );\nend $$",
    "revoke all on function public.list_crm_assignment_assignees(uuid)\n  from public,anon,authenticated",
    "grant execute on function public.list_crm_assignment_assignees(uuid)\n  to service_role"
  ],
  "transactionMode": "transactional",
  "ownTransaction": false,
  "incompatible": false
}
