 b=p.read_bytes();return {'path':p.as_posix(),'rawSha256':sha(b),'canonicalSha256':sha(b.replace(b'\r\n',b'\n')),'bytes':len(b),'rawGitBlob':hashlib.sha1(b'blob '+str(len(b)).encode()+b'\0'+b).hexdigest()}
source=[]
for folder in ['task-11-fix3-native-integration-d774592d308c406995319b830ac9eade','task-11-fix3-native-integration-86d10b772bdb48dfa016dd2ebd784746']:
 p=s/folder;r=json.loads((p/'receipt.json').read_text(encoding='utf-8'));b=[x for x in r['inputBindings']if x['label']=='exact-existing-refusal-source'];assert len(b)==1;archive=p/b[0]['archive'];assert bound(archive)['rawSha256']==b[0]['rawSha256'];source.append(archive)
