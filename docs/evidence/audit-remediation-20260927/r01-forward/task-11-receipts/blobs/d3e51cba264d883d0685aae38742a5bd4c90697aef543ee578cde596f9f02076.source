+await mkdir(out,{recursive:true});const sha=(b:Buffer)=>createHash("sha256").update(b).digest("hex");const bindings:Record<string,unknown>={};
+for(const [i,p]of paths.entries()){const b=await readFile(p);const proc=Bun.spawn(["git","hash-object","--no-filters",p],{stdout:"pipe",stderr:"pipe"});const [blob,err,exit]=await Promise.all([new Response(proc.stdout).text(),new Response(proc.stderr).text(),proc.exited]);if(exit||err)throw Error("Binding failed "+p);bindings[p]={rawSha256:sha(b),canonicalSha256:hash(b.toString().replaceAll("\r\n","\n")),rawGitBlob:blob.trim(),rawBytes:b.length,archive:"s"+i+".source"};await copyFile(p,resolve(out,"s"+i+".source"));}
+const actualSource=await readFile(source,"utf8");if(hash(actualSource)!=="b1afa5d56a9a5793ae7dc618479fd997b74d635093dd3f5eb2a7ea2b3af7ab77")throw Error("Independently captured official source provenance differs");
+const sourceObject=JSON.parse(actualSource),vendorObject=JSON.parse(await readFile(vendor,"utf8"));
