+const r:Record<string,unknown>={receiptType:"component-red",mode:"component",out,at:new Date().toISOString(),bindings,sourceBase:"d45b849d300f76700efcf5450a9b426e32cc372f",qualification:"Own PG17.6 component uses independently bound actual17.11/Auth LF SQL; not full17.11 CI bootstrap",requiredFinalFlags,error:null,failedFinalFlags:[],task1Applied:false,task8Applied:false};
+let c:Awaited<ReturnType<typeof createProductionClone>>|undefined;let modernBefore:string|undefined;const modern="postgresql://postgres:postgres@127.0.0.1:57322/postgres";
+try{modernBefore=await localSourceState(modern);const cap=await captureModernLocalSchema();c=await createProductionClone(cap);const db=c.sql;r.clone=c.name;r.schemaParity=true;r.zeroApplicationTables=c.tableCount;await assertSafeFixtureTables(db,fixtureScope);r.fullScannerPassed=true;
+for(const [f,h]of dependencies){const b=await readFile(resolve("supabase/migrations",f));if(sha(b)!==h)throw Error("Dependency bytes differ "+f);await db.begin(async tx=>{await tx`set local role postgres`;await tx.unsafe(b.toString());});}r.dependenciesBound=true;
+const extra=async(sql:typeof db)=>({auth:(await sql.unsafe(authQuery))[0].value,native:(await sql.unsafe(nativeQuery))[0].value,indexes:(await sql.unsafe(indexDetailsQuery))[0].value,shapes:(await sql.unsafe(shapesQuery))[0].value});
+const candidate=await readFile(migration,"utf8"),rollback=new Error("Own component rollback");
+try{await db.begin(async tx=>{await tx`set local role postgres`;await tx.unsafe(candidate);r.baselineAccepted=true;throw rollback;});}catch(e){if(e!==rollback)throw e;}
+const before=await snapshot(db),beforeFunctions=await db.unsafe(functionsQuery),beforeExtra=await extra(db);r.beforeCatalog=before;r.beforeFunctions=beforeFunctions;r.beforeExtra=beforeExtra;
