ion_receipts_with_audit','issue_receipt_with_audit','issue_receipt')) order by n.nspname,p.proname,pg_get_function_identity_arguments(p.oid)) f where f.schema='public' and f.name='fail_pending_provider_payment';
+ if v_actual not in('[{"schema":"public","name":"fail_pending_provider_payment","args":"p_payment_id uuid, p_donation_id uuid","allargs":"p_payment_id uuid, p_donation_id uuid","defaults":0,"default_expression":null,"result":"jsonb","owner":"postgres","acl":"{postgres=X/postgres,service_role=X/postgres}","full_acl":[{"grantee":"postgres","grantor":"postgres","grantable":false,"privilege":"EXECUTE"},{"grantee":"service_role","grantor":"postgres","grantable":false,"privilege":"EXECUTE"}],"config":["search_path=\"\""],"definer":false,"language":"plpgsql","kind":"f","cost":100,"rows":0,"strict":false,"leakproof":false,"parallel":"u","volatility":"v","support":"-","variadic":"-","modes":null,"body":"9205a027706d421c2187bcd94e126c60","definition":"06f2f9af819d0165d2ddb3ca51773502"}]'::jsonb) then
+ execute $definition$create or replace function public.fail_pending_provider_payment(
+  p_payment_id uuid,
+  p_donation_id uuid
+)
+returns jsonb
+language plpgsql
+security invoker
+set search_path = ''
+as $$
+declare
+  v_payment public.payment%rowtype;
+  v_donation public.donation%rowtype;
+  v_now timestamptz;
+begin
+  if p_payment_id is null or p_donation_id is null then
+    raise exception 'missing payment or donation id' using errcode = '22023';
+  end if;
+
+  select * into v_payment
+  from public.payment
+  where id = p_payment_id
+  for update;
+  if not found or v_payment.donation_id <> p_donation_id then
+    return jsonb_build_object('kind', 'not_found');
+  end if;
+
+  select * into v_donation
+  from public.donation
+  where id = p_donation_id
+  for update;
+  if not found then
+    return jsonb_build_object('kind', 'not_found');
+  end if;
+
+  if v_payment.status not in ('pending', 'failed')
+     or v_donation.status not in ('pending', 'failed') then
+    return jsonb_build_object(
+      'kind', 'state_conflict',
+      'payment_status', v_payment.status,
+      'donation_status', v_donation.status
+    );
+  end if;
+
+  if v_payment.status = 'failed' and v_donation.status = 'failed' then
+    return jsonb_build_object('kind', 'already_failed');
+  end if;
+
+  v_now := clock_timestamp();
+  update public.payment
+  set status = 'failed', updated_at = v_now
+  where id = p_payment_id and status = 'pending';
+
+  update public.donation
+  set status = 'failed', updated_at = v_now
+  where id = p_donation_id and status = 'pending';
+
+  return jsonb_build_object('kind', 'failed');
+end;
+$$;
+revoke all on function public.fail_pending_provider_payment(uuid,uuid) from public,anon,authenticated,service_role;
+grant execute on function public.fail_pending_provider_payment(uuid,uuid) to service_role;
+$definition$;
+ end if;
+ select coalesce(pg_catalog.jsonb_agg(to_jsonb(f) order by f.schema,f.name,f.args),'[]'::jsonb) into v_actual from (select n.nspname schema,p.proname name,pg_get_function_identity_arguments(p.oid) args,pg_get_function_arguments(p.oid) allargs,p.pronargdefaults defaults,pg_get_expr(p.proargdefaults,0) default_expression,pg_get_function_result(p.oid) result,pg_get_userbyid(p.proowner) owner,p.proacl::text acl,(select jsonb_agg(jsonb_build_object('grantor',pg_get_userbyid(a.grantor),'grantee',case when a.grantee=0 then 'PUBLIC' else pg_get_userbyid(a.grantee) end,'privilege',a.privilege_type,'grantable',a.is_grantable) order by pg_get_userbyid(a.grantor),case when a.grantee=0 then 'PUBLIC' else pg_get_userbyid(a.grantee) end,a.privilege_type) from aclexplode(coalesce(p.proacl,acldefault('f',p.proowner))) a) full_acl,p.proconfig config,p.prosecdef definer,l.lanname language,p.prokind kind,p.procost cost,p.prorows rows,p.proisstrict strict,p.proleakproof leakproof,p.proparallel parallel,p.provolatile volatility,p.prosupport::text support,p.provariadic::regtype::text variadic,p.proargmodes modes,md5(p.prosrc) body,md5(pg_get_functiondef(p.oid)) definition from pg_proc p join pg_namespace n on n.oid=p.pronamespace join pg_language l on l.oid=p.prolang where p.oid in(select t.tgfoid from pg_trigger t where t.tgrelid in('auth.users'::regclass,'public.admin_user'::regclass,'public.supporter'::regclass,'public.donation'::regclass,'public.payment'::regclass,'public.receipt'::regclass,'public.receipt_sequence'::regclass,'public.audit_log'::regclass,'public.supporter_consent_intent'::regclass,'public.donation_delivery_job'::regclass) and not t.tgisinternal) or (n.nspname='auth' and p.proname='uid') or(n.nspname='private' and p.proname in('has_admin_role','allocate_receipt_number','lock_admin_user_mutation','require_active_admin_user')) or(n.nspname='public' and p.proname in('fail_pending_provider_payment','refund_provider_payment_atomically','void_receipt_with_audit','void_donation_receipts_with_audit','issue_receipt_with_audit','issue_receipt')) order by n.nspname,p.proname,pg_get_function_identity_arguments(p.oid)) f where f.schema='public' and f.name='refund_provider_payment_atomically';
+ if v_actual not in('[{"schema":"public","name":"refund_provider_payment_atomically","args":"p_payment_id uuid, p_donation_id uuid","allargs":"p_payment_id uuid, p_donation_id uuid","defaults":0,"default_expression":null,"result":"jsonb","owner":"postgres","acl":"{postgres=X/postgres,service_role=X/postgres}","full_acl":[{"grantee":"postgres","grantor":"postgres","grantable":false,"privilege":"EXECUTE"},{"grantee":"service_role","grantor":"postgres","grantable":false,"privilege":"EXECUTE"}],"config":["search_path=\"\""],"definer":false,"language":"plpgsql","kind":"f","cost":100,"rows":0,"strict":false,"leakproof":false,"parallel":"u","volatility":"v","support":"-","variadic":"-","modes":null,"body":"3fa99e019f6b4e4f44fc9dd1936ae3c9","definition":"8bf99eb5cec11a980cfcd27c2b16bc15"}]'::jsonb) then
+ execute $definition$create or replace function public.refund_provider_payment_atomically(
+  p_payment_id uuid,
+  p_donation_id uuid
+)
+returns jsonb
+language plpgsql
+security invoker
+set search_path = ''
+as $$
+declare
+  v_payment public.payment%rowtype;
+  v_donation public.donation%rowtype;
+  v_now timestamptz;
+begin
+  if p_payment_id is null or p_donation_id is null then
+    raise exception 'missing payment or donation id' using errcode = '22023';
+  end if;
+
+  select * into v_payment
+  from public.payment
+  where id = p_payment_id
+  for update;
+  if not found or v_payment.donation_id <> p_donation_id then
+    return jsonb_build_object('kind', 'not_found');
+  end if;
+
+  select * into v_donation
+  from public.donation
+  where id = p_donation_id
+  for update;
+  if not found then
+    return jsonb_build_object('kind', 'not_found');
+  end if;
+
+  if v_payment.status not in ('pending', 'succeeded', 'refunded')
+     or v_donation.status not in ('pending', 'succeeded', 'refunded') then
+    return jsonb_build_object(
+      'kind', 'state_conflict',
+      'payment_status', v_payment.status,
+      'donation_status', v_donation.status
+    );
+  end if;
+
+  if v_payment.status = 'refunded' and v_donation.status = 'refunded' then
+    return jsonb_build_object('kind', 'already_refunded');
+  end if;
+
+  v_now := clock_timestamp();
+  update public.payment
+  set status = 'refunded', updated_at = v_now
+  where id = p_payment_id and status in ('pending', 'succeeded');
+
+  update public.donation
+  set status = 'refunded', updated_at = v_now
+  where id = p_donation_id and status in ('pending', 'succeeded');
+
+  return jsonb_build_object('kind', 'refunded');
+end;
+$$;
+revoke all on function public.refund_provider_payment_atomically(uuid,uuid) from public,anon,authenticated,service_role;
+grant execute on function public.refund_provider_payment_atomically(uuid,uuid) to service_role;
+$definition$;
+ end if;
+ select coalesce(pg_catalog.jsonb_agg(to_jsonb(f) order by f.schema,f.name,f.args),'[]'::jsonb) into v_actual from (select n.nspname schema,p.proname name,pg_get_function_identity_arguments(p.oid) args,pg_get_function_arguments(p.oid) allargs,p.pronargdefaults defaults,pg_get_expr(p.proargdefaults,0) default_expression,pg_get_function_result(p.oid) result,pg_get_userbyid(p.proowner) owner,p.proacl::text acl,(select jsonb_agg(jsonb_build_object('grantor',pg_get_userbyid(a.grantor),'grantee',case when a.grantee=0 then 'PUBLIC' else pg_get_userbyid(a.grantee) end,'privilege',a.privilege_type,'grantable',a.is_grantable) order by pg_get_userbyid(a.grantor),case when a.grantee=0 then 'PUBLIC' else pg_get_userbyid(a.grantee) end,a.privilege_type) from aclexplode(coalesce(p.proacl,acldefault('f',p.proowner))) a) full_acl,p.proconfig config,p.prosecdef definer,l.lanname language,p.prokind kind,p.procost cost,p.prorows rows,p.proisstrict strict,p.proleakproof leakproof,p.proparallel parallel,p.provolatile volatility,p.prosupport::text support,p.provariadic::regtype::text variadic,p.proargmodes modes,md5(p.prosrc) body,md5(pg_get_functiondef(p.oid)) definition from pg_proc p join pg_namespace n on n.oid=p.pronamespace join pg_language l on l.oid=p.prolang where p.oid in(select t.tgfoid from pg_trigger t where t.tgrelid in('auth.users'::regclass,'public.admin_user'::regclass,'public.supporter'::regclass,'public.donation'::regclass,'public.payment'::regclass,'public.receipt'::regclass,'public.receipt_sequence'::regclass,'public.audit_log'::regclass,'public.supporter_consent_intent'::regclass,'public.donation_delivery_job'::regclass) and not t.tgisinternal) or (n.nspname='auth' and p.proname='uid') or(n.nspname='private' and p.proname in('has_admin_role','allocate_receipt_number','lock_admin_user_mutation','require_active_admin_user')) or(n.nspname='public' and p.proname in('fail_pending_provider_payment','refund_provider_payment_atomically','void_receipt_with_audit','void_donation_receipts_with_audit','issue_receipt_with_audit','issue_receipt')) order by n.nspname,p.proname,pg_get_function_identity_arguments(p.oid)) f where f.schema='public' and f.name='void_receipt_with_audit';
+ if v_actual not in('[{"schema":"public","name":"void_receipt_with_audit","args":"p_receipt_id uuid, p_actor uuid, p_supporter_id uuid","allargs":"p_receipt_id uuid, p_actor uuid, p_supporter_id uuid DEFAULT NULL::uuid","defaults":1,"default_expression":"NULL::uuid","result":"TABLE(receipt_id uuid, pdf_url text)","owner":"postgres","acl":"{postgres=X/postgres,service_role=X/postgres}","full_acl":[{"grantee":"postgres","grantor":"postgres","grantable":false,"privilege":"EXECUTE"},{"grantee":"service_role","grantor":"postgres","grantable":false,"privilege":"EXECUTE"}],"config":["search_path=\"\""],"definer":true,"language":"plpgsql","kind":"f","cost":100,"rows":1000,"strict":false,"leakproof":false,"parallel":"u","volatility":"v","support":"-","variadic":"-","modes":["i","i","i","t","t"],"body":"c120cd972f5c6bcb9ad822b1e61b1168","definition":"6e159b4b6d2b50514401d99e3dd54b7b"}]'::jsonb) then
+ execute $definition$create or replace function public.void_receipt_with_audit(
+  p_receipt_id uuid,
+  p_actor uuid,
+  p_supporter_id uuid default null
+)
+returns table (receipt_id uuid, pdf_url text)
+language plpgsql
+security definer
+set search_path = ''
+as $$
+declare
+  v_receipt public.receipt%rowtype;
+  v_voided_at timestamptz;
+begin
+  perform 1 from auth.users u
+  where u.id = p_actor
+    and u.email_confirmed_at is not null
+    and (u.banned_until is null or u.banned_until <= pg_catalog.clock_timestamp())
+  for share;
+  if not found then
+    raise exception 'receipt_void_admin_required' using errcode = '42501';
+  end if;
+
+  perform 1 from public.admin_user a
+  where a.auth_user_id = p_actor
+    and a.status = 'active'
+    and a.role in ('treasurer', 'admin')
+  for share;
+  if not found then
+    raise exception 'receipt_void_admin_required' using errcode = '42501';
+  end if;
+
+  select * into v_receipt
+  from public.receipt
+  where id = p_receipt_id
+  for update;
+  if not found or v_receipt.status <> 'issued' then
+    raise exception 'receipt_not_issued' using errcode = '22023';
+  end if;
+  if p_supporter_id is not null and p_supporter_id <> v_receipt.supporter_id then
+    raise exception 'receipt_supporter_mismatch' using errcode = '22023';
+  end if;
+
+  v_voided_at := pg_catalog.clock_timestamp();
+  update public.receipt
+  set status = 'void', voided_at = v_voided_at, voided_by = p_actor
+  where id = v_receipt.id;
+
+  insert into public.audit_log(actor_user_id, action, entity, entity_id, detail)
+  values (
+    p_actor, 'receipt.void', 'receipt', v_receipt.id::text,
+    pg_catalog.jsonb_build_object(
+      'voidedAt', v_voided_at,
+      'supporterId', v_receipt.supporter_id,
+      'reason', 'manual'
+    )
+  );
+
+  return query select v_receipt.id, v_receipt.pdf_url;
+end;
+$$;
+revoke all on function public.void_receipt_with_audit(uuid,uuid,uuid) from public,anon,authenticated,service_role;
+grant execute on function public.void_receipt_with_audit(uuid,uuid,uuid) to service_role;
+$definition$;
+ end if;
