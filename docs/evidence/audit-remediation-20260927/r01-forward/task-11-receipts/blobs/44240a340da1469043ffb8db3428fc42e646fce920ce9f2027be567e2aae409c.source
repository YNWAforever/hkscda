{
  "statements": [
    "-- R01 Task 2: missing hosted adoption upload/retry objects only.\n-- Existing reviewed modern objects are validated and preserved, never replaced.\n-- Run as postgres in the migration transaction; no Storage/provider operation.\nset local search_path = ''",
    "do $migration$\ndeclare\n  v_table oid;\n  v_existing_intent boolean;\n  v_function oid;\n  v_column record;\n  v_constraint record;\n  v_expected text;\n  v_body text := $body$\ndeclare\n  v_intent public.adoption_upload_intent%rowtype;\nbegin\n  select * into v_intent\n  from public.adoption_upload_intent\n  where application_id = p_application_id\n  for update;\n\n  if not found or v_intent.submitted_at is not null\n    or v_intent.expires_at >= pg_catalog.clock_timestamp() - interval '1 hour' then\n    return 'defer';\n  end if;\n\n  -- The parent lock coordinates with the case insertion's FK key-share lock.\n  perform 1\n  from public.adoption_applications\n  where id = p_application_id\n  for update;\n\n  if found then\n    if exists (\n      select 1 from public.adoption_case\n      where public_application_id = p_application_id\n    ) then\n      return 'completed';\n    end if;\n\n    delete from public.adoption_applications where id = p_application_id;\n  end if;\n\n  -- Keep the intent until the caller confirms successful Storage deletion.\n  return 'purged';\nend;\n$body$;\nbegin\n  if current_user <> 'postgres' then\n    raise exception 'R01 adoption migration requires postgres owner context' using errcode = '55000';\n  end if;\n\n  -- This exact existing FK/unique pairing is essential to parent/case locking.\n  if not exists (\n    select 1 from pg_catalog.pg_constraint\n    where conrelid = 'public.adoption_case'::pg_catalog.regclass\n      and confrelid = 'public.adoption_applications'::pg_catalog.regclass\n      and conname = 'adoption_case_public_application_id_fkey'\n      and contype = 'f' and confdeltype = 'n' and convalidated\n      and pg_catalog.pg_get_constraintdef(oid, true) =\n        'FOREIGN KEY (public_application_id) REFERENCES public.adoption_applications(id) ON DELETE SET NULL'\n  ) or not exists (\n    select 1 from pg_catalog.pg_constraint\n    where conrelid = 'public.adoption_case'::pg_catalog.regclass\n      and conname = 'adoption_case_public_application_id_key'\n      and contype = 'u' and convalidated\n      and pg_catalog.pg_get_constraintdef(oid, true) = 'UNIQUE (public_application_id)'\n  ) then\n    raise exception 'R01 adoption parent/case coordination prerequisites differ' using errcode = '55000';\n  end if;\n\n  v_table := pg_catalog.to_regclass('public.adoption_upload_intent');\n  v_existing_intent := v_table is not null;\n  if v_table is null then\n    create table public.adoption_upload_intent (\n      application_id uuid primary key,\n      photo_paths text[] not null check (pg_catalog.cardinality(photo_paths) between 1 and 6),\n      status_token_hash text not null unique check (status_token_hash ~ '^[0-9a-f]{64}$'),\n      created_at timestamptz not null default pg_catalog.now(),\n      expires_at timestamptz not null,\n      submitted_at timestamptz,\n      constraint adoption_upload_intent_expiry_after_creation check (expires_at > created_at)\n    );\n    alter table public.adoption_upload_intent enable row level security;\n    revoke all on public.adoption_upload_intent from public, anon, authenticated, service_role;\n    grant select, insert, update, delete on public.adoption_upload_intent to service_role;\n    create index adoption_upload_intent_cleanup_idx\n      on public.adoption_upload_intent (expires_at) where submitted_at is null;\n    v_table := 'public.adoption_upload_intent'::pg_catalog.regclass;\n  end if;\n\n  if not exists (\n    select 1 from pg_catalog.pg_class\n    where oid = v_table and relkind = 'r' and relrowsecurity and not relforcerowsecurity\n      and pg_catalog.pg_get_userbyid(relowner) = 'postgres'\n  ) or exists (select 1 from pg_catalog.pg_policy where polrelid = v_table)\n    or exists (select 1 from pg_catalog.pg_trigger where tgrelid = v_table and not tgisinternal) then\n    raise exception 'R01 adoption intent owner/RLS/policy/trigger differs' using errcode = '55000';\n  end if;\n  if (select count(*) from pg_catalog.pg_attribute where attrelid = v_table and attnum > 0 and not attisdropped) <> 6 then\n    raise exception 'R01 adoption intent column set differs' using errcode = '55000';\n  end if;\n  for v_column in\n    select a.attname, pg_catalog.format_type(a.atttypid, a.atttypmod) as type,\n      a.attnotnull, a.attidentity, a.attgenerated, a.attacl, a.attnum,\n      pg_catalog.pg_get_expr(d.adbin, d.adrelid) as default_expression\n    from pg_catalog.pg_attribute a\n    left join pg_catalog.pg_attrdef d on d.adrelid = a.attrelid and d.adnum = a.attnum\n    where a.attrelid = v_table and a.attnum > 0 and not a.attisdropped\n  loop\n    v_expected := case v_column.attname\n      when 'application_id' then 'uuid'\n      when 'photo_paths' then 'text[]'\n      when 'status_token_hash' then 'text'\n      when 'created_at' then 'timestamp with time zone'\n      when 'expires_at' then 'timestamp with time zone'\n      when 'submitted_at' then 'timestamp with time zone' end;\n    if v_expected is null or v_column.type <> v_expected\n      or v_column.attnum <> array_position(array['application_id','photo_paths','status_token_hash','created_at','expires_at','submitted_at'], v_column.attname::text)\n      or v_column.attnotnull <> (v_column.attname <> 'submitted_at')\n      or v_column.attidentity <> '' or v_column.attgenerated <> ''\n      or v_column.attacl is not null\n      or v_column.default_expression is distinct from (case when v_column.attname = 'created_at' then 'now()' else null end) then\n      raise exception 'R01 adoption intent column definition differs: %', v_column.attname using errcode = '55000';\n    end if;\n  end loop;\n\n  if (select count(*) from pg_catalog.pg_constraint where conrelid = v_table) <> 5 then\n    raise exception 'R01 adoption intent constraint set differs' using errcode = '55000';\n  end if;\n  for v_constraint in select * from pg_catalog.pg_constraint where conrelid = v_table loop\n    v_expected := case v_constraint.conname\n      when 'adoption_upload_intent_pkey' then 'PRIMARY KEY (application_id)'\n      when 'adoption_upload_intent_photo_paths_check' then 'CHECK (cardinality(photo_paths) >= 1 AND cardinality(photo_paths) <= 6)'\n      when 'adoption_upload_intent_status_token_hash_key' then 'UNIQUE (status_token_hash)'\n      when 'adoption_upload_intent_status_token_hash_check' then 'CHECK (status_token_hash ~ ''^[0-9a-f]{64}$''::text)'\n      when 'adoption_upload_intent_expiry_after_creation' then 'CHECK (expires_at > created_at)' end;\n    if v_expected is null or not v_constraint.convalidated\n      or v_constraint.condeferrable or v_constraint.condeferred\n      or pg_catalog.pg_get_constraintdef(v_constraint.oid, true) <> v_expected then\n      raise exception 'R01 adoption intent constraint differs: %', v_constraint.conname using errcode = '55000';\n    end if;\n  end loop;\n  if (select count(*) from pg_catalog.pg_index where indrelid = v_table) <> 3\n    or exists (\n      select 1 from pg_catalog.pg_index i join pg_catalog.pg_class c on c.oid = i.indexrelid\n      where i.indrelid = v_table and (\n        not i.indisvalid or not i.indisready\n        or pg_catalog.pg_get_indexdef(i.indexrelid) is distinct from case c.relname\n          when 'adoption_upload_intent_pkey' then 'CREATE UNIQUE INDEX adoption_upload_intent_pkey ON public.adoption_upload_intent USING btree (application_id)'\n          when 'adoption_upload_intent_status_token_hash_key' then 'CREATE UNIQUE INDEX adoption_upload_intent_status_token_hash_key ON public.adoption_upload_intent USING btree (status_token_hash)'\n          when 'adoption_upload_intent_cleanup_idx' then 'CREATE INDEX adoption_upload_intent_cleanup_idx ON public.adoption_upload_intent USING btree (expires_at) WHERE (submitted_at IS NULL)' end\n      )\n    ) then\n    raise exception 'R01 adoption intent index differs' using errcode = '55000';\n  end if;\n  -- Actual modern legacy defaults retained eight nongrantable service privileges.\n  -- Preserve that exact reviewed profile only on an existing table. A newly\n  -- missing hosted table receives only the four explicitly granted CRUD rights.\n  if not exists (\n    select 1 from pg_catalog.pg_class c,\n      lateral pg_catalog.aclexplode(coalesce(c.relacl, pg_catalog.acldefault('r', c.relowner))) a\n    where c.oid = v_table\n    group by c.oid, c.relowner\n    having pg_catalog.array_agg(a.privilege_type order by a.privilege_type)\n        filter (where a.grantee = c.relowner) =\n          array['DELETE','INSERT','MAINTAIN','REFERENCES','SELECT','TRIGGER','TRUNCATE','UPDATE']::text[]\n      and (\n        pg_catalog.array_agg(a.privilege_type order by a.privilege_type)\n          filter (where a.grantee = 'service_role'::pg_catalog.regrole) =\n            array['DELETE','INSERT','SELECT','UPDATE']::text[]\n        or (v_existing_intent and pg_catalog.array_agg(a.privilege_type order by a.privilege_type)\n          filter (where a.grantee = 'service_role'::pg_catalog.regrole) =\n            array['DELETE','INSERT','MAINTAIN','REFERENCES','SELECT','TRIGGER','TRUNCATE','UPDATE']::text[])\n      )\n  ) or exists (\n    select 1 from pg_catalog.pg_class c, lateral pg_catalog.aclexplode(coalesce(c.relacl, pg_catalog.acldefault('r', c.relowner))) a\n    where c.oid = v_table and (a.grantor <> c.relowner\n      or a.is_grantable\n      or (a.grantee <> c.relowner and a.grantee <> 'service_role'::pg_catalog.regrole))\n  ) or not (\n    pg_catalog.has_table_privilege('service_role', v_table, 'SELECT')\n    and pg_catalog.has_table_privilege('service_role', v_table, 'INSERT')\n    and pg_catalog.has_table_privilege('service_role', v_table, 'UPDATE')\n    and pg_catalog.has_table_privilege('service_role', v_table, 'DELETE')\n  ) or pg_catalog.has_table_privilege('anon', v_table, 'SELECT,INSERT,UPDATE,DELETE,TRUNCATE,REFERENCES,TRIGGER,MAINTAIN')\n    or pg_catalog.has_table_privilege('authenticated', v_table, 'SELECT,INSERT,UPDATE,DELETE,TRUNCATE,REFERENCES,TRIGGER,MAINTAIN')\n    or pg_catalog.has_any_column_privilege('anon', v_table, 'SELECT,INSERT,UPDATE,REFERENCES')\n    or pg_catalog.has_any_column_privilege('authenticated', v_table, 'SELECT,INSERT,UPDATE,REFERENCES') then\n    raise exception 'R01 adoption intent effective privileges differ' using errcode = '55000';\n  end if;\n\n  -- Nullable without a default: old tokens cannot confirm a changed submission.\n  if not exists (\n    select 1 from pg_catalog.pg_attribute\n    where attrelid = 'public.public_status_token'::pg_catalog.regclass\n      and attname = 'submission_fingerprint' and not attisdropped\n  ) then\n    alter table public.public_status_token add column submission_fingerprint text;\n  end if;\n  select a.*, pg_catalog.pg_get_expr(d.adbin, d.adrelid) as default_expression into v_column\n  from pg_catalog.pg_attribute a\n  left join pg_catalog.pg_attrdef d on d.adrelid = a.attrelid and d.adnum = a.attnum\n  where a.attrelid = 'public.public_status_token'::pg_catalog.regclass\n    and a.attname = 'submission_fingerprint' and not a.attisdropped;\n  if v_column.atttypid <> 'pg_catalog.text'::pg_catalog.regtype or v_column.atttypmod <> -1\n    or v_column.attnotnull or v_column.attidentity <> '' or v_column.attgenerated <> ''\n    or v_column.default_expression is not null or v_column.attacl is not null then\n    raise exception 'R01 adoption fingerprint column differs' using errcode = '55000';\n  end if;\n  if not exists (\n    select 1 from pg_catalog.pg_constraint\n    where conrelid = 'public.public_status_token'::pg_catalog.regclass\n      and conname = 'public_status_token_submission_fingerprint_format'\n  ) then\n    alter table public.public_status_token add constraint public_status_token_submission_fingerprint_format\n      check (submission_fingerprint is null or submission_fingerprint ~ '^[0-9a-f]{64}$');\n  end if;\n  if not exists (\n    select 1 from pg_catalog.pg_constraint\n    where conrelid = 'public.public_status_token'::pg_catalog.regclass\n      and conname = 'public_status_token_submission_fingerprint_format'\n      and contype = 'c' and convalidated and not condeferrable\n      and pg_catalog.pg_get_constraintdef(oid, true) =\n        'CHECK (submission_fingerprint IS NULL OR submission_fingerprint ~ ''^[0-9a-f]{64}$''::text)'\n  ) then\n    raise exception 'R01 adoption fingerprint constraint differs' using errcode = '55000';\n  end if;\n\n  v_function := pg_catalog.to_regprocedure('public.cleanup_expired_adoption_application(uuid)');\n  if v_function is null then\n    if exists (\n      select 1 from pg_catalog.pg_proc where pronamespace = 'public'::pg_catalog.regnamespace\n        and proname = 'cleanup_expired_adoption_application'\n    ) then\n      raise exception 'R01 adoption cleanup has an unexpected overload' using errcode = '55000';\n    end if;\n    execute 'create function public.cleanup_expired_adoption_application(p_application_id uuid)\n      returns text language plpgsql security definer set search_path = '''' as ' || pg_catalog.quote_literal(v_body);\n    revoke all on function public.cleanup_expired_adoption_application(uuid) from public, anon, authenticated, service_role;\n    grant execute on function public.cleanup_expired_adoption_application(uuid) to service_role;\n    v_function := 'public.cleanup_expired_adoption_application(uuid)'::pg_catalog.regprocedure;\n  end if;\n  if (select count(*) from pg_catalog.pg_proc where pronamespace = 'public'::pg_catalog.regnamespace\n    and proname = 'cleanup_expired_adoption_application') <> 1 or not exists (\n    select 1 from pg_catalog.pg_proc p join pg_catalog.pg_language l on l.oid = p.prolang\n    where p.oid = v_function and pg_catalog.pg_get_userbyid(p.proowner) = 'postgres'\n      and p.prokind = 'f' and p.prosecdef and l.lanname = 'plpgsql'\n      and p.prorettype = 'pg_catalog.text'::pg_catalog.regtype and not p.proretset\n      and p.proargnames = array['p_application_id']::text[] and p.pronargdefaults = 0\n      and p.provolatile = 'v' and p.proparallel = 'u' and not p.proisstrict\n      and not p.proleakproof\n      and (\n        (p.prosrc = v_body and p.proconfig = array['search_path=\"\"']::text[])\n        -- Full reviewed legacy body, retained exactly on the modern prestate.\n        or (pg_catalog.md5(p.prosrc) = '422feeb1fc84428147e7e1b49e371ded'\n          and p.proconfig = array['search_path=public, pg_temp']::text[])\n      )\n  ) then\n    raise exception 'R01 adoption cleanup definition differs; explicit review required' using errcode = '55000';\n  end if;\n  if exists (\n    select 1 from pg_catalog.pg_proc p, lateral pg_catalog.aclexplode(coalesce(p.proacl, pg_catalog.acldefault('f', p.proowner))) a\n    where p.oid = v_function and (a.grantor <> p.proowner\n      or (a.grantee <> p.proowner and (a.grantee <> 'service_role'::pg_catalog.regrole\n        or a.privilege_type <> 'EXECUTE' or a.is_grantable)))\n  ) or not pg_catalog.has_function_privilege('service_role', v_function, 'EXECUTE')\n    or pg_catalog.has_function_privilege('anon', v_function, 'EXECUTE')\n    or pg_catalog.has_function_privilege('authenticated', v_function, 'EXECUTE') then\n    raise exception 'R01 adoption cleanup effective EXECUTE differs' using errcode = '55000';\n  end if;\nend;\n$migration$"
  ],
  "transactionMode": "transactional",
  "ownTransaction": false,
  "incompatible": false
}
