{
  "statements": [
    "create or replace function private.append_sponsorship_allocations(\n  p_proof_id uuid,\n  p_actor_admin_id uuid,\n  p_allocations jsonb\n)\nreturns jsonb\nlanguage plpgsql\nsecurity definer\nset search_path = public, pg_temp\nas $fn$\ndeclare\n  v_proof public.sponsorship_payment_proof%rowtype;\n  v_pledge public.sponsorship_pledge%rowtype;\n  v_entry jsonb;\n  v_month date;\n  v_amount integer;\n  v_period_id uuid;\n  v_applied jsonb := '[]'::jsonb;\n  v_total integer := 0;\nbegin\n  select * into v_proof\n  from public.sponsorship_payment_proof\n  where id = p_proof_id\n  for update;\n  if not found then\n    raise exception 'Payment proof % not found', p_proof_id;\n  end if;\n\n  if exists(select 1 from public.sponsorship_payment_source s join public.payment p on p.id=s.payment_id where s.proof_id=p_proof_id and p.status='refunded') then raise exception 'Refunded money cannot be allocated'; end if;\n\n  if v_proof.review_status <> 'approved' then\n    raise exception\n      'Payment proof % is not approved; only a verified payment may be allocated to a month',\n      p_proof_id;\n  end if;\n\n  if p_allocations is null or jsonb_array_length(p_allocations) = 0 then\n    -- Nothing planned. The payment stands as received but unattributed, which\n    -- the ledger shows as an outstanding month rather than hiding.\n    return jsonb_build_object('status', 'skipped', 'proofId', p_proof_id, 'allocatedCents', 0);\n  end if;\n\n  select * into v_pledge\n  from public.sponsorship_pledge\n  where id = v_proof.pledge_id\n  for update;\n  if not found then\n    raise exception 'Sponsorship pledge % not found', v_proof.pledge_id;\n  end if;\n\n  for v_entry in select * from jsonb_array_elements(p_allocations)\n  loop\n    v_month := (v_entry ->> 'periodMonth')::date;\n    v_amount := (v_entry ->> 'amountCents')::integer;\n\n    if v_month is null or v_amount is null then\n      raise exception 'Each allocation needs periodMonth and amountCents, received %', v_entry;\n    end if;\n    if v_month <> date_trunc('month', v_month)::date then\n      raise exception 'periodMonth % must be the first day of a month', v_month;\n    end if;\n    if v_amount <= 0 then\n      raise exception 'Allocation amount must be positive, received %', v_amount;\n    end if;\n\n    -- Open the month if it is new. `committed_cents` comes from the pledge, not\n    -- from the caller, so a month can never be opened committed to an amount\n    -- the supporter never pledged.\n    insert into public.sponsorship_period (pledge_id, period_month, committed_cents)\n    values (v_proof.pledge_id, v_month, v_pledge.amount_cents)\n    on conflict (pledge_id, period_month) do nothing;\n\n    select id into v_period_id\n    from public.sponsorship_period\n    where pledge_id = v_proof.pledge_id and period_month = v_month;\n\n    if v_amount > (select p.committed_cents-coalesce(sum(a.amount_cents),0) from public.sponsorship_period p left join public.sponsorship_payment_allocation a on a.period_id=p.id where p.id=v_period_id group by p.id) then\n      raise exception 'Allocation exceeds outstanding month; split prepayments across months';\n    end if;\n    insert into public.sponsorship_payment_allocation (\n      period_id, proof_id, amount_cents, created_by\n    ) values (\n      v_period_id, p_proof_id, v_amount, p_actor_admin_id\n    );\n\n    v_total := v_total + v_amount;\n    v_applied := v_applied || jsonb_build_object(\n      'periodMonth', v_month,\n      'amountCents', v_amount\n    );\n  end loop;\n\n  return jsonb_build_object(\n    'status', 'allocated',\n    'proofId', p_proof_id,\n    'allocatedCents', v_total,\n    'allocations', v_applied\n  );\nend;\n$fn$",
    "revoke all on function private.append_sponsorship_allocations(uuid,uuid,jsonb) from public,anon,authenticated,service_role",
    "create table public.sponsorship_allocation_command(actor_user_id uuid not null,idempotency_key uuid not null,command jsonb not null,result jsonb not null,primary key(actor_user_id,idempotency_key))",
    "alter table public.sponsorship_allocation_command enable row level security",
    "revoke all on public.sponsorship_allocation_command from public,anon,authenticated,service_role",
    "create function public.allocate_exact_sponsorship_payment(p_actor uuid,p_proof uuid,p_expected_net bigint,p_key uuid,p_month date,p_amount integer,p_reason text)\nreturns jsonb language plpgsql security definer set search_path=public,pg_temp as $$\ndeclare v_actor uuid;v_proof public.sponsorship_payment_proof%rowtype;v_net bigint;v_command jsonb;v_prior public.sponsorship_allocation_command%rowtype;v_result jsonb;\nbegin\n select id into v_actor from public.admin_user where auth_user_id=p_actor and status='active' and role in ('treasurer','admin');\n if v_actor is null then raise exception 'Finance role required' using errcode='42501';end if;\n if p_key is null or p_expected_net is null or p_expected_net<0 or length(trim(coalesce(p_reason,'')))<5 then raise exception 'Expected balance, retry key and reason required';end if;\n perform 1 from public.sponsorship_pledge where id=(select pledge_id from public.sponsorship_payment_proof where id=p_proof) for update;\n perform pg_advisory_xact_lock(hashtextextended(p_actor::text||p_key::text,714));\n v_command:=jsonb_build_object('proof',p_proof,'expectedNet',p_expected_net,'month',p_month,'amount',p_amount,'reason',p_reason);\n select * into v_prior from public.sponsorship_allocation_command where actor_user_id=p_actor and idempotency_key=p_key;\n if found then if v_prior.command<>v_command then raise exception 'Retry key reused for changed allocation';end if;return v_prior.result||jsonb_build_object('replayed',true);end if;\n select * into v_proof from public.sponsorship_payment_proof where id=p_proof for update;\n if not found then raise exception 'Payment proof not found';end if;\n select coalesce(sum(amount_cents),0) into v_net from public.sponsorship_payment_allocation where proof_id=p_proof;\n if v_net<>p_expected_net then raise exception 'Allocation balance changed; reload the ledger';end if;\n if p_amount is null or p_amount<=0 or p_amount>v_proof.amount_cents-v_net then raise exception 'Allocation exceeds the remaining received money';end if;\n v_result:=private.append_sponsorship_allocations(p_proof,v_actor,jsonb_build_array(jsonb_build_object('periodMonth',p_month,'amountCents',p_amount)));\n insert into public.audit_log(actor_user_id,action,entity,entity_id,detail) values(p_actor,'sponsorship_pledge.payment_reallocated','sponsorship_pledge',v_proof.pledge_id::text,jsonb_build_object('proofId',p_proof,'beforeNet',v_net,'allocation',v_result,'reason',p_reason));\n insert into public.sponsorship_allocation_command values(p_actor,p_key,v_command,v_result);\n return v_result;\nend; $$",
    "revoke all on function public.allocate_exact_sponsorship_payment(uuid,uuid,bigint,uuid,date,integer,text) from public,anon,authenticated",
    "grant execute on function public.allocate_exact_sponsorship_payment(uuid,uuid,bigint,uuid,date,integer,text) to service_role"
  ],
  "transactionMode": "transactional",
  "ownTransaction": false,
  "incompatible": false
}
