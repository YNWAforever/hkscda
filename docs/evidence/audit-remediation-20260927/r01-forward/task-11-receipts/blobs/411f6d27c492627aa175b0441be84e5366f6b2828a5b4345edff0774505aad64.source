begin read only;set local search_path=pg_catalog;select coalesce(jsonb_agg(to_jsonb(q)),'[]'::jsonb) from (select jsonb_build_object('owner',pg_get_userbyid(c.relowner),'acl',c.relacl::text,'rls',c.relrowsecurity,'forceRls',c.relforcerowsecurity,'serviceSelect',has_table_privilege('service_role',c.oid,'SELECT'),'serviceUpdate',has_table_privilege('service_role',c.oid,'UPDATE'),'serviceColumnSelect',has_any_column_privilege('service_role',c.oid,'SELECT'),'serviceColumnUpdate',has_any_column_privilege('service_role',c.oid,'UPDATE'),'postgresSelect',has_table_privilege('postgres',c.oid,'SELECT'),'postgresUpdate',has_table_privilege('postgres',c.oid,'UPDATE'),'columns',(select jsonb_agg(jsonb_build_object('name',a.attname,'acl',a.attacl::text,'type',format_type(a.atttypid,a.atttypmod),'notNull',a.attnotnull,'serviceSelect',has_column_privilege('service_role',c.oid,a.attnum,'SELECT'),'serviceUpdate',has_column_privilege('service_role',c.oid,a.attnum,'UPDATE'),'postgresSelect',has_column_privilege('postgres',c.oid,a.attnum,'SELECT'),'postgresUpdate',has_column_privilege('postgres',c.oid,a.attnum,'UPDATE')) order by a.attnum) from pg_attribute a where a.attrelid=c.oid and a.attnum>0 and not a.attisdropped)) value from pg_class c where c.oid='auth.users'::regclass)q;rollback;
