# Safe dummy values for running the test suites. Nothing here is a real credential,
# and none of it reaches a real service: unit and integration tests replace Supabase,
# Stripe, PayPal, Resend and Upstash with in-process fakes, and the admin E2E suite
# starts its own fake Supabase on 127.0.0.1:54331.
#
# The suites do not need this file. `bun run test` is designed to run with no env file
# at all (`bun --no-env-file run test`, see README.md), and CI sets nothing. Copy it to
# `.env.test` only if a local tool insists on one, and never point any value at a
# production project, real payment account or real inbox.

# Disable the auto-detected local RLS stack for a unit-only run (CLAUDE.md).
SUPABASE_LOCAL_URL=http://127.0.0.1:1

# Placeholder Supabase project. Integration tests replace fetch; this host never resolves.
VITE_SUPABASE_URL=http://fake-supabase.invalid
VITE_SUPABASE_ANON_KEY=test-anon-key
SUPABASE_URL=http://fake-supabase.invalid
SUPABASE_SERVICE_ROLE_KEY=test-service-role-key

APP_URL=http://localhost:3000
VITE_PUBLIC_SITE_ORIGIN=http://localhost:3000

# Scheduled jobs refuse callers without this bearer value.
CRON_SECRET=test-cron-secret

# Leave payment, email, Turnstile and Upstash variables unset: the code takes its
# local/preview path (checkout disabled, limiting fail-open, no email sent).
VITE_PUBLIC_DONATION_CHECKOUT_ENABLED=false

# Admin E2E (bun run test:e2e) bakes this fake into the build it makes; listed for reference.
E2E_SUPABASE_URL=http://127.0.0.1:54331
# Optional: run E2E against a Chromium binary instead of installed Google Chrome.
# E2E_CHROMIUM_PATH=/opt/pw-browsers/chromium-1243/chrome-linux64/chrome
