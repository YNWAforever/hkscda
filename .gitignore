# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
.output
.vinxi
.tanstack/**
.nitro
*.local

# Secrets. `*.local` above only covers .env.local — a plain .env or .env.production
# would otherwise be committed. .env.example is the tracked template.
.env
.env.*
!.env.example

.codex/
.superpowers/
.worktrees/
supabase/.temp/

# Wrangler / Cloudflare
.wrangler/
.dev.vars

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.vercel
supabase/.temp/
.superpowers/
.worktrees/

# Scraper session cookies (scripts/scrape-hkscda.js)
data/.cf-state.json
# Browser verification captures are local evidence; representative pairs live under docs/assets.
artifacts/brand-redesign/*
!artifacts/brand-redesign/.gitkeep
# verify:brand writes here in CI (OUTPUT_DIR=artifacts/brand-ci)
artifacts/brand-ci*/
# verify:a11y writes here in CI (OUTPUT_DIR=artifacts/a11y-ci)
artifacts/a11y-ci*/
# verify:performance writes here in CI (OUTPUT_DIR=artifacts/performance-ci)
artifacts/performance-ci*/

# Local database backups -- never commit; may contain real production data
backups/
