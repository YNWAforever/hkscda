{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "brand": {
    "name": "HKSCDA approved public identity",
    "approved": "2026-08"
  },
  "color": {
    "brand": {
      "blue": { "$value": "#05648E", "$type": "color" },
      "blue-deep": { "$value": "#034A69", "$type": "color" },
      "blue-soft": { "$value": "#E4F2F7", "$type": "color" },
      "magenta": { "$value": "#A61C56", "$type": "color" },
      "magenta-deep": { "$value": "#821442", "$type": "color" },
      "magenta-soft": { "$value": "#F9E7EF", "$type": "color" }
    },
    "neutral": {
      "ink": { "$value": "#162C36", "$type": "color" },
      "muted": { "$value": "#5B6E76", "$type": "color" },
      "paper": { "$value": "#FFFDF9", "$type": "color" },
      "warm": { "$value": "#F6F1E9", "$type": "color" },
      "sand": { "$value": "#E8DED0", "$type": "color" },
      "line": { "$value": "#D7DDD9", "$type": "color" },
      "white": { "$value": "#FFFFFF", "$type": "color" }
    },
    "semantic": {
      "primary": { "$value": "{color.brand.blue}", "$type": "color" },
      "primary-hover": { "$value": "{color.brand.blue-deep}", "$type": "color" },
      "primary-highlight": { "$value": "{color.brand.blue-soft}", "$type": "color" },
      "accent": { "$value": "{color.brand.magenta}", "$type": "color" },
      "accent-hover": { "$value": "{color.brand.magenta-deep}", "$type": "color" },
      "accent-highlight": { "$value": "{color.brand.magenta-soft}", "$type": "color" },
      "text": { "$value": "{color.neutral.ink}", "$type": "color" },
      "text-muted": { "$value": "{color.neutral.muted}", "$type": "color" },
      "background": { "$value": "{color.neutral.paper}", "$type": "color" },
      "surface-warm": { "$value": "{color.neutral.warm}", "$type": "color" },
      "border-warm": { "$value": "{color.neutral.sand}", "$type": "color" },
      "border": { "$value": "{color.neutral.line}", "$type": "color" },
      "success": { "$value": "#176F54", "$type": "color" }
    }
  },
  "typography": {
    "font-family": {
      "$value": [
        "Noto Sans HK",
        "PingFang HK",
        "Microsoft JhengHei",
        "system-ui",
        "sans-serif"
      ],
      "$type": "fontFamily"
    },
    "body-line-height": { "$value": 1.72, "$type": "number" },
    "navigation-size": { "$value": "16px", "$type": "dimension" },
    "body-size": { "$value": "16px", "$type": "dimension" }
  },
  "layout": {
    "content-max": { "$value": "1200px", "$type": "dimension" },
    "grid-columns": { "$value": 12, "$type": "number" },
    "spacing-unit": { "$value": "8px", "$type": "dimension" },
    "radius-small": { "$value": "8px", "$type": "dimension" },
    "radius-card": { "$value": "16px", "$type": "dimension" },
    "radius-pill": { "$value": "999px", "$type": "dimension" },
    "touch-target-min": { "$value": "44px", "$type": "dimension" }
  },
  "motion": {
    "reveal-fast": { "$value": "350ms", "$type": "duration" },
    "reveal-slow": { "$value": "500ms", "$type": "duration" }
  }
}

