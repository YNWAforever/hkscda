# Public Supabase client config
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side Supabase access
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_RECEIPT_BUCKET=receipts

# Admin seeding
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin
ADMIN_ROLE=admin

# App URLs
APP_URL=http://localhost:3000

# Stripe test mode
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=

# Resend test mode/domain
RESEND_API_KEY=
DONATION_EMAIL_FROM=HKSCDA <noreply@hkscda.com>
DONATION_REPLY_TO=info@hkscda.com
NOTIFICATION_EMAIL=info@hkscda.com

# Receipt PDF metadata
RECEIPT_SIGNATORY_NAME=HKSCDA
RECEIPT_CHARITY_NAME=香港拯救貓狗協會有限公司
RECEIPT_FILE_NO=91/14493

# Rate limiting (Upstash Redis). Leave unset to disable limiting (dev/preview);
# the limiter fails open when these are absent.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile CAPTCHA on the public donation + adoption forms.
# TURNSTILE_SECRET_KEY is server-only; VITE_TURNSTILE_SITE_KEY is public.
# Leave unset to disable (verification fails open when the secret is absent).
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=
